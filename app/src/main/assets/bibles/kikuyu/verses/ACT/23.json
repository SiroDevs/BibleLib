{
  "id": "ACT.23",
  "number": "23",
  "bookId": "ACT",
  "reference": "Atũmwo 23",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "ACT 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Paũlũ agĩkũũrĩra athuuri a Kĩama kĩu maitho akĩmeera atĩrĩ, “Ariũ a Baba, nĩndungatĩire Ngai ndĩ na thamiri ĩtarĩ ũcuuke nginya mũthenya wa ũmũthĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Anania mũthĩnjĩri-Ngai ũrĩa mũnene, agĩatha andũ arĩa maarũgamĩte hakuhĩ na Paũlũ mamũringe kanua.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.2",
            "verseOrgIds": [
              "ACT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Paũlũ akĩmwĩra atĩrĩ, “Wee rũthingo rũrũ rũhakĩtwo mũnyũ mwerũ, we nĩwe ũkũringwo nĩ Ngai! Ũikarĩte hau ũnduĩre ciira kũringana na watho, no wee ũkaregana na watho, ũgaathana atĩ ningwo!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.3",
            "verseOrgIds": [
              "ACT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ arĩa maarũgamĩte hakuhĩ na Paũlũ makĩmũũria atĩrĩ, “Anga nĩũkũũmĩrĩria kũruma mũthĩnjĩri-Ngai ũrĩa mũnene?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.4",
            "verseOrgIds": [
              "ACT.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Paũlũ akĩmacookeria atĩrĩ, “Ariũ a Baba, ndikũmenyete atĩ ũcio nĩwe mũthĩnjĩri-Ngai ũrĩa mũnene; nĩgũkorwo nĩ kwandĩkĩtwo atĩrĩ: ‘Ndũkanaarie ũũru igũrũ rĩa mũnene wa andũ anyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, Paũlũ aamenya atĩ amwe ao maarĩ Asadukai, na arĩa angĩ Afarisai, akĩanĩrĩra Kĩama-inĩ kĩu, akiuga atĩrĩ, “Ariũ a Baba, niĩ ndĩ Mũfarisai, na njiarĩtwo nĩ Mũfarisai. Ndĩraciirithio nĩ ũndũ wa kĩĩrĩgĩrĩro gĩakwa gĩa kũriũkio kwa arĩa akuũ.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa oigire ũguo, gũkĩgĩa na ngarari gatagatĩ ka Afarisai na Asadukai, nakĩo kĩũngano kĩu gĩkĩamũkana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.7",
            "verseOrgIds": [
              "ACT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Asadukai moigaga gũtirĩ ũriũkio, na gũtirĩ araika, o na kana maroho, no Afarisai nĩmetĩkĩtie maũndũ macio mothe.)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.8",
            "verseOrgIds": [
              "ACT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gũkĩgĩa na ngũĩ nene, nao arutani a watho amwe arĩa maarĩ Afarisai makĩrũgama na makĩaria megũmĩire mũno, makiuga atĩrĩ, “Ithuĩ tũtirona ũũru wa mũndũ ũyũ. Ĩ kũngĩkorwo nĩ roho kana mũraika ũmwarĩirie?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.9",
            "verseOrgIds": [
              "ACT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ngarari ikĩneneha mũno, o nginya mũnene wa mbũtũ akĩigua guoya nĩkuona ta Paũlũ angĩtarũrangwo tũcunjĩ nĩo. Agĩatha mbũtũ cia thigari ciikũrũke, imweherie harĩo na hinya, na imũtware nyũmba ya thigari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.10",
            "verseOrgIds": [
              "ACT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtukũ ũrĩa warũmĩrĩire, Mwathani akĩrũgama hakuhĩ na Paũlũ, akĩmwĩra atĩrĩ, “Wĩyũmĩrĩrie! O ũguo ũheanĩte ũhoro wakwa gũkũ Jerusalemu, noguo ũkaũheana kũu Roma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.11",
            "verseOrgIds": [
              "ACT.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ithugunda rĩa Kũũraga Paũlũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rũciinĩ rũrũ rũngĩ, Ayahudi makĩgĩa na ndundu na makĩĩhĩta mwĩhĩtwa matikaarĩe kana manyue matooragĩte Paũlũ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.12",
            "verseOrgIds": [
              "ACT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ arĩa maathugundĩte ndundu ĩyo maarĩ makĩria ya mĩrongo ĩna.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.13",
            "verseOrgIds": [
              "ACT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩthiĩ kũrĩ athĩnjĩri-Ngai arĩa anene na athuuri makĩmeera atĩrĩ, “Ithuĩ nĩtwĩhĩtĩte mwĩhĩtwa wa kwaga kũrĩa kĩndũ kana kũnyua nginya tũũrage Paũlũ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.14",
            "verseOrgIds": [
              "ACT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, inyuĩ mũrĩ hamwe na Kĩama gĩa Athuuri ũriai mũnene wa mbũtũ amũrehe mbere yanyu, mwĩtuĩte ta mũrenda gũtuĩria wega ũhoro wa ciira wake. Ithuĩ nĩtwĩhaarĩirie kũmũũraga atanakinya haha.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.15",
            "verseOrgIds": [
              "ACT.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩa mwanake wa mwarĩ wa nyina na Paũlũ aaiguire ũhoro wa ithugunda rĩu, agĩthiĩ nyũmba ya thigari akĩĩra Paũlũ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.16",
            "verseOrgIds": [
              "ACT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Paũlũ agĩĩta ũmwe wa anene a thigari igana rĩmwe, akĩmwĩra atĩrĩ, “Twara mwanake ũyũ kũrĩ mũnene wa mbũtũ; arĩ na ũndũ arenda kũmwĩra.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.17",
            "verseOrgIds": [
              "ACT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio mũnene ũcio akĩmuoya, akĩmũtwara kũrĩ mũnene wa mbũtũ. Mũnene ũcio wa thigari igana rĩmwe akĩmwĩra atĩrĩ, “Paũlũ, ũrĩa muohe nĩandũmanĩire anjĩĩra ndeehe mwanake ũyũ kũrĩ we tondũ arĩ na ũndũ arenda gũkwĩra.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.18",
            "verseOrgIds": [
              "ACT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene ũcio wa mbũtũ akĩnyiita mwanake ũcio guoko, akĩmũtwara keeheri-inĩ, akĩmũũria atĩrĩ, “Nĩ atĩa ũrenda kũnjĩĩra?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.19",
            "verseOrgIds": [
              "ACT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mwanake ũcio akĩmũcookeria atĩrĩ, “Ayahudi nĩmaiguanĩire makũũrie ũmarehere Paũlũ nĩguo arũgame mbere ya kĩama rũciũ, metuĩte ta marenda gũtuĩria ũhoro wake wega.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.20",
            "verseOrgIds": [
              "ACT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũgetĩkĩre ũguo marenda, tondũ andũ makĩria ya mĩrongo ĩna ao mamuoheirie njĩra-inĩ. Nĩmehĩtĩte mwĩhĩtwa wa kwaga kũrĩa kana kũnyua nginya mamũũrage. Na rĩrĩ, nĩmehaarĩirie, metereire wĩtĩkĩre ihooya rĩao.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.21",
            "verseOrgIds": [
              "ACT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũnene ũcio wa mbũtũ akĩĩra mwanake ũcio athiĩ, na akĩmũkaania, akĩmwĩra atĩrĩ, “Ndũkeere mũndũ o na ũrĩkũ atĩ nĩũnginyĩirie ũhoro ũcio.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paũlũ Gũtwarwo Kaisarea",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũnene ũcio wa mbũtũ agĩcooka agĩĩta anene aake eerĩ a thigari igana rĩmwe akĩmaatha atĩrĩ, “Haarĩriai gĩkundi gĩa thigari magana meerĩ, na thigari mĩrongo mũgwanja iria ithiiaga ihaicĩte mbarathi, na thigari magana meerĩ iria ithiiaga ikuuĩte matimũ, nĩguo mathiĩ Kaisarea thaa ithatũ cia ũtukũ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.23",
            "verseOrgIds": [
              "ACT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ningĩ mũhaarĩrie mbarathi cia gũkuua Paũlũ atwarwo kũrĩ Felike ũrĩa barũthi hatarĩ na ũgwati.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.24",
            "verseOrgIds": [
              "ACT.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agĩcooka akĩandĩka marũa ũũ:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.25",
            "verseOrgIds": [
              "ACT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ niĩ Kilaudio Lisia,\nKũrĩ mũgaathe Barũthi Felike:\nNĩndakũgeithia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũyũ aranyiitĩtwo nĩ Ayahudi na mararĩ hakuhĩ kũmũũraga, no ndĩrathiĩ na thigari ciakwa ndĩramũthara, nĩgũkorwo nĩndĩramenyete atĩ nĩ raiya wa Roma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.27",
            "verseOrgIds": [
              "ACT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩndĩrendaga kũmenya kĩrĩa maramũthitangagĩra, na nĩ ũndũ ũcio ndĩramũtwara Kĩama-inĩ kĩao.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.28",
            "verseOrgIds": [
              "ACT.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndĩrakora atĩ athitangĩirwo maũndũ makoniĩ watho wao, no hatirarĩ ũndũ acuukĩirwo ũngĩratũmire atuĩrwo kũũragwo kana kuohwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.29",
            "verseOrgIds": [
              "ACT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa ndĩramenyithirio atĩ kũraarĩ na ithugunda rĩa kũũraga mũndũ ũcio, ndĩramũtũma kũrĩ we o hĩndĩ ĩyo. Ndĩracooka ndĩraatha andũ acio mamũthitangĩte makũrehere thitango ĩrĩa mamũthitangĩire.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio thigari ikĩoya Paũlũ ũtukũ o ta ũrĩa ciaathĩtwo, ikĩmũtwara o nginya Antipatiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.31",
            "verseOrgIds": [
              "ACT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo mũthenya ũyũ ũngĩ igĩtiga thigari iria ciathiiaga ihaicĩte mbarathi ithiĩ nake, nacio igĩcooka nyũmba ciao.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.32",
            "verseOrgIds": [
              "ACT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thigari icio cia mbarathi ciakinya Kaisarea, ikĩnengera barũthi marũa na ikĩneana Paũlũ kũrĩ we.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake barũthi aathoma marũa, akĩũria kũrĩa Paũlũ oimĩte. Rĩrĩa aamenyire atĩ oimĩte Kilikia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "akĩmwĩra atĩrĩ, “Ngaathikĩrĩria ciira waku andũ arĩa magũthitangĩte mooka.” Agĩcooka agĩathana Paũlũ aikare arangĩrĩtwo kũu nyũmba-inĩ ya ũthamaki ya Herode.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
            "verseOrgIds": [
              "ACT.23.35"
            ]
          }
        }
      ]
    }
