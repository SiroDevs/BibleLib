{
  "id": "ACT.25",
  "number": "25",
  "bookId": "ACT",
  "reference": "Atũmwo 25",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
