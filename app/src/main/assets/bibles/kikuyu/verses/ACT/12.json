{
  "id": "ACT.12",
  "number": "12",
  "bookId": "ACT",
  "reference": "Atũmwo 12",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
