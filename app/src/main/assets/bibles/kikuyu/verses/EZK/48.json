    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na rĩrĩ, maya nĩmo marĩĩtwa ma mĩhĩrĩga ĩyo: Mũhaka-inĩ wa mwena wa gathigathini, Dani nĩakaheo gĩcigo kĩmwe; nakĩo gĩgaatwarana na njĩra ya Hethiloni ya gũthiĩ nginya Lebo-Hamathu; Hazari-Enani na mũhaka wa mwena wa gathigathini wa Dameski kũrigania na Hamathu gũgaakorwo kũrĩ mũhaka wakuo kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Asheri aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Dani kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Nafitali aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Asheri kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Manase aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Nafitali kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Efiraimu aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Manase kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Rubeni aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Efiraimu kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Juda aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Rubeni kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ningĩ kũhakana na rũgongo rwa Juda kuuma mwena wa irathĩro nginya mwena wa ithũĩro, nĩmũkaruta gĩcigo mũkĩneane gĩtuĩke kĩheo kĩa mwanya. Gĩgaakorwo kĩrĩ na wariĩ wa mĩkono 25,000kwarama, naguo ũraihu wakĩo ũkaiganana na gĩcigo kĩmwe kĩa iria igaĩirwo mĩhĩrĩga kuuma mwena wa irathĩro nginya mwena wa ithũĩro; naho handũ-harĩa-haamũre hagaakorwo harĩ gatagatĩ ga kĩo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gĩcigo kĩu kĩa mwanya mũkaarutĩra Jehova-rĩ, gĩgaakorwo kĩrĩ na ũraihu wa mĩkono 25,000, na wariĩ wa mĩkono 10,000.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcigo kĩu gĩgaatuĩka gĩcigo kĩamũre kĩa athĩnjĩri-Ngai. Gĩgaakorwo kĩrĩ kĩa ũraihu wa mĩkono 25,000 mwena wa gathigathini na wariĩ wa mĩkono 10,000 mwena wa ithũĩro, na wariĩ wa mĩkono 10,000 mwena wa irathĩro, na ũraihu wa mĩkono 25,000 mwena wa gũthini. Handũ-harĩa-haamũre hagaakorwo harĩ gatagatĩ ga kĩo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcigo kĩu gĩgaatuĩka kĩa athĩnjĩri-Ngai arĩa aamũre, nao nĩ andũ a Zadoku arĩa matũũrĩte marĩ ehokeku makĩndungatĩra, na matiigana gũturuura ta ũrĩa Alawii meekire hĩndĩ ĩrĩa andũ a Isiraeli maaturuurire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcigo kĩu gĩgaatuĩka kĩheo kĩao kĩa mwanya kĩrutĩtwo kuuma gĩcigo-inĩ kĩu kĩamũre kĩa bũrũri, nakĩo gĩgaatuĩka igai itheru mũno, na gĩkaahakana na rũgongo rwa Alawii.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gũtwarana na rũgongo rũu rwa athĩnjĩri-Ngai-rĩ, Alawii nĩmakagaya gĩcigo kĩa mĩkono 25,000, na wariĩ wa mĩkono 10,000. Ũraihu wakĩo wothe ũgaakorwo ũrĩ mĩkono 25,000, naguo wariĩ wakĩo ũkorwo ũrĩ wa mĩkono 10,000.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao matikanendie kana makũũranie o na kĩmwe gĩa cio. Gĩkĩ nĩkĩo gĩcigo kĩrĩa kĩega mũno bũrũri-inĩ ũyũ, na gĩtikananengerwo mũndũ ũngĩ, tondũ nĩkĩamũrĩre Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gĩcigo kĩrĩa gĩgaatigara kĩa wariĩ wa mĩkono 5,000,na ũraihu wa mĩkono 25,000, gĩgaatuĩka gĩa kũhũthagĩrwo na maũndũ ma itũũra rĩu inene, kĩhũthĩrwo na gwakwo nyũmba cia gũtũũrwo, na ithaka cia ũrĩithio. Itũũra rĩu inene rĩgaakorwo gatagatĩ ga gĩcigo kĩu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "narĩo itũũra rĩu rĩgaakorwo na ithimo ici: mwena wa gathigathini nĩ mĩkono 4,500,na mwena wa gũthini nĩ mĩkono 4,500, na mwena wa irathĩro nĩ mĩkono 4,500, na mwena wa ithũĩro nĩ 4,500.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩthaka kĩa ũrĩithio wa itũũra rĩu inene gĩgaakorwo kĩrĩ na mĩkono 250mwena wa gathigathini, na mĩkono 250 mwena wa gũthini, na mĩkono 250 mwena wa irathĩro, na mĩkono 250 mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcigo kĩrĩa gĩgaatigara, kĩhakanĩte na gĩcigo kĩu kĩamũre, na gĩtwaranĩte na ũraihu wakĩo, gĩgaakorwo kĩrĩ kĩa mĩkono 10,000 mwena wa irathĩro, na mĩkono 10,000 mwena wa ithũĩro. Maciaro makĩo nĩmo makaarĩĩagwo nĩ aruti wĩra a itũũra rĩu inene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aruti wĩra acio a itũũra rĩu inene arĩa makaarĩmaga kũu makoima mĩhĩrĩga-inĩ yothe ya Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcigo kĩu gĩothe gĩgaakorwo kĩiganaine mĩena yothe ĩna, na gĩkorwo kĩrĩ na mĩkono 25,000 o mwena. Nĩmũkaruta gĩcigo kĩu kĩamũre kĩrĩ kĩheo kĩa mwanya, gĩtuĩke gĩcigo kĩamũre, mũkĩrutanĩrie na gĩthaka gĩa itũũra rĩu inene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kũndũ kũrĩa gũgaatigara mĩena yeerĩ ya gĩcigo kĩu kĩamũre na gĩthaka gĩa itũũra rĩrĩa inene gũgaatuĩka kwa mũthamaki. Kũndũ kũu gũgaatambũrũka mwena wa irathĩro wa kũrĩa gwathimĩtwo mĩkono 25,000 ya gĩcigo kĩu kĩamũre gũkinye nginya mũhaka-inĩ wa mwena wa irathĩro, naguo mwena wa ithũĩro uume hau haathimĩtwo mĩkono 25,000, gũkinye nginya mũhaka-inĩ wa mwena wa ithũĩro. Icigo icio cierĩ itwaranĩte na ũraihu wa icigo icio ingĩ cia mĩhĩrĩga igaatuĩka cia mũthamaki, nakĩo gĩcunjĩ kĩrĩa kĩamũre, hamwe na handũ-harĩa-haamũre ha hekarũ igaakorwo gatagatĩ ga kũndũ kũu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ithaka cia Alawii na ithaka cia itũũra inene igaakorwo irĩ gatagatĩ ga gĩcigo kĩu kĩa mũthamaki. Gĩcigo kĩu kĩa mũnene gĩgaakorwo kĩrĩ gatagatĩ ka mũhaka wa Juda na mũhaka wa Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ha ũhoro wa mĩhĩrĩga ĩyo ĩngĩ ĩtigarĩte: Benjamini akaaheo gĩcigo kĩmwe; nakĩo gĩgaatambũrũka kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Simeoni aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Benjamini kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Isakaru aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Simeoni kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake Zebuluni aheo gĩcigo kĩmwe; nakĩo gĩkaahakana na rũgongo rwa Isakaru kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gadi nĩakagaya gĩcigo kĩmwe; gĩkaahakana na rũgongo rwa Zebuluni kuuma mwena wa irathĩro nginya mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũhaka wa mwena wa gũthini wa Gadi ũgaathiĩ ũrorete mwena wa gũthini kuuma Tamaru nginya maaĩ ma Meriba-Kadeshi, ningĩ ũtwarane na Karũũĩ ka Misiri nginya Iria Rĩrĩa Inene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 48:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ũcio nĩguo bũrũri ũrĩa mũkaagayania ũtuĩke igai rĩa mĩhĩrĩga ya Isiraeli, nacio icio nĩcio igaatuĩka icigo ciao,” ũguo nĩguo Mwathani Jehova ekuuga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.29",
            "verseOrgIds": [
              "EZK.48.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihingo cia Itũũra Inene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 48:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ici nĩcio igaatuĩka njĩra cia kuuma itũũra rĩu inene: Kwambĩrĩria mwena wa gathigathini, ũrĩa ũrĩ na ũraihu wa mĩkono 4,500,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.30",
            "verseOrgIds": [
              "EZK.48.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 48:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihingo cia itũũra rĩu inene igeetanio na mĩhĩrĩga ya Isiraeli. Ihingo icio ithatũ irĩ mwena wa gathigathini-rĩ, kĩmwe nĩ kĩa Rubeni, kĩu kĩngĩ nĩ kĩa Juda, na kĩu kĩngĩ nĩ kĩa Lawi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naguo mwena wa irathĩro, ũrĩa ũrĩ na ũraihu wa mĩkono 4,500, ũgaakorwo ũrĩ na ihingo ithatũ: kĩmwe nĩ kĩa Jusufu, kĩu kĩngĩ nĩ kĩa Benjamini, na kĩu kĩngĩ nĩ kĩa Dani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ningĩ mwena wa gũthini, ũrĩa ũrĩ na gĩthimo kĩa mĩkono 4,500, ũgaakorwo ũrĩ na ihingo ithatũ: kĩmwe nĩ kĩa Simeoni, kĩu kĩngĩ nĩ kĩa Isakaru, na kĩu kĩngĩ nĩ kĩa Zebuluni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“O na ningĩ mwena wa ithũĩro, ũrĩa ũrĩ na ũraihu wa mĩkono 4,500, ũgaakorwo ũrĩ na ihingo ithatũ: kĩmwe nĩ kĩa Gadi, kĩu kĩngĩ nĩ kĩa Asheri, na kĩu kĩngĩ nĩ kĩa Nafitali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 48:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itĩĩna rĩa gũthiũrũrũkĩria itũũra rĩu rĩothe rĩgaakorwo na mĩkono 18,000.“Narĩo itũũra rĩu inene kuuma hĩndĩ ĩyo gũthiĩ na mbere rĩgeetagwo ũũ: JEHOVA ARĨ KUO.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.35",
            "verseOrgIds": [
              "EZK.48.35"
            ]
          }
        }
      ]
    }
