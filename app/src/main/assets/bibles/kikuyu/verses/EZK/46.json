{
  "id": "EZK.46",
  "number": "46",
  "bookId": "EZK",
  "reference": "Ezekieli 46",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
