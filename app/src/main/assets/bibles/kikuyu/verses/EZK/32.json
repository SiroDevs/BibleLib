              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka-inĩ wa ikũmi na ĩĩrĩ, mũthenya wa mbere wa mweri wa ikũmi na ĩĩrĩ, kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩĩrwo atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũrũ wa mũndũ, ambĩrĩria gũcakaĩra Firaũni, mũthamaki wa Misiri, ũmwĩre atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
