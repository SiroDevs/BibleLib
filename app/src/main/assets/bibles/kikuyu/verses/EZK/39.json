  "bookId": "EZK",
  "reference": "Ezekieli 39",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "EZK 39"
      },
      "items": [
