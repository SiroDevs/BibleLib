              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Rĩu-rĩ, gĩko gĩaku nĩ ũũra-thoni. Tondũ ngeretie gũgũtheria, no wee ndũngĩthera gĩko gĩaku, wee ndũngĩthera rĩngĩ nginya mangʼũrĩ makwa ma gũgũũkĩrĩra makahũahũa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Niĩ Jehova nĩnjarĩtie. Ihinda nĩikinyu njĩke ũndũ. Ndikerigĩrĩria; na ndikaiguanĩra tha kana ndĩĩricũkwo. Ũgaatuĩrwo ciira kũringana na mĩtugo yaku, na ciĩko ciaku, ũguo nĩguo Mwathani Jehova ekuuga.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũtumia wa Ezekieli Gũkua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩĩrwo atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũrũ wa mũndũ, atĩrĩ, ndĩ hakuhĩ gũkwehereria kĩrĩa gĩkenagia maitho maku mũno na igũtha o rĩmwe. No rĩrĩ, ndũgacakae kana ũrĩre, o na kana ũite maithori.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caaya ũkirĩte; tiga kũrĩrĩra ũcio ũkuĩte. Ikara wĩohete kĩremba mũtwe na wĩkĩrĩte iraatũ magũrũ; ndũkehumbĩre kanua kana ũrĩe irio cia mũtugo wa hĩndĩ ya macakaya.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.17",
            "verseOrgIds": [
              "EZK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngĩrooka kwarĩria andũ rũciinĩ, na hwaĩ-inĩ ũcio mũtumia wakwa agĩkua. Rũciinĩ rũrũ rũngĩ ngĩĩka o ta ũrĩa ndaathĩtwo njĩke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
            "verseOrgIds": [
              "EZK.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ acio makĩnjũũria atĩrĩ, “Kaĩ ũtangĩtwĩra ũhoro wa maũndũ maya na ũrĩa matũkoniĩ?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
            "verseOrgIds": [
              "EZK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngĩmeera atĩrĩ, “Kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩĩrwo atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.20",
            "verseOrgIds": [
              "EZK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩra andũ a nyũmba ya Isiraeli atĩrĩ, ‘Ũũ nĩguo Mwathani Jehova ekuuga: Ngirie gũthaahia handũ-hakwa-harĩa-haamũre, hau gĩikaro kĩa hinya kĩrĩa mwĩtĩĩaga nakĩo, o kĩu gĩkenagia maitho manyu, kĩrĩa mwendete. Ariũ na aarĩ anyu arĩa mwatigire na thuutha makaaniinwo na rũhiũ rwa njora.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.21",
            "verseOrgIds": [
              "EZK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inyuĩ nĩmũgeeka o ta ũguo niĩ njĩkĩte. Mũtikehumbĩra kanua kana mũrĩe irio cia mũtugo wa hĩndĩ ya macakaya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũgaikara mwĩohete iremba mĩtwe na mwĩkĩrĩte iraatũ magũrũ. Mũtigacakaya kana mũrĩre, no nĩmũkahwererekera tondũ wa mehia manyu na mũcaayage thĩinĩ wanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.23",
            "verseOrgIds": [
              "EZK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezekieli agaatuĩka rũũri harĩ inyuĩ; mũgeeka o ta ũguo we ekĩte. Hĩndĩ ĩrĩa maũndũ macio mageekĩka-rĩ, nĩrĩo mũkaamenya atĩ niĩ nĩ niĩ Mwathani Jehova.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nawe mũrũ wa mũndũ, mũthenya ũrĩa ngeeheria gĩikaro kĩao kĩa hinya, gĩkeno kĩao na riiri wao, na kĩndũ kĩrĩa gĩkenagia maitho mao, na wendi wa ngoro ciao, na aanake na airĩtu ao o nao,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũthenya ũcio mũndũ ũũrĩte kwao nĩagakũrehera ũhoro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo kanua gaku nĩgagatumũka; nĩũkaria nake, na ndũgacooka gũkira. Nĩ ũndũ ũcio wee ũgaatuĩka rũũri harĩo, nao nĩmakamenya atĩ niĩ nĩ niĩ Jehova.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.27",
            "verseOrgIds": [
              "EZK.24.27"
            ]
          }
        }
      ]
    }
  ],
