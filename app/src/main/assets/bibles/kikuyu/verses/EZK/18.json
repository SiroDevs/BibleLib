      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩũrio atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inyuĩ andũ aya, mũkoragwo mũkiuga atĩa rĩrĩa mũkwaria thimo ĩno igũrũ rĩa bũrũri wa Isiraeli:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwathani Jehova ekuuga atĩrĩ: Ti-itherũ o ta ũrĩa niĩ ndũũraga muoyo-rĩ, mũtigacooka kũgweta thimo ĩno thĩinĩ wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo roho o wothe ũrĩ muoyo nĩ wakwa; roho wa ithe nĩ wakwa o na wa mũriũ no wakwa. Roho ũrĩa wĩhagia nĩguo ũgaakua.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
