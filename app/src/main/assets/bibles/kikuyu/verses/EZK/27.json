      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩĩrwo atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.1",
            "verseOrgIds": [
              "EZK.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũrũ wa mũndũ, cakaya nĩ ũndũ wa Turo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩra Turo, itũũra rĩu rĩrĩ itoonyero-inĩ rĩa iria, rĩu rĩonjoranagia na andũ a ndwere-inĩ nyingĩ cia iria atĩrĩ, ‘Mwathani Jehova ekuuga ũũ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
