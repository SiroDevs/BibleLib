          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ agĩcooka akĩnginyia kĩhingo-inĩ kĩa mwena wa gathigathini, nake agĩthima kĩhingo kĩu. Nakĩo nĩkĩaiganainie ithimo na ihingo icio ingĩ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
            "verseOrgIds": [
              "EZK.40.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
