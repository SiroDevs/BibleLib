{
  "id": "EZK.25",
  "number": "25",
  "bookId": "EZK",
  "reference": "Ezekieli 25",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "EZK 25"
      },
      "items": [
