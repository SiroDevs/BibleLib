              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, mwaka-inĩ wa ikũmi na ũmwe, mũthenya wa mbere wa mweri wa gatatũ, kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩĩrwo atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
