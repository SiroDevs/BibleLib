            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũrũ wa mũndũ, arĩria Firaũni mũthamaki wa Misiri na kĩrĩndĩ gĩake, ũmeere atĩrĩ:",
          "type": "text",
          "attrs": {
