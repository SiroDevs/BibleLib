{
  "id": "EZK.3",
  "number": "3",
  "bookId": "EZK",
  "reference": "Ezekieli 3",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EZK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũndũ ũcio akĩnjĩĩra atĩrĩ, “Mũrũ wa mũndũ, rĩa kĩrĩa kĩrĩ mbere yaku, rĩa ibuku rĩĩrĩ rĩa gĩkũnjo; ũcooke ũthiĩ ũkaarĩrie andũ a nyũmba ya Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngĩathamia kanua, nake akĩĩhe ibuku rĩu rĩa gĩkũnjo ndĩrĩrĩe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ akĩnjĩĩra atĩrĩ, “Mũrũ wa mũndũ, rĩa ibuku rĩĩrĩ rĩa gĩkũnjo ndĩrakũhe ũiyũrie nda yaku.” Nĩ ũndũ ũcio ngĩrĩrĩa, na rĩrĩ kanua-inĩ gakwa rĩarĩ na mũrĩo ta ũũkĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ agĩcooka akĩnjĩĩra atĩrĩ: “Mũrũ wa mũndũ, thiĩ o rĩu kũrĩ andũ a nyũmba ya Isiraeli ũmaarĩrie ciugo ciakwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndũratũmwo kũrĩ andũ a mwarĩrie ũtooĩ kana rũthiomi rũritũ, no nĩ kũrĩ andũ a nyũmba ya Isiraeli;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti kũrĩ ndũrĩrĩ nyingĩ iria ciaragia mwarĩrie ũtooĩ kana rũthiomi rũritũ, kana rũrĩ na ciugo iria ũtangĩmenya. Ti-itherũ, korwo nĩndagũtũmĩte kũrĩ o, nĩmangĩagũthikĩrĩirie.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, andũ a nyũmba ya Isiraeli matingĩenda gũkũigua, nĩ ũndũ matiendaga kũnjigua, nĩgũkorwo nyũmba yothe ya Isiraeli nĩyũmĩtie ngoro na ĩkangʼathia.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, niĩ ngũtũma wage kuororoa na ũũmie ngoro o ta o.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngũtũma gĩthiithi gĩaku kĩũme ta ihiga rĩrĩa rĩũmũ mũno, rĩrĩa rĩũmũ gũkĩra ihiga rĩa nyaigĩ. Ndũkametigĩre kana ũmakio nĩo, o na akorwo nĩ a nyũmba ya ũremi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ akĩnjĩĩra atĩrĩ, “Mũrũ wa mũndũ, thikĩrĩria wega na wĩkĩre ciugo iria ciothe ngũkwarĩria ngoro-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thiĩ o rĩu kũrĩ andũ anyu arĩa matahĩtwo warie nao. Meere atĩrĩ, ‘Ũũ nĩguo Mwathani Jehova ekuuga,’ kana nĩmegũthikĩrĩria kana matigũthikĩrĩria.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Roho akĩnjoya na igũrũ, na ngĩigua mũgambo mũnene thuutha wakwa ũkĩruruma. (Riiri wa Jehova ũrogoocwo arĩ o kũu gĩikaro-inĩ gĩake!)",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo warĩ mũgambo wa mathagu ma ciũmbe icio irĩ muoyo makĩhutania mo mene, na wa magũrũ ma ngaari marĩa maarĩ mĩena yacio, naguo warĩ mũgambo mũnene warurumaga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho agĩcooka akĩnjoya na igũrũ akĩnjeheria, na niĩ ngĩthiĩ ndĩ na marũrũ na marakara ngoro-inĩ, nakuo guoko kwa Jehova kũrĩa kwa hinya kwarĩ igũrũ rĩakwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩkinya kũrĩ arĩa maatahĩtwo, arĩa maatũũraga kũu Teli-Abibu, gũkuhĩ na Rũũĩ rwa Kebari, na ngĩikarania nao kwa ihinda rĩa mĩthenya mũgwanja, makĩte mũno.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeli Gũkaanio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha wa mĩthenya ĩyo mũgwanja-rĩ, kiugo kĩa Jehova gĩkĩnginyĩrĩra, ngĩĩrwo atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũrũ wa mũndũ, nĩngũtuĩte mũrangĩriwa andũ a nyũmba ya Isiraeli, nĩ ũndũ ũcio igua kiugo kĩrĩa ngwaria, na ũmeere ũrĩa ndĩramakaania.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.17",
            "verseOrgIds": [
              "EZK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa ngwĩra mũndũ mwaganu atĩrĩ, ‘Ti-itherũ, nĩũgaakua,’ nawe wage kũmũkaania, kana kũmwarĩria atigane na mĩthiĩre yake ya waganu nĩguo ahonokie muoyo wake-rĩ, mũndũ ũcio mwaganu nĩagaakua nĩ ũndũ wa mehia make, nawe nĩwe ngooria thakame yake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.18",
            "verseOrgIds": [
              "EZK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "No wee ũngĩkaania mũndũ ũcio mwaganu, nake arege kũgarũrũka atigane na waganu wake kana mĩthiĩre yake mĩũru-rĩ, we nĩagaakua nĩ ũndũ wa mehia make; no wee-rĩ, nĩũgaakorwo ũhonoketie muoyo waku.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ningĩ-rĩ, mũndũ mũthingu angĩgarũrũka atigane na ũthingu wake eke maũndũ mooru, na niĩ ndĩmwĩkĩrĩre mũhĩnga mbere yake-rĩ, nĩagaakua. Kũngĩkorwo ndwamũkaanirie-rĩ, nĩagaakua nĩ ũndũ wa mehia make. Maũndũ marĩa aneeka ma ũthingu matikaaririkanwo, nawe nĩwe ngooria thakame yake.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.20",
            "verseOrgIds": [
              "EZK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, wee ũngĩkaania mũndũ ũcio mũthingu atige kwĩhia, nake aage kwĩhia-rĩ, ti-itherũ nĩagatũũra muoyo nĩ ũndũ nĩathikĩrĩirie ũguo wamũkaanirie, nawe-rĩ, nĩũgaakorwo ũhonoketie muoyo waku.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guoko kwa Jehova kwarĩ igũrũ rĩakwa ndĩ o kũu, nake akĩnjĩĩra atĩrĩ, “Ũkĩra ũthiĩ werũ-inĩ ũrĩa mwaraganu, na kũu nĩkuo ngũkwarĩria.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.22",
            "verseOrgIds": [
              "EZK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngĩũkĩra ngĩthiĩ werũ-inĩ ũcio mwaraganu, naguo riiri wa Jehova warũngiĩ kuo, ũhaana ta riiri ũrĩa ndoonete hũgũrũrũ-inĩ cia Rũũĩ rwa Kebari, na niĩ ngĩĩgũithia, ngĩturumithia ũthiũ thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Roho agĩtoonya thĩinĩ wakwa, akĩnjoya akĩndũgamia na magũrũ makwa. Akĩnjarĩria, akĩnjĩĩra atĩrĩ, “Thiĩ ũkehingĩre gwaku nyũmba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, wee mũrũ-wa-mũndũ, nĩmagakuoha na mĩhĩndo; ũgaikara ũrĩ muohe nĩguo ndũkoime ũthiĩ gatagatĩ-inĩ ka andũ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niĩ nĩngatũma rũrĩmĩ rwaku rũnyiitane na karakara nĩguo ũkire wage kũmanegenia, o na akorwo o nĩ andũ a nyũmba ya ũremi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
            "verseOrgIds": [
              "EZK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩa ngaakwarĩria-rĩ, nĩngakũhingũra kanua, nawe nĩũkameera ũũ, ‘Mwathani Jehova ekuuga atĩrĩ.’ Ũrĩa wothe ũngĩthikĩrĩria nĩathikĩrĩrie, nake ũrĩa wothe ũkũrega nĩarege; nĩgũkorwo o nĩ andũ a nyũmba ya ũremi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.27",
            "verseOrgIds": [
              "EZK.3.27"
            ]
          }
        }
      ]
    }
  ],
