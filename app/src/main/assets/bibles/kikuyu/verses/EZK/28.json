      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiugo kĩa Jehova nĩkĩanginyĩrĩire, ngĩĩrwo atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũrũ wa mũndũ, erekeria ũthiũ waku Sidoni; rĩrathĩre ũhoro wa kũrĩũkĩrĩra,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũrĩĩre atĩrĩ: ‘Mwathani Jehova ekuuga ũũ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Gũtirĩ hĩndĩ ĩngĩ andũ a Isiraeli makaagĩa na thũ mariganĩtie nacio, nĩguo ituĩke congʼe ũrĩ ruo, na mĩigua mĩũgĩ. Hĩndĩ ĩyo nĩmakamenya atĩ niĩ nĩ niĩ Mwathani Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mwathani Jehova ekuuga ũũ: Hĩndĩ ĩrĩa ngaacookanĩrĩria andũ a Isiraeli moime ndũrĩrĩ-inĩ kũrĩa maahurunjirwo, hĩndĩ ĩyo nĩngonania maitho-inĩ ma ndũrĩrĩ atĩ ndĩ mũtheru ndĩ thĩinĩ wao. Hĩndĩ ĩyo nĩmagatũũra bũrũri wao kĩũmbe ũrĩa ndaaheire ndungata yakwa Jakubu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magaatũũra kuo marĩ agitĩre, na nĩmagaka nyũmba, na mahaande mĩgũnda ya mĩthabibũ; nao magaatũũra marĩ agitĩre rĩrĩa ngaarehe iherithia kũrĩ andũ arĩa othe mariganĩtie nao arĩa maamacambagia. Hĩndĩ ĩyo nĩmakamenya atĩ niĩ nĩ niĩ Jehova Ngai wao.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
