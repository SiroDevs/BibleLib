          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũhianano wa Thahabu, na Icua rĩa Mwaki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, Mũthamaki Nebukadinezaru nĩathondekithirie mũhianano wa thahabu, wa mĩkono mĩrongo ĩtandatũkũraiha na igũrũ, na mĩkono ĩtandatũkwarama, na akĩũhaandithia werũ-inĩ wa Dura kũu bũrũri wa Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinezaru agĩcooka agĩĩta anene, na anyabara, na abarũthi, na ataari a mũthamaki, na aigi kĩgĩĩna, na aciirithania, na mawakiri, na anene a mabũrũri make mothe moke kĩamũro-inĩ gĩa kwamũra mũhianano ũcio aahandithĩtie.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, anene, na anyabara, na abarũthi, na ataari a mũthamaki, na aigi kĩgĩĩna, na aciirithania, na mawakiri, na anene othe a mabũrũri makĩgomana nĩ ũndũ wa kwamũra mũhianano ũcio Mũthamaki Nebukadinezaru aahaandithĩtie, nao makĩrũgama mbere yaguo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũhuhi coro akĩanĩrĩra na mũgambo mũnene, akiuga atĩrĩ, “Inyuĩ andũ a iruka ciothe na a ndũrĩrĩ ciothe, na a mĩario yothe ta thikĩrĩriai ũrĩa mũthamaki aathanĩte mwĩke.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa mũrĩigua mũgambo wa coro, na mĩtũrirũ, na thethe, na kĩnanda gĩa kĩnũbi, na kĩnanda kĩa mũgeeto, na mĩtũrirũ ĩrĩa mĩariĩ, o hamwe na ũini wa mĩthemba yothe-rĩ, o rĩmwe mwĩgũithie thĩ mũhooe mũhianano ũcio wa thahabu ũrĩa Mũthamaki Nebukadinezaru aahaandithĩtie.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũrĩa wothe ũtekwĩgũithia thĩ na ahooe, o hĩndĩ ĩyo nĩegũikio icua-inĩ rĩa mwaki ũgwakana mũno.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, rĩrĩa andũ acio maiguire mũgambo wa coro, na mĩtũrirũ, na thethe, na kĩnanda gĩa kĩnũbi, na kĩnanda kĩa mũgeeto, na ũini wa mĩthemba yothe, andũ othe, na ndũrĩrĩ, na andũ a mĩario yothe makĩĩgũithia thĩ, makĩhooya mũhianano ũcio wa thahabu ũrĩa Mũthamaki Nebukadinezaru aahaandithĩtie.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihinda o rĩu arori a njata amwe makĩyumĩria, magĩcuuka Ayahudi,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "makĩĩra Mũthamaki Nebukadinezaru atĩrĩ, “Wee mũthamaki ũrotũũra tene na tene!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atĩrĩrĩ, wee mũthamaki nĩũrutĩte uuge waku, ũkoiga atĩ rĩrĩa mũndũ o wothe akaigua mũgambo wa coro, na mĩtũrirũ, na thethe, na kĩnanda gĩa kĩnũbi, na kĩnanda kĩa mũgeeto, na mĩtũrirũ ĩrĩa mĩariĩ, na ũini wa mĩthemba yothe no nginya egũithie thĩ, ahooe mũhianano ũcio wa thahabu,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũkoiga atĩ mũndũ ũrĩa wothe ũtekwĩgũithia thĩ aũhooe, nĩagaikio icua-inĩ rĩa mwaki ũgwakana mũno.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, nĩ harĩ Ayahudi amwe arĩa wee ũigĩte a kũrora maũndũ ma bũrũri wa Babuloni, na nĩo Shadiraka, na Meshaki, na Abedinego, arĩa matakũiguaga, wee mũthamaki. Matitungatagĩra ngai ciaku, kana makahooya mũhianano wa thahabu ũcio ũhandithĩtie.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Nebukadinezaru agĩcinwo nĩ marakara, nake agĩtũmanĩra Shadiraka, na Meshaki, na Abedinego mareehwo harĩ we. Nĩ ũndũ ũcio andũ acio makĩreehwo mbere ya mũthamaki,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Nebukadinezaru akĩmooria atĩrĩ, “Nĩ ũhoro wa ma wee Shadiraka, na Meshaki, na Abedinego, atĩ mũtitungatagĩra ngai ciakwa, o na kana mũkahooya mũhianano wa thahabu ũcio handithĩtie?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩu-rĩ, mũngĩĩhaarĩria nĩgeetha rĩrĩa mũrĩigua mũgambo wa coro, na mĩtũrirũ, na thethe, na kĩnanda gĩa kĩnũbi, na kĩnanda kĩa mũgeeto, na mĩtũrirũ ĩrĩa mĩariĩ, na ũini wa mĩthemba yothe, mwĩgũithie thĩ, mũhooe mũhianano ũcio niĩ thondekithĩtie, nĩ wega mũno. No rĩrĩ, mũngĩrega kũhooya mũhianano ũcio-rĩ, nĩmũgũikio o ro rĩmwe icua-inĩ rĩa mwaki ũgwakana mũno. Na rĩrĩ, hihi nĩ ngai ĩrĩkũ ĩngĩhota kũmũhonokia kuuma guoko-inĩ gwakwa?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Shadiraka, na Meshaki, na Abedinego magĩcookeria mũthamaki, makĩmwĩra atĩrĩ, “Wee Nebukadinezaru, ithuĩ tũtibataire kwĩyarĩrĩria tũrĩ mbere yaku igũrũ rĩa ũhoro ũyũ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũngĩikio icua-inĩ rĩa mwaki ũgwakana mũno-rĩ, Ngai ũrĩa ithuĩ tũtungataga e na ũhoti wa gũtũruta thĩinĩ warĩo, na nĩwe ũgũtũhonokia kuuma guoko-inĩ gwaku, wee mũthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
            "verseOrgIds": [
              "DAN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, o na angĩaga gũtũhonokia-rĩ, nĩtũkwenda ũmenye, wee mũthamaki, atĩ ithuĩ tũtingĩtungatĩra ngai ciaku, kana tũhooe mũhianano wa thahabu ũcio wee ũhandithĩtie.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Nebukadinezaru akĩrakara mũno nĩ ũndũ wa Shadiraka, na Meshaki, na Abedinego, na agĩtukia gĩthiithi nĩ ũndũ wao. Agĩcooka agĩathana, akiuga icua rĩu rĩongererwo ngũ nĩguo rĩhiũhe maita mũgwanja ma ũrĩa rĩakoragwo rĩhiũhĩte.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinezaru agĩatha thigari imwe iria ciarĩ na hinya mũno ita-inĩ rĩake ciohe Shadiraka, na Meshaki, na Abedinego, imaikie icua-inĩ rĩu rĩa mwaki wakanĩte mũno.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio andũ acio, mehumbĩte kanjũ ciao, na thuruarĩ, na iremba, o na nguo icio ingĩ-rĩ, makĩohwo na magĩikio icua-inĩ rĩu rĩa mwaki wakanĩte mũno.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
            "verseOrgIds": [
              "DAN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watho ũcio wa mũthamaki warĩ wa ihenya mũno, narĩo icua rĩkahiũha mũno, ũũ atĩ nĩnĩmbĩ cia mwaki ũcio cioragire thigari iria cianyiitĩte Shadiraka, na Meshaki, na Abedinego,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.22",
            "verseOrgIds": [
              "DAN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao andũ acio atatũ, moohetwo makarũmio, makĩgũa icua-inĩ rĩu rĩa mwaki wakanĩte mũno.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Mũthamaki Nebukadinezaru akĩgega, akĩrũgama na igũrũ o rĩmwe, akĩũria andũ arĩa maamũheaga kĩrĩra atĩrĩ, “Githĩ ti andũ atatũ tuohire na twamaikia mwaki-inĩ?” Nao makĩmũcookeria atĩrĩ, “Ĩĩ, nĩ ma ũguo nĩguo, mũthamaki.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũthamaki akiuga atĩrĩ, “Hĩ, ta rorai! Niĩ ndĩrona andũ ana magĩcangacanga mwaki-inĩ, matarĩ ohe kana makahutio nĩ mwaki, nake ũcio wa kana ahaana ta ũmwe wa ariũ a ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
              "DAN.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadinezaru agĩkuhĩrĩria mũromo-inĩ wa icua rĩu rĩakanaga mwaki, akĩanĩrĩra, akiuga atĩrĩ, “Inyuĩ Shadiraka, na Meshaki, na Abedinego, inyuĩ ndungata cia Ngai-Ũrĩa-ũrĩ Igũrũ-Mũno, umĩrai, mũũke haha!” Nĩ ũndũ ũcio Shadiraka, na Meshaki, na Abedinego makiumĩra mwaki-inĩ ũcio,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
        {
          "name": "verse",
