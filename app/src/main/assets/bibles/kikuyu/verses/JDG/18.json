{
  "id": "JDG.18",
  "number": "18",
  "bookId": "JDG",
  "reference": "Atiirĩrĩri 18",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
