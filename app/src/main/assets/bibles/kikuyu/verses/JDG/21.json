{
  "id": "JDG.21",
  "number": "21",
  "bookId": "JDG",
  "reference": "Atiirĩrĩri 21",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
