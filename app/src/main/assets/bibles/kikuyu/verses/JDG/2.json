{
  "id": "JDG.2",
  "number": "2",
  "bookId": "JDG",
  "reference": "Atiirĩrĩri 2",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
