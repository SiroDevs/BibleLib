{
  "id": "JDG.15",
  "number": "15",
  "bookId": "JDG",
  "reference": "Atiirĩrĩri 15",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
