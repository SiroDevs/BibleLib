{
  "id": "JDG.20",
  "number": "20",
  "bookId": "JDG",
  "reference": "Atiirĩrĩri 20",
  "verseCount": 48,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
