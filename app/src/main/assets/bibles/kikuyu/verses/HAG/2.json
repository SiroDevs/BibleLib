{
  "id": "HAG.2",
  "number": "2",
  "bookId": "HAG",
  "reference": "Hagai 2",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
