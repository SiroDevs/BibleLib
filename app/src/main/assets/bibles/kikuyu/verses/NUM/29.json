          ]
        },
        {
          "text": "“ ‘Mũthenya wa kanana-rĩ, gĩagai na kĩũngano na mũtikarute wĩra wa ndũire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.35",
