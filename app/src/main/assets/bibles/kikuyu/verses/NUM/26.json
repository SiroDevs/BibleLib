{
  "id": "NUM.26",
  "number": "26",
  "bookId": "NUM",
  "reference": "Ndari 26",
  "verseCount": 65,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "NUM 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũtaranwo gwa Keerĩ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, thuutha wa mũthiro ũcio Jehova akĩĩra Musa na Eleazaru mũrũ wa Harũni, ũrĩa mũthĩnjĩri-Ngai atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.1",
            "verseOrgIds": [
              "NUM.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tarai kĩrĩndĩ gĩothe kĩa andũ a Isiraeli kũringana na nyũmba ciao, andũ arĩa othe maakinyĩtie mĩaka mĩrongo ĩĩrĩ na makĩria, arĩa mangĩhota gũthiĩ ita-inĩ marĩ mbũtũ cia Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.2",
            "verseOrgIds": [
              "NUM.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, Musa na Eleazaru ũrĩa mũthĩnjĩri-Ngai makĩarĩria andũ a Isiraeli kũu werũ-inĩ wa Moabi hakuhĩ na Rũũĩ rwa Jorodani mũrĩmo wa Jeriko, makĩmeera atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.3",
            "verseOrgIds": [
              "NUM.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tarai andũ arĩa makinyĩtie mĩaka mĩrongo ĩĩrĩ na makĩria, o ta ũrĩa Jehova aathĩte Musa.” Aya nĩo andũ a Isiraeli arĩa moimire bũrũri wa Misiri:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.4",
            "verseOrgIds": [
              "NUM.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiaro cia Rubeni, irigithathi rĩa Isiraeli ciarĩ ici: kuuma kũrĩ Hanoku, nĩ mbarĩ ya Ahanoku; kuuma kũrĩ Palu, nĩ mbarĩ ya Apalu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.5",
            "verseOrgIds": [
              "NUM.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Hezironi, nĩ mbarĩ ya Ahezironi; kuuma kũrĩ Karimi, nĩ mbarĩ ya Akarimi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.6",
            "verseOrgIds": [
              "NUM.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio mbarĩ cia Rubeni; arĩa maatarirwo maarĩ andũ 43,730.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.7",
            "verseOrgIds": [
              "NUM.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũrũ wa Palu arĩ Eliabu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.8",
            "verseOrgIds": [
              "NUM.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao ariũ a Eliabu maarĩ Nemueli, na Dathani, na Abiramu. Dathani na Abiramu nĩo maarĩ anene a kĩrĩndĩ, na nĩo maaremeire Musa na Harũni na maarĩ amwe a arũmĩrĩri a Kora rĩrĩa maaremeire Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.9",
            "verseOrgIds": [
              "NUM.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo thĩ ĩgĩathamia kanua kayo ĩkĩmameria hamwe na Kora, ũrĩa arũmĩrĩri ake maakuire rĩrĩa mwaki wacinire arũme arĩa 250. Nao magĩtuĩka kĩonereria gĩa gũkaania arĩa angĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.10",
            "verseOrgIds": [
              "NUM.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, rũciaro rwa Kora rũtiathirire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.11",
            "verseOrgIds": [
              "NUM.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Simeoni kũringana na mbarĩ ciao nĩ ici: kuuma kũrĩ Nemueli, nĩ mbarĩ ya Anemueli; kuuma kũrĩ Jamini, nĩ mbarĩ ya Ajamini; kuuma kũrĩ Jakini, nĩ mbarĩ ya Ajakini;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.12",
            "verseOrgIds": [
              "NUM.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Zera, nĩ mbarĩ ya Azera; kuuma kũrĩ Shauli, nĩ mbarĩ ya Ashaulu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.13",
            "verseOrgIds": [
              "NUM.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Simeoni; nao maarĩ andũ 22,200.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.14",
            "verseOrgIds": [
              "NUM.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Gadi kũringana na mbarĩ ciao nĩ ici: kuuma kũrĩ Zefoni, nĩ mbarĩ ya Azefoni; kuuma kũrĩ Hagi, nĩ mbarĩ ya Ahagi; kuuma kũrĩ Shuni, nĩ mbarĩ ya Ashuni;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.15",
            "verseOrgIds": [
              "NUM.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Ozini, nĩ mbarĩ ya Aozini; kuuma kũrĩ Eri, nĩ mbarĩ ya Aeri;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.16",
            "verseOrgIds": [
              "NUM.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Arodi, nĩ mbarĩ ya Aarodi; kuuma kũrĩ Areli, nĩ mbarĩ ya Aareli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.17",
            "verseOrgIds": [
              "NUM.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Gadi; arĩa maatarirwo maarĩ andũ 40,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.18",
            "verseOrgIds": [
              "NUM.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri na Onani, maarĩ ariũ a Juda, no maakuĩrĩire Kaanani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.19",
            "verseOrgIds": [
              "NUM.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Juda kũringana na mbarĩ ciao nĩ ici: kuuma kũrĩ Shela, nĩ mbarĩ ya Ashela; kuuma kũrĩ Perezu, nĩ mbarĩ ya Aperezu; kuuma kũrĩ Zera, nĩ mbarĩ ya Azera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.20",
            "verseOrgIds": [
              "NUM.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Perezu ciarĩ ici: kuuma kũrĩ Hezironi, nĩ mbarĩ ya Ahezironi; kuuma kũrĩ Hamuli, nĩ mbarĩ ya Ahamuli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.21",
            "verseOrgIds": [
              "NUM.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Juda; arĩa maatarirwo maarĩ andũ 76,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.22",
            "verseOrgIds": [
              "NUM.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Isakaru kũringana na mbarĩ ciao ciarĩ ici: kuuma kũrĩ Tola, nĩ mbarĩ ya Atola; kuuma kũrĩ Puva nĩ mbarĩ ya Apuva;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.23",
            "verseOrgIds": [
              "NUM.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Jashubu, nĩ mbarĩ ya Ajashubu; kuuma kũrĩ Shimuroni, nĩ mbarĩ ya Ashimuroni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.24",
            "verseOrgIds": [
              "NUM.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Isakaru; arĩa maatarirwo maarĩ andũ 64,300.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.25",
            "verseOrgIds": [
              "NUM.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Zebuluni kũringana na mbarĩ ciao ciarĩ ici: kuuma kũrĩ Seredi, nĩ mbarĩ ya Aseredi; kuuma kũrĩ Eloni nĩ mbarĩ ya Aeloni, na kuuma kũrĩ Jahaleeli, nĩ mbarĩ ya Ajahaleeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.26",
            "verseOrgIds": [
              "NUM.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Zebuluni; arĩa maatarirwo maarĩ andũ 60,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.27",
            "verseOrgIds": [
              "NUM.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Jusufu kũringana na mbarĩ ciao kuuma kũrĩ Manase na Efiraimu ciarĩ ici:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.28",
            "verseOrgIds": [
              "NUM.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiaro cia Manase: kuuma kũrĩ Makiru, nĩ mbarĩ ya Amakiru (Makiru nĩwe warĩ ithe wa Gileadi); kuuma kũrĩ Gileadi nĩ mbarĩ ya Agileadi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.29",
            "verseOrgIds": [
              "NUM.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio njiaro cia Gileadi: kuuma kũrĩ Iezeri, nĩ mbarĩ ya Aiezeli; kuuma kũrĩ Heleku, nĩ mbarĩ ya Aheleku;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.30",
            "verseOrgIds": [
              "NUM.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Asirieli, nĩ mbarĩ ya Aasirieli; kuuma kũrĩ Shekemu, nĩ mbarĩ ya Ashekemu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.31",
            "verseOrgIds": [
              "NUM.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Shemida, nĩ mbarĩ ya Ashemida; kuuma kũrĩ Heferi, nĩ mbarĩ ya Aheferi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.32",
            "verseOrgIds": [
              "NUM.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Zelofehadi mũrũ wa Heferi ndaarĩ na aanake, no airĩtu atheri, namo marĩĩtwa mao maarĩ Mahala, na Noa, na Hogila, na Milika, na Tiriza.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.33",
            "verseOrgIds": [
              "NUM.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Manase, arĩa maatarirwo maarĩ andũ 52,700.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.34",
            "verseOrgIds": [
              "NUM.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio njiaro cia Efiraimu kũringana na mbarĩ ciao: kuuma kũrĩ Shuthela, nĩ mbarĩ ya Ashuthela; kuuma kũrĩ Bekeri, nĩ mbarĩ ya Abekeri; kuuma kũrĩ Tahani nĩ mbarĩ ya Atahani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.35",
            "verseOrgIds": [
              "NUM.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio ciarĩ njiaro cia Shuthela; kuuma kũrĩ Erani, nĩ mbarĩ ya Aerani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.36",
            "verseOrgIds": [
              "NUM.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio ciarĩ mbarĩ cia Efiraimu; arĩa maatarirwo maarĩ andũ 32,500.\nIcio nĩcio njiaro cia Jusufu kũringana na mbarĩ ciao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.37",
            "verseOrgIds": [
              "NUM.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Benjamini kũringana na mbarĩ ciao ciarĩ ici: kuuma kũrĩ Bela, nĩ mbarĩ ya Abela; kuuma kũrĩ Ashibeli, nĩ mbarĩ ya Aashibeli; kuuma kũrĩ Ahiramu, nĩ mbarĩ ya Aahiramu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.38",
            "verseOrgIds": [
              "NUM.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Shefufamu, nĩ mbarĩ ya Ashefufamu; kuuma kũrĩ Hufamu, nĩ mbarĩ ya Ahufamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.39",
            "verseOrgIds": [
              "NUM.26.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Bela kuuma kũrĩ Aridi na Naamani ciarĩ ici: kuuma kũrĩ Aridi, nĩ mbarĩ ya Aaridi; na kuuma kũrĩ Naamani nĩ mbarĩ ya Anaamani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.40",
            "verseOrgIds": [
              "NUM.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio ciarĩ mbarĩ cia Benjamini; arĩa maatarirwo maarĩ andũ 45,600.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.41",
            "verseOrgIds": [
              "NUM.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Dani kũringana na mbarĩ ciao ciarĩ ici: kuuma kũrĩ Shuhamu nĩ mbarĩ ya Ashuhamu. Icio nĩcio ciarĩ mbarĩ ya Dani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.42",
            "verseOrgIds": [
              "NUM.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio othe maarĩ a mbarĩ cia Ashuhamu: na arĩa maatarirwo maarĩ andũ 64,400.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.43",
            "verseOrgIds": [
              "NUM.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Asheri kũringana na mbarĩ ciao ciarĩ ici: kuuma kũrĩ Imuna, nĩ mbarĩ ya Aimuna; kuuma kũrĩ Ishivi, nĩ mbarĩ ya Aishivi; kuuma kũrĩ Beria, nĩ mbarĩ ya Aberia;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.44",
            "verseOrgIds": [
              "NUM.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao aya nĩo maarĩ a njiaro cia Beria: kuuma kũrĩ Heberi, nĩ mbarĩ ya Aheberi; na kuuma kũrĩ Malikieli, nĩ mbarĩ ya Amalikieli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.45",
            "verseOrgIds": [
              "NUM.26.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Asheri aarĩ na mwarĩ wetagwo Sera.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.46",
            "verseOrgIds": [
              "NUM.26.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 26:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icio nĩcio ciarĩ mbarĩ cia Asheri; arĩa maatarirwo maarĩ andũ 53,400.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.47",
            "verseOrgIds": [
              "NUM.26.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 26:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia Nafitali kũringana na mbarĩ ciao ciarĩ ici: kuuma kũrĩ Jahazeeli, nĩ mbarĩ ya Ajahazeeli; kuuma kũrĩ Guni, nĩ mbarĩ ya Aguni;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.48",
            "verseOrgIds": [
              "NUM.26.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 26:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ Jezeri, nĩ mbarĩ ya Ajezeri; kuuma kũrĩ Shilemu, nĩ mbarĩ ya Ashilemu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.49",
            "verseOrgIds": [
              "NUM.26.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 26:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ici nĩcio ciarĩ mbarĩ cia Nafitali; arĩa maatarirwo maarĩ andũ 45,400.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.50",
            "verseOrgIds": [
              "NUM.26.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 26:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũigana wa arũme acio othe a Isiraeli maarĩ andũ 601,730.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.51",
            "verseOrgIds": [
              "NUM.26.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 26:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.52",
            "verseOrgIds": [
              "NUM.26.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 26:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bũrũri ũyũ nĩguo makagaĩrwo ũtuĩke igai rĩao kũringana na mũigana wa marĩĩtwa mao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.53",
            "verseOrgIds": [
              "NUM.26.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 26:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ arĩa aingĩ ũmagaĩre igai inene, nao arĩa maanyiiha ũmagaĩre igai inini; o mũhĩrĩga ũheo igai rĩaguo kũringana na mũigana wa andũ arĩa maandĩkĩtwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.54",
            "verseOrgIds": [
              "NUM.26.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 26:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũmenyerere wega atĩ, bũrũri ũyũ ũkaaheanwo na ũndũ wa gũcuuka mĩtĩ. Kĩrĩa o gĩkundi gĩkaagaya gĩkaringana na marĩĩtwa ma mĩhĩrĩga ya maithe mao ma tene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.55",
            "verseOrgIds": [
              "NUM.26.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 26:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "O igai rĩkaheanwo na ũndũ wa gũcuuka mĩtĩ kũrĩ ikundi iria nene na iria nini.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.56",
            "verseOrgIds": [
              "NUM.26.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "NUM 26:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nĩo Alawii arĩa maatarirwo kũringana na mbarĩ ciao: kuuma kũrĩ Gerishoni, nĩ mbarĩ ya Agerishoni; kuuma kũrĩ Kohathu, nĩ mbarĩ ya Akohathu; kuuma kũrĩ Merari, nĩ mbarĩ ya Amerari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.57",
            "verseOrgIds": [
              "NUM.26.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "NUM 26:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nacio ici ciarĩ mbarĩ cia Alawii: mbarĩ ya Alibini, na mbarĩ ya Ahebironi, na mbarĩ ya Amahali, na mbarĩ ya Amushi, na mbarĩ ya Akora. (Kohathu aarĩ guka wa Amuramu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.58",
            "verseOrgIds": [
              "NUM.26.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "NUM 26:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake mũtumia wa Amuramu eetagwo Jokebedi, wa rũciaro rwa Lawi, waciarĩirwo Alawii kũu bũrũri wa Misiri. Nake Jokebedi agĩciarĩra Amuramu Harũni, na Musa, na mwarĩ wa nyina wao Miriamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.59",
            "verseOrgIds": [
              "NUM.26.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "NUM 26:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harũni nĩwe warĩ ithe wa Nadabu na Abihu na Eleazaru na Ithamaru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.60",
            "verseOrgIds": [
              "NUM.26.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "NUM 26:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Nadabu na Abihu nĩmakuire rĩrĩa maarutĩire Jehova igongona na mwaki ũtaarĩ mwĩtĩkĩrie.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.61",
            "verseOrgIds": [
              "NUM.26.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "NUM 26:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alawii othe arũme a ũkũrũ wa mweri ũmwe na makĩria arĩa maatarirwo maarĩ andũ 23,000. Matiataranĩirio hamwe na andũ a Isiraeli arĩa angĩ tondũ matiagaire kĩndũ hamwe na andũ arĩa angĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.62",
            "verseOrgIds": [
              "NUM.26.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "NUM 26:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nĩo maatarirwo nĩ Musa na Eleazaru ũrĩa mũthĩnjĩri-Ngai rĩrĩa maatarĩire andũ a Isiraeli werũ-inĩ wa Moabi hũgũrũrũ-inĩ cia Rũũĩ rwa Jorodani, mũrĩmo ũyũ wa Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.63",
            "verseOrgIds": [
              "NUM.26.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "NUM 26:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatiarĩ o na ũmwe wa arĩa matarĩtwo nĩ Musa na Harũni ũrĩa mũthĩnjĩri-Ngai, hĩndĩ ĩrĩa maatarĩire andũ a Isiraeli werũ-inĩ wa Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.64",
            "verseOrgIds": [
              "NUM.26.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "NUM 26:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ Jehova nĩeerĩte andũ a Isiraeli atĩ ti-itherũ no nginya makuĩre werũ-inĩ, na gũtirĩ o na ũmwe wao watigarire, tiga no Kalebu mũrũ wa Jefune, na Joshua mũrũ wa Nuni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.65",
            "verseOrgIds": [
              "NUM.26.65"
            ]
          }
        }
      ]
    }
  ],
