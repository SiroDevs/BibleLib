{
  "id": "NUM.31",
  "number": "31",
  "bookId": "NUM",
  "reference": "Ndari 31",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "NUM 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwĩrĩhĩria harĩ Amidiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Musa atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.1",
            "verseOrgIds": [
              "NUM.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rĩhĩria andũ a Isiraeli harĩ andũ a Midiani. Na thuutha ũcio nĩũgũcooka ũkue.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Musa akĩĩra andũ acio atĩrĩ, “Andũ amwe anyu nĩmeohe indo ciao cia mbaara mathiĩ makahũũrane na andũ a Midiani nĩguo marĩhĩrie Jehova kũrĩ o.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.3",
            "verseOrgIds": [
              "NUM.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũmai andũ 1,000 kuuma kũrĩ o mũhĩrĩga wa Isiraeli mbaara-inĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.4",
            "verseOrgIds": [
              "NUM.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio andũ 12,000 meeohete indo cia mbaara, o 1,000 kuuma kũrĩ o mũhĩrĩga, makĩneanwo kuuma mĩhĩrĩga ya Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.5",
            "verseOrgIds": [
              "NUM.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akĩmatũma mbaara-inĩ, o 1,000 kuuma harĩ o mũhĩrĩga, marĩ hamwe na Finehasi mũrũ wa Eleazaru ũrĩa mũthĩnjĩri-Ngai, ũrĩa wakuuire indo cia handũ-harĩa-haamũre, o na tũrumbeta twa kũhuhwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.6",
            "verseOrgIds": [
              "NUM.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makĩhũũrana na andũ a Midiani o ta ũrĩa Jehova aathĩte Musa, na makĩũraga arũme othe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.7",
            "verseOrgIds": [
              "NUM.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatagatĩ ka arĩa mooragire nĩ Evi, na Rekemu, na Zuru, na Huri, na Reba, athamaki arĩa atano a Midiani. O na ningĩ nĩmooragire Balamu mũrũ wa Beori na rũhiũ rwa njora.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.8",
            "verseOrgIds": [
              "NUM.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ a Isiraeli magĩtaha andũ-a-nja a Midiani na ciana, na magĩkuua ndũũru ciothe cia andũ a Midiani cia ngʼombe na cia mbũri, na magĩtaha indo iria ingĩ ciothe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.9",
            "verseOrgIds": [
              "NUM.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩcina matũũra mothe kũrĩa andũ a Midiani maatũũrĩte, o ũndũ ũmwe na kambĩ ciao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.10",
            "verseOrgIds": [
              "NUM.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩkuua indo ciothe iria maatahĩte na iria maatunyanĩte hamwe na andũ na nyamũ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.11",
            "verseOrgIds": [
              "NUM.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na magĩtwara andũ arĩa matahĩtwo na indo icio maatunyanĩte, na iria maatahĩte kũrĩ Musa na kũrĩ Eleazaru ũrĩa mũthĩnjĩri-Ngai na kũrĩ kĩũngano kĩa andũ a Isiraeli kũu kambĩ yarĩ werũ-inĩ wa Moabi, hũgũrũrũ-inĩ cia Rũũĩ rwa Jorodani mũrĩmo wa Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa, na Eleazaru ũrĩa mũthĩnjĩri-Ngai na atongoria othe a kĩrĩndĩ magĩthiĩ kũmatũnga nja ya kambĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.13",
            "verseOrgIds": [
              "NUM.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akĩrakarĩra anene a mbũtũ icio cia ita na atongoria a mbũtũ cia o ngiri, ngiri, na atongoria a mbũtũ cia o igana, igana, arĩa moimĩte mbaara-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.14",
            "verseOrgIds": [
              "NUM.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩmooria atĩrĩ, “Kaĩ mwĩtĩkĩrĩtie andũ a nja othe matũũre muoyo?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.15",
            "verseOrgIds": [
              "NUM.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nĩo maarũmĩrĩire mataaro ma Balamu, na nĩo maatũmire andũ a Isiraeli matirike Jehova ũhoro-inĩ ũrĩa wekĩkire kũu Peori, naguo ũndũ ũcio ũkĩrehithĩria andũ a Jehova mũthiro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.16",
            "verseOrgIds": [
              "NUM.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, ũragai tũhĩĩ tuothe. Na ningĩ mũũrage mũndũ-wa-nja wothe ũrĩ wakoma na mũndũ mũrũme,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.17",
            "verseOrgIds": [
              "NUM.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "no mwĩhonokerie mũirĩtu o wothe ũrĩa ũtarĩ wakoma na mũndũ mũrũme.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.18",
            "verseOrgIds": [
              "NUM.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inyuothe arĩa mũũragĩte mũndũ o wothe kana mũkahutia mũndũ o wothe mũũrage no nginya mũikare nja ya kambĩ mĩthenya mũgwanja. Mũthenya wa ĩtatũ na wa mũgwanja, no nginya mwĩtherie inyuĩ ene na arĩa mũtahĩte.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.19",
            "verseOrgIds": [
              "NUM.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Theriai nguo ciothe, o ũndũ ũmwe na kĩndũ gĩothe gĩthondeketwo na rũũa, kana guoya wa mbũri kana mbaũ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Eleazaru ũrĩa mũthĩnjĩri-Ngai akĩĩra thigari iria ciathiĩte mbaara-inĩ atĩrĩ, “Watho ũrĩa Jehova aaheire Musa uugĩte atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.21",
            "verseOrgIds": [
              "NUM.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thahabu, na betha, na gĩcango, na kĩgera, na ibati, na rũbũũa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.22",
            "verseOrgIds": [
              "NUM.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kĩndũ o gĩothe kĩngĩhota gwĩtiiria mwaki, no nginya kĩhĩtũkagĩrio mwaki-inĩ nĩgeetha gĩthirwo nĩ thaahu. No rĩrĩ, no nginya gĩcooke gĩtherio na maaĩ marĩa ma kũniina thaahu. Nakĩo kĩndũ gĩothe gĩtangĩĩtiiria mwaki no nginya kĩhĩtũkĩrio maaĩ-inĩ macio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.23",
            "verseOrgIds": [
              "NUM.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya wa mũgwanja-rĩ, thambiai nguo cianyu na inyuĩ nĩ mũgaathirwo nĩ thaahu. Thuutha ũcio no mũtoonye kambĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kũgayania Indo iria Ndahe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.25",
            "verseOrgIds": [
              "NUM.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wee na Eleazaru ũrĩa mũthĩnjĩri-Ngai na atongoria a nyũmba cia kĩrĩndĩ gĩkĩ no nginya mũtare andũ othe na nyamũ iria ciatahirwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.26",
            "verseOrgIds": [
              "NUM.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gayaniai indo cia iria ndahe gatagatĩ ga thigari iria ciathiĩte mbaara-inĩ na kĩrĩndĩ kĩrĩa kĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.27",
            "verseOrgIds": [
              "NUM.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kũrĩ thigari iria ciarũire mbaara, rutai gĩcunjĩ kĩa Jehova, kĩndũ kĩmwe thĩinĩ wa indo magana matano, marĩ andũ, kana ngʼombe, kana ndigiri, kana ngʼondu, o na kana mbũri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.28",
            "verseOrgIds": [
              "NUM.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oya gĩcunjĩ gĩkĩ kuuma harĩ nuthu ya igai rĩao mũkĩnengere Eleazaru ũrĩa mũthĩnjĩri-Ngai kĩrĩ gĩcunjĩ kĩa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kũrĩ nuthu ya gĩcunjĩ kĩa andũ a Isiraeli, thuura kĩndũ kĩmwe kuuma harĩ o gĩkundi kĩa mĩrongo ĩtano, kĩrĩ kĩa andũ, kana ngʼombe, kana ndigiri, kana ngʼondu, kana mbũri o na kana nyamũ ingĩ. Cinengere Alawii arĩa wĩra wao ũrĩ kũmenyerera Hema-ĩrĩa-Nyamũre ya Jehova.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Musa na Eleazaru ũrĩa mũthĩnjĩri-Ngai magĩĩka o ta ũrĩa Jehova aathĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indo cia gũtahwo cia iria ciatigarĩte kuuma kũrĩ indo iria ciatunyanĩtwo nĩ thigari ciarĩ ngʼondu 675,000,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngʼombe 72,000,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
              "NUM.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndigiri 61,000",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.34",
            "verseOrgIds": [
              "NUM.31.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andũ-a-nja 32,000 arĩa mataakomete na mũndũ mũrũme.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuthu ya igai rĩa andũ arĩa maarũĩte mbaara-inĩ ciarĩ:\nngʼondu 337,500,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma harĩ icio Jehova akĩrutĩrwo ngʼondu 675;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nacio ngʼombe ciarĩ 36,000 na kuuma harĩ icio Jehova akĩrutĩrwo ngʼombe 72;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nacio ndigiri ciarĩ 30,500, na kuuma harĩ icio Jehova akĩrutĩrwo ndigiri 61;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "andũ maarĩ 16,000, na kuuma kũrĩ o Jehova akĩrutĩrwo andũ 32.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akĩnengera Eleazaru ũrĩa mũthĩnjĩri-Ngai gĩcunjĩ kĩa Jehova, o ta ũrĩa Jehova aathĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuthu ĩrĩa yarĩ ya andũ a Isiraeli, ĩrĩa Musa aamũranĩtie na arĩa maathiĩte mbaara-inĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
            "verseOrgIds": [
              "NUM.31.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuthu ĩrĩa yaheirwo kĩrĩndĩ ciarĩ ngʼondu 337,500,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "nacio ngʼombe ciarĩ 36,000,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
            "verseOrgIds": [
              "NUM.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "nacio ndigiri ciarĩ 30,500,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
            "verseOrgIds": [
              "NUM.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao andũ maarĩ 16,000.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kũrĩ nuthu ĩrĩa yaheirwo andũ a Isiraeli, Musa agĩthuura mũndũ ũmwe kuuma kũrĩ andũ mĩrongo ĩtano, na nyamũ ĩmwe kuuma kũrĩ nyamũ mĩrongo ĩtano, o ta ũrĩa Jehova aamwathĩte, na agĩcihe Alawii arĩa wĩra wao warĩ kũmenyerera Hema-ĩrĩa-Nyamũre ya Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ anene arĩa matongoragia mbũtũ cia ita, acio maathaga ikundi cia o ngiri ngiri, na ikundi cia o igana igana, magĩthiĩ harĩ Musa,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao makĩmwĩra atĩrĩ, “Ndungata ciaku nĩitarĩte thigari iria twathaga na hatirĩ o na ũmwe ũtarĩ ho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio nĩtwarehe indo ici cia thahabu ituĩke iruta riitũ kũrĩ Jehova iria o ũmwe witũ eegwatĩire, nacio nĩ icũhĩ cia moko na bangiri cia moko, na icũhĩ cia ciara, na cia matũ, na mĩgathĩ ya ngingo, nĩguo twĩhoroherie mbere ya Jehova.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Eleazaru ũrĩa mũthĩnjĩri-Ngai makĩamũkĩra thahabu ĩyo kuuma kũrĩ o, indo icio ciothe ciaturĩtwo wega.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thahabu yothe ĩrĩa yoimire kũrĩ anene a ikundi cia o ngiri, ngiri na anene a ikundi cia o igana, igana ĩrĩa Musa na Eleazaru maatwarĩire Jehova kĩrĩ kĩheo, yarĩ ya ũritũ wa cekeri 16,750.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mũthigari nĩetahĩire indo ciake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Eleazaru ũrĩa mũthĩnjĩri-Ngai makĩamũkĩra thahabu ĩyo kuuma kũrĩ anene a ikundi cia o ngiri, ngiri na anene a ikundi cia o igana, igana magĩcirehe Hema-inĩ ya Gũtũnganwo ituĩke kĩririkania harĩ andũ a Isiraeli mbere ya Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.54",
            "verseOrgIds": [
              "NUM.31.54"
            ]
          }
        }
      ]
    }
