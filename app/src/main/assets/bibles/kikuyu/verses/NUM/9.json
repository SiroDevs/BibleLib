{
  "id": "NUM.9",
  "number": "9",
  "bookId": "NUM",
  "reference": "Ndari 9",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "NUM 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gĩathĩ-gĩa-Bathaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩarĩria Musa kũu Werũ-inĩ wa Sinai mweri-inĩ wa mbere wa mwaka wa keerĩ thuutha wa andũ a Isiraeli kuuma bũrũri wa Misiri, akĩmwĩra atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ĩra andũ a Isiraeli makũngũyagĩre Gĩathĩ-kĩa-Bathaka ihinda rĩrĩa rĩtuĩtwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũngũyagĩrai gĩathĩ kĩu ihinda rĩrĩa rĩtuĩtwo, hwaĩ-inĩ wa mũthenya wa ikũmi na ĩna wa mweri ũyũ, kũringana na mawatho makĩo mothe na mũtabarĩre wakĩo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Musa akĩĩra andũ a Isiraeli makũngũĩre Gĩathĩ-kĩa-Bathaka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao magĩĩka o ro ũguo kũu Werũ-inĩ wa Sinai hwaĩ-inĩ wa mũthenya wa ikũmi na ĩna wa mweri wa mbere. Andũ a Isiraeli magĩĩka maũndũ mothe o ta ũrĩa Jehova aathĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "No amwe ao matingĩakũngũĩire Gĩathĩ-kĩa-Bathaka mũthenya ũcio nĩ ũndũ nĩmagwatĩtwo nĩ thaahu nĩ ũndũ wa kũhutania na kĩimba kĩa mũndũ. Nĩ ũndũ ũcio magĩũka kũrĩ Musa na Harũni mũthenya o ro ũcio",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "makĩĩra Musa atĩrĩ, “Nĩ tũnyiitĩtwo nĩ thaahu nĩ ũndũ wa kũhutania na kĩimba kĩa mũndũ, no nĩ kĩĩ gĩgũtũma tũgirio kũneana indo cia kũrutĩra Jehova tũrĩ hamwe na andũ a Isiraeli arĩa angĩ ihinda rĩrĩa rĩtuĩtwo?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akĩmacookeria atĩrĩ, “Etererai nyambe nduĩrie ũhoro wa ũrĩa Jehova egwathana ũhoro wanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova agĩcooka akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ĩra andũ a Isiraeli atĩrĩ: ‘Rĩrĩa mũndũ wanyu o na ũrĩkũ kana njiaro cianyu marĩ na thaahu nĩ ũndũ wa kũhutania na kĩimba kĩa mũndũ, kana akorwo arĩ rũgendo-inĩ-rĩ, mũndũ ũcio o nake no akũngũĩre Gĩathĩ-kĩa-Bathaka ya Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marĩkũngũyagĩra gĩathĩ kĩu hwaĩ-inĩ wa mũthenya wa ikũmi na ĩna wa mweri wa keerĩ. Marĩrĩĩaga gatũrũme na mĩgate ĩtarĩ mĩĩkĩre ndawa ya kũimbia na nyeni ndũrũ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matikanatigie gacunjĩ o na kamwe karaare nginya rũciinĩ kana moine ihĩndĩ rĩako o na rĩmwe. Rĩrĩa megũkũngũĩra Gĩathĩ-kĩa-Bathaka ĩyo no nginya marũmagĩrĩre mũtabarĩre wakĩo wothe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mũndũ angĩkorwo ndarĩ na thaahu, na ndathiĩte rũgendo, na aage gũkũngũĩra Gĩathĩ-kĩa-Bathaka, mũndũ ũcio nĩakaingatwo athengio kuuma kũrĩ andũ ao, nĩ ũndũ ndaareheire Jehova indo iria arutagĩrwo ihinda rĩrĩa rĩtuĩtwo. Mũndũ ũcio nĩagacookererwo nĩ mehia make mwene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mũgeni ũikaranĩtie na inyuĩ na ende gũkũngũĩra Gĩathĩ-kĩa-Bathaka ya Jehova-rĩ, no nginya eke ũguo kũringana na watho na mũtabarĩre wakĩo. No nginya mũgĩage na mĩtabarĩre ya mũthemba ũmwe kũrĩ mũgeni na kũrĩ mũndũ ũrĩa ũciarĩirwo bũrũri wanyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itu Igũrũ rĩa Hema-ĩrĩa-Nyamũre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũrĩa Hema-ĩrĩa-Nyamũre, o Hema-ĩyo-ya-Ũira yaambirwo-rĩ, itu rĩkĩmĩhumbĩra. Kuuma hwaĩ-inĩ nginya rũciinĩ itu rĩu rĩarĩ igũrũ rĩa Hema-ĩyo-Nyamũre na itu rĩu rĩkoonagwo rĩhaana ta mwaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũguo nĩguo gwathiire na mbere gũikara; itu rĩkamĩhumbĩra ũtukũ na rĩkoonagwo rĩhaana ta mwaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa yothe itu rĩu rĩeheraga kuuma harĩ hema ĩyo, andũ a Isiraeli makoimagara magathiĩ; na rĩrĩ, itu rĩu rĩarũgamĩra handũ, andũ a Isiraeli makaamba hema ciao ho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova aathana-rĩ, andũ a Isiraeli makoimagara magathiĩ, na aathana rĩngĩ makaamba hema ciao. Hĩndĩ ĩrĩa yothe itu rĩu rĩaikara igũrũ rĩa Hema-ĩyo-Nyamũre, maikaraga o hau kambĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa itu rĩaikara igũrũ rĩa Hema-ĩyo-Nyamũre kahinda karaaya-rĩ, andũ a Isiraeli magaathĩkĩra Jehova na makaaga kuumagara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahinda mamwe itu rĩu rĩaikaraga igũrũ rĩa Hema-ĩyo-Nyamũre o matukũ manini; no Jehova aathana makaamba hema, na ningĩ aathana, makoimagara magathiĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahinda mamwe itu rĩu rĩaikaraga o kuuma hwaĩ-inĩ nginya rũciinĩ, na itu rĩehera rũciinĩ-rĩ, makoimagara magathiĩ. Kana nĩ mũthenya kana nĩ ũtukũ, hĩndĩ o yothe itu rĩu rĩehera nao makoimagara magathiĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
              "NUM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itu rĩu rĩngĩaikarire igũrũ rĩa hema ĩyo mĩthenya ĩĩrĩ, kana mweri, kana mwaka, andũ a Isiraeli maikaraga kũu kambĩ, na matingĩoimagarire mathiĩ, no itu rĩu rĩehera makoimagara magathiĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.22",
            "verseOrgIds": [
              "NUM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova aathana makaamba hema, na ningĩ Jehova aathana makoimagara magathiĩ. Maathĩkagĩra watho wa Jehova kũringana na ũrĩa aathaga Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
            "verseOrgIds": [
              "NUM.9.23"
            ]
          }
        }
      ]
    }
  ],
