{
  "id": "NUM.34",
  "number": "34",
  "bookId": "NUM",
  "reference": "Ndari 34",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "NUM 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mĩhaka ya Kaanani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.1",
            "verseOrgIds": [
              "NUM.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atha andũ a Isiraeli, ũmeere atĩrĩ: ‘Rĩrĩa mũgaatoonya Kaanani-rĩ, bũrũri ũcio mũkaagaĩrwo ũtuĩke igai rĩanyu ũgaakorwo na mĩhaka ĩno:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.2",
            "verseOrgIds": [
              "NUM.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mwena wanyu wa gũthini ũkoima Werũ-inĩ wa Zini kũrigania na mũhaka wa Edomu. Mwena wa irathĩro, mũhaka wanyu wa mwena wa gũthini ũkaambĩrĩria mũthia-inĩ wa Iria rĩa Cumbĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũtuĩkanĩirie mwena wa gũthini ũrorete Mwanya wa Akirabimu, ũthiĩte na mbere o nginya Zini, na ũikũrũke na mwena wa gũthini wa Kadeshi-Barinea. Ningĩ ũcooke ũkinye Hazoru-Adari, na uumĩrĩre Azimoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kũrĩa ũkaarigiicũka, ũnyiitane na karũũĩ ka Misiri, na ũrĩkĩrie Iria-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mũhaka wanyu wa mwena wa ithũĩro ũgaakorwo ũrĩ hũgũrũrũ cia Iria rĩrĩa Inene. Ũcio nĩguo ũgaatuĩka mũhaka wanyu wa mwena wa ithũĩro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Naguo mũhaka wanyu wa mwena wa gathigathini uumĩte Iria rĩrĩa Inene ũgaakinya Kĩrĩma-inĩ kĩa Horu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.7",
            "verseOrgIds": [
              "NUM.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kuuma Kĩrĩma kĩa Horu ũgaakinya Lebo-Hamathu. Ningĩ mũhaka ũcio ũgaakinya Zedadi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.8",
            "verseOrgIds": [
              "NUM.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũthiĩ na mbere nginya Zifironi, na ũgaathirĩra Hazoru-Enani. Ũcio nĩguo ũgaatuĩka mũhaka wanyu wa mwena wa gathigathini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
            "verseOrgIds": [
              "NUM.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Na rĩrĩ, mũhaka wanyu wa mwena wa irathĩro, ũkoima Hazoru-Enani ũkinye Shefamu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.10",
            "verseOrgIds": [
              "NUM.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũhaka ũcio ũgaaikũrũka kuuma Shefamu nginya Ribila, mwena wa irathĩro wa Aini, na ũthiĩ na mbere ũtwaranĩte na hurũrũka cia mwena wa irathĩro wa Iria rĩrĩa rĩa Kinerethu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.11",
            "verseOrgIds": [
              "NUM.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũhaka ũcio ũikũrũkanie na Rũũĩ rwa Jorodani, ũrĩkĩrie Iria-inĩ rĩa Cumbĩ. “ ‘Ũcio nĩguo ũgaatuĩka bũrũri wanyu, na mĩhaka yaguo mĩena yothe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
            "verseOrgIds": [
              "NUM.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa agĩatha andũ a Isiraeli, akĩmeera atĩrĩ: “Mũkaagaya bũrũri ũcio na ũndũ wa kũũcukĩra mĩtĩ ũtuĩke igai rĩanyu Jehova nĩathanĩte akoiga ũkaaheeo mĩhĩrĩga ĩrĩa kenda na nuthu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ nyũmba cia mũhĩrĩga wa Rubeni, na mũhĩrĩga wa Gadi, na nuthu ya mũhĩrĩga wa Manase nĩmarĩkĩtie kwamũkĩra igai rĩao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩhĩrĩga ĩyo yeerĩ na nuthu nĩĩrĩkĩtie kwamũkĩra magai mayo mwena wa irathĩro wa Rũũĩ rwa Jorodani ya Jeriko, kwerekera irathĩro rĩa riũa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.16",
            "verseOrgIds": [
              "NUM.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Maya nĩmo marĩĩtwa ma andũ arĩa makaamũgayania bũrũri ũcio ũtuĩke igai rĩanyu: nĩ Eleazaru ũrĩa mũthĩnjĩri-Ngai na Joshua mũrũ wa Nuni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.17",
            "verseOrgIds": [
              "NUM.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũthuure mũtongoria ũmwe kuuma kũrĩ o mũhĩrĩga nĩgeetha mateithĩrĩrie kũgayania bũrũri ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.18",
            "verseOrgIds": [
              "NUM.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maya nĩmo marĩĩtwa mao:\nnĩ Kalebu mũrũ wa Jefune, kuuma mũhĩrĩga wa Juda;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.19",
            "verseOrgIds": [
              "NUM.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Shemueli mũrũ wa Amihudu, kuuma mũhĩrĩga wa Simeoni;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.20",
            "verseOrgIds": [
              "NUM.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Elidadi mũrũ wa Kisiloni, kuuma mũhĩrĩga wa Benjamini;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.21",
            "verseOrgIds": [
              "NUM.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Buki mũrũ wa Jogili, ũrĩa mũtongoria kuuma mũhĩrĩga wa Dani;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.22",
            "verseOrgIds": [
              "NUM.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hanieli mũrũ wa Efodi, ũrĩa mũtongoria kuuma mũhĩrĩga wa Manase mũrũ wa Jusufu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.23",
            "verseOrgIds": [
              "NUM.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kemueli mũrũ wa Shifitani, ũrĩa mũtongoria kuuma mũhĩrĩga wa Efiraimu mũrũ wa Jusufu;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.24",
            "verseOrgIds": [
              "NUM.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Elizafani mũrũ wa Paranaki, ũrĩa mũtongoria kuuma mũhĩrĩga wa Zebuluni;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.25",
            "verseOrgIds": [
              "NUM.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Palitieli mũrũ wa Azani, ũrĩa mũtongoria kuuma mũhĩrĩga wa Isakaru;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.26",
            "verseOrgIds": [
              "NUM.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ahihudu mũrũ wa Shelomi, ũrĩa mũtongoria kuuma mũhĩrĩga wa Asheri;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.27",
            "verseOrgIds": [
              "NUM.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Pedaheli mũrũ wa Amihudu, ũrĩa mũtongoria kuuma mũhĩrĩga wa Nafitali.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.28",
            "verseOrgIds": [
              "NUM.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nĩo andũ arĩa Jehova aathanire makaagaĩra andũ a Isiraeli magai mao kũu bũrũri wa Kaanani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.29",
            "verseOrgIds": [
              "NUM.34.29"
            ]
          }
        }
      ]
    }
  ],
