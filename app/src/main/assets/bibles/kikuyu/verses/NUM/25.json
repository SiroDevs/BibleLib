  "reference": "Ndari 25",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "NUM 25"
      },
      "items": [
        {
          "text": "25",
