              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, rĩrĩa Balamu onire atĩ Jehova nĩakenaga nĩ kũrathima Isiraeli-rĩ, ndaacookire kũrũmĩrĩra ũragũri ta ũrĩa ekaga mahinda macio mangĩ, no ehũgũrire akĩrora werũ-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Balamu eroreire akĩona ũrĩa Isiraeli maambĩte hema kũringana na mĩhĩrĩga yao-rĩ, akĩiyũrwo nĩ Roho wa Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake akĩaria ndũmĩrĩri yake, akiuga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
