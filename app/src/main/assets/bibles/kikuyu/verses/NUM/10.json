{
  "id": "NUM.10",
  "number": "10",
  "bookId": "NUM",
  "reference": "Ndari 10",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "NUM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tũrumbeta twa Betha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova akĩĩra Musa atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Thondeka tũrumbeta twĩrĩ, ũtũthondeke na betha ndure, tũhũthagĩrwo gwĩtaga kĩrĩndĩ hamwe, o na twa gwĩta andũ moime kambĩ moimagare mathiĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa tũrumbeta tweerĩ twahuhwo hamwe, kĩrĩndĩ gĩothe gĩkongana harĩwe hau itoonyero-inĩ rĩa Hema-ya-Gũtũnganwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo no karumbeta kamwe kahuhwo-rĩ, atongoria, nĩo anene a mbarĩ cia Isiraeli, nĩo marĩũnganaga harĩwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa karumbeta kahuhwo na mũgambo mũnene, mĩhĩrĩga ĩrĩa ĩikarĩte mwena wa irathĩro ĩkoimagara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karumbeta ga keerĩ kahuhwo na mũgambo mũnene, andũ a kambĩ cia mwena wa gũthini makoimagara. Mũgambo ũcio mũnene nĩguo kĩmenyithia gĩa kuumagara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgeetha kĩrĩndĩ kĩũngane-rĩ, huhagai tũrumbeta, no ti na mĩhuhĩre ta ĩyo ĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ariũ a Harũni, acio athĩnjĩri-Ngai, nĩo marĩhuhaga tũrumbeta tũu. Ũndũ ũcio ũtuĩke watho wa gũtũũrio nĩ inyuĩ na njiarwa iria igooka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa mũgũthiĩ mbaara ĩrĩ bũrũri wanyu kĩũmbe mũkarũe na thũ iria imũhinyagĩrĩria-rĩ, huhagai tũrumbeta na mũgambo mũnene. Hĩndĩ ĩyo Jehova Ngai wanyu nĩakamũririkana na amũhonokie kuuma kũrĩ thũ cianyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mahinda manyu ma gũkena, nĩmo ma ciathĩ cianyu iria njathane, na ciathĩ cia Karũgamo ka Mweri, nĩ mũrĩhuhaga tũrumbeta nĩ ũndũ wa maruta ma njino na maruta ma ũiguano, na nĩmo magaatuĩka kĩririkano kĩanyu mbere ya Ngai wanyu. Niĩ nĩ niĩ Jehova Ngai Wanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andũ a Isiraeli Kuuma Sinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya wa mĩrongo ĩĩrĩ wa mweri wa keerĩ mwaka-inĩ wa ĩĩrĩ, itu nĩrĩeherire kuuma hema-inĩ ĩrĩa nyamũre ya Ũira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ a Isiraeli makiumagara kuuma Werũ wa Sinai magĩthiĩ kuuma handũ hamwe nginya harĩa hangĩ, o nginya rĩrĩa itu rĩu rĩarũgamire Werũ-inĩ wa Parani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makiumagara, arĩ riita rĩa mbere, o ta ũrĩa Jehova aathĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikundi cia kambĩ ya Juda nĩcio cioimagarire mbere, irũmĩrĩire bendera yao. Nake Nahashoni mũrũ wa Aminadabu nĩwe warĩ mũtongoria wao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nethaneli mũrũ wa Zuaru nĩwe warĩ mũtongoria wa gĩkundi kĩa mũhĩrĩga wa Isakaru,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Eliabu mũrũ wa Heloni nĩwe warĩ mũtongoria wa gĩkundi kĩa mũhĩrĩga wa Zebuluni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Hema-ĩrĩa-Nyamũre ĩkĩambũrwo, nao Agerishoni na Amerari, arĩa maamĩkuuaga, makiumagara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ikundi cia kambĩ ya Rubeni ikĩrũmĩrĩra ikundi cia Juda, irũmĩrĩire bendera yao. Elizuru mũrũ wa Shedeuru nĩwe warĩ mũtongoria wao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.18",
            "verseOrgIds": [
              "NUM.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelumieli mũrũ wa Zurishadai nĩwe warĩ mũtongoria wa gĩkundi kĩa mũhĩrĩga wa Simeoni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.19",
            "verseOrgIds": [
              "NUM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Eliasafu mũrũ wa Deueli nĩwe warĩ mũtongoria wa gĩkundi kĩa mũhĩrĩga wa Gadi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Akohathu makiumagara makuuĩte indo iria nyamũre. Hema-ĩrĩa-Nyamũre yarĩ ĩkorwo yaambĩtwo matanakinya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ikundi cia kambĩ ya Efiraimu ikĩrũmĩrĩra ikundi cia Rubeni, irũmĩrĩire bendera yao. Elishama mũrũ wa Amihudu nĩwe warĩ mũtongoria wao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamalieli mũrũ wa Pedazuru nĩwe warĩ mũtongoria wa gĩkundi kĩa mũhĩrĩga wa Manase,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Abidani mũrũ wa Gideoni nĩwe warĩ mũtongoria wa gĩkundi kĩa mũhĩrĩga wa Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũrigĩrĩria-rĩ, ikundi cia kambĩ ya Dani ikiumagara irĩ thuutha wa icio ingĩ ciothe, ikiumagara ĩrũmĩrĩire bendera yao. Ahiezeri mũrũ wa Amishadai nĩwe warĩ mũtongoria wao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pagieli mũrũ wa Okirani nĩwe watongoragia gĩkundi kĩa mũhĩrĩga wa Asheri,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Ahira mũrũ wa Enani nĩwe watongoragia gĩkundi kĩa mũhĩrĩga wa Nafitali.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũguo nĩguo ikundi cia andũ a Isiraeli ciarũmanĩrĩire ikiumagara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.28",
            "verseOrgIds": [
              "NUM.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, Musa akĩĩra Hobabu mũrũ wa Reueli ũrĩa Mũmidiani ũrĩa warĩ mũthoni-we atĩrĩ, “Nĩtũroimagara tũthiĩ kũrĩa Jehova aatwĩrire ũhoro wakuo atĩrĩ, ‘Nĩngamũhe kũndũ kũu.’ Ũka tũthiĩ nawe, na nĩtũgũgwĩka maũndũ mega, nĩ ũndũ Jehova nĩerĩire Isiraeli maũndũ mega.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.29",
            "verseOrgIds": [
              "NUM.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hobabu akĩmũcookeria atĩrĩ, “Aca, ndigũũka; no ngũcooka bũrũri witũ na kũrĩ andũ aitũ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.30",
            "verseOrgIds": [
              "NUM.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Musa akĩmwĩra atĩrĩ, “Ndagũthaitha ndũgatũtige. Wee nĩũũĩ kũndũ kũrĩa tũngĩamba hema ciitũ gũkũ werũ-inĩ, na no ũtuĩke maitho maitũ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.31",
            "verseOrgIds": [
              "NUM.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũngĩtwarana na ithuĩ-rĩ, nĩtũrĩkũgayagĩra kĩrĩa gĩothe kĩega Jehova arĩtũheaga.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.32",
            "verseOrgIds": [
              "NUM.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio makiumagara moimĩte hau kĩrĩma-inĩ kĩa Jehova, magĩthiĩ rũgendo rwa mĩthenya ĩtatũ. Narĩo ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova rĩgĩthiĩ rĩmatongoretie mĩthenya ĩyo ĩtatũ, nĩguo rĩkamacarĩrie handũ ha kũhurũka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narĩo itu rĩa Jehova rĩakoragwo igũrũ rĩao o mũthenya makiumagara kuuma kambĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa yothe ithandũkũ rĩoimagario, Musa akoiga atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa rĩaigwo thĩ, akoiga atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        }
