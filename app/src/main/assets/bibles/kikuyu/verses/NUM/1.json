          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma mũhĩrĩga wa Asheri maarĩ andũ 41,500.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.41",
            "verseOrgIds": [
              "NUM.1.41"
            ]
          }
        },
        {
          "name": "verse",
