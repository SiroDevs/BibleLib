{
  "id": "NUM.15",
  "number": "15",
  "bookId": "NUM",
  "reference": "Ndari 15",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "NUM 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maruta ma Mĩthemba Mĩthemba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.1",
            "verseOrgIds": [
              "NUM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arĩria andũ a Isiraeli, ũmeere atĩrĩ: ‘Thuutha wa gũtoonya bũrũri ũrĩa ngũmũhe ũtuĩke mũciĩ wanyu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũrutĩre Jehova maruta ma njino kuuma rũũru rwa ngʼombe kana rwa mbũri, matuĩke mũtararĩko wa gũkenia Jehova, marĩ maruta ma njino, kana magongona, nĩ ũndũ wa mĩĩhĩtwa ya mwanya, kana maruta ma kwĩyendera kana maruta ma ciathĩ-rĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũrĩa ũrĩĩrehaga iruta rĩake, arĩĩrutagĩra Jehova iruta rĩa mũtu gĩcunjĩ gĩa ikũmi kĩa eba ĩmweya mũtu mũhinyu mũno, ũtukanĩtio na gĩcunjĩ kĩa inya kĩa hini ĩmweya maguta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harĩ o gatũrũme ka iruta rĩa njino kana igongona, haaragĩria gĩcunjĩ kĩa inya kĩa hini ĩmwe ya ndibei ĩrĩ iruta rĩa kũnyuuo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Igongona rĩa ndũrũme-rĩ, haarĩria igongona rĩa mũtu icunjĩ igĩrĩ cia ikũmi cia eba ĩmweya mũtu mũhinyu mũno, ũtukanĩtio na gĩcunjĩ gĩa ithatũ kĩa hini ĩmweya maguta,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na gĩcunjĩ gĩa ithatũ kĩa hini ĩmwe ya ndibei ĩrĩ iruta rĩa kũnyuuo. Rĩrutei rĩrĩ mũtararĩko wa gũkenia Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Rĩrĩa mũkũhaarĩria gategwa nĩ ũndũ wa iruta rĩa njino kana igongona, nĩ ũndũ wa mwĩhĩtwa wa mwanya kana iruta rĩa ũiguano rĩrutĩirwo Jehova-rĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "rehagai hamwe na ndegwa ĩyo iruta rĩa mũtu icunjĩ ithatũ cia ikũmi cia eba ĩmweya mũtu mũhinyu mũno, ũtukanĩtio na nuthu ya hini ĩmweya maguta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ningĩ rehagai nuthu ya hini ĩmwe ya ndibei ĩrĩ iruta rĩa kũnyuuo. Narĩo igongona rĩu rĩgatuĩka iruta rĩa njino rĩrĩ mũtararĩko wa gũkenia Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndegwa kana ndũrũme o yothe, kana gatũrũme kana koori o gothe, irĩhaaragĩrio o ro ũguo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.11",
            "verseOrgIds": [
              "NUM.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩkagai ũguo harĩ o ĩmwe yacio ya iria ciothe mũrĩharagĩria.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.12",
            "verseOrgIds": [
              "NUM.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mũndũ wothe ũciarĩirwo kwanyu no nginya ekage maũndũ macio ũguo rĩrĩa arĩrehaga iruta rĩa gũcinwo na mwaki rĩrĩ mũtararĩko wa gũkenia Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ wa njiarwa iria igooka, rĩrĩa rĩothe mũgeni kana mũndũ ũngĩ o wothe ũtũũranĩtie na inyuĩ arĩĩrutaga iruta rĩa gũcinwo na mwaki rĩrĩ mũtararĩko wa gũkenia Jehova-rĩ, no nginya ekage o ta ũrĩa inyuĩ mwĩkaga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩrĩndĩ gĩkĩ kĩrĩkoragwo na watho o ũmwe wanyu na harĩ mũgeni ũrĩa ũtũũranĩtie na inyuĩ; ũyũ nĩ watho wa gũtũũra nĩ ũndũ wa njiarwa iria igooka. Inyuĩ na mũgeni mũrĩkoragwo mũrĩ o ũndũ ũmwe maitho-inĩ ma Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawatho mamwe na mwathanĩre ũmwe nĩguo ũrĩhũthagĩrwo harĩ inyuĩ na harĩ mũgeni ũrĩa ũtũũranĩtie na inyuĩ.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.17",
            "verseOrgIds": [
              "NUM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arĩria andũ a Isiraeli, ũmeere atĩrĩ: ‘Rĩrĩa mũgatoonya bũrũri ũrĩa ndĩramũtwara,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.18",
            "verseOrgIds": [
              "NUM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũrĩe irio cia bũrũri ũcio, heanai imwe ciacio irĩ iruta harĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.19",
            "verseOrgIds": [
              "NUM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ mũkaaruta tũmĩgate kuuma mũtu-inĩ wanyu ũrĩa mũgaathĩa rĩa mbere na mũtũheane tũrĩ iruta kĩhuhĩro-inĩ kĩa ngano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.20",
            "verseOrgIds": [
              "NUM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmũkaheanaga iruta rĩrĩ rĩa mũtu ũrĩa mũgathĩa rĩa mbere kũrĩ Jehova njiarwa-inĩ cianyu ciothe iria igooka thuutha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.21",
            "verseOrgIds": [
              "NUM.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maruta nĩ ũndũ wa Mehia Matarĩ ma Rũtũrĩko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Na rĩrĩ, mũngĩkaaga kũrũmĩrĩra rĩathani o na rĩmwe rĩa maya Jehova aaheire Musa mũtekwenda-rĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.22",
            "verseOrgIds": [
              "NUM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "rĩathani o rĩothe Jehova aamũheire na kanua ka Musa kuuma mũthenya ũrĩa Jehova aamaheanire na kũrũmĩrĩra nginya njiarwa iria igooka,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.23",
            "verseOrgIds": [
              "NUM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũndũ ũcio ũngĩkorwo wĩkĩtwo mũtekwenda, kĩrĩndĩ gĩtekũmenya ũhoro ũcio, hĩndĩ ĩyo kĩrĩndĩ gĩothe nĩgĩkaruta gategwa gatuĩke igongona rĩa njino rĩna mũtararĩko wa gũkenia Jehova, hamwe na maruta ma mũtu na ma kũnyuuo, marĩa matuĩtwo, na thenge ya igongona rĩa kũhoroheria mehia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.24",
            "verseOrgIds": [
              "NUM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthĩnjĩri-Ngai nĩakahoroheria kĩrĩndĩ kĩu gĩothe kĩa andũ a Isiraeli, na nĩmakarekerwo, nĩgũkorwo ũndũ ũcio ndwarĩ wa rũtũrĩko, na nĩ ũndũ wa kũrutĩra Jehova iruta rĩa gũcinwo na mwaki rĩa mahĩtia mao, na iruta rĩa kũhoroherio mehia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.25",
            "verseOrgIds": [
              "NUM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩrĩndĩ gĩothe kĩa andũ a Isiraeli na ageni arĩa matũũranagia nao nĩmakarekerwo, nĩ ũndũ andũ othe mehĩtie matekwenda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.26",
            "verseOrgIds": [
              "NUM.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘No kũngĩkorwo no mũndũ ũmwe wĩhĩtie atekwenda, no nginya arehe kaharika ka mwaka ũmwe ka igongona rĩa kũhoroherio mehia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.27",
            "verseOrgIds": [
              "NUM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthĩnjĩri-Ngai nĩakahoroheria mũndũ ũcio wĩhĩtie atekwenda hau mbere ya Jehova na aarĩkia kũhoroherio, nĩakarekerwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.28",
            "verseOrgIds": [
              "NUM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watho o ro ũmwe nĩguo ũrĩhũthagĩrwo harĩ mũndũ o wothe ũkehia atekwenda, arĩ Mũisiraeli ũciarĩirwo kwanyu kana arĩ mũgeni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.29",
            "verseOrgIds": [
              "NUM.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘No mũndũ ũrĩa ũkehia na rũtũrĩko akĩendaga, arĩ wa gũciarĩrwo kwanyu kana arĩ mũgeni, ũcio nĩarumĩte Jehova, na mũndũ ũcio no nginya aingatwo kuuma kũrĩ andũ ao.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ nĩ amenete kiugo kĩa Jehova na akoina maathani make, mũndũ ũcio ti-itherũ no nginya aingatwo biũ naguo wĩhia wake nĩũkamũcokerera.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũthũkia wa Thabatũ Kũũragwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa andũ a Isiraeli maarĩ werũ-inĩ, kũrĩ mũndũ wonirwo akiuna ngũ mũthenya wa Thabatũ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.32",
            "verseOrgIds": [
              "NUM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arĩa maamuonire akiuna ngũ makĩmũtwara kũrĩ Musa na Harũni, o na kũrĩ kĩũngano kĩu gĩothe gĩa Isiraeli,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.33",
            "verseOrgIds": [
              "NUM.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makĩmũhingĩra nĩ ũndũ gũtiamenyekaga ũrĩa agĩrĩirwo nĩ gwĩkwo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.34",
            "verseOrgIds": [
              "NUM.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Musa atĩrĩ, “Mũndũ ũcio no nginya akue. Kĩũngano gĩothe kĩa Isiraeli no nginya kĩmũhũũre na mahiga nyuguto nja ya kambĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.35",
            "verseOrgIds": [
              "NUM.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio kĩũngano kĩu gĩkĩmũtwara nja ya kambĩ gĩkĩmũhũũra na mahiga nyuguto agĩkua, o ta ũrĩa Jehova aathĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.36",
            "verseOrgIds": [
              "NUM.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciohe cia Ndigi Nguo-inĩ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.37",
            "verseOrgIds": [
              "NUM.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arĩria andũ a Isiraeli, ũmeere atĩrĩ: ‘Njiarwa-inĩ ciothe iria igooka, nĩmũgatumagĩrĩra ciohe cia ndigi koine-inĩ ka nguo cianyu, o kĩohe gĩkohererwo na rũrigi rwa rangi wa bururu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciohe icio nĩcio mũrĩroraga nĩguo mũririkanage maathani mothe ma Jehova, nĩguo mũmathĩkagĩre, mũtikanahũũre ũmaraya na ũndũ wa kũrũmĩrĩra merirĩria ma ngoro o na kana maitho manyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ nĩmũkaririkanaga gwathĩkagĩra maathani makwa mothe na mũtuĩke andũ mamũrĩirwo Ngai wanyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.40",
            "verseOrgIds": [
              "NUM.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niĩ nĩ niĩ Jehova Ngai wanyu, ũrĩa wamũrutire bũrũri wa Misiri nĩguo nduĩke Ngai wanyu. Niĩ nĩ niĩ Jehova Ngai wanyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        }
      ]
    }
  ],
