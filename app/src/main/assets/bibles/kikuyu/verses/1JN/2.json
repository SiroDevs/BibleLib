              "1JN.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũtikende Thĩ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikende thĩ kana kĩndũ o gĩothe kĩrĩ thĩinĩ wa thĩ. Mũndũ o na ũ angĩkorwo nĩendete thĩ-rĩ, wendo wa Ithe witũ ndũrĩ thĩinĩ wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.15",
            "verseOrgIds": [
              "1JN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo ũndũ o wothe ũrĩ gũkũ thĩ, na nĩmo merirĩria ma mwĩrĩ, na merirĩria ma maitho make, na mwĩraho wa kĩrĩa arĩ nakĩo na ũrĩa ekaga: maũndũ macio matiumanĩte na Ithe witũ, no moimanĩte na thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thĩ na merirĩria mayo nĩithiraga, no mũndũ ũrĩa wĩkaga ũrĩa Ngai endaga atũũraga nginya tene.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
            "verseOrgIds": [
              "1JN.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwĩmenyerera Mũmena-Kristũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twana twakwa nyendete, rĩĩrĩ nĩ ithaa rĩa kũrigĩrĩria; na o ta ũrĩa mũiguĩte atĩ mũmena-Kristũ nĩarooka, o na rĩu amena-Kristũ aingĩ nĩmokĩte. Na nĩ ũndũ ũcio nĩtũmenyete atĩ rĩĩrĩ nĩrĩo ithaa rĩa kũrigĩrĩria.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.18",
            "verseOrgIds": [
              "1JN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma nĩmoimire kũrĩ ithuĩ, no matiarĩ aitũ. Nĩgũkorwo mangĩarĩ aitũ-rĩ, nĩmangĩaikarire hamwe na ithuĩ; no gũthiĩ kwao kuonanirie atĩ gũtiarĩ o na ũmwe wao warĩ witũ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.19",
            "verseOrgIds": [
              "1JN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, inyuĩ mũrĩ ahake maguta nĩ Ũrĩa Mũtheru, na inyuĩ inyuothe nĩmũũĩ ũhoro wa ma.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.20",
            "verseOrgIds": [
              "1JN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndĩramwandĩkĩra tondũ mũtiũĩ ũhoro wa ma, no ngũmwandĩkĩra tondũ nĩmũũĩ ũhoro wa ma, na tondũ gũtirĩ ũhoro wa maheeni uumanaga na ũhoro wa ma.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.21",
            "verseOrgIds": [
              "1JN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũkĩrĩ mũheenania? Nĩ mũndũ ũrĩa ũkaanaga atĩ Jesũ nĩwe Kristũ. Mũndũ ta ũcio nĩwe mũmena-Kristũ: mũndũ ũcio nĩakaanaga Ithe o na Mũriũ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.22",
            "verseOrgIds": [
              "1JN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gũtirĩ mũndũ ũkaanaga Mũriũ ũkĩrĩ na Ithe witũ; ũrĩa wothe uumbũraga Mũriũ arĩ na Ithe o nake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwĩmenyererei nĩguo ũndũ ũrĩa mũrĩkĩtie kũigua kuuma o kĩambĩrĩria ũikarage thĩinĩ wanyu. Ũndũ ũcio ũngĩikara thĩinĩ wanyu-rĩ, o na inyuĩ mũrĩikaraga thĩinĩ wa Mũriũ, o na mũrĩ thĩinĩ wa Ithe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ũndũ ũyũ nĩguo atwĩrĩire: o muoyo wa tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1JN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndĩramwandĩkĩra maũndũ maya makoniĩ ũhoro wa andũ arĩa marageria kũmũhĩtithia.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.26",
            "verseOrgIds": [
              "1JN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1JN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inyuĩ-rĩ, maguta marĩa mwahakirwo nĩwe-rĩ, megũtũũra thĩinĩ wanyu, na mũtibatairio nĩ mũndũ o na ũ wa kũmũruta ũhoro. No rĩrĩ, o ta ũrĩa ihaka rĩake rĩa maguta rĩmũrutaga ũhoro wa maũndũ mothe, na o ta ũrĩa rĩrĩ rĩa ma, na ti rĩa maheeni: o ta ũrĩa rĩmũrutĩĩte-rĩ, tũũrai thĩinĩ wake.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciana cia Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1JN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩu, inyuĩ twana twakwa nyendete, kĩrĩrĩriai gũikara thĩinĩ wake nĩgeetha rĩrĩa akoonithanio tũgaakorwo tũrĩ na ũũmĩrĩru na tũtegũconoka mbere yake hĩndĩ ĩrĩa agooka.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
            "verseOrgIds": [
              "1JN.2.28"
            ]
          }
        },
