          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kiugo kĩa Muoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũhoro ũrĩa warĩ kuo kuuma o kĩambĩrĩria, ũrĩa tũiguĩte, na ũrĩa tuonete na maitho maitũ, na tũkawĩrorera, namo moko maitũ makaũhutia, o ũhoro ũcio wa Kiugo kĩa muoyo, nĩguo tũhunjagia.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muoyo ũcio nĩwonithanirio; na ithuĩ nĩtũwonete na tũkaheana ũira waguo, na ithuĩ tũkamũhunjagĩria ũhoro wa muoyo wa tene na tene, ũrĩa watũire na Ithe witũ, na ũkĩonithanio kũrĩ ithuĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ithuĩ tũmũhunjagĩria kĩrĩa tuonete na tũkaigua, nĩgeetha o na inyuĩ mũgĩe ngwatanĩro na ithuĩ. Nayo ngwatanĩro iitũ nĩ ngwatanĩro na Ithe witũ, o na Mũriũ Jesũ Kristũ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũramwandĩkĩra maũndũ maya nĩguo gĩkeno giitũ kĩiganĩre.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũthiĩ na Ũtheri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩno nĩyo ndũmĩrĩri ĩrĩa tũiguĩte kuuma kũrĩ we, na nĩyo tũramũmenyithia, atĩ: Ngai nĩ ũtheri; thĩinĩ wake gũtirĩ nduma o na hanini.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũngiuga atĩ tũrĩ ngwatanĩro nake, tũgĩthiiaga na mĩthiĩre ya nduma-rĩ, ũguo nĩkũheenania, naguo ũhoro wa ma ndũtũũraga thĩinĩ witũ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "No tũngĩthiĩ na ũtheri, o ta ũrĩa we arĩ ũtheri-inĩ, tũrĩ na ngwatanĩro mũndũ na ũrĩa ũngĩ, nayo thakame ya Jesũ, Mũrũ wake, nĩĩtũtheragia, tũgathirwo nĩ mehia mothe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũngiuga tũtirĩ na mehia, nĩ kwĩheenia tũkwĩheenia, naguo ũhoro wa ma ndũrĩ thĩinĩ witũ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.8",
            "verseOrgIds": [
              "1JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũngiumbũra mehia maitũ-rĩ, we nĩ mwĩhokeku na nĩ wa kĩhooto, na nĩegũtũrekera mehia maitũ na atũtherie tũthirwo nĩ maũndũ mothe marĩa matarĩ ma ũthingu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.9",
            "verseOrgIds": [
              "1JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũngiuga tũtiĩhĩtie-rĩ, tũkũmũtua wa maheeni, naguo ũhoro wake ndũrĩ na handũ thĩinĩ witũ.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.10",
            "verseOrgIds": [
              "1JN.1.10"
            ]
          }
        }
      ]
    }
  ],
