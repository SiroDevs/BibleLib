{
  "id": "2CH.1",
  "number": "1",
  "bookId": "2CH",
  "reference": "2 Maũndũ ma Matukũ ma Tene 1",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
