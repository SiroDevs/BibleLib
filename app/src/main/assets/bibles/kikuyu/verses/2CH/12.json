  "bookId": "2CH",
  "reference": "2 Maũndũ ma Matukũ ma Tene 12",
  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
