{
  "id": "2CH.18",
  "number": "18",
  "bookId": "2CH",
  "reference": "2 Maũndũ ma Matukũ ma Tene 18",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
