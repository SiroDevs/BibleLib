{
  "id": "2CH.26",
  "number": "26",
  "bookId": "2CH",
  "reference": "2 Maũndũ ma Matukũ ma Tene 26",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
