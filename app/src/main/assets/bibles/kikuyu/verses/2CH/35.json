{
  "id": "2CH.35",
  "number": "35",
  "bookId": "2CH",
  "reference": "2 Maũndũ ma Matukũ ma Tene 35",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
