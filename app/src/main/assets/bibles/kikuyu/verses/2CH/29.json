{
  "id": "2CH.29",
  "number": "29",
  "bookId": "2CH",
  "reference": "2 Maũndũ ma Matukũ ma Tene 29",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
