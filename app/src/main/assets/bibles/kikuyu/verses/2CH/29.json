          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia Gũtheria Hekarũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia aarĩ wa mĩaka mĩrongo ĩĩrĩ na ĩtano rĩrĩa aatuĩkire mũthamaki, nake agĩthamaka arĩ Jerusalemu mĩaka mĩrongo ĩĩrĩ na kenda. Nyina eetagwo Abija mwarĩ wa Zekaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.1",
            "verseOrgIds": [
              "2CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake agĩĩka maũndũ marĩa maagĩrĩire maitho-inĩ ma Jehova, o ta ũrĩa ithe Daudi eekĩte.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweri wa mbere wa mwaka wa mbere wa wathani wake-rĩ, nĩahingũrire mĩrango ya hekarũ ya Jehova na akĩmĩthondeka kũrĩa yathũkĩtio.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akĩrehe athĩnjĩri-Ngai na Alawii, akĩmacookanĩrĩria hamwe nja ya mwena wa irathĩro,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.4",
            "verseOrgIds": [
              "2CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akiuga atĩrĩ: “Ta thikĩrĩriai inyuĩ Alawii! Mwĩtheriei rĩu, na mũtherie hekarũ ya Jehova Ngai wa maithe manyu. Eheriai kĩndũ gĩothe kĩrĩ thaahu kuuma handũ-harĩa-haamũre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maithe maitũ matiarĩ ehokeku; nĩmekire ũũru maitho-inĩ ma Jehova Ngai witũ na makĩmũtirika. Nĩmahũgũrire mothiũ mao makĩaga kũrora gĩikaro kĩa Jehova, makĩmũhutatĩra.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ningĩ nĩmahingire mĩrango ya gĩthaku na makĩhoria matawa. Matiacinire ũbumba kana makĩrutĩra Ngai wa Isiraeli maruta o na marĩkũ ma njino handũ-inĩ harĩa haamũre.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, marakara ma Jehova magĩkora Juda na Jerusalemu; nake agĩtũma matuĩke ta kĩndũ gĩa kũmakania na kĩa magigi, na gĩa kũnyũrũrio, o ta ũrĩa mũreyonera na maitho manyu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩu nĩkĩo gĩatũmire maithe maitũ mooragwo na rũhiũ rwa njora, na nokĩo gĩtũmĩte ariũ aitũ, na airĩtu aitũ, na atumia aitũ matahwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, ndĩciirĩtie na ngoro yakwa kũrĩkanĩra kĩrĩkanĩro na Jehova, Ngai wa Isiraeli, nĩgeetha marakara make mahiũ matweherere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atĩrĩrĩ, ariũ akwa, mũtigatuĩke andũ matarũmbũyagia ũndũ, nĩgũkorwo Jehova nĩamũthuurĩte mũrũgamage mbere yake mũmũtungatagĩre, mũtuĩke a gũtungata mũrĩ mbere yake na mũcinage ũbumba.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Alawii aya makĩambĩrĩria kũruta wĩra: kuuma kũrĩ Akohathu, maarĩ Mahathu mũrũ wa Amasai, na Joeli mũrũ wa Azaria; kuuma kũrĩ Amerari, maarĩ Kishu mũrũ wa Abudi, na Azaria mũrũ wa Jehaleleli; kuuma kũrĩ Agerishoni, maarĩ Joa mũrũ wa Zima, na Edeni mũrũ wa Joa;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuuma kũrĩ njiaro cia Elizafani, maarĩ Shimuri na Jeieli; kuuma kũrĩ njiaro cia Asafu, maarĩ Zekaria na Matania;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kũrĩ njiaro cia Hemani, maarĩ Jehueli na Shimei; kuuma kũrĩ njiaro cia Jeduthuni, maarĩ Shemaia na Uzieli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarĩkia gũcookanĩrĩria ariũ a ithe wao hamwe na meetheria-rĩ, magĩtoonya hekarũ ya Jehova, makĩmĩtheria, o ta ũrĩa mũthamaki aathanĩte arũmĩrĩire kiugo kĩa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao athĩnjĩri-Ngai magĩtoonya handũ-harĩa-haamũre ha Jehova nĩguo mahatherie. Na indo ciothe iria itaarĩ theru iria maakorire kũu hekarũ-inĩ ya Jehova magĩciruta magĩciiga nja ya hekarũ ya Jehova. Nao Alawii magĩcioya magĩcitwara Gĩtuamba-inĩ gĩa Kidironi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maambĩrĩirie wĩra wa gũtheria hekarũ mũthenya wa mbere wa mweri wa mbere, na mũthenya wa ĩnana wa mweri ũcio magĩkinya gĩthaku-inĩ kĩa Jehova. Na handũ ha matukũ mangĩ manana-rĩ, magĩtheria hekarũ ya Jehova yo nyene, na makĩrĩkia wĩra ũcio mũthenya wa ikũmi na ĩtandatũ wa mweri ũcio wa mbere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩcooka magĩthiĩ kũrĩ Mũthamaki Hezekia, makĩmwĩra atĩrĩ: “Nĩtũtheretie hekarũ ya Jehova yothe, kĩgongona kĩa maruta ma njino, na indo ciakĩo ciothe, na metha ĩrĩa ĩigagĩrĩrwo mĩgate ĩrĩa mĩamũre, na indo ciayo ciothe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtũhaarĩirie na tũkaamũra indo iria ciothe Mũthamaki Ahazu ehereetie Hekarũ-inĩ rĩrĩa aarĩ mũthamaki nĩ ũndũ wa kwaga wĩhokeku. Na rĩrĩ, rĩu irĩ mbere ya kĩgongona kĩa Jehova.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, rũciinĩ tene, Mũthamaki Hezekia agĩcookanĩrĩria anene a itũũra rĩu inene na magĩthiĩ hekarũ-inĩ ya Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makĩrehe ndegwa mũgwanja, na ndũrũme mũgwanja, na tũtũrũme mũgwanja, o na thenge mũgwanja cia igongona rĩa kũhoroherio mehia makoniĩ ũthamaki ũcio, na ma handũ-harĩa-haamũre o na ma Juda. Nake mũthamaki agĩatha athĩnjĩri-Ngai, o acio a njiaro cia Harũni, macithĩnjĩre hau kĩgongona-inĩ kĩa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio magĩthĩnja ndegwa icio, nao athĩnjĩri-Ngai makĩoya thakame yacio makĩmĩminjaminjĩria kĩgongona; magĩcooka magĩthĩnja ndũrũme icio na makĩminjaminjĩria kĩgongona thakame yacio; magĩcooka magĩthĩnja tũtũrũme tũu na makĩminjaminjĩria kĩgongona thakame yatuo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.22",
            "verseOrgIds": [
              "2CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio thenge cia igongona rĩa kũhoroherio mehia ikĩrehwo mbere ya mũthamaki na kĩũngano kĩu, nao magĩciigĩrĩra moko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.23",
            "verseOrgIds": [
              "2CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao athĩnjĩri-Ngai magĩcooka magĩthĩnja thenge icio hamwe na thakame yacio, magĩcirutĩra hau kĩgongona-inĩ irĩ maruta ma kũhoroheria mehia nĩguo ihoroherie andũ a Isiraeli othe, nĩ tondũ mũthamaki nĩathanĩte kũrutwo iruta rĩa njino na iruta rĩa kũhoroheria mehia rĩrĩ rĩa andũ othe a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthamaki akĩiga Alawii hekarũ-inĩ ya Jehova marĩ na thaani iria ihũũrithanagio ikagamba, na inanda cia mũgeeto na cia kĩnũbi ta ũrĩa gwaathanĩtwo nĩ Daudi na Gadi mũndũ ũrĩa wonagĩra mũthamaki maũndũ, na Nathani ũrĩa mũnabii; ũndũ ũyũ waathanĩtwo nĩ Jehova na tũnua twa anabii ake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Alawii makĩrũgama mehaarĩirie na inanda cia Daudi cia kũina, na athĩnjĩri-Ngai marĩ na tũrumbeta twao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia agĩathana atĩ kũrutwo iruta rĩa njino kĩgongona-inĩ. Narĩo igongona rĩambĩrĩria kũrutwo-rĩ, andũ makĩambĩrĩria kũinĩra Jehova marĩ na tũrumbeta na inanda cia kũina cia Daudi mũthamaki wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩũngano kĩu gĩothe gĩkĩinamĩrĩra, gĩkĩhooya, nao aini makĩinaga na tũrumbeta tũkĩhuhagwo. Maũndũ macio mothe magĩthiĩ na mbere nginya igongona rĩu rĩa njino rĩkĩrĩka kũrutwo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩa maruta maarĩkirie kũrutwo-rĩ, mũthamaki na andũ othe arĩa maarĩ nake hau magĩturia maru makĩhooya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Mũthamaki Hezekia na anene ake magĩatha Alawii magooce Jehova na ciugo cia Daudi na cia Asafu mũndũ ũrĩa muoni-maũndũ. Nĩ ũndũ ũcio makĩina nyĩmbo cia kũgooca Jehova marĩ na gĩkeno na makĩinamia mĩtwe yao makĩmũhooya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Hezekia akiuga atĩrĩ, “Rĩu nĩmweyamũrĩra Jehova. Rehei magongona na maruta ma gũcookia ngaatho hekarũ-inĩ ya Jehova.” Nĩ ũndũ ũcio kĩũngano kĩu gĩkĩrehe magongona na maruta ma gũcookia ngaatho, na andũ othe arĩa ngoro ciao cieyendeire makĩrehe maruta ma njino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo mũigana wa maruta ma njino marĩa maarehirwo nĩ kĩũngano kĩu warĩ ndegwa mĩrongo mũgwanja, na ndũrũme 100 na tũtũrũme 200, ciothe ciarĩ cia maruta ma njino ma kũrutĩrwo Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamũ ciothe iria ciaamũrĩtwo cia magongona ciarĩ ndegwa 600 na ngʼondu hamwe na mbũri 3,000.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, athĩnjĩri-Ngai maarĩ anini mũno matingĩahotire gũthĩnja nyamũ ciothe cia maruta ma njino; nĩ ũndũ ũcio andũ a nyũmba ciao, nĩo Alawii, makĩmateithĩrĩria nginya wĩra ũcio ũkĩrĩka nginya rĩrĩa athĩnjĩri-Ngai angĩ maamũrirwo, nĩgũkorwo Alawii maarĩ na kĩyo gĩa kwĩyamũra gũkĩra athĩnjĩri-Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, nĩ kwarĩ na maruta ma njino maingĩ mũno, hamwe na maguta ma maruta ma ũiguano, o na maruta ma indo cia kũnyuuo marĩa maarutanagĩrio na maruta ma njino. Nĩ ũndũ ũcio wĩra wa ũtungata wa hekarũ ya Jehova ũgĩcookio rĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Hezekia na andũ othe magĩkena nĩ ũndũ wa ũrĩa Ngai eekĩire andũ ake, tondũ ũndũ ũcio wekirwo narua mũno.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
  ],
