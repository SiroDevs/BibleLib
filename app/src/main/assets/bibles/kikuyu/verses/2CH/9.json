            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maũndũ marĩa mangĩ makoniĩ wathani wa Solomoni, kuuma o kĩambĩrĩria nginya kĩrĩkĩro-rĩ, githĩ matiandĩkĩtwo maandĩko-inĩ ma Nathani ũrĩa mũnabii, na ũrathi-inĩ wa Ahija ũrĩa Mũshiloni, na cioneki-inĩ cia Ido ũrĩa wonaga maũndũ makoniĩ Jeroboamu mũrũ wa Nebati?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni aathamakĩire Isiraeli rĩothe arĩ Jerusalemu mĩaka mĩrongo ĩna.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
