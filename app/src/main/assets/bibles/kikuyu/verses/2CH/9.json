          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarathi cia Solomoni ciarehetwo kuuma bũrũri wa Misiri, na kuuma mabũrũri marĩa mangĩ mothe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
    },
    {
