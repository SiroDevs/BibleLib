              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo ngĩkiuga na ngoro yakwa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mĩnoga no ya Tũhũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngĩthũũra gũtũũra muoyo, tondũ wĩra ũrĩa ũrutagwo gũkũ thĩ kwaraga riũa warĩ wa kũnjiguithia kĩeha. Wothe warĩ wa tũhũ, o ta gũtengʼeria rũhuho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩgĩthũũra maũndũ mothe marĩa ndenogeetie namo gũkũ thĩ kwaraga riũa, tondũ no nginya ngaamatigĩra ũrĩa ũgooka thuutha wakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ nũũ ũũĩ kana ũcio ũgooka ithenya rĩakwa agaakorwo arĩ mũndũ mũũgĩ kana arĩ mũndũ mũkĩĩgu? No rĩrĩ, nĩwe ũkaarũgamĩrĩra wĩra ũrĩa ndaanetungumania naguo ngĩtũmagĩra ũũgĩ wakwa gũkũ thĩ kwaraga riũa. Ũndũ ũcio o naguo no wa tũhũ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngoro yakwa ĩkĩambĩrĩria kũũrwo nĩ hinya nĩ ũndũ wa wĩra wakwa wothe wa mĩnoga ũrĩa ndaarutaga gũkũ thĩ kwaraga riũa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ mũndũ no arute wĩra wake na ũũgĩ, na ũmenyo, na kũũhĩgĩra maũndũ, no rĩrĩ, no nginya acooke atige kĩrĩa gĩothe agĩĩta nakĩo kũrĩ mũndũ ũngĩ ũtakĩnogeire. Ũndũ ũyũ o naguo no wa tũhũ, na nĩ mũtino mũnene.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ-rĩ, nĩ uumithio ũrĩkũ oonaga harĩ wĩra ũrĩa wothe arutaga, na mĩnoga, na gwĩtungumania kũrĩa anetungumania nakuo gũkũ thĩ kwaraga riũa?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo matukũ make mothe, wĩra wake nĩ wa ruo na kĩeha; o na ũtukũ, meciiria make matihurũkaga. Ũndũ ũcio o naguo no wa tũhũ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ-rĩ, ndarĩ ũndũ ũngĩ mwega angĩĩka ũkĩrĩte kũrĩa na kũnyua, na gũkenera wĩra wake. Ũndũ ũyũ o naguo ngĩona atĩ uumĩte guoko-inĩ kwa Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩ ũndũ-rĩ, nũũ ũngĩhota kũrĩa kana gũkena Ngai atarĩ ho?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
              "ECC.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai aheaga mũndũ ũrĩa ũmũkenagia maũndũ ma ũũgĩ, na ũmenyo, na gĩkeno, no mũndũ ũrĩa mwĩhia akamũhe wĩra wa gũcookanĩrĩria na kwĩigĩra ũtonga, nĩguo acooke aũnenganĩre kũrĩ mũndũ ũrĩa ũmũkenagia. Ũndũ ũcio o naguo no wa tũhũ, o ta gũtengʼeria rũhuho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.26",
            "verseOrgIds": [
              "ECC.2.26"
            ]
          }
        }
      ]
    }
  ],
