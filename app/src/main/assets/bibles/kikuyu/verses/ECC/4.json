    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ũthii wa-na-Mbere no wa Tũhũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ kaba mũndũ mwĩthĩ mũthĩĩni no nĩ mũũgĩ, gũkĩra mũthamaki mũkũrũ no nĩ mũkĩĩgu, ũrĩa ũtangĩtaarĩka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ mwĩthĩ ũcio no akorwo oimĩte njeera agatuuo mũthamaki, kana akorwo aaciarirwo arĩ mũthĩĩni o kũu ũthamaki-inĩ wake.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩkĩona atĩ andũ arĩa othe matũũraga na magathiiagĩra gũkũ thĩ kwaraga riũa maarũmĩrĩire mwanake ũcio mũthĩĩni, o ũcio wacookire ithenya rĩa mũthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ arĩa othe maathagwo nĩwe matingĩtarĩka. No rĩrĩ, andũ arĩa mookire thuutha wake matiakenirio nĩ ũcio wacookire ithenya rĩa mũthamaki. Ũndũ ũyũ o naguo nĩ wa tũhũ, o ta gũtengʼeria rũhuho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
      ]
