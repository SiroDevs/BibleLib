            "number": "28",
            "style": "v",
            "sid": "DEU 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaga ũguo, bũrũri ũrĩa wee watũrutire ũkoiga atĩrĩ, ‘Tondũ Jehova ndangĩahotire kũmakinyia bũrũri ũrĩa aamerĩire, na nĩ tondũ nĩamamenete-rĩ, nĩkĩo aamatwarire werũ-inĩ amooragĩre kuo.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
