{
  "id": "DEU.19",
  "number": "19",
  "bookId": "DEU",
  "reference": "Gũcookerithia 19",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
