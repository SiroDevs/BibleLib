{
  "id": "DEU.6",
  "number": "6",
  "bookId": "DEU",
  "reference": "Gũcookerithia 6",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
