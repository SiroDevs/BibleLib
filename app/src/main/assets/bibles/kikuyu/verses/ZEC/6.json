{
  "id": "ZEC.6",
  "number": "6",
  "bookId": "ZEC",
  "reference": "Zekaria 6",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
