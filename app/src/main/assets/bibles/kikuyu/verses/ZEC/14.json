{
  "id": "ZEC.14",
  "number": "14",
  "bookId": "ZEC",
  "reference": "Zekaria 14",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
