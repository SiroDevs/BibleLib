{
  "id": "GEN.13",
  "number": "13",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 13",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
