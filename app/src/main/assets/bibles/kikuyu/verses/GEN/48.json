{
  "id": "GEN.48",
  "number": "48",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 48",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
