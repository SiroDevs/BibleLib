{
  "id": "GEN.40",
  "number": "40",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 40",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
