{
  "id": "GEN.32",
  "number": "32",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 32",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "GEN 32"
      },
      "items": [
        {
          "text": "32",
