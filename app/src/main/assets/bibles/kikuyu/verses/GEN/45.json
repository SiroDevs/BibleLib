{
  "id": "GEN.45",
  "number": "45",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 45",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "GEN 45"
      },
      "items": [
