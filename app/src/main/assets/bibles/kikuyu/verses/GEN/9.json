{
  "id": "GEN.9",
  "number": "9",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 9",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
