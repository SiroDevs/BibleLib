          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enoku aakinyia mĩaka mĩrongo ĩtandatũ na ĩtano-rĩ, akĩgĩa na mũriũ wetagwo Methusela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.21",
            "verseOrgIds": [
              "GEN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na thuutha wa Methusela gũciarwo-rĩ, Enoku agĩtũũra atwaranaga na Ngai mĩaka magana matatũ, akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
