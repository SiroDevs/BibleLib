            "style": "v",
            "sid": "GEN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩaka yothe ĩrĩa Enoku aatũũrire muoyo yarĩ mĩaka magana matatũ na mĩrongo ĩtandatũ na ĩtano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.23",
            "verseOrgIds": [
              "GEN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enoku agĩtwarana na Ngai nginya akĩagwo tondũ Ngai nĩamuoire.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.24",
            "verseOrgIds": [
              "GEN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Methusela aakinyia mĩaka igana na mĩrongo ĩnana na mũgwanja-rĩ, akĩgĩa na mũriũ wetagwo Lameku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.25",
            "verseOrgIds": [
              "GEN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
