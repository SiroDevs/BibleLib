            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenani aakinyia mĩaka mĩrongo mũgwanja-rĩ, akĩgĩa na mũriũ wetagwo Mahalaleli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.12",
