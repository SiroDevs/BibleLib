          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lameku aakinyia mĩaka igana na mĩrongo ĩnana na ĩĩrĩ-rĩ, akĩgĩa mwana wa kahĩĩ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.28",
            "verseOrgIds": [
              "GEN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake agĩgatua Nuhu, akiuga atĩrĩ, “Nĩarĩtũhooragĩria ruo rwa wĩra na mĩnoga ya moko maitũ rĩrĩa tũkũrĩma, tondũ Jehova nĩarumire thĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha wa Nuhu gũciarwo-rĩ, Lameku agĩtũũra muoyo mĩaka ĩngĩ magana matano na mĩrongo kenda na ĩtano, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.30",
            "verseOrgIds": [
              "GEN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
