          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩaka yothe ĩrĩa Methusela aatũũrire muoyo yarĩ mĩaka magana kenda na mĩrongo ĩtandatũ na kenda, agĩcooka agĩkua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
            ]
          }
        },
        {
