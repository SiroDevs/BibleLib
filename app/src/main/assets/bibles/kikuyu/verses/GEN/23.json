{
  "id": "GEN.23",
  "number": "23",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 23",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
