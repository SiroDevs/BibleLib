{
  "id": "GEN.33",
  "number": "33",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 33",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
