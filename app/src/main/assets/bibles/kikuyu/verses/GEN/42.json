{
  "id": "GEN.42",
  "number": "42",
  "bookId": "GEN",
  "reference": "Kĩambĩrĩria 42",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
