{
  "id": "JHN.19",
  "number": "19",
  "bookId": "JHN",
  "reference": "Johana 19",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JHN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesũ Gũtuĩrwo kwambwo Mũtĩ-Igũrũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Pilato akĩoya Jesũ, akĩmũhũũrithia iboko.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.1",
            "verseOrgIds": [
              "JHN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio thigari igĩtuma thũmbĩ ya mĩigua, ikĩmwĩkĩra mũtwe, na ikĩmũhumba kanjũ ya rangi wa ndathi,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.2",
            "verseOrgIds": [
              "JHN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "igathiiaga harĩ we o ihinda kwa ihinda, ikamũnyũrũragia ikiugaga atĩrĩ, “Ngeithi, mũthamaki wa Ayahudi!” Nacio ikamũgũthaga ũthiũ na hĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.3",
            "verseOrgIds": [
              "JHN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rĩngĩ Pilato akiuma nja, akĩĩra Ayahudi atĩrĩ, “Ta onei ngũmũruta nja ndĩmũrehe kũrĩ inyuĩ, nĩguo mũmenye atĩ niĩ ndionete ũndũ o na ũrĩkũ angĩthitangĩrwo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.4",
            "verseOrgIds": [
              "JHN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Jesũ oimire nja ekĩrĩte thũmbĩ ĩyo ya mĩigua na ehumbĩte kanjũ ĩyo ya rangi wa ndathi-rĩ, Pilato akĩmeera atĩrĩ, “Mũndũ nĩ ũyũ!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.5",
            "verseOrgIds": [
              "JHN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa athĩnjĩri-Ngai arĩa anene o na atongoria a Ayahudi maamuonire, makĩanĩrĩra makiuga atĩrĩ, “Mwambithie mũtĩ-igũrũ! Mwambithie mũtĩ-igũrũ!” No Pilato akĩmacookeria atĩrĩ, “Muoei mũmwambe mũtĩ igũrũ arĩ inyuĩ. Ha ũhoro wakwa, ndirona ũndũ o na ũrĩkũ angĩthitangĩrwo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Ayahudi makiuga magwatĩirie atĩrĩ, “Ithuĩ nĩtũrĩ watho; na kũringana na watho ũcio no nginya akue, tondũ nĩetuĩte Mũrũ wa Ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Pilato aiguire ũguo, agĩĩtigĩra mũno makĩria,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.8",
            "verseOrgIds": [
              "JHN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "agĩcooka thĩinĩ wa nyũmba ĩyo ya ũthamaki. Ningĩ akĩũria Jesũ atĩrĩ, “Wee-rĩ, uumĩte kũ?” Nowe Jesũ ndaigana kũmũcookeria.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.9",
            "verseOrgIds": [
              "JHN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilato akĩmũũria atĩrĩ, “Kaĩ ũkũrega kũnjarĩria? Kaĩ ũtooĩ ndĩ na ũhoti wa gũkuohorithia, kana wa gũkwambithia mũtĩ igũrũ?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.10",
            "verseOrgIds": [
              "JHN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesũ akĩmũcookeria atĩrĩ, “Wee ndũngĩrĩ na ũhoti igũrũ rĩakwa korwo ndũheetwo guo kuuma igũrũ. Nĩ ũndũ ũcio ũrĩa ũũneanire kũrĩwe nĩwe ũrĩ na mehia marĩa manene.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma hĩndĩ ĩyo, Pilato akĩgeria kuohora Jesũ, no Ayahudi magĩthiĩ na mbere kwanĩrĩra atĩrĩ, “Ũngĩrekereria mũndũ ũyũ, wee ndũrĩ mũrata wa Kaisari. Mũndũ o wothe wĩtuaga mũthamaki nĩamenete Kaisari.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Pilato aiguire ũguo-rĩ, akiumia Jesũ nja, na agĩikarĩra gĩtĩ kĩa mũtuanĩri ciira handũ hoĩkaine ta “Harĩa-haare-Mahiga” (na heetagwo na Kĩhibirania Gabatha).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwarĩ mũthenya wa Ihaarĩria rĩa Kiumia gĩa Gĩathĩ kĩa Bathaka; na kwarĩ ta thaa thita. Nake Pilato akĩĩra Ayahudi atĩrĩ, “Ũyũ mũthamaki wanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No-o makĩanĩrĩra, makiuga atĩrĩ, “Mweherie! Mweherie! Mwambithie mũtĩ-igũrũ!” Nake Pilato akĩmooria atĩrĩ, “Nyambithie Mũthamaki wanyu?” Nao athĩnjĩri-Ngai arĩa anene magĩcookia atĩrĩ, “Ithuĩ tũtirĩ mũthamaki ũngĩ tiga Kaisari.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthia-inĩ Pilato akĩmũneana kũrĩ o nĩguo akambwo mũtĩ-igũrũ. Jesũ Kwambwo Mũtĩ-Igũrũ Nacio thigari ikĩnyiita Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.16",
            "verseOrgIds": [
              "JHN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ekuuĩire mũtharaba wake agĩthiĩ nginya harĩa heetagwo “Ha Ihĩndĩ rĩa Mũtwe” (na no ho hetagwo na Kĩhibirania, Gologotha.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.17",
            "verseOrgIds": [
              "JHN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hau nĩho maamwambire, na hamwe nake makĩamba andũ angĩ eerĩ, ũmwe mwena ũmwe na ũcio ũngĩ mwena ũcio ũngĩ; nake Jesũ arĩ gatagatĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.18",
            "verseOrgIds": [
              "JHN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Pilato akĩandĩkithia kĩbaũ na gĩkĩhũũrĩrwo mũtharaba-inĩ. Nakĩo kĩandĩkĩtwo atĩrĩ, JESŨ WA NAZARETHI, MŨTHAMAKI WA AYAHUDI.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.19",
            "verseOrgIds": [
              "JHN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Ayahudi aingĩ magĩthoma maandĩko macio, nĩgũkorwo handũ harĩa Jesũ aambĩirwo haarĩ hakuhĩ na itũũra rĩu inene, nakĩo kĩbaũ kĩu kĩandĩkĩtwo na Kĩhibirania, na Kĩlatini, na Kĩyunani.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.20",
            "verseOrgIds": [
              "JHN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao athĩnjĩri-Ngai arĩa anene a Ayahudi makĩĩra Pilato atĩrĩ, “Tiga kwandĩka ‘Mũthamaki wa Ayahudi’, no andĩka atĩ mũndũ ũyũ nĩ kuuga oigire atĩ nĩwe mũthamaki wa Ayahudi.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.21",
            "verseOrgIds": [
              "JHN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Pilato akĩmacookeria atĩrĩ, “Ũguo ndandĩka nĩndandĩka.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa thigari ciarĩkirie kwamba Jesũ, ikĩoya nguo ciake, igĩcigayania maita mana, o mũndũ yake, no kanjũ yatigarire. Nguo ĩyo ndĩarĩ na rũtumo, yatumĩtwo kuuma igũrũ nginya thĩ ĩrĩ o taama ũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ikĩĩrana atĩrĩ, “Nĩtũtigei kũmĩtarũra; rekei tũmĩcuukĩre mĩtĩ nĩguo tũmenye ũrĩa ũgũthiĩ nayo.” Gwekĩkire ũguo nĩguo Maandĩko mahinge marĩa moigĩte atĩrĩ,Ũguo nĩguo thigari ciekire.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhĩ na mũtharaba wa Jesũ nĩho nyina aarũgamĩte, na mwarĩ wa nyina na nyina, na Mariamu mũtumia wa Kiliopa, na Mariamu Mũmagidali.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
            "verseOrgIds": [
              "JHN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Jesũ onire nyina na mũrutwo ũrĩa endete marũngiĩ hakuhĩ nake, akĩĩra nyina atĩrĩ, “Mũtumia ũyũ, ũcio mũrũguo,”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "agĩcooka akĩĩra mũrutwo ũcio atĩrĩ, “Ũcio maitũguo.” Kuuma hĩndĩ ĩyo mũrutwo ũcio akĩoya nyina wa Jesũ, agĩthiĩ gũtũũra mũciĩ kwa mũrutwo ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũkua kwa Jesũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha ũcio, Jesũ amenya atĩ maũndũ mothe nĩmathira, na nĩguo Maandĩko mahinge, akiuga atĩrĩ, “Nĩnyootiĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hau nĩ haarĩ na cuba yarĩ na thiki, nĩ ũndũ ũcio thigari igĩtobokia thibũnji ho, igĩcooka igĩthecerera thibũnji ĩyo rũthanju-inĩ rwa mũthobi, ikĩmĩtwarĩrĩria kanua-inĩ ka Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa Jesũ aamĩkundire, akiuga atĩrĩ, “Ũhoro nĩwathira.” Na oiga ũguo, akĩinamia mũtwe, agĩtuĩkana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, kwarĩ mũthenya wa Ihaarĩria wa Ayahudi, nĩguo marokere Thabatũ ya mwanya. Na tondũ Ayahudi matiendaga mĩĩrĩ ĩyo ĩtigwo mĩtharaba-inĩ hĩndĩ ya Thabatũ, makĩũria Pilato aathane atĩ andũ acio maambĩtwo moinwo magũrũ, na mĩĩrĩ yao ĩcuurũrio.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.31",
            "verseOrgIds": [
              "JHN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio thigari igĩthiĩ ikiuna magũrũ ma mũndũ wa mbere ũrĩa mambanĩirio na Jesũ na igĩcooka ikiuna ma ũcio ũngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.32",
            "verseOrgIds": [
              "JHN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩa maakinyire harĩ Jesũ na makĩona atĩ nĩarĩkĩtie gũkua, makĩaga kuuna magũrũ make.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.33",
            "verseOrgIds": [
              "JHN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Handũ ha ũguo-rĩ, mũthigari ũmwe agĩtheeca Jesũ mbaru na itimũ, na o rĩmwe hakiura thakame na maaĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũndũ ũrĩa wonire maũndũ macio nĩarutĩte ũira, naguo ũira wake nĩ wa ma. We nĩooĩ atĩ aaragia ũhoro wa ma, na oimbũraga nĩgeetha o na inyuĩ mwĩtĩkie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.35",
            "verseOrgIds": [
              "JHN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo maũndũ macio meekĩkire nĩgeetha Maandĩko mahinge marĩa moigĩte atĩrĩ, “Gũtirĩ ihĩndĩ o na rĩmwe rĩake rĩkoinwo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ningĩ no harĩ Maandĩko mangĩ moigĩte atĩrĩ, “Makeerorera mũndũ ũrĩa maathecire.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũthikwo kwa Jesũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha ũcio, Jusufu wa Arimathea akĩhooya Pilato mwĩrĩ wa Jesũ. Na rĩrĩ, Jusufu aarĩ mũrutwo wa Jesũ, no amũrũmagĩrĩra na hitho tondũ wa gwĩtigĩra Ayahudi. Nake Pilato akĩmũhe rũtha, nake agĩthiĩ agĩkuua mwĩrĩ ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maathiire na Nikodemo, ũrĩa wathiĩte kũrĩ Jesũ ũtukũ. Nikodemo agĩtwara mũtukanio wa manemane na thubiri ingĩkinya o ta ratiri mĩrongo mũgwanja na ithano.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao eerĩ makĩoya mwĩrĩ wa Jesũ, makĩwoha na mataama ma gatani hamwe na mĩtukanio ĩyo mĩnungi wega, kũringana na mĩtugo ya Ayahudi ya gũthikana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hau Jesũ aambĩirwo nĩ haarĩ na mũgũnda, na thĩinĩ wa mũgũnda ũcio nĩ kwarĩ na mbĩrĩra njerũ, ĩrĩa ĩtakoretwo ĩigĩtwo mwĩrĩ wa mũndũ o na ũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ kwarĩ mũthenya wa Ihaarĩria wa Ayahudi nĩguo marokere Thabatũ, na ningĩ nĩ ũndũ mbĩrĩra ĩyo yarĩ o hakuhĩ-rĩ, makĩiga Jesũ ho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
  ],
