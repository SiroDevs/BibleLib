          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũtũũrĩre wa Gũkenia Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo ũhoro wa kũrigĩrĩria, ariũ na aarĩ a Ithe witũ-rĩ, nĩ atĩ nĩtwamũrutire ũhoro wa mũtũũrĩre, ũrĩa ũkenagia Ngai, na noguo mũtũũraga mwĩkaga. Rĩu tũkũmũũria na tũkamũringĩrĩria thĩinĩ wa Mwathani Jesũ atĩ mũkĩragĩrĩrie gwĩkaga o ũguo.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nĩmũũĩ maũndũ marĩa twamũtaarire namo, tũrĩ na ũhoti wa Mwathani Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ rĩĩrĩ, ũndũ ũrĩa Ngai endete nĩ atĩ mũtuĩke andũ aamũre: atĩ mwĩtheemage ũmaraya;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atĩ o ũmwe wanyu amenye gwatha mwĩrĩ wake mwene ũikarage ũrĩ mũtheru na akĩũtĩĩaga,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "atarĩ na merirĩria ma mwĩrĩ ta andũ a ndũrĩrĩ arĩa matooĩ Ngai;",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na atĩ ha ũhoro wa maũndũ macio, gũtigakorwo mũndũ o na ũrĩkũ ũngĩhĩtĩria mũrũ na mwarĩ wa ithe, kana amwĩke ũũru. Mwathani nĩakaherithia andũ nĩ ũndũ wa mehia mothe ta macio, o ta ũrĩa tũrĩkĩtie kũmwĩra na tũkamũkaania.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ Ngai ndatwĩtĩire maũndũ ma waganu, no aatwĩtire nĩguo tũtũũre mũtũũrĩre wa ũtheru.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, mũndũ ũrĩa ũkũregana na ũrutani ũyũ ti mũndũ araregana nake no nĩ Ngai, ũrĩa ũmũheaga inyuĩ Roho wake Mũtheru.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩu-rĩ, harĩ ũhoro wa kwendana na ariũ na aarĩ a Ithe witũ-rĩ, tũtibataire kũmwandĩkĩra nĩ ũndũ inyuĩ ene nĩmũrutĩtwo kwendanaga nĩ Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ti-itherũ, nĩmwendete ariũ na aarĩ a Ithe witũ othe arĩa marĩ Makedonia guothe. No nĩtũkũmũringĩrĩria inyuĩ ariũ na aarĩ a Ithe witũ, atĩ mũkĩragĩrĩrie gwĩka ũguo makĩria.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atĩrĩrĩ, mwĩrirĩriei gũtũũra mũtũũrĩre wa ũhooreri, na mũhangʼagĩre o maũndũ marĩa mamũkoniĩ, na mũrutage wĩra na moko manyu, o ta ũrĩa twamwĩrire,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgeetha mũtũũrĩre wanyu wa o mũthenya, ũtũme mũheagwo gĩtĩĩo nĩ andũ arĩa matarĩ a thiritũ yanyu, na nĩgeetha mũtigatuĩke mũrigo kũrĩ mũndũ o na ũrĩkũ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũcooka kwa Mwathani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, ariũ na aarĩ a Ithe witũ, tũtikwenda mũikarage mũtooĩ ũhoro wa andũ arĩa makomete, kana mũigue kĩeha ta andũ arĩa angĩ matarĩ na kĩĩrĩgĩrĩro.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
            "verseOrgIds": [
              "1TH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtwĩtĩkĩtie atĩ Jesũ nĩakuire na akĩriũka, na nĩ ũndũ ũcio nĩtwĩtĩkĩtie atĩ Ngai nĩakarehanĩria Jesũ hamwe na andũ arĩa makomete marĩ thĩinĩ wake.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
            "verseOrgIds": [
              "1TH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũringana na kiugo kĩa Mwathani we mwene, tũkũmwĩra atĩ ithuĩ arĩa tũrĩ muoyo, arĩa tũtigĩtwo nginya rĩrĩa agacooka tũtigatongoria arĩa marĩkĩtie gũkoma.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha wa ũguo, ithuĩ arĩa tũgaakorwo tũrĩ muoyo na tũtigaire-rĩ, nĩtũkoyanĩrio hamwe nao tũtwarwo matu-inĩ nĩguo tũgacemanie na Mwathani rĩera-inĩ. Na nĩ ũndũ ũcio tũgaatũũrania na Mwathani nginya tene.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, ũmanagĩrĩriai mũndũ na ũrĩa ũngĩ na ciugo icio.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
  ],
