        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muoyo thĩinĩ wa Roho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ wa maũndũ macio-rĩ, andũ arĩa marĩ thĩinĩ wa Kristũ Jesũ o ti a kũherithio,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.1",
            "verseOrgIds": [
              "ROM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tondũ nĩ kũgerera harĩ Jesũ Kristũ watho wa Roho ũrĩa ũheaga muoyo wanjohorire kuuma kũrĩ wĩhia na gĩkuũ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.2",
            "verseOrgIds": [
              "ROM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo ũndũ ũrĩa watho wa Musa ũtangĩahotire gwĩka nĩ ũndũ wa kwagithio hinya nĩ mwĩrĩ ũyũ wĩhagia-rĩ, Ngai nĩekire ũndũ ũcio na ũndũ wa gũtũma Mũriũ wake mwene arĩ na mwĩrĩ ũhaanaine na mwĩrĩ ũyũ wĩhagia, nĩgeetha atuĩke igongona rĩa kũhoroheria mehia. Na nĩ ũndũ ũcio agĩtuĩra wĩhia ũrĩa warĩ thĩinĩ wa mũndũ ũrĩa wĩhagia ciira,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.3",
            "verseOrgIds": [
              "ROM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgeetha maũndũ ma ũthingu marĩa mathanĩtwo nĩ watho mahingio thĩinĩ witũ, ithuĩ arĩa tũtatũũraga kũringana na mwĩrĩ ũyũ wĩhagia, no tũtũũraga kũringana na Roho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.4",
            "verseOrgIds": [
              "ROM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ arĩa matũũraga kũringana na mwĩrĩ ũyũ wĩhagia meciiragia o maũndũ marĩa mwĩrĩ ũcio wendaga; no arĩa matũũraga kũringana na Roho meciiragia o maũndũ marĩa mendagwo nĩ Roho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.5",
            "verseOrgIds": [
              "ROM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meciiria ma mũndũ mwĩhia marehaga gĩkuũ, no meciiria marĩa maathagwo nĩ Roho marehaga muoyo na thayũ;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.6",
            "verseOrgIds": [
              "ROM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "meciiria marĩa mehagia marĩ ũthũ na Ngai. Meciiria macio matiathĩkagĩra watho wa Ngai, o na matingĩhota gwĩka ũguo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.7",
            "verseOrgIds": [
              "ROM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ arĩa maathagwo nĩ mwĩrĩ ũyũ wĩhagia matingĩhota gũkenia Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.8",
            "verseOrgIds": [
              "ROM.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, inyuĩ mũtiathagwo nĩ mwĩrĩ ũyũ wĩhagia, no mwathagwo nĩ Roho, angĩkorwo Roho wa Ngai atũũraga thĩinĩ wanyu. No rĩrĩ, mũndũ o wothe ũtarĩ na Roho wa Kristũ-rĩ, ũcio ti wa Kristũ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.9",
            "verseOrgIds": [
              "ROM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No angĩkorwo Kristũ arĩ thĩinĩ wanyu-rĩ, mĩĩrĩ yanyu nĩmĩkuũ nĩ ũndũ wa mehia, no maroho manyu marĩ muoyo nĩ ũndũ wa ũthingu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.10",
            "verseOrgIds": [
              "ROM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ningĩ angĩkorwo Roho wa Ngai ũrĩa wariũkirie Jesũ kuuma kũrĩ arĩa akuũ atũũraga thĩinĩ wanyu-rĩ, o we ũcio wariũkirie Kristũ kuuma kũrĩ arĩa akuũ nĩagatũma mĩĩrĩ ĩyo yanyu ĩkuaga ĩgĩe na muoyo nĩ ũndũ wa Roho wake, ũcio ũtũũraga thĩinĩ wanyu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.11",
            "verseOrgIds": [
              "ROM.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, ariũ na aarĩ a Ithe witũ, ithuĩ tũrĩ na thiirĩ, no ti thiirĩ kũrĩ mwĩrĩ ũyũ wĩhagia, atĩ nĩguo tũtũũrage kũringana na ũrĩa wendaga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.12",
            "verseOrgIds": [
              "ROM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo mũngĩtũũra kũringana na ũrĩa mwĩrĩ ũyũ wĩhagia wendaga-rĩ, nĩmũgakua, no mũngĩũraga ciĩko icio njũru cia mwĩrĩ na hinya wa Roho-rĩ, nĩmũgatũũra muoyo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.13",
            "verseOrgIds": [
              "ROM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tondũ andũ arĩa othe matongoragio nĩ Roho wa Ngai acio nĩo ciana cia Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.14",
            "verseOrgIds": [
              "ROM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo mũtiaheirwo roho wa kũmũtua ngombo rĩngĩ nĩguo mwĩtigagĩre, no mwaheirwo Roho wa kũmũtua ciana ciake cia kwĩrererwo. Na nĩguo ũtũmaga twanĩrĩre tũkoiga atĩrĩ, “Abba, Baba.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.15",
            "verseOrgIds": [
              "ROM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho Mũtheru we mwene nĩwe mũira hamwe na maroho maitũ atĩ ithuĩ tũrĩ ciana cia Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.16",
            "verseOrgIds": [
              "ROM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩu-rĩ, angĩkorwo tũrĩ ciana ciake-rĩ, tũkĩrĩ agai, tũgatuĩka o agai a kũgaya Ngai, na agai hamwe na Kristũ, angĩkorwo ti-itherũ nĩtũgwatanagĩra nake mĩnyamaro yake nĩguo tũkaahota kũgwatanĩra riiri wake o naguo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.17",
            "verseOrgIds": [
              "ROM.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riiri ũrĩa Ũgooka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguona atĩ mĩnyamaro ĩrĩa tũrĩ nayo rĩu ndĩngĩringithanio na riiri ũrĩa tũkaaguũrĩrio.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.18",
            "verseOrgIds": [
              "ROM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indo iria ciombirwo itũũraga cietereire kũguũranĩrio gwa ciana cia Ngai irĩ na gũthethũka kũnene.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.19",
            "verseOrgIds": [
              "ROM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo ciũmbe icio ciathĩrĩirio itũũre itarĩ kĩene na ti ũndũ wa gwĩthuurĩra cio nyene, no nĩ ũndũ wa kwenda kwa ũrĩa waciathĩrĩirie itũũre irĩ na kĩĩrĩgĩrĩro,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.20",
            "verseOrgIds": [
              "ROM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "atĩ ciũmbe cio nyene nĩigakũũrwo kuuma ũkombo-inĩ wa kũbutha, ikinye wĩyathi-inĩ wa riiri wa ciana cia Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.21",
            "verseOrgIds": [
              "ROM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtũũĩ atĩ nginyagia rĩu ciũmbe icio ciothe itũire icaayaga irĩ na ruo ta rwa mũndũ-wa-nja akĩheo mwana.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.22",
            "verseOrgIds": [
              "ROM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na to indo icio icaayaga, no o na ithuĩ arĩa tũrĩ na maciaro ma mbere ma Roho, nĩtũcaayaga ngoro-inĩ ciitũ thĩinĩ, twetereire hĩndĩ ĩkinye ya gũtuuo ciana cia Ngai, na nĩkuo gũkũũrwo kwa mĩĩrĩ iitũ kuuma ũkombo-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.23",
            "verseOrgIds": [
              "ROM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo twahonokirio nĩ ũndũ wa kĩĩrĩgĩrĩro kĩu. No rĩrĩ, kwĩrĩgĩrĩra kĩndũ kĩoneku-rĩ, kĩu ti kĩĩrĩgĩrĩro kũrĩ. Nũũ wĩrĩgagĩrĩra kĩrĩa arĩ nakĩo?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.24",
            "verseOrgIds": [
              "ROM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, tũngĩkorwo twĩrĩgĩrĩire kĩrĩa tũtarĩ nakĩo-rĩ, tũgĩetagĩrĩra o tũkirĩrĩirie.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.25",
            "verseOrgIds": [
              "ROM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ũndũ ũmwe, Roho nake nĩatũteithagia nĩ ũndũ wa ũrĩa tũtarĩ hinya. Ithuĩ tũtiũĩ kĩrĩa twagĩrĩirwo nĩkũhooya, no Roho we mwene nĩatũthaithanagĩrĩra arĩ na mũcaayo ũtangĩgweteka na ciugo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.26",
            "verseOrgIds": [
              "ROM.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai ũrĩa ũthuthuuragia ngoro ciitũ nĩoĩ meciiria ma Roho, tondũ Roho nĩwe ũthaithanagĩrĩra andũ arĩa aamũre kũringana na ũrĩa Ngai endete.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.27",
            "verseOrgIds": [
              "ROM.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andũ a Ngai Nĩatoorania",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ nĩtũũĩ atĩ harĩ andũ arĩa mendete Ngai, o arĩa metĩtwo nĩwe kũringana na ũrĩa aathugundĩte-rĩ, maũndũ mothe mateithanagia hamwe mamarehere kĩrathimo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.28",
            "verseOrgIds": [
              "ROM.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo acio Ngai aamenyete o tene-rĩ, nĩo aathĩrĩirie matuĩke a kũhaananio na mũhianĩre wa Mũrũwe, nĩguo atuĩke irigithathi harĩ andũ aingĩ a Ithe ũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.29",
            "verseOrgIds": [
              "ROM.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao acio aathĩrĩirie o mbere, nĩo eetire; nao acio eetire, nĩo aatuire athingu; nao acio aatuire athingu, nĩo aahumbire riiri.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.30",
            "verseOrgIds": [
              "ROM.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũkiuge atĩa ũhoro ũkoniĩ maũndũ macio? Angĩkorwo Ngai arĩ mwena witũ-rĩ, nũũ ũngĩkĩhota gũtũtuma ũthũ?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.31",
            "verseOrgIds": [
              "ROM.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũcio ũtaigana gũcaĩra Mũriũ wake mwene, no akĩmũneana nĩ ũndũ witũ ithuothe, na rĩrĩ, agĩtũheete ũcio-rĩ, angĩkĩrega atĩa gũtũtaanahĩra na indo iria ingĩ ciothe?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.32",
            "verseOrgIds": [
              "ROM.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũngĩona ũndũ wa gũthitangĩra andũ arĩa Ngai ethuurĩire? Nĩ Ngai ũmatuĩte atĩ matirĩ na mahĩtia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.33",
            "verseOrgIds": [
              "ROM.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũngĩhota kũmatua ehia? Gũtirĩ! Kristũ Jesũ, o we ũrĩa wakuire, na akĩriũka akiuma kũrĩ arĩa akuũ, nĩwe ũikarĩte guoko-inĩ kwa ũrĩo kwa Ngai agĩtũthaithanĩrĩra.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.34",
            "verseOrgIds": [
              "ROM.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ROM 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũngĩtũtigithania na wendani wa Kristũ? Anga nĩ kuona thĩĩna, kana kwĩhĩrwo nĩ ruo, kana nĩkũnyariirwo, kana ngʼaragu, kana kwaga nguo, kana ũgwati, o na kana rũhiũ rwa njora?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.35",
            "verseOrgIds": [
              "ROM.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ROM 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ũrĩa kwandĩkĩtwo atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.36",
            "verseOrgIds": [
              "ROM.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ROM 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, o na tũkĩonaga maũndũ macio mothe-rĩ, ithuĩ tũrĩ makĩria ma atooria nĩ ũndũ wa ũcio watwendire.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.37",
            "verseOrgIds": [
              "ROM.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ROM 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nĩndĩkĩtie kũmenya kũna atĩ o na kũngĩtuĩka nĩ ũhoro wa gũkua kana gũtũũra muoyo, o na kana araika kana ndaimono, o na kana ũhoro wa mahinda maya kana marĩa magooka, o na kana maahinya o na marĩkũ,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.38",
            "verseOrgIds": [
              "ROM.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ROM 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na kana ũraihu wa na igũrũ kana ũriku, o na kana kĩndũ kĩngĩ o gĩothe kĩa iria ciombirwo: gũtirĩ o na kĩmwe kĩngĩhota gũtũtigithania na wendani wa Ngai, ũcio ũrĩ thĩinĩ wa Kristũ Jesũ, Mwathani witũ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.8.39",
            "verseOrgIds": [
              "ROM.8.39"
            ]
          }
        }
      ]
    }
  ],
