  "bookId": "ROM",
  "reference": "Aroma 6",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ROM 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũtũũra Muoyo thĩinĩ wa Kristũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakĩrĩ ũguo-rĩ, tũkiuge atĩa? Nĩ tũtũũre o twĩhagia nĩgeetha wega wa Ngai ũingĩhage?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.1",
            "verseOrgIds": [
              "ROM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩ! Kũroaga gũtuĩka ũguo! Ithuĩ-rĩ, nĩtwakuire ũhoro-inĩ wa wĩhia; twakĩhota atĩa gũcooka gũtũũra thĩinĩ waguo?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.2",
            "verseOrgIds": [
              "ROM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaĩ inyuĩ mũtooĩ atĩ ithuĩ othe arĩa twabatithirio thĩinĩ wa Kristũ Jesũ twabatithirio thĩinĩ wa gĩkuũ gĩake?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.3",
            "verseOrgIds": [
              "ROM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, twabatithio nĩgũthikwo twathikirwo hamwe nake gĩkuũ-inĩ gĩake, nĩgeetha o ta ũrĩa Kristũ aariũkirio kuuma kũrĩ arĩa akuũ nĩ hinya wa riiri wa Ithe, o na ithuĩ tũtũũre na mũtũũrĩre mwerũ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.4",
            "verseOrgIds": [
              "ROM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo nĩtũnyiitithanĩtio nake ũguo thĩinĩ wa gĩkuũ gĩake-rĩ, hatirĩ nganja nĩtũkanyiitithanio nake thĩinĩ wa kũriũka gwake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.5",
            "verseOrgIds": [
              "ROM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nĩtũũĩ atĩ mũndũ witũ wa tene nĩambirwo hamwe nake nĩgeetha mwĩrĩ ũyũ wa mehia weherio, nĩguo tũtikanacooke gũtuĩka ngombo cia mehia,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.6",
            "verseOrgIds": [
              "ROM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tondũ mũndũ o wothe ũrĩa ũrĩkĩtie gũkua nĩatigithanĩtio na mehia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.7",
            "verseOrgIds": [
              "ROM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, angĩkorwo nĩtwakuire hamwe na Kristũ-rĩ, nĩtwĩtĩkĩtie atĩ nĩtũgatũũra muoyo hamwe nake.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.8",
            "verseOrgIds": [
              "ROM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nĩtũũĩ atĩ tondũ Kristũ nĩariũkirio akiuma kũrĩ arĩa akuũ-rĩ, ndarĩ hĩndĩ agaacooka gũkua; gĩkuũ gĩtirĩ na hinya wa kũmwatha rĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.9",
            "verseOrgIds": [
              "ROM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩkuũ kĩrĩa aakuire, aakuĩrĩire ũhoro wa mehia o riita rĩmwe rĩa kũigana; no muoyo ũrĩa atũũraga-rĩ, atũũraga nĩ ũndũ wa riiri wa Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.10",
            "verseOrgIds": [
              "ROM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na inyuĩ, o ũndũ ũmwe mwĩonagei atĩ nĩmũkuĩte ũhoro-inĩ wa mehia, na atĩ mũtũũraga muoyo mũrĩ ngwatanĩro na Ngai thĩinĩ wa Kristũ Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.11",
            "verseOrgIds": [
              "ROM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ ũcio, mũtikanareke mehia mathamakage thĩinĩ wa mĩĩrĩ yanyu ĩyo ĩkuaga, atĩ nĩguo mwathĩkagĩre merirĩria mooru mayo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.12",
            "verseOrgIds": [
              "ROM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũtikananeane ciĩga cia mĩĩrĩ yanyu mehia-inĩ, atĩ nĩguo ituĩke ta indo cia kũhũthĩrwo cia kwagana nacio, no nĩ kaba mwĩheanage kũrĩ Ngai, mũhaana ta andũ marutĩtwo gĩkuũ-inĩ makarehwo muoyo-inĩ na mũneanage ciĩga icio cia mĩĩrĩ yanyu kũrĩ we nĩguo ituĩke ta indo cia kũhũthĩrwo na gwĩka maũndũ ma ũthingu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.13",
            "verseOrgIds": [
              "ROM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtigatuĩke a gwathagwo nĩ mehia, tondũ inyuĩ mũtirĩ agũthamakagĩrwo nĩ watho, no mũrĩ agũthamakagĩrwo nĩ wega wa Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.14",
            "verseOrgIds": [
              "ROM.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngombo cia Ũthingu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũkiuge atĩa? Kuona atĩ tũtirĩ rungu rwa watho no tũrĩ rungu rwa wega wa Ngai-rĩ, nĩtũtũũre twĩhagia? Kũroaga gũtuĩka ũguo!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
            "verseOrgIds": [
              "ROM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaĩ inyuĩ mũtooĩ atĩ rĩrĩa mweheana kũrĩ mũndũ nĩguo mũtuĩke ngombo mũmwathĩkagĩre-rĩ, inyuĩ mũkĩrĩ o ngombo cia ũcio mwathĩkagĩra: mũrĩ ngombo cia mehia marĩa merekagĩria mũndũ gĩkuũ-inĩ, kana mũrĩ ngombo cia wathĩki ũrĩa ũrehaga ũthingu?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.16",
            "verseOrgIds": [
              "ROM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Ngai arocookerio ngaatho, tondũ o na gũtuĩka inyuĩ mwarĩ ngombo cia mehia-rĩ, rĩu nĩmwathĩkĩire na ngoro yothe ũrutani ũrĩa mwehokeirwo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuĩ nĩmũrĩkĩtie kuohorwo mũkoima mehia-inĩ, mũgacooka gũtuĩka ngombo cia ũthingu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.18",
            "verseOrgIds": [
              "ROM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndĩraaria ũhoro ũyũ ngĩũgerekanagia na maũndũ ma andũ tondũ inyuĩ nĩmwagĩte hinya mũtũũrĩre-inĩ wanyu wa ndũire. O ta ũrĩa mwatũire mũneanaga ciĩga cianyu cia mĩĩrĩ ituĩke ngombo kũrĩ maũndũ marĩa matarĩ ma ũtheru o na ma waganu ũrĩa ũtũire wongererekaga-rĩ, rĩu kĩneanei ciĩga cianyu ituĩke ngombo cia ũthingu nĩguo mũgaatuĩka andũ atheru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.19",
            "verseOrgIds": [
              "ROM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa mwarĩ ngombo cia mehia-rĩ, mũtiathagwo nĩ ũthingu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.20",
            "verseOrgIds": [
              "ROM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo muonaga uumithio ũrĩkũ kuuma kũrĩ maũndũ marĩa matũmaga rĩu mũconoke? Maũndũ macio marigĩrĩrio-inĩ marehaga gĩkuũ!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.21",
            "verseOrgIds": [
              "ROM.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩu tondũ nĩmwohoretwo mũkoima mehia-inĩ na mũgatuĩka ngombo cia Ngai-rĩ, uumithio ũrĩa muonaga ũmwerekagĩria ũtheru-inĩ, na maciaro maguo nĩ muoyo wa tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.22",
            "verseOrgIds": [
              "ROM.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo mũcaara wa mehia nĩ gĩkuũ, no kĩheo kĩrĩa Ngai aheanaga nĩ muoyo wa tene na tene thĩinĩ wa Kristũ Jesũ Mwathani witũ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.23",
            "verseOrgIds": [
              "ROM.6.23"
            ]
          }
        }
      ]
    }
  ],
