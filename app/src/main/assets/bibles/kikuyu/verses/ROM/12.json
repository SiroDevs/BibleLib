{
  "id": "ROM.12",
  "number": "12",
  "bookId": "ROM",
  "reference": "Aroma 12",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
