        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hema ĩrĩa Nyamũre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Thondeka hema nyamũre ĩrĩ na itambaya ikũmi cia gũcuurio itumĩtwo na gatani yogothetwo wega ya ndigi cia rangi wa bururu, na cia rangi wa ndathi, na cia rangi mũtune ta gakarakũ, na igemio na makerubi nĩ mũtumi mũũgĩ na wĩra ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itambaya icio cia gũcuurio ciothe ikorwo ciiganaine, mĩkono mĩrongo ĩĩrĩ na ĩnanakũraiha na mĩkono ĩnakwarama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itambaya ithano-rĩ, itumanio hamwe, na icio ingĩ ithano itumanio hamwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundĩka ciana cia gĩtambaya kĩa rangi wa bururu mũthia-inĩ wa gĩtambaya gĩa gũcuurio kĩrĩa kĩrĩ mũico wa mwena ũmwe, na wĩke o ro ũguo harĩ gĩtambaya kĩa mũico kĩa mwena ũcio ũngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundĩka ciana mĩrongo ĩtano gĩtambaya-inĩ kĩmwe gĩa gũcuurio, na ingĩ mĩrongo ĩtano gĩtambaya-inĩ kĩa mũico kĩa mwena ũcio ũngĩ, na ũringithanie o kĩana na kĩrĩa kĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ ũthondeke ngathĩka mĩrongo ĩtano cia thahabu, na ũcihũthĩre na kuohithania itambaya icio cia gũcuurio nĩguo hema ĩyo nyamũre ĩtuĩke kĩndũ kĩmwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tuma itambaya ikũmi na kĩmwe cia guoya wa mbũri ituĩke hema ya kũhumbĩra hema ĩrĩa nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itambaya icio ciothe ikũmi na kĩmwe ikorwo ciiganaine, ikorwo irĩ mĩkono mĩrongo ĩtatũkũraiha na mĩkono ĩnakwarama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumania itambaya ithano cia icio cia gũcuurio ituĩke kĩndũ kĩmwe, nacio icio ingĩ ithathatũ itumanio hamwe. Kũnja gĩtambaya gĩa gatandatũ maita meerĩ mwena wa mbere wa hema.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundĩka ciana mĩrongo ĩtano mũthia-inĩ wa itambaya cia gũcuurio cia mwena ũmwe, ningĩ wĩke o ũguo mũthia-inĩ wa itambaya icio cia mwena ũrĩa ũngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ ũthondeke ngathĩka mĩrongo ĩtano cia gĩcango, na ũcitoonyie ciana-inĩ nĩgeetha hema ĩyo ĩtuĩke kĩndũ kĩmwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harĩ ũraihu wa gĩtambaya gĩa gũcuurio ũrĩa ũngĩtigara, nuthu ya gĩtambaya kĩrĩa gĩtigaire nĩ gĩcunjuure mwena wa thuutha wa hema ĩyo nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itambaya cia gũcuurio cia hema ikorwo iraihĩte kũrĩ icio ingĩ na mũkono ũmwemĩena yeerĩ; kĩrĩa gĩgũtigara gĩcunjuure kĩhumbĩre mĩena ya hema ĩyo nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thondekera hema ĩyo kĩandarũa kĩa njũa cia ndũrũme itoboketio rangi-inĩ mũtune igatunĩha, na igũrũ wakĩo ũkĩhumbĩre na njũa cia pomboo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Thondeka mbaũ cia kũrũgama cia mũtĩ wa mũgaa cia gwaka hema ĩyo nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rũbaũ-inĩ rũkorwo rũrĩ rwa mĩkono ikũmikũraiha na mũkono ũmwe na nuthukwarama,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbaũ icio igĩe na tũhocio tũcomokete tũigananĩirie. Thondeka mbaũ icio ciothe cia Hema-ĩrĩa-Nyamũre na njĩra ĩyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thondeka mbaũ mĩrongo ĩĩrĩ cia mwena wa gũthini wa hema ĩyo nyamũre,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũthondeke itina cia betha mĩrongo ĩna cia gũikarĩrwo nĩ mbaũ icio mĩrongo ĩĩrĩ, o rũbaũ rũmwe rũgaikarĩra itina igĩrĩ, o rũmwe rũkorwo rũrĩ rungu rwa kahocio.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mwena ũcio ũngĩ, mwena wa gathigathini wa hema ĩyo nyamũre, thondeka mbaũ mĩrongo ĩĩrĩ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na itina mĩrongo ĩna cia betha o igĩrĩ igaikarĩrwo nĩ rũbaũ rũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thondeka mbaũ ithathatũ cia mwena wa na thuutha, nĩguo mwena wa mũthia wa ithũĩro wa hema ĩyo nyamũre,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũthondeke mbaũ igĩrĩ cia koine cia mwena wa na thuutha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koine-inĩ icio cierĩ no nginya ikorwo irĩ mbaũ igĩrĩ igĩrĩ kuuma thĩ nginya igũrũ, na ciohanio na mũrĩnga ũmwe; koine cierĩ igakorwo itariĩ ũguo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio hegũkorwo na mbaũ inyanya, na itina ikũmi na ithathatũ cia betha, o igĩrĩ igaikarĩrwo nĩ rũbaũ rũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ningĩ ũthondeke mĩgamba ya mbaũ cia mũgaa: ĩtano yayo nĩ ũndũ wa mbaũ cia mwena ũmwe wa hema ĩyo nyamũre,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ĩtano nĩ ũndũ wa mbaũ cia mwena ũcio ũngĩ, na ĩtano nĩ ũndũ wa mbaũ cia mwena wa ithũĩro mũthia-inĩ ũrĩa wa na thuutha wa hema ĩyo nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũgamba wa gatagatĩ uume mũthia ũmwe nginya ũrĩa ũngĩ, ũgereire gatagatĩ ka mbaũ icio.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gemia mbaũ icio na thahabu, na ũthondeke mĩrĩnga ya thahabu ya kũnyiitĩrĩra mĩgamba ĩyo. O nayo mĩgamba ĩyo nĩĩgemio na thahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aka hema ĩyo nyamũre kũringana na mũhianĩre ũrĩa wonirio rĩrĩa warĩ kĩrĩma-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
            "verseOrgIds": [
              "EXO.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tuma gĩtambaya gĩa gũcuurio kĩa ndigi cia rangi wa bururu, na cia rangi wa ndathi na cia rangi mũtune ta gakarakũ, na cia gatani ĩrĩa yogothetwo wega na ĩkagemio na makerubi nĩ mũbundi mũũgĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuuria gĩtambaya kĩu na tũcuurio twa thahabu ikĩngĩ-inĩ inya cia mũgaa iria igemetio na thahabu, na ikarũgama igũrũ rĩa njikarĩro inya cia betha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuuria gĩtambaya kĩu gĩa gũcuurio na ngathĩka, na ũcooke ũige ithandũkũ rĩa Ũira thuutha wa gĩtambaya kĩu gĩa gũcuurio. Gĩtambaya kĩu gĩa gũcuurio kĩhakanie Handũ-harĩa-Hatheru na Handũ-harĩa-Hatheru-Mũno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igĩrĩra gĩtĩ gĩa tha igũrũ rĩa ithandũkũ rĩa Ũira thĩinĩ wa Handũ-harĩa-Hatheru-Mũno.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iga metha nja ya gĩtambaya kĩu gĩa gũcuurio mwena wa gathigathini wa hema ĩyo nyamũre, naguo mũtĩ wa kũigĩrĩra matawa ũũige mwena wa gũthini ũngʼethanĩre na metha ĩyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Itoonyero-inĩ rĩa hema, thondeka gĩtambaya gĩa gũcuurio kĩa rangi wa bururu, na rangi wa ndathi, na rangi mũtune ta gakarakũ, na gatani ĩrĩa yogothetwo wega, kĩgemetio nĩ mũgemia mũũgĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thondekera gĩtambaya kĩu gĩa gũcuurio tũcuurio twa thahabu na itugĩ ithano cia mũgaa igemetio na thahabu. Na ũcitwekerie itina ithano cia gĩcango.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
              "EXO.26.37"
            ]
          }
        }
      ]
    }
