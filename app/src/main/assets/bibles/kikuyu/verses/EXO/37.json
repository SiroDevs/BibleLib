{
  "id": "EXO.37",
  "number": "37",
  "bookId": "EXO",
  "reference": "Thaama 37",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "EXO 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ithandũkũ rĩa Kĩrĩkanĩro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezaleli nĩathondekire ithandũkũ rĩa kĩrĩkanĩro rĩa mbaũ cia mũgaa, mũigana wa mĩkono ĩĩrĩkũraiha, na mũkono ũmwe na nuthukwarama, na mũkono ũmwe na nuthu kũraiha na igũrũ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩrĩgemia na thahabu therie thĩinĩ na nja, na akĩrĩtiriha na mũcibi wa thahabu mĩena yothe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.2",
            "verseOrgIds": [
              "EXO.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩarĩtwekeirie icũhĩ inya cia thahabu na agĩciohania na magũrũ marĩo mana, o icũhĩ igĩrĩ mwena ũmwe na icũhĩ igĩrĩ mwena ũrĩa ũngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.3",
            "verseOrgIds": [
              "EXO.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ agĩthondeka mĩtĩ mĩraaya ya mũgaa na akĩmĩgemia na thahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.4",
            "verseOrgIds": [
              "EXO.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agĩcooka agĩtoonyia mĩtĩ ĩyo mĩraaya mĩrĩnga-inĩ ĩyo yarĩ mĩena-inĩ ya ithandũkũ ĩrĩ ya kũrĩkuua.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.5",
            "verseOrgIds": [
              "EXO.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩarĩthondekeire gĩtĩ gĩa tha gĩa thahabu, therie kĩa ũraihu wa mĩkono ĩrĩ na nuthu,na wariĩ wa mũkono ũmwe na nuthu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agĩcooka agĩtura makerubi meerĩ ma thahabu akĩmekĩra mĩthia-inĩ ya gĩtĩ kĩu gĩa tha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩathondekire ikerubi rĩmwe rĩikare mũthia-inĩ ũmwe na ikerubi rĩu rĩngĩ rĩikare mũthia-inĩ ũrĩa ũngĩ; mĩthia-inĩ ĩyo yeerĩ akĩmathondeka marĩ kĩndũ kĩmwe na gĩtĩ gĩa tha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mathagu ma makerubi macio matambũrũkĩtio na igũrũ, magathiĩka gĩtĩ kĩu gĩa tha. Makerubi macio maathondeketwo maroranĩte, na marorete gĩtĩ kĩu gĩa tha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Metha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmathondekire metha ya mbaũ cia mũgaa, ũraihu wayo warĩ mĩkono ĩĩrĩ,na wariĩ wayo warĩ mũkono ũmwe,na kũraiha na igũrũ kwayo kwarĩ mũkono ũmwe na nuthu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
            "verseOrgIds": [
              "EXO.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ makĩmĩgemia na thahabu therie, na makĩmĩtiriha na mũcibi wa thahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.11",
            "verseOrgIds": [
              "EXO.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩcooka makĩmĩthondekera karũbaũ gaceke ka wariĩ wa rũhĩ,gagĩthiũrũrũkĩria metha ĩyo, na magĩgatiriha na mũcibi wa thahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.12",
            "verseOrgIds": [
              "EXO.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩtwekeria metha ĩyo mĩrĩnga ĩna ya thahabu, na makĩmĩoherera koine-inĩ inya ciayo, o harĩa magũrũ mayo mana maarĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.13",
            "verseOrgIds": [
              "EXO.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icũhĩ icio ciekĩrirwo hakuhĩ na mũcibi wa karũbaũ karĩa gaceke, nĩgeetha ĩnyiitagĩrĩre mĩtĩ ĩrĩa mĩraaya yahũthagĩrwo gũkuua metha ĩyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.14",
            "verseOrgIds": [
              "EXO.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩtĩ ĩyo mĩraaya ya gũkuua metha yarĩ ya mbaũ cia mũgaa, na ĩkagemio na thahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.15",
            "verseOrgIds": [
              "EXO.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ magĩthondeka indo cia thahabu therie, cia kũigagĩrĩrwo metha, na nacio nĩ: thaani, na thaani nene, na mbakũri, na ndigithũ cia gũitaga iruta rĩa kũnyuuo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũtĩ wa Kũigĩrĩrwo Matawa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmathondekire mũtĩ wa kũigĩrĩrwo matawa wa thahabu therie. Mũrũgamo waguo na gĩtina kĩaguo igĩturwo inyiitanĩte o hamwe na ikombe ciaguo na mahũa maguo, na tũkonyo twaguo; ciothe igĩkorwo irĩ kĩndũ kĩmwe naguo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtĩ ũcio warĩ na honge ithathatũ ciumĩte mĩena-inĩ ya mũrũgamo wa mũtĩ ũcio wa kũigĩrĩrwo matawa; ithatũ mwena ũmwe, na ithatũ mwena ũrĩa ũngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikombe ithatũ ciaturĩtwo ihaana ta mahũa ma mũrothi, irĩ na tũkonyo na mahũa, igakorwo rũhonge-inĩ rũmwe, nacio ithatũ igakorwo rũhonge-inĩ rũu rũngĩ; honge icio ciothe ithathatũ ciahaanaga ũguo ciumĩte mũtĩ-inĩ ũcio wa kũigĩrĩrwo matawa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũtĩ-inĩ ũcio wa kũigĩrĩrwo matawa haarĩ na ikombe inya ciathondeketwo ihaana ta mahũa ma mũrothi, irĩ na tũkonyo na mahũa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakonyo kamwe kaarĩ rungu rwa honge igĩrĩ ciumĩte mũrũgamo-inĩ wa mũtĩ ũcio wa kũigĩrĩrwo matawa, nako gakonyo ga keerĩ kaarĩ rungu rwa honge cia keerĩ igĩrĩ, na gakonyo ga gatatũ kaarĩ rungu rwa honge cia gatatũ igĩrĩ; ciothe ciarĩ honge ithathatũ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tũkonyo na honge ciarĩ kĩndũ kĩmwe na mũtĩ ũcio wa kũigĩrĩrwo matawa, iturĩtwo kuuma thahabu therie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmathondekire matawa mũgwanja maguo, o ũndũ ũmwe na magathĩ ma gũtinia ndaambĩ, na thaani cia mũrarĩ wa ndaambĩ, cia thahabu therie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maahũthĩrire taranda ĩmweya thahabu therie gũthondeka mũtĩ ũcio wa kũigĩrĩrwo matawa na indo ciaguo ciothe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kĩgongona kĩa Ũbumba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩmathondekire kĩgongona gĩa gũcinĩra ũbumba na mbaũ cia mũgaa. Kĩaiganaine mĩena yothe, mũigana wa mũkono ũmwekũraiha, na mũkono ũmwe kwarama, na mĩkono ĩĩrĩkũraiha na igũrũ. Hĩa ciakĩo ciarĩ kĩndũ kĩmwe na kĩgongona.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.25",
            "verseOrgIds": [
              "EXO.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩkĩgemia igũrũ na mĩena yothe o na hĩa ciakĩo na thahabu therie na magĩgĩtiriha na mũcibi wa thahabu ũgĩgĩthiũrũrũkĩria.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.26",
            "verseOrgIds": [
              "EXO.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magĩthondeka mĩrĩnga ĩĩrĩ ya thahabu mũhuro wa mũcibi ũcio, ĩĩrĩ mwena ũmwe na ĩĩrĩ mwena ũrĩa ũngĩ. Mĩrĩnga ĩyo nĩyo yatoonyagio mĩtĩ ĩrĩa mĩraihu yatũmagĩrwo gũgĩkuua.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.27",
            "verseOrgIds": [
              "EXO.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
