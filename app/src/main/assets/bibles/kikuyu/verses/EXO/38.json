          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcango kĩrĩa kĩarutĩtwo kuuma iruta rĩa gũthũngũthio kĩarĩ gĩa taranda 70 na cekeri 2,400.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
