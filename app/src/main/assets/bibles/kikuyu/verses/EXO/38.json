            "number": "30",
            "style": "v",
            "sid": "EXO 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maahũthĩrire gĩcango kĩu na gũthondeka itina cia itoonyero rĩa Hema-ya-Gũtũnganwo, na gwaka kĩgongona gĩa gĩcango hamwe na kĩrũtara gĩakĩo gĩa gĩcango na indo ciakĩo ciothe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
