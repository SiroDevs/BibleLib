  "bookId": "EXO",
  "reference": "Thaama 9",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EXO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũthiro wa Kũniina Ũhiũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ, “Thiĩ kũrĩ Firaũni ũkamwĩre atĩrĩ, ‘Jehova, o we Ngai wa Ahibirania ekuuga ũũ: “Rekereria andũ akwa mathiĩ, nĩgeetha makandungatĩre.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.1",
            "verseOrgIds": [
              "EXO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũngĩrega kũmarekereria, na ũthiĩ na mbere kũmarigĩrĩria-rĩ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.2",
            "verseOrgIds": [
              "EXO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "guoko kwa Jehova nĩgũkũrehithĩria ũhiũ waku ũrĩa ũrĩ ũrĩithio-inĩ mũthiro mũũru mũno kũrĩ mbarathi cianyu na ndigiri, na ngamĩĩra, na ngʼombe cianyu, na ngʼondu na mbũri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.3",
            "verseOrgIds": [
              "EXO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Jehova nĩagekĩra ngũũrani gatagatĩ ka ũhiũ wa andũ a Isiraeli na andũ a Misiri, nĩgeetha gũtikagĩe nyamũ ya Mũisiraeli ĩgũkua.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.4",
            "verseOrgIds": [
              "EXO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova agĩtua ihinda, na akiuga atĩrĩ, “Rũciũ Jehova nĩageeka ũndũ ũyũ gũkũ bũrũri-inĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.5",
            "verseOrgIds": [
              "EXO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũthenya ũyũ ũngĩ Jehova agĩgĩka o ũguo: Ũhiũ wothe wa andũ a Misiri ũgĩkua, no gũtirĩ nyamũ o na ĩmwe ya Mũisiraeli yakuire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.6",
            "verseOrgIds": [
              "EXO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firaũni agĩtũma andũ magatuĩrie ũhoro, nao makĩona atĩ gũtiarĩ nyamũ o na ĩmwe ya andũ a Isiraeli yakuĩte. No rĩrĩ, ngoro yake ndĩororoire na ndaigana kũrekereria andũ mathiĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.7",
            "verseOrgIds": [
              "EXO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũthiro wa Mahũha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa na Harũni atĩrĩ, “Oyai ngundi cia mbiro kuuma riiko rĩrĩa inene, nake Musa amĩikie igũrũ mbere ya Firaũni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.8",
            "verseOrgIds": [
              "EXO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiro ĩyo nĩĩgatuĩka rũkũngũ rũhinyu, naruo rũiyũre bũrũri wothe wa Misiri, rũcooke rũtuĩke mahũha ma ironda mĩĩrĩ-inĩ ya andũ na ya nyamũ bũrũri-inĩ ũcio wothe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.9",
            "verseOrgIds": [
              "EXO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio magĩkĩoya mbiro kuuma riiko inene, makĩrũgama mbere ya Firaũni. Musa akĩmĩikia igũrũ, namo mahũha ma ironda makiumĩra mĩĩrĩ-inĩ ya andũ o na ya nyamũ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.10",
            "verseOrgIds": [
              "EXO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aringi ciama a Misiri matingĩahotire kũrũgama mbere ya Musa nĩ ũndũ wa mahũha marĩa maarĩ namo,hamwe na andũ othe a bũrũri wa Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.11",
            "verseOrgIds": [
              "EXO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Jehova akĩũmia ngoro ya Firaũni, akĩrega kũigua Musa na Harũni, o ta ũrĩa Jehova eerĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.12",
            "verseOrgIds": [
              "EXO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũthiro wa Mbura ya Mbembe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ, “Ũkĩra rũciinĩ tene, ũkarũgame mbere ya Firaũni ũmwĩre atĩrĩ, ‘Ũũ nĩguo Jehova Ngai wa Ahibirania ekuuga: Rekereria andũ akwa mathiĩ, nĩgeetha makahooe,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.13",
            "verseOrgIds": [
              "EXO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana ihinda rĩĩrĩ ngũtũmĩre mĩthiro yakwa yothe ya hinya, we o hamwe na anene aku na andũ aku, nĩguo ũmenye atĩ gũtirĩ ũngĩ ũhaana ta niĩ gũkũ thĩ guothe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.14",
            "verseOrgIds": [
              "EXO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nginya rĩu nĩingĩhotete gũtambũrũkia guoko gwakwa, ngakũhũũra na ngahũũra andũ aku na mũthiro ũrĩa ũngĩmũniinĩte inyuothe thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.15",
            "verseOrgIds": [
              "EXO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ngũrũgamĩtie nĩ ũndũ wa gĩtũmi gĩkĩ kĩũmbe, atĩ nguonie hinya wakwa, na atĩ rĩĩtwa rĩakwa rĩhunjio thĩ yothe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.16",
            "verseOrgIds": [
              "EXO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "No wĩyũmĩtie kũhinyĩrĩria andũ akwa na ũkagiria mathiĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.17",
            "verseOrgIds": [
              "EXO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, rũciũ ihinda ta rĩĩrĩ ngoiria mbura ya mbembe njũru mũno, ĩtarĩ yoira ĩngĩ tayo gũkũ bũrũri wa Misiri kuuma rĩrĩa Misiri kwambĩrĩirie gũtũũrwo nginya rĩu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.18",
            "verseOrgIds": [
              "EXO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩathane rĩu atĩ ũhiũ waku na indo ciothe iria ũrĩ nacio mũgũnda itoonyio handũ ingĩĩgitia, tondũ mbura ĩyo ya mbembe yoirĩra mũndũ o wothe ũrĩ nja kana nyamũ ĩtarehetwo mũciĩ o yothe na ĩrĩ kũu mũgũnda no ĩgũkua.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.19",
            "verseOrgIds": [
              "EXO.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene acio a Firaũni arĩa meetigĩrĩte kiugo kĩa Jehova makĩhiũha gũtoonyia ngombo ciao na ũhiũ wao nyũmba thĩinĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.20",
            "verseOrgIds": [
              "EXO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "No arĩa mateetigĩrire kiugo kĩa Jehova maatigire ngombo ciao na ũhiũ wao mĩgũnda-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.21",
            "verseOrgIds": [
              "EXO.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ, “Tambũrũkia guoko ũkũroretie matu-inĩ nĩgeetha mbura ya mbembe yure bũrũri wa Misiri guothe; yurĩre andũ, na nyamũ na yurĩre kĩndũ gĩothe kĩrakũra mĩgũnda-inĩ ya bũrũri wa Misiri.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.22",
            "verseOrgIds": [
              "EXO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Musa aatambũrũkirie rũthanju arũroretie matu-inĩ, Jehova agĩtũma kũgĩe na marurumĩ hamwe na mbura ya mbembe, naruo rũheni rũkĩhenũka thĩ. Nĩ ũndũ ũcio Jehova akiuria mbura ya mbembe kũu bũrũri wa Misiri;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.23",
            "verseOrgIds": [
              "EXO.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbura ya mbembe ĩgĩkiura, naruo rũheni rũkĩhenũka kũndũ guothe. Nĩkĩo kĩarĩ kĩhuhũkanio kĩrĩa kĩũru mũno kĩonekanĩte bũrũri wothe wa Misiri kuuma wambĩrĩria gũtũũrwo nĩ andũ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.24",
            "verseOrgIds": [
              "EXO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbura ĩyo ya mbembe ĩkiura bũrũri wothe wa Misiri, ĩkiurĩra kĩndũ gĩothe kĩarĩ mũgũnda, andũ o hamwe na nyamũ; ĩgĩthũkia kĩndũ gĩothe kĩarĩ mũgũnda na ĩgĩkahũra mĩtĩ yothe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.25",
            "verseOrgIds": [
              "EXO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũndũ kũrĩa mbura ĩyo ya mbembe ĩtoirire no bũrũri wa Gosheni, kũrĩa andũ a Isiraeli maarĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Firaũni agĩĩta Musa na Harũni, akĩmeera atĩrĩ, “Ihinda rĩĩrĩ nĩnjĩhĩtie. Jehova nĩwe wa ma; niĩ na andũ akwa nĩtũhĩtĩtie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hooyai Jehova, nĩgũkorwo nĩtũiganĩtie marurumĩ na mbura ya mbembe iria tuonete. Nĩngũmũrekereria mũthiĩ; mũtigũikara gũkũ rĩngĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akĩmũcookeria atĩrĩ, “Ndoima itũũra rĩĩrĩ inene, nĩngũtambũrũkia moko hooe Jehova. Marurumĩ nĩmegũthira, na gũtigũkorwo na mbura ĩngĩ ya mbembe, nĩgeetha ũmenye atĩ thĩ nĩ ya Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No nĩnjũũĩ atĩ wee na anene aku mũtirĩ mũretigĩra Jehova Ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ũguta na cairi nĩciathũkirio, nĩ ũndũ cairi nĩyarutĩte magira, naguo ũguta ũkaruta kĩro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, ngano o na guthemethu itiathũkirio, tondũ itiarĩ ngũrũ.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Musa akĩehera harĩ Firaũni na akiuma nja ya itũũra inene. Agĩtambũrũkia moko amaroretie na kũrĩ Jehova; marurumĩ na mbura ya mbembe igĩthira, na gũtiacookire kuura.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Firaũni onire atĩ mbura ya mbembe na marurumĩ nĩciathira akĩĩhia rĩngĩ; we na anene ake makĩũmia ngoro ciao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio ngoro ya Firaũni yarĩ nyũmũ na ndangĩarekereirie andũ a Isiraeli mathiĩ, o ta ũrĩa Jehova aarĩtie na kanua ka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
      ]
    }
