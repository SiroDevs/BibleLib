            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa mbarathi cia Firaũni, na ngaari cia ita, na andũ arĩa maathiiaga mahaicĩte mbarathi maatoonyire iria-inĩ-rĩ, Jehova agĩcookania maaĩ ma iria, makĩmathika. No rĩrĩ, andũ a Isiraeli maatuĩkanirie iria-inĩ mathiĩrĩire thĩ nyũmũ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Miriamu ũrĩa mũnabii mũndũ-wa-nja, mwarĩ wa nyina na Harũni, akĩoya kĩhembe gĩa kũinio, nao atumia othe makĩmuuma thuutha marĩ na ihembe ciao makĩinaga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriamu akĩmainĩra atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maaĩ ma Mara na ma Elimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Musa agĩtongoria Isiraeli kuuma Iria Itune magĩthiĩ Werũ wa Shuri. Magĩthiĩ rũgendo rwa mĩthenya ĩtatũ werũ-inĩ na matekuona maaĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa maakinyire Mara, matingĩahotire kũnyua maaĩ makuo tondũ maarĩ marũrũ. (Nĩkĩo handũ hau hetagwo Mara.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio andũ magĩtetia Musa, makiuga atĩrĩ, “Tũkũnyua kĩ?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Musa agĩkaĩra Jehova, nake Jehova akĩmuonia kamũtĩ. Agĩgaikia maaĩ-inĩ, namo makĩgĩa mũcamo mwega. O hau Jehova agĩathana, akĩmathondekera watho na uuge wa kũrũmagĩrĩrwo, na akĩmagereria ho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiuga atĩrĩ, “Mũngĩthikĩrĩria mũgambo wa Jehova Ngai wanyu wega, na mwĩke maũndũ marĩa magĩrĩire maitho-inĩ make, mũngĩrũmbũiya maathani make na mũmenyerere wathani wake wothe-rĩ, ndikamũrehera mũrimũ o na ũmwe wa ĩrĩa ndareheire andũ a Misiri, nĩgũkorwo niĩ nĩ niĩ Jehova, ũrĩa ũmũhonagia.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ magĩkinya Elimu, harĩa haarĩ ithima ikũmi na igĩrĩ, na mĩtende mĩrongo mũgwanja, nao makĩamba hema hau hakuhĩ na maaĩ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
        }
      ]
    }
