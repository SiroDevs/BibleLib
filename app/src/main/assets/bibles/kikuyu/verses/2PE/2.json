{
  "id": "2PE.2",
  "number": "2",
  "bookId": "2PE",
  "reference": "2 Petero 2",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
