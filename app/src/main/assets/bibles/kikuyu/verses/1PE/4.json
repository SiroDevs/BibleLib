{
  "id": "1PE.4",
  "number": "4",
  "bookId": "1PE",
  "reference": "1 Petero 4",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1PE 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũtũũrĩra Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, tondũ Kristũ nĩanyariirirwo mwĩrĩ-inĩ-rĩ, o na inyuĩ kĩĩhotorei mũrĩ na meciiria o ta macio aarĩ namo, tondũ mũndũ ũrĩa ũrĩkĩtie kũnyariirwo mwĩrĩ nĩatiganĩte na mehia.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.1",
            "verseOrgIds": [
              "1PE.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ wa ũguo, mũtũũrĩre wake ũrĩa ũtigarĩte wa gũtũũra gũkũ thĩ ndarĩtũũraga nĩguo ahingagie merirĩria mooru ma mwĩrĩ, no arĩtũũraga nĩguo ekage ũrĩa Ngai endaga.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ nĩmũtũũrĩte ihinda rĩa kũigana mũgĩkaga maũndũ marĩa andũ arĩa matetĩkĩtie Ngai mendaga gwĩka, namo nĩ ta mĩtũũrĩre ya ũũra-thoni, na merirĩria mooru ma mwĩrĩ, na ũrĩĩu, na gũthiiaga maruga-inĩ ma waganu, o na ciathĩ-inĩ cia kũnyua njoohi, o na mũhooere ũrĩ thaahu wa kũhooya mĩhianano.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ acio nĩmagegaga mona atĩ mũtiranyiitanĩra nao hĩndĩ ĩrĩa marakĩrĩrĩria ũmaramari-inĩ ũcio wao, nao magakĩmũcambagia.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao no nginya makaaheana ũhoro wa maũndũ mao kũrĩ ũrĩa wĩhaarĩirie gũtuĩra ciira arĩa marĩ muoyo na arĩa makuĩte.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo gĩkĩ nĩkĩo gĩtũmi kĩrĩa gĩatũmire Ũhoro-ũrĩa-Mwega ũhunjĩrio o na andũ arĩa makuĩte, nĩgeetha ha ũhoro wa mwĩrĩ magaatuĩrwo ciira o ta ũrĩa andũ arĩa angĩ magaatuĩrwo, no ha ũhoro wa roho matũũre muoyo o ta ũrĩa Ngai atũũraga.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ithirĩro rĩa maũndũ mothe nĩrĩkuhĩrĩirie. Nĩ ũndũ ũcio ikaragai mũrĩ na ũũgĩ wa ngoro, na mũikarage mũterigĩtwo nĩguo mũhotage kũhooya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ gũkĩra maũndũ mothe, ikaragai mwendaine mũno mũndũ na ũrĩa ũngĩ, tondũ wendani nĩũhumbagĩra mehia maingĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũtuganage mũtekũnuguna.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mũndũ nĩ ahũthĩre kĩheo o gĩothe kĩrĩa amũkĩrĩte nĩguo atungatagĩre andũ arĩa angĩ, arĩ ta mũramati mwĩhokeku wa wega wa Ngai wa mĩthemba mĩingĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ o wothe angĩkorwo akĩaria-rĩ, nĩarie taarĩ mũndũ ũkũheana ciugo cia Ngai. Nake mũndũ o wothe angĩkorwo agĩtungata-rĩ, nĩatungate na hinya ũrĩa ũheanagwo nĩ Ngai, nĩgeetha Ngai agoocagwo maũndũ-inĩ mothe thĩinĩ wa Jesũ Kristũ. Nake nĩwe ũgũtũũra arĩ na riiri na hinya nginya tene na tene. Ameni.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kũnyariirwo nĩ ũndũ wa Gũtuĩka Mũkristiano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arata akwa nyenda mũno, mũtikagegio nĩ magerio marĩa mũranyariirwo namo, taarĩ ũndũ mũgeni ũrekĩka thĩinĩ wanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "No kenagai nĩgũkorwo nĩ mũgwatanĩire thĩinĩ wa kũnyariirĩka gwa Kristũ, nĩgeetha mũkaiyũrĩrĩrwo nĩ gĩkeno hĩndĩ ĩrĩa riiri wake ũkaaguũranĩrio.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kũrathimwo-rĩ, nĩ inyuĩ mũngĩrumwo nĩ ũndũ wa rĩĩtwa rĩa Kristũ, nĩ ũndũ Roho ũrĩa ũrĩ na riiri, o we Roho wa Ngai, arĩ igũrũ rĩanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ wanyu ndakananyariirwo ta mũũragani, kana mũici, kana mũgeri ngero ĩngĩ o yothe, o na kana ta mũndũ ũrĩa wĩtoonyagĩrĩria maũndũ-inĩ ma andũ angĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, mũndũ angĩnyariirwo tondũ wa gũtuĩka Mũkristiano-rĩ, ndakanaconoke, no nĩagooce Ngai tondũ nĩaheetwo rĩĩtwa rĩu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
              "1PE.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo ihinda nĩ ikinyu ciira wambĩrĩrie gũtuĩrwo andũ a nyũmba ya Ngai; na angĩkorwo ũkwambĩrĩria na ithuĩ-rĩ, gũgaagĩtuĩka atĩa harĩ arĩa mataathĩkagĩra Ũhoro-ũrĩa-Mwega wa Ngai?",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, andũ arĩa manyariirĩkaga kũringana na ũrĩa Ngai endete, nĩmaheane mĩoyo yao kũrĩ Mũũmbi wao ũrĩa wa kwĩhokeka, na mathiĩ na mbere gwĩkaga maũndũ mega.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.19",
            "verseOrgIds": [
              "1PE.4.19"
            ]
          }
        }
      ]
    }
  ],
