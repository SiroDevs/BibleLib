              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "maitho ma mwĩtĩĩo, na rũrĩmĩ rũrĩa rũheenanagia, na moko marĩa maitaga thakame ya andũ matehĩtie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.17",
            "verseOrgIds": [
              "PRO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngoro ĩrĩa ĩthugundaga maũndũ ma waganu, na magũrũ marĩa matengʼeraga gũthiĩ gwĩka ũũru,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.18",
            "verseOrgIds": [
              "PRO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũira ũtarĩ wa ma ũrĩa ũthothoraga ndeto cia maheeni, o na mũndũ ũrĩa ũrehaga nyamũkano gatagatĩ ka andũ a nyina ũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.6.19",
            "verseOrgIds": [
              "PRO.6.19"
            ]
          }
        }
      ]
    },
