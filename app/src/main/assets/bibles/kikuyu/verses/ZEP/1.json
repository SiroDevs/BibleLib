        },
        {
          "text": "Atĩrĩrĩ, ĩno nĩyo ndũmĩrĩri ya Jehova ĩrĩa yakinyĩrĩire Zefania mũrũ wa Kushi, mũrũ wa Gedalia, mũrũ wa Amaria, mũrũ wa Hezekia, rĩrĩa Mũthamaki Josia mũrũ wa Amoni aathamakaga Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Juda Gũtuĩrwo Ciira",
          "type": "text"
        }
      ]
    },
