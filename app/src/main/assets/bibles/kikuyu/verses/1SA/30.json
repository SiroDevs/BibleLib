{
  "id": "1SA.30",
  "number": "30",
  "bookId": "1SA",
  "reference": "1 Samũeli 30",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "1SA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Kũniina Amaleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, Daudi na andũ ake maakinyire Zikilagi mũthenya wa gatatũ. Nao Amaleki magĩkorwo nĩ matharĩkĩire Negevu na Zikilagi. Nĩmahũrĩte Zikilagi na makarĩcina,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.1",
            "verseOrgIds": [
              "1SA.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nĩmatahĩte andũ-a-nja arĩa othe maarĩ kuo, andũ ethĩ o na arĩa akũrũ. Matiigana kũũraga mũndũ o na ũmwe, no nĩmamakuuire magĩthiĩ nao.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.2",
            "verseOrgIds": [
              "1SA.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Daudi na andũ ake mookire Zikilagi, maakorire rĩcinĩtwo na mwaki, na atumia ao na ariũ ao na airĩtu ao magatahwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.3",
            "verseOrgIds": [
              "1SA.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Daudi na andũ ake makĩrĩra maanĩrĩire nginya makĩaga hinya wa kũrĩra rĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.4",
            "verseOrgIds": [
              "1SA.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumia a Daudi eerĩ nĩmatahĩtwo, Ahinoamu wa Jezireeli, na Abigaili ũrĩa warĩ mũtumia wa ndigwa wa Nabali kuuma Karimeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.5",
            "verseOrgIds": [
              "1SA.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akĩnyariirĩka mũno nĩ ũndũ andũ nĩmaciirĩire kũmũhũũra na mahiga; o mũndũ arĩ na marũrũ ngoro nĩ ũndũ wa aanake na airĩtu ake. No Daudi akĩgĩa na hinya thĩinĩ wa Jehova Ngai wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.6",
            "verseOrgIds": [
              "1SA.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agĩcooka akĩĩra Abiatharu, mũthĩnjĩri-Ngai, mũrũ wa Ahimeleku atĩrĩ, “Ndeehera ebodi.” Nake Abiatharu akĩmũrehera ebodi,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.7",
            "verseOrgIds": [
              "1SA.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Daudi agĩtuĩria ũhoro kũrĩ Jehova, akĩũria atĩrĩ, “Nyingatithie mbũtũ ĩyo ĩtũtharĩkĩire? Nĩngũmĩkinyĩra?” Akĩmũcookeria atĩrĩ, “Mĩrũmĩrĩre, hatarĩ nganja nĩũkũmĩkinyĩra na nĩũkũhota gũcookia kĩrĩa gĩtahe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.8",
            "verseOrgIds": [
              "1SA.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi na andũ magana matandatũ arĩa maarĩ hamwe nake magĩkinya Mũkuru wa Besori, harĩa amwe ao maatigirwo thuutha,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.9",
            "verseOrgIds": [
              "1SA.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgũkorwo andũ ta magana meerĩ maarĩ anogu mũno, makĩremwo nĩ kũringa mũkuru ũcio. No Daudi na andũ magana mana magĩthiĩ na mbere kũmarũmĩrĩra.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.10",
            "verseOrgIds": [
              "1SA.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao magĩkorerera Mũmisiri werũ-inĩ, makĩmũtwara kũrĩ Daudi. Makĩmũhe maaĩ ma kũnyua na irio cia kũrĩa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.11",
            "verseOrgIds": [
              "1SA.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kĩenyũ kĩa ngũyũ hihe na imanjĩka igĩrĩ cia thabibũ nyũmithie. Akĩrĩa agĩcookwo nĩ hinya, nĩ ũndũ ndaarĩte irio kana akanyua maaĩ handũ ha mĩthenya ĩtatũ, ũtukũ na mũthenya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.12",
            "verseOrgIds": [
              "1SA.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akĩmũũria atĩrĩ, “We ũrĩ wa ũ na uumĩte kũ?” Agĩcookia atĩrĩ, “Ndĩ Mũmisiri, ngombo ya mũndũ Mũamaleki. Mwathi wakwa aandiganĩirie ndarũara, mĩthenya ĩtatũ ĩthirĩte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.13",
            "verseOrgIds": [
              "1SA.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩtwatharĩkĩire Negevu ya Akerethi,na rũgongo rwa bũrũri wa Juda, na Negevu ya Kalebu, na tũgĩcina Zikilagi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.14",
            "verseOrgIds": [
              "1SA.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akĩmũũria atĩrĩ, “Wahota kũndongoria ũnjikũrũkie kũrĩ mbũtũ ĩyo ĩraatharĩkĩire?” Mũndũ ũcio agĩcookia atĩrĩ, “Wĩhĩte na mwĩhĩtwa mbere ya Ngai atĩ ndũkũnjũraga, kana ũneane kũrĩ mwathi wakwa, na nĩngũgũtwara, tũikũrũke tũthiĩ kũrĩa marĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.15",
            "verseOrgIds": [
              "1SA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agĩtongoria Daudi, magĩikũrũka, nao makĩmakora kũu, maharaganĩte bũrũri-inĩ ũcio, makĩrĩa na makĩnyua, magĩĩkenagia nĩ ũndũ wa ũrĩa maatahĩte indo nyingĩ kuuma bũrũri wa Afilisti, na kuuma Juda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.16",
            "verseOrgIds": [
              "1SA.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akĩmahũũra kuuma hwaĩ-inĩ kũrĩ mairia nginya hwaĩ-inĩ wa mũthenya ũyũ ũngĩ, na gũtirĩ mũndũ o na ũmwe worire, tiga o aanake magana mana arĩa maahaicire ngamĩĩra ciao makĩũra.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.17",
            "verseOrgIds": [
              "1SA.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agĩcookia indo ciothe iria Aamaleki maakuuĩte, o hamwe na atumia ake eerĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.18",
            "verseOrgIds": [
              "1SA.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gũtirĩ kĩndũ o na kĩmwe kĩagire: mũndũ mwĩthĩ kana mũkũrũ, kamwana kana kairĩtu, indo iria ciothe ciatahĩtwo kana kĩndũ o gĩothe kĩrĩa maakuuĩte. Daudi agĩcookithia indo ciothe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.19",
            "verseOrgIds": [
              "1SA.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akĩoya ndũũru ciothe cia mbũri na ngʼombe, nao andũ ake magĩcitwara mbere ya mahiũ marĩa mangĩ, makiugaga atĩrĩ, “Ici nĩ indo iria Daudi aatahĩte.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.20",
            "verseOrgIds": [
              "1SA.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Daudi agĩkinya harĩ andũ arĩa magana meerĩ arĩa maanogete mũno makaremwo nĩ kũmũrũmĩrĩra na magatigwo thuutha hau mũkuru-inĩ wa Besori. Magĩũka gũthagaana Daudi na andũ arĩa maarĩ nake. Rĩrĩa Daudi na andũ ake maakuhĩrĩirie, akĩmageithia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.21",
            "verseOrgIds": [
              "1SA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "No andũ arĩa othe aaganu na arĩa a haaro thĩinĩ wa arũmĩrĩri a Daudi makiuga atĩrĩ, “Tondũ matiathiire hamwe na ithuĩ-rĩ, tũtikũgayana nao indo cia gũtahwo iria tũcookithĩtie. No rĩrĩ, o mũndũ no oe mũtumia wake na ciana athiĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.22",
            "verseOrgIds": [
              "1SA.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agĩcookia atĩrĩ, “Aca, ariũ a baba, mũtingĩĩka ũguo na indo iria Jehova atũheete. Nĩatũgitĩire na akaneana mbũtũ iria ciatũũkĩrĩire moko-inĩ maitũ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ ũngĩthikĩrĩria ũguo mũroiga? Igai rĩa mũndũ ũrĩa watigirwo akĩrora indo rĩkũiganana na rĩa ũrĩa waikũrũkire agĩthiĩ mbaara-inĩ. Othe mekũgayana o ũndũ ũmwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.24",
            "verseOrgIds": [
              "1SA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi agĩtua ũndũ ũcio ũtuĩke kĩrĩra na watho wa kũrũmagĩrĩrwo kũu Isiraeli kuuma mũthenya ũcio nginya ũmũthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.25",
            "verseOrgIds": [
              "1SA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Daudi aakinyire Zikilagi, agĩtũmĩra athuuri a Juda arĩa maarĩ arata ake indo imwe cia iria ciatahĩtwo, akĩmeera atĩrĩ, “Gĩkĩ nĩ kĩheo kĩanyu harĩ indo iria itahĩtwo kuuma kũrĩ thũ cia Jehova.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agĩcitũmĩra arĩa maarĩ Betheli, na Ramothu-Negevu, na Jatiri;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na arĩa maarĩ Aroeri, na Sifimothu, na Eshitemoa,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Rakali; na arĩa maarĩ matũũra ma Ajerameeli, na Akeni;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
