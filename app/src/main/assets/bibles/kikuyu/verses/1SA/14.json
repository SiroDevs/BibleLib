{
  "id": "1SA.14",
  "number": "14",
  "bookId": "1SA",
  "reference": "1 Samũeli 14",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũmwe Jonathani mũrũ wa Saũlũ akĩĩra mwanake ũrĩa wamũkuuagĩra indo cia mbaara atĩrĩ, “Ũka tũthiĩ kambĩ-inĩ ya Afilisti mũrĩmo ũrĩa ũngĩ.” No ndaigana kwĩra ithe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.1",
            "verseOrgIds": [
              "1SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ aikarĩte ndeere-inĩ cia Gibea rungu rwa mũtĩ wa mũkomamanga kũu Migironi. Nao andũ arĩa aarĩ nao maarĩ ta andũ magana matandatũ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.2",
            "verseOrgIds": [
              "1SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũmwe wao aarĩ Ahija, ũrĩa wehumbĩte ebodi. Aarĩ mũrũ wa Ahitubu mũrũ wa nyina na Ikabodu, mũrũ wa Finehasi, ũrĩa mũrũ wa Eli, mũthĩnjĩri-Ngai wa Jehova kũu Shilo. Gũtiarĩ mũndũ wamenyete atĩ Jonathani nĩathiĩte.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩena yeerĩ ya kĩhunguro kĩrĩa Jonathani endaga gũũkĩrĩra nĩguo akinye irangĩro-inĩ rĩa Afilisti nĩ haarĩ na hurũrũka cia ihiga; ĩmwe yetagwo Bozezi, na ĩrĩa ĩngĩ Senehe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.4",
            "verseOrgIds": [
              "1SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurũrũka ĩmwe yarĩ mwena wa gathigathini kũngʼethera Mikimashi, na ĩyo ĩngĩ yarĩ gũthini kũngʼethera Geba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani akĩĩra mwanake ũcio wamũkuuagĩra indo cia mbaara atĩrĩ, “Ũka tũthiĩ irangĩro-inĩ rĩa andũ acio mataruaga. Hihi no gũkorwo Jehova nĩegwĩka ũndũ nĩ ũndũ witũ. Gũtirĩ kĩndũ kĩngĩgiria Jehova ahonokanie, andũ marĩ aingĩ, kana marĩ anini.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũkuui wake wa indo cia mbaara akĩmwĩra atĩrĩ, “Ĩka maũndũ mothe marĩa wĩciirĩtie gwĩka, ũgĩthiĩ na mbere tondũ niĩ ndĩ hamwe nawe maũndũ-inĩ mothe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.7",
            "verseOrgIds": [
              "1SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani akĩmwĩra atĩrĩ, “Ũka tũringe mũrĩmo ũrĩa ũngĩ twerekeire harĩ andũ acio tũmeonithie.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.8",
            "verseOrgIds": [
              "1SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mangĩtwĩra atĩrĩ, ‘Etererai hau nginya tũũke kũrĩ inyuĩ,’ tũgũikara o hau tũrĩ na tũtikwambata tũthiĩ kũrĩ o.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.9",
            "verseOrgIds": [
              "1SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mangĩtwĩra atĩrĩ, ‘Ambatai mũũke kũrĩ ithuĩ,’ tũkĩambate, nĩ ũndũ kĩu nĩkĩo gĩgũtuĩka kĩmenyithia giitũ atĩ Jehova nĩamaneanĩte moko-inĩ maitũ.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao eerĩ makĩĩonithania irangĩro-inĩ rĩa Afilisti. Nao Afilisti makiuga atĩrĩ, “Hĩ, ta rorai! Ahibirania makiuma marima-inĩ makurumĩte kũrĩa marehithĩte.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.11",
            "verseOrgIds": [
              "1SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ a irangĩro-inĩ makĩgũthũkĩra Jonathani na mũkuui wake wa indo cia mbaara makĩmeera atĩrĩ, “Ambatai mũũke kũrĩ ithuĩ na mũtirĩ ũndũ mũtekuona.” Nĩ ũndũ ũcio Jonathani akĩĩra mũkuui wake wa indo cia mbaara atĩrĩ, “Ambata, ũnyume thuutha; Jehova nĩamaneanĩte guoko-inĩ gwa Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani akĩambata, agĩthiĩ akurumĩte, na mũkuui wake wa indo cia mbaara amuumĩte thuutha. Nao Afilisti makĩgũa mbere ya Jonathani, nake mũkuui wake wa indo cia mbaara akĩmooraga arĩ thuutha wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.13",
            "verseOrgIds": [
              "1SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itharĩkĩra rĩu rĩa mbere rĩa Jonathani marĩ na mũkuui wake wa indo cia mbaara rĩoragire andũ mĩrongo ĩĩrĩ gacigo-inĩ ka nuthu ya ĩka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.14",
            "verseOrgIds": [
              "1SA.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afilisti Kũhootwo nĩ Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo kĩmako gĩkĩnyiita andũ othe a ita, arĩa maarĩ kambĩ-inĩ na mĩgũnda-inĩ, o na arĩa maarĩ irangĩro-inĩ, na ikundi cia atharĩkĩri, nayo thĩ ĩgĩthingitha. Kĩmako kĩu kĩarehetwo nĩ Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arangĩri a Saũlũ arĩa maarĩ Gibea ya Benjamini makĩona andũ a ita rĩu maharaganĩte mĩena yothe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.16",
            "verseOrgIds": [
              "1SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Saũlũ akĩĩra andũ arĩa maarĩ nake atĩrĩ, “Tarai andũ a ita mũmenye nũũ ũtarĩ ho.” Rĩrĩa meekire ũguo, magĩkora nĩ Jonathani na mũkuui wake wa indo cia mbaara mataarĩ ho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.17",
            "verseOrgIds": [
              "1SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ akĩĩra Ahija atĩrĩ, “Rehe ithandũkũ rĩa Ngai.” (Mahinda macio ithandũkũ rĩu rĩarĩ na andũ a Isiraeli).",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.18",
            "verseOrgIds": [
              "1SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O hĩndĩ ĩyo Saũlũ aaragĩria mũthĩnjĩri-Ngai-rĩ, ironja rĩrĩa rĩarĩ kambĩ-inĩ ya Afilisti rĩgĩkĩrĩrĩria kũingĩha. Nĩ ũndũ ũcio Saũlũ akĩĩra mũthĩnjĩri-Ngai ũcio atĩrĩ, “Eheria guoko gwaku.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.19",
            "verseOrgIds": [
              "1SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Saũlũ na andũ ake othe makĩũngana, magĩthiĩ mbaara-inĩ. Magĩkorerera Afilisti marĩ na kĩhĩngĩĩcano kĩnene, magĩtemangana o ene na hiũ cia njora.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.20",
            "verseOrgIds": [
              "1SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahibirania arĩa maarĩ na Afilisti mbere ĩyo na arĩa maambĩte magathiĩ hamwe nao kambĩ-inĩ ciao, makĩgarũrũka magĩcooka mwena wa andũ a Isiraeli arĩa maarĩ hamwe na Saũlũ na Jonathani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.21",
            "verseOrgIds": [
              "1SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa andũ a Isiraeli arĩa meehithĩte bũrũri ũrĩa ũrĩ irĩma wa Efiraimu maiguire atĩ Afilisti nĩ kũũra mooraga-rĩ, nao makĩingĩra mbaara-inĩ, makĩmatengʼeria.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũguo nĩguo Jehova aahonokirie Isiraeli mũthenya ũcio, nayo mbaara ĩgĩthiĩ na mbere nginya ĩkĩhĩtũka Bethi-Aveni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jonathani kũrĩa Ũũkĩ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, andũ a Isiraeli maarĩ thĩĩna-inĩ mũnene mũthenya ũcio, nĩ ũndũ Saũlũ nĩamehĩtithĩtie na mwĩhĩtwa, akameera atĩrĩ, “Kũgwatwo nĩ kĩrumi nĩ mũndũ ũrĩa ũkũrĩa irio gũtanatuka, iterĩhĩirie harĩ thũ ciakwa!” Nĩ ũndũ ũcio gũtirĩ mũndũ o na ũmwe wa ita rĩu wacamire irio.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.24",
            "verseOrgIds": [
              "1SA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ita rĩothe rĩgĩtoonya mũtitũ, na kũu nĩ kwarĩ na ũũkĩ handũ thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.25",
            "verseOrgIds": [
              "1SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa maatoonyire mũtitũ nĩmoonire ũũkĩ ũgĩtaata, no gũtirĩ mũndũ o na ũmwe waũcamire na kanua nĩ ũndũ nĩmetigagĩra mwĩhĩtwa ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.26",
            "verseOrgIds": [
              "1SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "No Jonathani ndaiguĩte atĩ ithe nĩehĩtithĩtie andũ na mwĩhĩtwa; nĩ ũndũ ũcio agĩtambũrũkia rũthanju rũrĩa aanyiitĩte akĩrũtobokia igua-inĩ rĩa ũũkĩ. Akĩũcama na kanua, namo maitho make magĩthera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.27",
            "verseOrgIds": [
              "1SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ũmwe wa thigari icio akĩmwĩra atĩrĩ, “Thoguo nĩehĩtithĩtie andũ aya a ita na mwĩhĩtwa mũrũmu, akoiga atĩrĩ, ‘Kũgwatwo nĩ kĩrumi nĩ mũndũ ũrĩa ũkũrĩa irio ũmũthĩ!’ Nĩkĩo andũ aya moorĩtwo nĩ hinya.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.28",
            "verseOrgIds": [
              "1SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonathani akiuga atĩrĩ, “Baba nĩatũmĩte bũrũri ũgĩe na thĩĩna. Ta kĩonei ũrĩa maitho makwa matherire rĩrĩa njamire kaũũkĩ gaka kanini.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.29",
            "verseOrgIds": [
              "1SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Githĩ gũtingiuma wega makĩria korwo ũmũthĩ andũ nĩmekũrĩĩte indo imwe cia iria matahĩte kuuma kũrĩ thũ ciao? Githĩ rĩũraga rĩu rĩa Afilisti rĩtingiuma inene makĩria?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũcio, thuutha wa andũ a Isiraeli kũhũũra Afilisti kuuma Mikimashi nginya Aijaloni, magĩkorwo manogeete mũno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makĩguthũkĩra indo iria maatahĩte, makĩoya ngʼondu, na ngʼombe, na tũcaũ, magĩcithĩnjĩra hau thĩ, na magĩcirĩanĩria na thakame.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo mũndũ ũmwe akĩĩra Saũlũ atĩrĩ, “Atĩrĩrĩ, ta kĩone andũ aya nĩmehĩirie Jehova nĩ kũrĩa nyama irĩ na thakame.” Nake akiuga atĩrĩ, “Nĩmwagarara watho. Garagariai ihiga inene mũrĩrehe haha o rĩu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agĩcooka akĩmeera atĩrĩ, “Thiĩi kũrĩ andũ, mũmeere atĩrĩ, ‘O mũndũ wanyu nĩandehere ngʼombe yake na ngʼondu, mũcithĩnjĩre haha na mũcirĩe. Tigai kwĩhĩria Jehova nĩ kũrĩa nyama irĩ na thakame.’ ” Nĩ ũndũ ũcio o mũndũ akĩrehe ndegwa yake ũtukũ ũcio na akĩmĩthĩnjĩra hau.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Saũlũ agĩakĩra Jehova kĩgongona; rĩu nĩrĩo rĩarĩ ihinda rĩake rĩa mbere gwĩka ũguo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ akiuga atĩrĩ, “Nĩtũikũrũkei tũrũmĩrĩre Afilisti ũtukũ, tũmatahe nginya rũciinĩ, na tũtigatigie mũndũ o na ũmwe wao arĩ muoyo.” Nao magĩcookia atĩrĩ, “Ĩka o ũrĩa ũkuona wagĩrĩire mũno harĩwe.” No mũthĩnjĩri-Ngai akiuga atĩrĩ, “Rekei tũtuĩrie ũhoro kuuma kũrĩ Ngai o haha.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Saũlũ akĩũria Ngai atĩrĩ, “Nĩ wega njikũrũke, nũmĩrĩre Afilisti? Nĩũkũmaneana moko-inĩ ma andũ a Isiraeli?” No Ngai ndaigana kũmũcookeria ũhoro mũthenya ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.37",
            "verseOrgIds": [
              "1SA.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Saũlũ akiuga atĩrĩ, “Ũkai haha, inyuothe atongoria a ita, tũmenye wĩhia ũrĩa wĩkĩtwo ũmũthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.38",
            "verseOrgIds": [
              "1SA.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti-itherũ o ta ũrĩa Jehova ũrĩa ũhonokagia Isiraeli atũũraga muoyo-rĩ, o na kũngĩtuĩka nĩ Jonathani mũrũ wakwa wĩkĩte ũguo-rĩ, no nginya akue.” No gũtirĩ mũndũ o na thĩinĩ wao woigire ũndũ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ agĩcooka akĩĩra andũ othe a Isiraeli atĩrĩ, “Inyuĩ rũgamai haarĩa; na niĩ na Jonathani mũrũ wakwa tũrũgame haha.” Nao andũ magĩcookia atĩrĩ, “Ĩka ũrĩa ũkuona kwagĩrĩire.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Saũlũ akĩhooya Jehova Ngai wa Isiraeli, akiuga atĩrĩ, “He icookio rĩrĩa rĩagĩrĩire.” Mĩtĩ yacuukwo yagwĩrĩire Jonathani na Saũlũ, nao andũ acio makĩoneka matiarĩ na ũcuuke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ akiuga atĩrĩ, “Tũcuukĩrei mĩtĩ niĩ na Jonathani, mũrũ wakwa.” Nake Jonathani akĩgwĩrwo nĩ mũtĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Saũlũ akĩĩra Jonathani atĩrĩ, “Ta njĩĩra nĩ atĩa wĩkĩte.” Nĩ ũndũ ũcio Jonathani akĩmwĩra atĩrĩ, “No gũcama njamire kaũũkĩ kanini na mũthia wa rũthanju rwakwa. Na rĩrĩ, no nginya niĩ ngue?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ akiuga atĩrĩ, “Ngai arothũũra na anjĩke ũndũ mũũru makĩria, kũngĩkorwo wee Jonathani ndũgũkua.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "No andũ acio makĩũria Saũlũ atĩrĩ, “Jonathani nĩagĩrĩirwo nĩ gũkua, arĩ we ũreheire Isiraeli ũhootani mũnene ũũ? Aca, kũroaga gũtuĩka ũguo! Ti-itherũ, o ta ũrĩa Jehova atũũraga muoyo, gũtirĩ rũcuĩrĩ o na rũmwe rwa mũtwe wake rũkũgũa thĩ, nĩgũkorwo eekire ũguo ũmũthĩ na ũteithio wa Ngai.” Nĩ ũndũ ũcio andũ acio makĩhonokia Jonathani, na ndaigana kũũragwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Saũlũ agĩtiga kũingatana na Afilisti, nao magĩcooka bũrũri-inĩ wao.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ aambĩrĩria gũthamakĩra Isiraeli, nĩarũire na thũ ciao ndwere-inĩ ciothe: akĩrũa na Moabi, na Amoni, na Edomu, na athamaki a Zoba na a Afilisti. Kũrĩa guothe eerekagĩra, nĩamanyariiraga akamaherithia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩrũa na ũcamba, akĩhoota Aamaleki, na akĩhonokia Isiraeli kuuma moko-inĩ ma arĩa maamatahĩte indo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andũ a Nyũmba ya Saũlũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariũ a Saũlũ maarĩ Jonathani, na Ishivi, na Maliki-Shua. Mwarĩ wake ũrĩa mũkũrũ eetagwo Merabu, na ũrĩa mũnini eetagwo Mikali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtumia wake eetagwo Ahinoamu mwarĩ wa Ahimaazu. Mũnene wa ita rĩa Saũlũ eetagwo Abineri mũrũ wa Neri, nake Neri aarĩ ithe mũnini wa Saũlũ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kishu ithe wa Saũlũ, na Neri ithe wa Abineri maarĩ ariũ a Abieli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matukũ-inĩ mothe ma Saũlũ nĩ kwarĩ na mbaara ndũrũ cia kũrũa na Afilisti, na rĩrĩa rĩothe Saũlũ angĩonire mũndũ ũrĩ hinya kana njamba, aamuoyaga, akamũtoonyia ita-inĩ rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.52",
            "verseOrgIds": [
              "1SA.14.52"
            ]
          }
        }
      ]
    }
  ],
