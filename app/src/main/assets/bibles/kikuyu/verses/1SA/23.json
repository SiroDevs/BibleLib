{
  "id": "1SA.23",
  "number": "23",
  "bookId": "1SA",
  "reference": "1 Samũeli 23",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi Kũhonokia Keila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, Daudi akĩĩrwo atĩrĩ, “Atĩrĩrĩ, Afilisti nĩmararũa na itũũra rĩa Keila, na magatunyana ngano ĩrĩa ĩrĩ mahuhĩro-inĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake agĩtuĩria ũhoro harĩ Jehova, akĩũria atĩrĩ, “Nĩnjagĩrĩirwo nĩgũthiĩ gũtharĩkĩra Afilisti acio?” Nake Jehova akĩmũcookeria atĩrĩ, “Thiĩ ũgatharĩkĩre Afilisti nĩguo ũhonokie Keila.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No andũ a Daudi makĩmwĩra atĩrĩ, “Gũkũ Juda nĩtũretigĩra. Githĩ tũtigũgĩĩtigĩra makĩria twathiĩ Keila tũkarũe na mbũtũ cia Afilisti!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rĩngĩ Daudi agĩtuĩria ũhoro harĩ Jehova, nake Jehova akĩmũcookeria atĩrĩ, “Ikũrũka ũthiĩ Keila, nĩ ũndũ nĩngũneana Afilisti guoko-inĩ gwaku.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Daudi na andũ ake magĩthiĩ Keila, makĩrũa na Afilisti, na makĩmataha mahiũ mao. Akĩrehera Afilisti hathara nene, na akĩhonokia andũ a Keila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Na rĩrĩ, Abiatharu mũrũ wa Ahimeleku nĩokĩte akuuĩte ebodi rĩrĩa aikũrũkire, akĩũrĩra kũrĩ Daudi kũu Keila.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saũlũ Kũingatithia Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ akĩĩrwo atĩ Daudi nĩathiĩte Keila, nake akiuga atĩrĩ, “Ngai nĩamũneanĩte kũrĩ niĩ, nĩgũkorwo Daudi nĩehingĩrĩirie na ũndũ wa gũtoonya itũũra rĩrĩ na ihingo na mĩgĩĩko.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Saũlũ agĩĩta mbũtũ ciake ciothe mathiĩ mbaara, nĩguo maikũrũke Keila makahingĩrĩrie Daudi na andũ ake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa Daudi aamenyire atĩ Saũlũ nĩaciirĩire kũmwĩka ũũru-rĩ, akĩĩra Abiatharu mũthĩnjĩri-Ngai atĩrĩ, “Rehe ebodi ĩyo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi akiuga atĩrĩ, “Wee Jehova, Ngai wa Isiraeli, ndungata yaku nĩ ĩiguĩte hatarĩ nganja atĩ Saũlũ nĩarooka Keila aniine itũũra rĩĩrĩ nĩ ũndũ wakwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hihi aikari a Keila nĩmekũũneana kũrĩ we? Hihi Saũlũ nĩegũikũrũka gũkũ, ta ũrĩa ndungata yaku ĩiguĩte? Wee Jehova, Ngai wa Isiraeli, menyithia ndungata yaku ũhoro.” Nake Jehova akiuga atĩrĩ, “Nĩegũikũrũka.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rĩngĩ Daudi akĩũria atĩrĩ, “Hihi aikari a Keila nĩmekũneana, niĩ na andũ akwa, kũrĩ Saũlũ?” Nake Jehova akiuga atĩrĩ, “Nĩmegũkũneana.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Daudi na andũ ake, andũ ta magana matandatũ, makiuma Keila, na magĩikara magĩcangacangaga kũndũ na kũndũ. Rĩrĩa Saũlũ eerirwo atĩ Daudi nĩorĩte akoima Keila, agĩtiga gũthiĩ kuo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Daudi agĩikara ciĩhitho cia werũ-inĩ na irĩma-inĩ cia Werũ wa Zifu. O mũthenya Saũlũ nĩamũcaragia, no Ngai ndaaneanire Daudi moko-inĩ make.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Daudi aarĩ Horeshu kũu Werũ wa Zifu, akĩmenya atĩ Saũlũ okĩte nĩguo amũũrage.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jonathani mũrũ wa Saũlũ agĩthiĩ kũrĩ Daudi kũu Horeshu na akĩmũteithia kwĩyũmĩrĩria thĩinĩ wa Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akĩmwĩra atĩrĩ, “Tiga gwĩtigĩra, Baba Saũlũ ndagakũhutia na guoko gwake. Wee nĩũgathamakĩra Isiraeli, na niĩ nduĩke mũnini waku. O na Baba Saũlũ, nĩoĩ ũguo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao eerĩ makĩgĩa kĩrĩkanĩro mbere ya Jehova. Thuutha ũcio Jonathani akĩinũka, no Daudi agĩtigwo kũu Horeshu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ a Azifu makĩambata magĩthiĩ kũrĩ Saũlũ kũu Gibea makĩmwĩra atĩrĩ, “Githĩ Daudi ndehithĩte gatagatĩ-inĩ gaitũ ciĩhitho-inĩ cia gũkũ Horeshu, kĩrĩma-igũrũ kĩa Hakila, mwena wa gũthini wa Jeshimoni?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, wee mũthamaki, ikũrũka ũũke o rĩrĩa rĩothe ũngĩenda gũũka, na ithuĩ nĩ igũrũ riitũ kũmũneana kũrĩ mũthamaki.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ akĩmacookeria atĩrĩ, “Jehova aromũrathima nĩ ũndũ wa kwĩĩnjiiria.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thiĩi mũkehaarĩrie makĩria. Tuĩriai nĩ kũ Daudi amenyerete gũthiiaga, na nũũ ũmuonete kuo. Njĩrĩĩtwo atĩ nĩ mũndũ mwara mũno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuĩriai ũhoro wa kũrĩa guothe ehithaga na mũndehere ũhoro mũkinyanĩru. Na niĩ nĩngũcooka thiĩ na inyuĩ; angĩkorwo arĩ kũndũ gũkũ-rĩ, nĩngamũcaria mĩhĩrĩga-inĩ yothe ya Juda.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio makiumagara magĩthiĩ kũu Zifu, magĩkinya mbere ya Saũlũ. Na rĩrĩ, Daudi na andũ ake maarĩ kũu Werũ-inĩ wa Maoni, kũu Araba mwena wa gũthini wa Jeshimoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Saũlũ na andũ ake makĩambĩrĩria kũmacaria, na rĩrĩa Daudi eerirwo ũhoro ũcio, agĩikũrũka agĩthiĩ rwaro-inĩ rwa ihiga, agĩikara kũu Werũ-inĩ wa Maoni. Rĩrĩa Saũlũ aiguire ũhoro ũcio-rĩ, o nake agĩthiĩ kũu Werũ-inĩ wa Maoni aingatithĩtie Daudi na ihenya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saũlũ aagerete mwena ũmwe wa kĩrĩma, nake Daudi na andũ ake makagerera mwena ũrĩa ũngĩ, mahiũhĩte nĩguo morĩre Saũlũ. Na rĩrĩa Saũlũ na thigari ciake maakuhagĩrĩria Daudi na andũ ake nĩguo mamanyiite-rĩ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "hagĩũka mũndũ watũmĩtwo kũrĩ Saũlũ, akĩmwĩra atĩrĩ, “Ũka na ihenya! Afilisti nĩmatharĩkĩire bũrũri.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Saũlũ agĩtiga kũrũmĩrĩra Daudi, agĩthiĩ agacemanie na Afilisti. Nĩkĩo metaga handũ hau Sela-Hamalekothu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
