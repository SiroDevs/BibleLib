{
  "id": "1SA.3",
  "number": "3",
  "bookId": "1SA",
  "reference": "1 Samũeli 3",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehova gwĩta Samũeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mwana ũcio ti Samũeli aatungataga mbere ya Jehova arĩ harĩ Eli. Matukũ-inĩ macio kiugo kĩa Jehova gĩtiaiguagwo kaingĩ, na gũtionekaga cioneki kaingĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtukũ ũmwe Eli, ũrĩa maitho make maambĩrĩirie kwaga hinya akaaga kuona wega, aakomete o harĩa aamenyerete.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tawa wa Ngai ndwahorete,nake Samũeli aakomete kũu thĩinĩ wa hekarũ ya Jehova, harĩa ithandũkũ rĩa Ngai rĩarĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Jehova agĩĩta Samũeli. Samũeli agĩcookia atĩrĩ, “Niĩ ũyũ haha.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake agĩtengʼera kũrĩ Eli, akiuga atĩrĩ, “Nĩ wanjĩta; niĩ ũyũ haha.” No Eli akiuga atĩrĩ, “Niĩ ndiĩtanĩte; cooka ũgakome.” Nĩ ũndũ ũcio Samũeli agĩthiĩ agĩkoma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova agĩĩtana rĩngĩ, “Samũeli!” Nake Samũeli agĩũkĩra, agĩthiĩ kũrĩ Eli, akiuga atĩrĩ, “Nĩ wanjĩta; niĩ ũyũ haha.” Eli akiuga atĩrĩ, “Mũrũ wakwa, niĩ ndiĩtanĩte; cooka ũgakome.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo Samũeli ndaakoretwo amenyete Jehova, kana akaguũrĩrio kiugo kĩa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova nĩetire Samũeli riita rĩa gatatũ, nake Samũeli agĩũkĩra agĩthiĩ kũrĩ Eli, akiuga atĩrĩ, “Nĩ wanjĩta; niĩ ũyũ haha.” Nake Eli akĩmenya atĩ nĩ Jehova wetaga mwana ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Eli akĩĩra Samũeli atĩrĩ, “Thiĩ ũgakome, na wona aagwĩta uuge atĩrĩ, ‘Jehova, aria, nĩ ũndũ ndungata yaku nĩĩthikĩrĩirie.’ ” Nĩ ũndũ ũcio Samũeli agĩthiĩ, na agĩkoma harĩa aakomaga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova agĩũka akĩrũgama hau, agĩĩtana o ta mahinda macio mangĩ atĩrĩ, “Samũeli! Samũeli!” Nake Samũeli akiuga atĩrĩ, “Aria, nĩ ũndũ ndungata yaku nĩĩthikĩrĩirie.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova akĩĩra Samũeli atĩrĩ, “Rora, niĩ ndĩ hakuhĩ gwĩka ũndũ thĩinĩ wa Isiraeli ũrĩa ũgaatũma matũ ma mũndũ o wothe ũrĩa ũkaũigua mararake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo maũndũ marĩa mothe ndoigire ma gũũkĩrĩra Eli na nyũmba yake nĩngamahingia kuuma kĩambĩrĩria nginya mũthia.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo nĩndamwĩrire nĩngatuĩra nyũmba yake ciira nginya tene nĩ ũndũ wa mehia marĩa we oĩ ũhoro wamo; ariũ ake nĩmetuire andũ a kũmeneka, nake akĩremwo nĩ kũmakaania.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio nĩndehĩtire igũrũ rĩa nyũmba ya Eli ngiuga atĩrĩ, ‘Waganu wa nyũmba ya Eli ndũrĩ hĩndĩ ũkaahoroherio na igongona kana iruta.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samũeli agĩkoma o nginya rũciinĩ, na okĩra akĩhingũra mĩrango ya nyũmba ya Jehova. Nĩetigagĩra kwĩra Eli ũhoro wa kĩoneki kĩu,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "no Eli akĩmwĩta, akiuga atĩrĩ, “Samũeli, mũrũ wakwa.” Nake Samũeli agĩcookia atĩrĩ, “Niĩ ũyũ haha.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli akĩmũũria atĩrĩ, “Nĩ ũndũ ũrĩkũ ũcio Jehova arakwĩrire? Ndũkae kũũhitha ũndũ ũcio. Ngai arogwĩka ũndũ mũũru makĩria, ũngĩĩhitha ũndũ o na ũmwe ũrĩa arakwĩrire.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.17",
            "verseOrgIds": [
              "1SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Samũeli akĩmwĩra maũndũ mothe, na ndaamũhithire ũndũ o na ũmwe. Eli agĩcooka akiuga atĩrĩ, “Ũcio nĩ Jehova; nĩeke ũndũ ũrĩa ekuona wagĩrĩire maitho-inĩ make.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova nĩakoragwo hamwe na Samũeli o ũrĩa aakũraga, na ndaarekire kiugo o na kĩmwe gĩake kĩũrĩre thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.19",
            "verseOrgIds": [
              "1SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuo Isiraeli guothe kuuma Dani nginya Birishiba magĩkũũrana atĩ Samũeli aarĩ mũthuure atuĩke mũnabii wa Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.20",
            "verseOrgIds": [
              "1SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jehova agĩthiĩ na mbere kuonekana kũu Shilo, na kũu nĩkuo eguũrĩirie kũrĩ Samũeli na ũndũ wa kiugo gĩake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.21",
            "verseOrgIds": [
              "1SA.3.21"
            ]
          }
        }
      ]
    }
  ],
