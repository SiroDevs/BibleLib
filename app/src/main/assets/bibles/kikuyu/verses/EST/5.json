{
  "id": "EST.5",
  "number": "5",
  "bookId": "EST",
  "reference": "Esiteri 5",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
