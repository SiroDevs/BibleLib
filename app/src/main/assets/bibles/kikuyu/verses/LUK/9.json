        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 9:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩĩra mũndũ ũngĩ atĩrĩ, “Nũmĩrĩra.” No mũndũ ũcio akĩmũcookeria atĩrĩ, “Mwathani, reke nyambe thiĩ ngathike baba.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.59",
            "verseOrgIds": [
              "LUK.9.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 9:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesũ akĩmwĩra atĩrĩ, “Reke arĩa akuũ mathikage akuũ ao ene, no wee thiĩ ũkahunjie ũhoro wa ũthamaki wa Ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.60",
            "verseOrgIds": [
              "LUK.9.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 9:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mũndũ ũngĩ akĩmwĩra atĩrĩ, “Mwathani, niĩ nĩngũkũrũmĩrĩra, no reke nyambe thiĩ ngoigĩre andũ aitũ ũhoro.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.61",
            "verseOrgIds": [
              "LUK.9.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 9:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesũ akĩmũcookeria atĩrĩ, “Gũtirĩ mũndũ o na ũrĩkũ ũnyiitaga mũraũ na guoko gwake na agacooka kũrora na thuutha wagĩrĩire gũtungata ũthamaki-inĩ wa Ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.9.62",
            "verseOrgIds": [
              "LUK.9.62"
            ]
          }
        }
