{
  "id": "LUK.16",
  "number": "16",
  "bookId": "LUK",
  "reference": "Luka 16",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "LUK 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya Mũrũgamĩrĩri Indo Warĩ Mũũgĩ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesũ akĩĩra arutwo ake atĩrĩ: “Nĩ kwarĩ na mũndũ ũmwe warĩ gĩtonga, nake nĩ aarĩ na mũrori wa indo ciake mũrori ũcio nĩathitangirwo kũrĩ gĩtonga kĩu atĩ nĩaitangaga indo ciake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.1",
            "verseOrgIds": [
              "LUK.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio agĩĩta mũrori ũcio wa indo, akĩmwĩra atĩrĩ, ‘Ũhoro ũcio ndĩraigua ũgũkoniĩ nĩ ũrĩkũ? Heana ũhoro wa ithabu rĩa ũrũgamĩrĩri waku, tondũ ndũgũcooka kũndorera indo ciakwa rĩngĩ.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.2",
            "verseOrgIds": [
              "LUK.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake mũrori wa indo icio akĩĩyũria na ngoro atĩrĩ, ‘Ngwĩka atĩa rĩu? Mwathi wakwa nĩekũndigithia wĩra. Ndirĩ na hinya mũiganu wa kũrĩma, na nĩngũconoka kũhooya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.3",
            "verseOrgIds": [
              "LUK.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩu nĩndamenya ũrĩa ngwĩka nĩgeetha rĩrĩa ngaatigithio wĩra gũkũ, andũ makaanyamũkagĩra kwao mĩciĩ.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.4",
            "verseOrgIds": [
              "LUK.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nĩ ũndũ ũcio agĩĩta mũndũ o wothe warĩ na thiirĩ wa mwathi wake. Akĩũria mũndũ wa mbere atĩrĩ, ‘Wee ũrĩ na thiirĩ ũigana atĩa wa mwathi wakwa?’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.5",
            "verseOrgIds": [
              "LUK.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nake akĩmũcookeria atĩrĩ, ‘Ndĩ na thiirĩ wa marebe magana meerĩ ma maguta ma mĩtamaiyũ.’ “Mũrori ũcio akĩmwĩra atĩrĩ, ‘Oya marũa maku ma thiirĩ ũikare thĩ narua wandĩke atĩ ũrĩ na thiirĩ wa marebe igana rĩmwe.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.6",
            "verseOrgIds": [
              "LUK.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agĩcooka akĩũria mũndũ wa keerĩ atĩrĩ, ‘Na we ũrĩ na thiirĩ ũigana atĩa?’ “Nake akĩmũcookeria atĩrĩ, ‘Ndĩ na thiirĩ wa makũnia igana rĩmwe ma ngano.’ “Mũrori ũcio akĩmwĩra atĩrĩ, ‘Oya marũa maku ma thiirĩ wandĩke ũrĩ na thiirĩ wa makũnia mĩrongo ĩnana.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.7",
            "verseOrgIds": [
              "LUK.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwathi ũcio nĩagathĩrĩirie mũrũgamĩrĩri ũcio wa indo ciake ũtaarĩ mwĩhokeku nĩ ũndũ wa kũgĩa na ũũgĩ. Nĩgũkorwo andũ a gũkũ thĩ nĩ oogĩ na maũndũ mao gũkĩra andũ a ũtheri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.8",
            "verseOrgIds": [
              "LUK.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngũmwĩra atĩrĩ, hũthagĩrai ũtonga wa gũkũ thĩ na gũthondeka ũrata na andũ, nĩguo rĩrĩa ũtonga ũcio ũgaathira, mũkaamũkĩrwo ciikaro-inĩ iria cia tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.9",
            "verseOrgIds": [
              "LUK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũndũ ũrĩa wothe ũngĩĩhokerwo indo nini no ehokerwo o na indo nyingĩ, na ũrĩa wothe ũtangĩĩhokeka na indo nini o na nyingĩ ndangĩĩhokerwo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.10",
            "verseOrgIds": [
              "LUK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio mũngĩkorwo mũtarĩ ehokeku na ũtonga wa gũkũ thĩ-rĩ, nũũ ũngĩmwĩhokera ũtonga ũrĩa wa ma?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.11",
            "verseOrgIds": [
              "LUK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũngĩkorwo mũtarĩ ehokeku na indo cia andũ arĩa angĩ-rĩ, nũũ ũngĩmũhe indo cianyu ene?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.12",
            "verseOrgIds": [
              "LUK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gũtirĩ ndungata ĩngĩhota gũtungatĩra aathani eerĩ. Nĩ ũndũ no ĩthũũrire ũmwe yende ũcio ũngĩ, kana ĩĩheane harĩ ũmwe, ĩnyarare ũcio ũngĩ. Mũtingĩtungatĩra Ngai na mũtungatĩre mbeeca.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Afarisai, arĩa meendete mbeeca, rĩrĩa maiguire maũndũ macio mothe, makĩambĩrĩria gũtemba Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akĩmeera atĩrĩ, “Inyuĩ mwĩtuuaga ega maitho-inĩ ma andũ, no Ngai nĩoĩ ngoro cianyu, nĩgũkorwo ũndũ ũrĩa ũtuagwo wa bata mũno harĩ andũ, nĩguo ũrĩ magigi maitho-inĩ ma Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ũrutani Ũngĩ wa Jesũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ũhoro wa Watho na ũrutani wa Anabii watũire ũhunjagio nginya hĩndĩ ya Johana ũrĩa Mũbatithania. Kuuma hĩndĩ ĩyo, Ũhoro-ũrĩa-Mwega wa ũthamaki-wa-Ngai nĩ ũhunjagio, na mũndũ o wothe nĩehatagĩrĩria aũtoonye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũhũthũ igũrũ na thĩ gũthira, gũkĩra gaturumo karĩa kanini mũno ka Watho keherio watho-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũndũ ũrĩa wothe ũngĩtigana na mũtumia acooke ahikie mũtumia ũngĩ, ũcio nĩatharĩtie, nake mũndũ mũrũme ũrĩa ũngĩhikia mũtumia ũtiganĩte na mũthuuri-we, nĩatharĩtie.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gĩtonga na Lazaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nĩ kwarĩ mũndũ warĩ gĩtonga wehumbaga nguo cia rangi wa ndathi na cia mũthemba wa gatani ĩrĩa njega, nake nĩeekenagia o mũthenya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, kĩhingo-inĩ gĩake nĩhaigagwo mũndũ wahooyaga thendi wetagwo Lazaro, waiyũrĩtwo nĩ ironda mwĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake nĩeeriragĩria kũrĩa rũitĩki rũrĩa rwagũũaga kuuma metha-inĩ ya gĩtonga kĩu. O na ngui nacio nĩciokaga na igacũna ironda ciake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
              "LUK.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ihinda nĩrĩakinyire mũhooi thendi ũcio agĩkua, nao araika makĩmũkuua makĩmũtwara harĩ Iburahĩmu. Gĩtonga kĩu o nakĩo nĩgĩakuire na gĩgĩthikwo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩrĩ kũu icua-inĩ, kĩna ruo rũnene, gĩgĩtiira maitho, gĩkĩona Iburahĩmu arĩ haraaya, na Lazaro arĩ hau nake.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
            "verseOrgIds": [
              "LUK.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio gĩtonga gĩkĩmwĩta gĩkĩmwĩra atĩrĩ, ‘Iburahĩmu, Baba, njiguĩra tha, ũtũme Lazaro atobokie mũthia wa kĩara gĩake maaĩ-inĩ ooke aahehie rũrĩmĩ, tondũ ndĩ na ruo rũnene gũkũ mwaki-inĩ ũyũ.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.24",
            "verseOrgIds": [
              "LUK.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nowe Iburahĩmu akĩmũcookeria atĩrĩ, ‘Mũrũ wakwa, ririkana rĩrĩa watũire muoyo woonaga o maũndũ mega, hĩndĩ ĩyo Lazaro nake oonaga o maũndũ mooru, no rĩu we nĩmũnyamarũre, nawe ũrĩ ruo-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
            "verseOrgIds": [
              "LUK.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwe na ũguo-rĩ, gatagatĩ gaitũ nawe harĩ na mũkuru mũriku mũno wĩkĩrĩtwo, nĩguo arĩa mangĩenda kuuma gũkũ tũrĩ moke kũrĩ we matikaahote, o na gũtirĩ mũndũ ũngiuma kũu akĩre ooke gũkũ tũrĩ.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.26",
            "verseOrgIds": [
              "LUK.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakĩo gĩtonga kĩu gĩgĩcookia atĩrĩ, ‘Ndagĩgũthaitha, baba, ũtũme Lazaro kũrĩ andũ a nyũmba ya baba,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgũkorwo ndĩ na ariũ a baba atano. Reke athiĩ akamahe ũhoro, nĩguo matikanooke gũkũ kũrĩ na ruo rũnene ũũ.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iburahĩmu akĩmũcookeria atĩrĩ, ‘Marĩ na Musa na Anabii; nĩmamathikĩrĩrie.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakĩo gĩtonga gĩkĩmwĩra atĩrĩ, ‘Iburahĩmu, baba, acio ti aiganu; mũndũ angĩthiĩ kũrĩ o oimĩte kũrĩ arĩa akuũ, no merire.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agĩkĩmũcookeria atĩrĩ, ‘Angĩkorwo matingĩigua Musa na Anabii, o na mũndũ angĩriũka kuuma kũrĩ arĩa akuũ matingĩmũigua.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.31",
            "verseOrgIds": [
              "LUK.16.31"
            ]
          }
        }
      ]
