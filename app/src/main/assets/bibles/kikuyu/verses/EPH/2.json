{
  "id": "EPH.2",
  "number": "2",
  "bookId": "EPH",
  "reference": "Aefeso 2",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
