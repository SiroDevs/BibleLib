{
  "id": "2SA.10",
  "number": "10",
  "bookId": "2SA",
  "reference": "2 Samũeli 10",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2SA 10"
      },
