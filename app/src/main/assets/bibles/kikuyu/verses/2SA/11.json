{
  "id": "2SA.11",
  "number": "11",
  "bookId": "2SA",
  "reference": "2 Samũeli 11",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "2SA 11"
      },
      "items": [
        {
