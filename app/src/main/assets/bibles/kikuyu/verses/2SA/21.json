{
  "id": "2SA.21",
  "number": "21",
  "bookId": "2SA",
  "reference": "2 Samũeli 21",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
