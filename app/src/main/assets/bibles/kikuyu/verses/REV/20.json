{
  "id": "REV.20",
  "number": "20",
  "bookId": "REV",
  "reference": "Kũguũrĩrio 20",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
