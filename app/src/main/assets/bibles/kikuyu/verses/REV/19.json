{
  "id": "REV.19",
  "number": "19",
  "bookId": "REV",
  "reference": "Kũguũrĩrio 19",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "REV 19"
      },
