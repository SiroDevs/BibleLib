              "REV.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rĩrĩa athamaki a thĩ arĩa maatharagia nake na makagwatanĩra nake mĩago-inĩ yake makoona ndogo yake akĩhĩa-rĩ, nĩmakamũrĩrĩra na mamũcakaĩre.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makaarũgama haraaya nĩ ũndũ wa gwĩtigĩra kĩnyariirĩko gĩake, nao marĩre, makiugaga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Onjoria a thĩ nĩmakamũrĩrĩra na mamũcakaĩre, tondũ gũtirĩ mũndũ ũgaacooka kũgũra indo ciao rĩngĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "indo cia thahabu, na betha, na mahiga ma goro, na ruru; ningĩ mataama ma gatani ĩrĩa njega, na marĩa ma rangi wa ndathi, na marĩa ma hariri, na mataama marĩa matune ta gakarakũ; ningĩ mĩthemba yothe ya mĩtĩ ĩrĩa mĩnungi wega, na indo cia mĩthemba yothe iria ithondeketwo na mĩguongo, na mbaũ cia goro, na gĩcango, na kĩgera, na mahiga mathaka ma nyaigĩ;",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.12",
            "verseOrgIds": [
              "REV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ningĩ mĩrigo ya ndarathini na iriki, na ya ũbumba, na maguta marĩa manungi wega, na ũbani, na ya ndibei na maguta ma ndamaiyũ, na ya mũtu ũrĩa mũhinyu mũno, o na ngano; ningĩ ngʼombe na ngʼondu; o na mbarathi na makaari; nginya ngombo o na mĩoyo ya andũ o nayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.13",
            "verseOrgIds": [
              "REV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nao nĩmakoiga atĩrĩ, ‘Itunda rĩrĩa weriragĩria nĩrĩkwehereire. Ũtonga waku wothe o na ũkengi waku nĩithirĩte, na gũtirĩ hĩndĩ igaacooka kuoneka o na rĩ.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.14",
            "verseOrgIds": [
              "REV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onjoria arĩa meendagia indo icio na magĩtonga kuuma kũrĩ we-rĩ, makaarũgama o haraaya nĩ ũndũ wa gwĩtigĩra kĩnyariirĩko gĩake. Nĩmakarĩra, na macakae,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.15",
            "verseOrgIds": [
              "REV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na maanĩrĩre, moige atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Anene othe a marikabu cia iria-inĩ, na arĩa othe mathiiaga na marikabu, atwarithia a marikabu, na arĩa othe marutaga wĩra kũu iria-inĩ rĩrĩa inene, makaarũgama o haraaya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa makoona ndogo ya itũũra rĩu rĩkĩhĩa-rĩ, nĩmakanĩrĩra moige atĩrĩ, ‘Kũrĩ kwagĩa itũũra rĩngĩ inene ta itũũra rĩĩrĩ?’",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nĩmakehurĩria rũkũngũ mĩtwe o makĩrĩraga na magĩcakayaga, na makae, makiugaga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.20",
            "verseOrgIds": [
              "REV.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũraika ũrĩ hinya akĩoya ihiga rĩaiganaga ta ihiga inene rĩa gĩthĩi, akĩrĩikia thĩinĩ wa iria rĩrĩa inene, akiuga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.21",
            "verseOrgIds": [
              "REV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
