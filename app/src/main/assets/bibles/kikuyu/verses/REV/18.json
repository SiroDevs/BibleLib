            "verseOrgIds": [
              "REV.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
