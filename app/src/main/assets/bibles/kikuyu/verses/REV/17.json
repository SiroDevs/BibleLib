{
  "id": "REV.17",
  "number": "17",
  "bookId": "REV",
  "reference": "Kũguũrĩrio 17",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
