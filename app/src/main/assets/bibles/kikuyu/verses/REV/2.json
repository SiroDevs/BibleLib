              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ta ũrĩa niĩ heetwo wathani uumĩte kũrĩ Baba.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
