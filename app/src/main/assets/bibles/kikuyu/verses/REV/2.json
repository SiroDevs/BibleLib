          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ningĩ nĩngamũhe njata ĩrĩa ya rũciinĩ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.28",
            "verseOrgIds": [
