{
  "id": "REV.16",
  "number": "16",
  "bookId": "REV",
  "reference": "Kũguũrĩrio 16",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "REV 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbakũri Mũgwanja cia Mangʼũrĩ ma Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ ngĩigua mũgambo mũnene ũkiuma thĩinĩ wa hekarũ, naguo ũkĩĩra araika acio mũgwanja atĩrĩ, “Thiĩi, mũkonorerie thĩ mbakũri icio mũgwanja cia mangʼũrĩ ma Ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũraika wa mbere agĩthiĩ akĩonoreria mbakũri yake thĩ, nacio ironda njũru mũno irĩ ruo ikĩgĩa andũ arĩa maarĩ na rũũri rwa nyamũ ĩyo, na arĩa maahooyaga mũhiano wayo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũraika wa keerĩ akĩonoreria mbakũri yake iria-inĩ rĩrĩa inene, narĩo iria rĩu rĩkĩgarũrũka rĩgĩtuĩka ta thakame ya mũndũ mũkuũ, nakĩo kĩndũ o gĩothe kĩarĩ muoyo iria-inĩ rĩu gĩgĩkua.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũraika wa gatatũ akĩonoreria mbakũri yake njũũĩ-inĩ na ithima-inĩ cia maaĩ, nacio igĩtuĩka thakame.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩcooka ngĩigua mũraika ũrĩa wathaga maaĩ akiuga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.6",
            "verseOrgIds": [
              "REV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ngĩigua kĩgongona gĩacookia atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.7",
            "verseOrgIds": [
              "REV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũraika wa kana akĩonoreria mbakũri yake riũa-inĩ, narĩo riũa rĩkĩheo hinya wa gũcina andũ na mwaki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ magĩcinwo nĩ ũrugarĩ ũcio mũnene, nao magakĩrumaga rĩĩtwa rĩa Ngai ũcio warĩ na hinya wa gwatha mĩthiro ĩyo, no matiigana kwĩrira mamũgooce.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũraika wa gatano akĩonoreria mbakũri yake gĩtĩ-inĩ kĩa ũnene kĩa nyamũ ĩrĩa, naguo ũthamaki wayo ũkĩiyũra nduma. Nao andũ makĩĩrũma nĩmĩ nĩ ũndũ wa ruo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makĩruma Ngai wa igũrũ nĩ ũndũ wa ruo rũrĩa maiguaga na nĩ ũndũ wa ironda iria maarĩ nacio, no matiigana kwĩrira nĩ ũndũ wa maũndũ marĩa meekĩte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũraika wa gatandatũ akĩonoreria mbakũri yake rũũĩ-inĩ rũrĩa rũnene rwa Farati, namo maaĩ maruo makĩhwa nĩguo athamaki a kuuma mwena wa Irathĩro mathondekerwo njĩra.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.12",
            "verseOrgIds": [
              "REV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngĩcooka ngĩona maroho matatũ mooru maahaanaga ta ciũra;namo moimire kanua ka ndamathia, na makiuma kanua ka nyamũ ĩrĩa, na kanua-inĩ ka mũnabii ũrĩa wa maheeni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.13",
            "verseOrgIds": [
              "REV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo nĩmo maarĩ maroho ma ndaimono marĩa maringaga ciama, namo mathiiaga kũrĩ athamaki a thĩ yothe, nĩguo mamacookanĩrĩrie nĩ ũndũ wa mbaara ĩrĩa ĩkaarũo mũthenya ũcio mũnene wa Ngai Mwene-Hinya-Wothe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.14",
            "verseOrgIds": [
              "REV.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na rĩrĩ, ngũũka o ta mũici! Kũrathimwo-rĩ, nĩ mũndũ ũrĩa ũikaraga eiguĩte na agaikara ahaarĩirie nguo ciake, nĩgeetha ndakanae gũthiĩ njaga, nake aconorithio.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo maroho macio magĩcookanĩrĩria athamaki handũ harĩa hetagwo na Kĩhibirania, Arimagedoni.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.16",
            "verseOrgIds": [
              "REV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũraika wa mũgwanja akĩonoreria mbakũri yake rĩera-inĩ, na rĩrĩ, hekarũ thĩinĩ gũkiuma mũgambo mũnene uumĩte gĩtĩ-inĩ kĩa ũnene, ũkiuga atĩrĩ, “Ũhoro ũcio nĩwarĩĩka!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gũgĩcooka gũkĩgĩa heni, na marurumĩ, na ngwa o na gĩthingithia kĩnene. Gũtirĩ kwagĩa gĩthingithia kĩngĩ kĩnene ta kĩu kuuma rĩrĩa thĩ kwagĩire andũ, nĩ ũrĩa gĩthingithia kĩu kĩarĩ kĩnene mũno.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.18",
            "verseOrgIds": [
              "REV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narĩo itũũra rĩrĩa inene rĩgĩatũkana njatũ ithatũ, namo matũũra ma ndũrĩrĩ makĩmomoka. Nake Ngai akĩririkana Babuloni itũũra rĩrĩa inene, na akĩrĩhe gĩkombe kĩaiyũrĩtio ndibei ya ũrũrũ wa mangʼũrĩ make.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.19",
            "verseOrgIds": [
              "REV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio icigĩrĩra ikĩũra ciothe, nacio irĩma ikĩaga gũcooka kuoneka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.20",
            "verseOrgIds": [
              "REV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo mahiga manene ma mbura ya mbembe, ma ũritũ wa ta kilo mĩrongo ĩtano o ihiga, makĩgwĩra andũ. Nao makĩruma Ngai nĩ ũndũ wa mũthiro ũcio wa mahiga ma mbura ya mbembe, tondũ mũthiro ũcio warĩ wa kũmakania mũno.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.21",
            "verseOrgIds": [
              "REV.16.21"
            ]
          }
        }
      ]
    }
  ],
