{
  "id": "2KI.20",
  "number": "20",
  "bookId": "2KI",
  "reference": "2 Athamaki 20",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "2KI 20"
      },
