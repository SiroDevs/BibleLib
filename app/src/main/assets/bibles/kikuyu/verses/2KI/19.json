              "2KI.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũtukũ o ro ũcio mũraika wa Jehova agĩthiĩ akĩũraga andũ 185,000 kũu kambĩ ya Ashuri. Rĩrĩa andũ mookĩrire rũciinĩ tene, magĩkora kũu no ciimba theri!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.35",
            "verseOrgIds": [
              "2KI.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Senakeribu mũthamaki wa Ashuri agĩtharia kambĩ agĩthiĩ. Agĩcooka Nineve agĩikara kuo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, mũthenya ũmwe, rĩrĩa aahooyaga arĩ hekarũ-inĩ ya ngai yake Nisiroku, ariũ ake eerĩ Adarameleki na Sharezeru makĩmũũraga na rũhiũ rũa njora, na makĩũrĩra bũrũri wa Ararati. Nake mũriũ Esari-Hadoni agĩtuĩka mũthamaki ithenya rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.37",
            "verseOrgIds": [
              "2KI.19.37"
            ]
          }
        }
