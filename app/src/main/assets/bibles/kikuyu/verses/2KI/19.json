            "number": "28",
            "style": "v",
            "sid": "2KI 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.28",
            "verseOrgIds": [
              "2KI.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gĩkĩ nĩkĩo gĩgaakorwo kĩrĩ kĩmenyithia gĩaku, wee Hezekia:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩyo kĩa Jehova Mwene-Hinya-Wothe nĩkĩo gĩkaahingia ũguo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nĩ ũndũ ũcio Jehova ekuuga ũũ igũrũ rĩa mũthamaki wa Ashuri:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 19:34"
          },
          "items": [
            {
              "text": "34",
