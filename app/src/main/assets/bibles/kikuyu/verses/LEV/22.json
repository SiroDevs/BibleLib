{
  "id": "LEV.22",
  "number": "22",
  "bookId": "LEV",
  "reference": "Alawii 22",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "LEV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maruta marĩa Ngai Angĩĩtĩkĩra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ĩra Harũni na ariũ ake matĩĩage maruta marĩa matheru marĩa andũ a Isiraeli maanyamũrĩire, nĩgeetha matikanathaahie rĩĩtwa rĩakwa itheru. Niĩ nĩ niĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Meere atĩrĩ, ‘Njiarwa iria igooka thuutha, mũndũ o na ũrĩkũ wa njiaro cianyu angĩgakorwo ethaahĩtie, nake akuhĩrĩrie maruta marĩa matheru marĩa andũ a Isiraeli maamũrĩire Jehova, mũndũ ũcio no nginya aingatwo, ehere mbere yakwa. Niĩ nĩ niĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mũndũ wa njiaro cia Harũni angĩkorwo arĩ na mũrimũ wa ngoothi ũngĩgwatanio, kana mwĩrĩ wake ũkoira, ndakaarĩa indo iria theru irutĩtwo cia maruta, nginya agaathirwo nĩ thaahu. Ningĩ nĩakanyiitwo nĩ thaahu angĩkaahutia kĩndũ gĩthaahie nĩ kĩimba, kana ahutie mũndũ o wothe ũrĩa uumĩtwo nĩ hinya wa arũme,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na kana angĩhutia kĩndũ o gĩothe kĩrĩa gĩtambaga thĩ kĩrĩa kĩngĩmũgwatia thaahu, kana ahutie mũndũ o na ũrĩkũ ũngĩtũma anyiitwo nĩ thaahu, o na thaahu ũcio ũngĩkorwo nĩ ũrĩkũ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũrĩa ũngĩhutia kĩndũ o na kĩrĩkũ ta kĩu nĩakanyiitwo nĩ thaahu o nginya hwaĩ-inĩ. Ndakanarĩe kĩndũ o na kĩrĩkũ kĩa maruta marĩa maamũre, no akorirwo ethambĩte mwĩrĩ na maaĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riũa rĩathũa nĩagathirwo nĩ thaahu, na thuutha ũcio no arĩe maruta marĩa maamũre, tondũ nĩcio irio ciake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanarĩe nyama cia nyamũ ĩkuĩte, kana nyama cia nyamũ ĩtambuurĩtwo nĩ nyamũ cia gĩthaka, nĩguo ndakae gũthaahio nĩcio. Niĩ nĩ niĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Athĩnjĩri-Ngai nĩmarũmagie mawatho makwa nĩgeetha matikahĩtagie, nao makue nĩ ũndũ wa kwaga gũtĩĩa mawatho macio. Niĩ nĩ niĩ Jehova ũrĩa ũmatheragia.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Gũtirĩ mũndũ o na ũrĩkũ ũtarĩ wa nyũmba ya mũthĩnjĩri-Ngai wagĩrĩirwo nĩ kũrĩa maruta marĩa matheru, o na mũgeni wa mũthĩnjĩri-Ngai, kana mũruti wa wĩra gwake o nao matigacirĩe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mũthĩnjĩri-Ngai angĩgũra ngombo na mbeeca, kana ngombo ĩciarĩrwo gwake mũciĩ, ngombo ĩyo no ĩrĩe irio ciake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwarĩ wa mũthĩnjĩri-Ngai angĩhikio nĩ mũndũ ũtarĩ mũthĩnjĩri-Ngai, ndakanarĩe kĩndũ o na kĩmwe kĩa maruta macio matheru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mwarĩ wa mũthĩnjĩri-Ngai angĩtuĩka mũtumia wa ndigwa, kana matigane na mũthuuriwe na ndarĩ ciana, nake acooke agaikare gwa ithe o ta rĩrĩa aarĩ mwĩthĩ, no arĩe irio icio nyamũre cia ithe. No mũndũ ũtetĩkĩrĩtio, ndakanarĩe kĩndũ o na kĩmwe gĩacio.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mũndũ o wothe angĩrĩa maruta matheru atekũmenya, no nginya acookerie mũthĩnjĩri-Ngai kĩndũ kĩu kĩamũre arĩĩte na ongerere gĩcunjĩ gĩa gatano gĩa thogora wakĩo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athĩnjĩri-Ngai matikanathaahie maruta marĩa matheru marĩa andũ a Isiraeli marutagĩra Jehova,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũndũ wa kũmetĩkĩria marĩe maruta macio matheru, na ũguo ũtũme mũcookererwo nĩ mahĩtia marĩa mũngĩrĩhio. Niĩ nĩ niĩ Jehova ũrĩa ũmatheragia.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Magongona marĩa Matangĩĩtĩkĩrĩka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arĩria Harũni na ariũ ake, na warĩrie andũ a Isiraeli othe, ũmeere atĩrĩ: ‘Mũndũ o na ũrĩkũ thĩinĩ wanyu, arĩ Mũisiraeli kana arĩ mũgeni ũtũũraga Isiraeli, angĩkaarutĩra Jehova kĩheo kĩa iruta rĩa njino nĩ ũndũ wa kũhingia mwĩhĩtwa, kana kĩrĩ kĩa iruta rĩa kwĩyendera,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "no nginya akaaruta njamba ĩtarĩ na kaũũgũ kuuma kũrĩ ngʼombe, kana ngʼondu, kana mbũri, nĩgeetha kĩheo kĩu gĩĩtĩkĩrĩke handũ-inĩ hanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikanarehe kĩndũ o na kĩrĩkũ kĩrĩ na kaũũgũ, tondũ gĩtigeetĩkĩrĩka handũ-inĩ hanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa mũndũ arĩĩrutaga kĩndũ kiumĩte rũrũ-inĩ rwake rwa ngʼombe kana rwa mbũri, kĩrĩ kĩa iruta rĩa ũiguano rĩa kũrutĩrwo Jehova, nĩguo ahingie mwĩhĩtwa wa mwanya, kana kĩa iruta rĩa kwĩyendera, no nginya gĩkoragwo gĩtarĩ na kaũũgũ kana kameni nĩguo gĩĩtĩkĩrĩke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikanarutĩre Jehova nyamũ ndumumu kana ndihie, kana ĩrathua, kana kĩndũ o gĩothe kĩrĩ na mbatata, kana kĩrĩ na ironda iratogota kana iroira. Mũtikanaigĩrĩre o na ĩmwe ya icio kĩgongona-inĩ ĩtuĩke ya iruta rĩa gũcinwo na mwaki harĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, no mũrute ndegwa, kana ngʼondu nyonju kana homu, ĩrĩ ya igongona rĩa kwĩyendera, no ĩyo ndĩngĩtĩkĩrwo ĩtuĩke ya kũhingia mwĩhĩtwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikanarutĩre Jehova nyamũ ĩrĩa ĩtihĩtio nyee, kana ĩkamendereka, kana ndarũre, kana hakũre. Mũtikanarute magongona ta macio bũrũri-inĩ wanyu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mũtikanamũkĩre nyamũ ta icio kuuma kũrĩ mũndũ mũgeni atĩ nĩguo mũcirute ituĩke irio cia Ngai wanyu. Nyamũ ta icio itingĩtĩkĩrĩka handũ-inĩ hanyu, nĩ ũndũ nĩ nyonju, na irĩ na ũũgũ.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rĩrĩa gacaũ, kana gatũrũme, kana koori gaaciarwo, karĩikaraga na nyina mĩthenya mũgwanja. Kuuma mũthenya wa kanana na thuutha ũcio, nĩgagetĩkĩrĩka gatuĩke iruta rĩa gũcinwo na mwaki harĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikanathĩnje ngʼombe kana ngʼondu hamwe na mwana wayo mũthenya ũmwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rĩrĩa mũkũruta igongona rĩa gũcookeria Jehova ngaatho, rĩrutagei na njĩra ya gũtũma rĩtĩkĩrĩke nĩ ũndũ wanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No nginya rĩrĩĩo mũthenya o ro ũcio rĩarutwo; mũtikanatigie kĩndũ kĩarĩo gĩkinyie rũciinĩ. Niĩ nĩ niĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rũmagiai maathani makwa na mũmarũmagĩrĩre. Niĩ nĩ niĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtikanathaahie rĩĩtwa rĩakwa itheru. No nginya andũ a Isiraeli mamenyage atĩ ndĩ mũtheru. Niĩ nĩ niĩ Jehova ũrĩa ũmũtheragia,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũrĩa wamũrutire bũrũri wa Misiri nduĩke Ngai wanyu. Niĩ nĩ niĩ Jehova.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        }
      ]
    }
