  "bookId": "LEV",
  "reference": "Alawii 23",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "LEV 23"
      },
      "items": [
        {
          "text": "23",
