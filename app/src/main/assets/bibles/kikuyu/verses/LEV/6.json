          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ mũrũme o wothe wa nyũmba ya mũthĩnjĩri-Ngai no arĩe nyama icio; iruta rĩu nĩ itheru mũno makĩria.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No iruta o rĩothe rĩa mehia rĩrĩa thakame yarĩo ĩtwarĩtwo thĩinĩ wa Hema-ya-Gũtũnganwo, ĩrĩ ya kũhorohanĩria thĩinĩ wa Handũ-Harĩa-Hatheru-rĩ, rĩtikanarĩĩo; no nginya rĩcinwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.30",
            "verseOrgIds": [
              "LEV.6.30"
            ]
          }
        }
