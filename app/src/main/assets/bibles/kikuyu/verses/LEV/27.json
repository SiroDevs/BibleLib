{
  "id": "LEV.27",
  "number": "27",
  "bookId": "LEV",
  "reference": "Alawii 27",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "LEV 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũkũũra Kĩndũ Kĩamũrĩirwo Jehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Jehova akĩĩra Musa atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arĩria andũ a Isiraeli, ũmeere atĩrĩ: ‘Mũndũ o wothe angĩkeehĩta mwĩhĩtwa wa mwanya wa kwamũrĩra Jehova andũ, na ũndũ wa kũruta indo iria ciiganĩire iruta rĩu,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩũgaatua irĩhi rĩa mũndũ mũrũme wa kuuma mĩaka mĩrongo ĩĩrĩ nginya mĩaka mĩrongo ĩtandatũ rĩkorwo rĩrĩ cekeri mĩrongo ĩtano cia betha,kũringana na cekeriya handũ-harĩa-haamũre,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na aakorwo nĩ mũndũ-wa-nja, ũgaatua irĩhi rĩkorwo rĩrĩ cekeri mĩrongo ĩtatũ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakorwo nĩ mũndũ wa kuuma mĩaka ĩtano nginya mĩrongo ĩĩrĩ, ũgaatua irĩhi rĩa mũndũ mũrũme rĩtuĩke nĩ cekeri mĩrongo ĩĩrĩ,na irĩhi rĩa mũndũ-wa-nja nĩ cekeri ikũmi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakorwo nĩ mũndũ wa kuuma mweri ũmwe nginya mĩaka ĩtano, ũgaatua irĩhi rĩa kahĩĩ rĩtuĩke nĩ cekeri ithano cia betha,na irĩhi rĩa kairĩtu nĩ cekeri ithatũ cia betha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aakorwo nĩ mũndũ wa mĩaka mĩrongo ĩtandatũ kana makĩrĩa, ũgaatua irĩhi rĩa mũndũ mũrũme rĩtuĩke nĩ cekeri ikũmi na ithano,na rĩa mũndũ-wa-nja nĩ cekeri ikũmi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo mũndũ ũrĩa wĩhĩtĩte mwĩhĩtwa nĩ mũthĩĩni mũno ndaangĩhota kũrĩha irĩhi rĩrĩa rĩtuĩtwo, nĩagatwara mũndũ ũcio kũrĩ mũthĩnjĩri-Ngai, ũrĩa ũgaatua irĩhi rĩrĩa mũndũ ũcio wĩhĩtĩte mwĩhĩtwa angĩhota kũrĩha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Angĩkorwo kĩndũ kĩrĩa eeranĩire na mwĩhĩtwa nĩ nyamũ ĩngĩĩtĩkĩrĩka ĩrĩ iruta kũrĩ Jehova, nyamũ ta ĩyo ĩheanĩtwo kũrĩ Jehova ĩrĩtuĩkaga nĩ nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakanamĩkũũranie kana amĩgarũranie, aige ĩrĩa njega ithenya rĩa ĩrĩa njũru, kana aige ĩrĩa njũru ithenya rĩa ĩrĩa njega; angĩgakũũrania nyamũ ĩyo na ĩngĩ, cierĩ ĩyo ya mbere na ĩyo ya gũkũũranio nĩigatuĩka nyamũre.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo kĩndũ kĩu ehĩtĩte kũruta nĩ nyamũ ĩrĩ na thaahu, ĩrĩa ĩtangĩĩtĩkĩrĩka ĩrĩ iruta kũrĩ Jehova,nyamũ ĩyo no nginya ĩtwarĩrwo mũthĩnjĩri-Ngai,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũrĩa ũgaatua kana nĩ njega kana ti njega. Thogora ũrĩa mũthĩnjĩri-Ngai agaatua, ũcio nĩguo ũgaatuĩka thogora wayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo mwene no ende gũkũũra nyamũ ĩyo, no nginya ongerere gĩcunjĩ kĩngĩ gĩa ithano harĩ thogora ũrĩa ũtuĩtwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Mũndũ angĩamũra nyũmba yake ĩrĩ kĩndũ kĩamũrĩirwo Jehova, mũthĩnjĩri-Ngai nĩagatua itua kana nĩ njega kana ti njega. Thogora ũrĩa mũthĩnjĩri-Ngai agaatua, ũcio nĩguo ũgaatuĩka thogora wayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũrĩa wamũrĩte nyũmba yake angĩmĩkũũra-rĩ, no nginya ongerere gĩcunjĩ kĩngĩ gĩa ithano gĩa thogora wayo, nayo nyũmba ĩyo nĩĩgatuĩka yake rĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Angĩkorwo mũndũ nĩakamũrĩra Jehova gĩcunjĩ kĩa mũgũnda wa nyũmba yao, thogora waguo ũgaatuuo kũringana na mbeũ iria ingĩhaandwo, nacio nĩ cekeri mĩrongo ĩtano cia betha, iria arĩ kĩbaba kĩmwe kĩa omeriya mbeũ cia cairi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkaamũra mũgũnda wake Mwaka-inĩ wa Jubilii, thogora ũrĩa ũtuĩtwo nĩguo ũgaatuĩka thogora waguo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "No angĩamũra mũgũnda wake thuutha wa Jubilii, mũthĩnjĩri-Ngai nĩagatua thogora kũringana na mĩaka ĩrĩa ĩtigarĩte Jubilii ĩrĩa ĩngĩ ĩgĩgaakinya, naguo thogora waguo nĩũkanyihanyiihio.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ũcio wamũrĩte mũgũnda wake angĩenda kũũkũũra, nĩakongerera gĩcunjĩ kĩngĩ gĩa ithano harĩ thogora waguo, mũgũnda ũcio ũcooke ũtuĩke wake rĩngĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, angĩkorwo ndegũkũũra mũgũnda ũcio, kana aakorwo nĩawendeirie mũndũ ũngĩ, mũgũnda ũcio ndũrĩ hĩndĩ ũgaakũũrwo o na rĩ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa mũgũnda ũcio ũkaarekererio Mwaka-inĩ wa Jubilii, nĩũgatuĩka mwamũre, o ta mũgũnda wamũrĩirwo Jehova; ũgaatuĩka mũgũnda wa athĩnjĩri-Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ningĩ mũndũ angĩkaamũrĩra Jehova mũgũnda ũrĩa agũrĩte, na ti mũgũnda wa nyũmba yao,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũthĩnjĩri-Ngai nĩagatua thogora waguo nginya Mwaka wa Jubilii, nake mũndũ ũcio nĩakarĩha irĩhi rĩu mũthenya ũcio taarĩ kĩndũ kĩamũrĩirwo Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka-inĩ wa Jubilii, mũgũnda ũcio nĩũgacookerera mwene ũrĩa wamwendeirie, ũrĩa warĩ mwene mũgũnda ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thogora wothe ũrĩtuagwo kũringana na cekeri ya handũ-harĩa-haamũre, nacio nĩ geera mĩrongo ĩĩrĩ harĩ cekeri ĩmwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Na rĩrĩ, gũtirĩ mũndũ ũngĩamũrĩra Jehova irigithathi rĩa nyamũ, nĩ ũndũ marigithathi mothe nĩ ma Jehova; arĩ ndegwa, kana ngʼondu, icio nĩ cia Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo nĩ nyamũ ĩmwe ya iria irĩ thaahu, no amĩgũre na thogora ũrĩa ĩtuĩrĩirwo, ongerere gĩcunjĩ kĩngĩ gĩa ithano harĩ thogora ũcio. Aakorwo ndekũmĩkũũra, nyamũ ĩyo nĩĩkeendio na thogora ũrĩa ũtuĩtwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘No gũtirĩ kĩndũ kĩa mũndũ kĩrĩa aamũrĩire Jehova, arĩ mũndũ, kana nyamũ, kana mũgũnda wa nyũmba yao, kĩngĩendio kana gĩkũũrwo; indo ciothe ciamũrĩirwo Jehova nĩ nyamũre harĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Na rĩrĩ, gũtirĩ mũndũ wamũrĩirwo kũũragwo ũngĩkũũrwo; no nginya ooragwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Gĩcunjĩ gĩa ikũmi kĩa indo ciothe cia kuuma mũgũnda, arĩ ngano ya mũgũnda kana maciaro ma mĩtĩ, nĩ kĩa Jehova; gĩcunjĩ kĩu kĩamũrĩirwo Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ angĩgakũũra gĩcunjĩ gĩake gĩa ikũmi, no nginya akongerera gĩcunjĩ kĩngĩ gĩa ithano harĩ thogora ũrĩa ũtuĩtwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gĩcunjĩ gĩa ikũmi gĩothe kĩa rũũru rwa ngʼombe kana rwa mbũri, nyamũ ya ikũmi yothe ĩrĩa ĩhĩtũkagĩra rungu rwa rũthanju rwa mũrĩithi nĩĩkamũrĩrwo Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũndũ ndagathuure ĩrĩa njega kana ĩrĩa njũru, kana akũũranie. Angĩgakũũrania nyamũ ĩyo na ĩngĩ, cierĩ, ya mbere na ĩyo ya gũkũũranio, nĩ igaatuĩka nyamũre, na icio itingĩkũũrwo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macio nĩmo maathani marĩa Jehova aaheire Musa Kĩrĩma-inĩ gĩa Sinai makoniĩ andũ a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        }
      ]
    }
