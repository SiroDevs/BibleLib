{
  "id": "MAT.14",
  "number": "14",
  "bookId": "MAT",
  "reference": "Mathayo 14",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "MAT 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Johana Mũbatithania Kũrengwo Mũtwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, hĩndĩ ĩyo, Mũthamaki Herode nĩaiguire ngumo ya Jesũ,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake akĩĩra arĩa maamũtungataga atĩrĩ, “Ũcio nĩ Johana Mũbatithania; nĩ ariũkĩte kuuma kũrĩ arĩa akuũ! Nĩkĩo arĩ na hinya mũnene ũguo wa kũringa ciama.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.2",
            "verseOrgIds": [
              "MAT.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, Herode nĩanyiitĩte Johana akamuoha, na akamũikia njeera nĩ ũndũ wa Herodia, ũrĩa warĩ mũtumia wa mũrũ wa nyina Filipu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.3",
            "verseOrgIds": [
              "MAT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tondũ Johana nĩamwĩrĩte atĩrĩ: “Watho ndũgwĩtĩkĩrĩtie ũmũhikie.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.4",
            "verseOrgIds": [
              "MAT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode nĩendaga kũũraga Johana, no nĩetigagĩra andũ, tondũ nĩmeetĩkĩtie atĩ Johana aarĩ mũnabii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.5",
            "verseOrgIds": [
              "MAT.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya wa gũkũngũĩra gũciarwo kwa Herode-rĩ, mwarĩ wa Herodia nĩainĩire andũ, na agĩkenia Herode mũno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.6",
            "verseOrgIds": [
              "MAT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Herode akĩĩhĩta na mwĩhĩtwa atĩ nĩekũmũhe kĩrĩa gĩothe angĩendire.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.7",
            "verseOrgIds": [
              "MAT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mũirĩtu ũcio aarĩkia gũtaarwo nĩ nyina, akiuga atĩrĩ, “He mũtwe wa Johana Mũbatithania o rĩu ũrĩ thĩinĩ wa kiuga.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.8",
            "verseOrgIds": [
              "MAT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthamaki nĩataangĩkire mũno, no nĩ ũndũ wa mwĩhĩtwa wake, na ageni arĩa maarĩ iruga-inĩ rĩake-rĩ, agĩathana atĩ mũirĩtu ũcio aheo kĩrĩa eetĩtie.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.9",
            "verseOrgIds": [
              "MAT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio agĩtũmana kũu njeera na Johana akĩrengwo mũtwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.10",
            "verseOrgIds": [
              "MAT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo mũtwe ũcio wake ũkĩrehwo na kiuga, ũkĩnengerwo mũirĩtu ũcio, nake akĩũtwarĩra nyina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.11",
            "verseOrgIds": [
              "MAT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao arutwo a Johana magĩthiĩ makĩoya kĩimba gĩake, magĩgĩthika, magĩcooka magĩthiĩ makĩĩra Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.12",
            "verseOrgIds": [
              "MAT.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesũ Kũhũũnia Andũ Ngiri Ithano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩa Jesũ aiguire ũhoro ũcio, akiuma kũu ahaicĩte gatarũ andũ matekũmenya, agĩthiĩ handũ hataarĩ na andũ. Nakĩo kĩrĩndĩ kĩaigua ũguo-rĩ, gĩkiuma matũũra-inĩ gĩkĩmũrũmĩrĩra na magũrũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.13",
            "verseOrgIds": [
              "MAT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Jesũ oimire gatarũ na akĩona andũ aingĩ, akĩmaiguĩra tha, na akĩhonia arũaru ao.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.14",
            "verseOrgIds": [
              "MAT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na gwakuhĩrĩria gũtuka-rĩ, arutwo ake magĩthiĩ harĩ we, makĩmwĩra atĩrĩ, “Gũkũ nĩ kũndũ gũtarĩ mĩciĩ, na nĩkũratuka. Ĩra andũ aya mathiĩ, nĩgeetha makegũrĩre irio tũtũũra-inĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.15",
            "verseOrgIds": [
              "MAT.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesũ akĩmacookeria atĩrĩ, “Hatirĩ bata wa mathiĩ. Mahei gĩa kũrĩa inyuĩ ene.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makĩmũcookeria atĩrĩ, “Haha tũrĩ na mĩgate ĩtano tu na thamaki igĩrĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.17",
            "verseOrgIds": [
              "MAT.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akĩmeera atĩrĩ, “Ndeherai haha.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake agĩathana andũ maikare thĩ nyeki-inĩ. Akĩoya mĩgate ĩyo ĩtano na thamaki icio igĩrĩ, akĩrora igũrũ, agĩcookia ngaatho, akĩenyũranga mĩgate ĩyo. Agĩcooka akĩmĩnengera arutwo, nao arutwo makĩhe andũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.19",
            "verseOrgIds": [
              "MAT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Othe makĩrĩa makĩhũũna, nao arutwo makĩũngania cienyũ iria ciatigarĩte makĩiyũria ciondo ikũmi na igĩrĩ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.20",
            "verseOrgIds": [
              "MAT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũigana wa andũ arĩa maarĩire maarĩ ta arũme ngiri ithano, andũ-a-nja na ciana matatarĩtwo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.21",
            "verseOrgIds": [
              "MAT.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesũ Kũgerera Maaĩ Igũrũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O hĩndĩ ĩyo Jesũ akĩĩra arutwo ake matoonye gatarũ, mathiĩ mbere yake mũrĩmo ũrĩa ũngĩ wa iria mũira wa oigĩre kĩrĩndĩ ũhoro.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.22",
            "verseOrgIds": [
              "MAT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha wa kũmoigĩra ũhoro-rĩ, akĩambata kĩrĩma-inĩ arĩ wiki nĩguo akahooe. Na gũgĩtuka aarĩ o ho wiki,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.23",
            "verseOrgIds": [
              "MAT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "no gatarũ nĩkarĩkĩtie gũthiĩ itĩĩna iraiharaihu kuuma thĩ nyũmũ, gakĩhũũragwo nĩ makũmbĩ ma maaĩ tondũ kerekeire na kũrĩa rũhuho ruoimaga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.24",
            "verseOrgIds": [
              "MAT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, ta thaa kenda cia ũtukũ-rĩ, Jesũ agĩthiĩ kũrĩ o agereire maaĩ igũrũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.25",
            "verseOrgIds": [
              "MAT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩrĩa arutwo maamuonire agĩthiĩ agereire maaĩ igũrũ, makĩnyiitwo nĩ guoya, makiuga atĩrĩ, “Ĩrĩa nĩ ngoma,” na magĩkaya nĩ gwĩtigĩra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.26",
            "verseOrgIds": [
              "MAT.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hĩndĩ o ĩyo Jesũ akĩmeera atĩrĩ, “Ũmĩrĩriai! Nĩ niĩ. Tigai gwĩtigĩra.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero akĩmũcookeria atĩrĩ, “Mwathani, akorwo nĩwe-rĩ, njĩĩra njũke kũrĩ we ngereire maaĩ igũrũ.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesũ akĩmwĩra atĩrĩ, “Ũka.” Hĩndĩ ĩyo, Petero akiuma gatarũ, agĩthiĩ agereire maaĩ igũrũ erekeire harĩ Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩa oonire rũhuho, agĩĩtigĩra, na akĩambĩrĩria gũtoonyerera maaĩ-inĩ, agĩkaya, akiuga atĩrĩ, “Mwathani, honokia!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rĩmwe, Jesũ agĩtambũrũkia guoko, akĩmũnyiita, akĩmwĩra atĩrĩ, “Wee kaĩ ũrĩ na wĩtĩkio mũnini-ĩ! Wagĩa na nganja nĩkĩ?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hĩndĩ ĩrĩa maahaicire gatarũ-rĩ, rũhuho rũgĩtiga kũhurutana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo arĩa maarĩ thĩinĩ wa gatarũ makĩmũgooca, makiuga atĩrĩ, “Nĩ ma wee nĩwe Mũrũ wa Ngai.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na maarĩkia kũringa mũrĩmo ũrĩa ũngĩ, magĩkinya bũrũri wa Genesareti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hĩndĩ ĩrĩa andũ a kũu maamenyire atĩ nĩ Jesũ, makĩhunjia ũhoro ngʼongo ciothe iria ciamarigiicĩirie. Nao makĩmũrehera andũ othe arĩa maarĩ arũaru,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makĩmũthaitha areke arũaru mahutie gĩcũrĩ kĩa nguo yake, na arĩa othe maamũhutirie makĩhonio.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
          }
        }
      ]
    }
