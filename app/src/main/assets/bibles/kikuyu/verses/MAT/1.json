{
  "id": "MAT.1",
  "number": "1",
  "bookId": "MAT",
  "reference": "Mathayo 1",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rũciaro rũrĩa Jesũ Oimire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maya nĩ maandĩko makoniĩ rũciaro rũrĩa Jesũ Kristũ, mũrũ wa Daudi, mũrũ wa Iburahĩmu oimire:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahĩmu aarĩ ithe wa Isaaka, nake Isaaka aarĩ ithe wa Jakubu, nake Jakubu aarĩ ithe wa Juda na ariũ a ithe,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Juda aarĩ ithe wa Perezu na Zera, arĩa nyina wao aarĩ Tamaru, nake Perezu aarĩ ithe wa Hezironi, nake Hezironi aarĩ ithe wa Ramu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Ramu aarĩ ithe wa Aminadabu, nake Aminadabu aarĩ ithe wa Nahashoni, nake Nahashoni aarĩ ithe wa Salimoni,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Salimoni aarĩ ithe wa Boazu, ũrĩa nyina aarĩ Rahabu, nake Boazu aarĩ ithe wa Obedi, ũrĩa nyina aarĩ Ruthu, nake Obedi aarĩ ithe wa Jesii,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Jesii aarĩ ithe wa Mũthamaki Daudi.\nDaudi aarĩ ithe wa Solomoni, ũrĩa nyina aarĩ mũtumia wa Uria,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Solomoni aarĩ ithe wa Rehoboamu, nake Rehoboamu aarĩ ithe wa Abija, nake Abija aarĩ ithe wa Asa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Asa aarĩ ithe wa Jehoshafatu, nake Jehoshafatu aarĩ ithe wa Joramu, nake Joramu aarĩ ithe wa Uzia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Uzia aarĩ ithe wa Jothamu, nake Jothamu aarĩ ithe wa Ahazu, nake Ahazu aarĩ ithe wa Hezekia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Hezekia aarĩ ithe wa Manase, nake Manase aarĩ ithe wa Amoni, nake Amoni aarĩ ithe wa Josia,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Josia aarĩ ithe wa Jekonia na ariũ a ithe, hĩndĩ ĩrĩa andũ maatahirwo, magĩtwarwo Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thuutha wa gũtahwo, magĩtwarwo kũu Babuloni: Jekonia aarĩ ithe wa Shealitieli, nake Shealitieli aarĩ ithe wa Zerubabeli,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Zerubabeli aarĩ ithe wa Abihudu, nake Abihudu aarĩ ithe wa Eliakimu, nake Eliakimu aarĩ ithe wa Azoro,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Azoro aarĩ ithe wa Zadoku, nake Zadoku aarĩ ithe wa Akimu, nake Akimu aarĩ ithe wa Eliudi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Eliudi aarĩ ithe wa Eleazaru, nake Eleazaru aarĩ ithe wa Maathani, nake Maathani aarĩ ithe wa Jakubu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake Jakubu aarĩ ithe wa Jusufu, mũthuuri wa Mariamu, ũrĩa waciarire Jesũ, ũrĩa wĩtagwo Kristũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũguo nĩ kuuga njiaro ciothe ciarĩ ikũmi na inya kuuma Iburahĩmu nginya Daudi, na njiaro ikũmi na inya kuuma Daudi nginya hĩndĩ ĩrĩa andũ maatahirwo magĩtwarwo kũu Babuloni, na ningĩ njiaro ikũmi na inya kuuma hĩndĩ ĩrĩa andũ maatahirwo nginya hĩndĩ ya Kristũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũciarwo kwa Jesũ Kristũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũhoro wa gũciarwo kwa Jesũ Kristũ watariĩ ũũ: Nyina Mariamu nĩ oorĩtio nĩ Jusufu atuĩke mũtumia wake, no matanaikarania-rĩ, nĩamenyekire atĩ arĩ na nda ya Roho Mũtheru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jusufu mũthuuri wake tondũ aarĩ mũndũ mũthingu na ndangĩendire kũmũconorithia kũrĩ andũ, agĩĩciiria amũtige na hitho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "No thuutha wa gwĩciiria ũndũ ũcio, mũraika wa Mwathani akĩmuumĩrĩra kĩroto-inĩ, akĩmwĩra atĩrĩ, “Jusufu, mũrũ wa Daudi, ndũkae gwĩtigĩra kũhikia Mariamu atuĩke mũtumia waku, tondũ nda ĩyo arĩ nayo nĩ ya Roho Mũtheru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩagaciara kahĩĩ, nawe nĩũgagatua Jesũ, tondũ nĩwe ũkaahonokia andũ ake kuuma mehia-inĩ mao.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, maũndũ macio mothe meekĩkire nĩguo ũrĩa Mwathani aarĩtie na kanua ka mũnabii ũhinge, rĩrĩa oigire atĩrĩ,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũirĩtu gathirange nĩakagĩa nda na nĩagaciara kahĩĩ, nao magaagatua Imanueli” ũguo naguo ũgĩtaũrwo nĩ kuuga, “Ngai hamwe na ithuĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.23",
            "verseOrgIds": [
              "MAT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩrĩa Jusufu ookĩrire, agĩĩka o ta ũrĩa mũraika wa Mwathani aamwathĩte, nake akĩinũkia Mariamu gwake mũciĩ, agĩtuĩka mũtumia wake.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.24",
            "verseOrgIds": [
              "MAT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No matiigana kũmenyana nginya rĩrĩa aaciarire mwana ũcio wa kahĩĩ. Nake Jusufu agĩtua mwana ũcio Jesũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.25",
            "verseOrgIds": [
              "MAT.1.25"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "MAT.2",
    "number": "2",
    "bookId": "MAT"
  },
