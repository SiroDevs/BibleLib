{
  "id": "MAT.23",
  "number": "23",
  "bookId": "MAT",
  "reference": "Mathayo 23",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "MAT 23"
      },
      "items": [
        {
