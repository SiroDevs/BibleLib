{
  "id": "MAT.6",
  "number": "6",
  "bookId": "MAT",
  "reference": "Mathayo 6",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MAT 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gũteithia arĩa Abatari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwĩmenyererei mũtigekage ciĩko cianyu cia ũthingu mbere ya andũ nĩguo mamuone. Mũngĩĩka ũguo-rĩ, mũtirĩ kĩheo mũkaaheo nĩ Ithe wanyu ũrĩa ũrĩ igũrũ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.1",
            "verseOrgIds": [
              "MAT.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nĩ ũndũ ũcio, rĩrĩa ũkũheana kĩndũ kũrĩ arĩa abatari, ndũkae kwanĩrĩra ũrĩa ũreka na tũrumbeta, ta ũrĩa hinga ciĩkaga thunagogi-inĩ na njĩra-inĩ, nĩguo itĩĩagwo nĩ andũ. Ngũmwĩra atĩrĩ na ma, acio nĩmarĩkĩtie kwamũkĩra kĩheo kĩao gĩothe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.2",
            "verseOrgIds": [
              "MAT.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hĩndĩ ĩrĩa ũkũheana kĩndũ kũrĩ arĩa abatari-rĩ, ndũkareke guoko gwaku kwa ũmotho kũmenye ũrĩa guoko gwaku kwa ũrĩo kũreeka,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.3",
            "verseOrgIds": [
              "MAT.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgeetha ũheani ũcio waku ũtuĩke wa hitho-inĩ. Nake Ithe wanyu, ũrĩa wonaga maũndũ marĩa mekagĩrwo hitho-inĩ, nĩakamũhe kĩheo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.4",
            "verseOrgIds": [
              "MAT.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kũhooya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na rĩrĩa mũkũhooya-rĩ, mũtikanatuĩke ta hinga, nĩgũkorwo ciendaga kũhooya irũgamĩte thĩinĩ wa thunagogi na macemanĩrio ma njĩra nĩguo cionwo nĩ andũ. Ngũmwĩra atĩrĩ na ma, icio nĩirĩkĩtie kwamũkĩra mũcaara wacio wothe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.5",
            "verseOrgIds": [
              "MAT.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "No hĩndĩ ĩrĩa ũkũhooya, toonya nyũmba yaku, ũhinge mũrango na ũhooye Thoguo ũrĩa ũtoonekaga. Nake Thoguo ũrĩa wonaga maũndũ marĩa mekagĩrwo hitho-inĩ, nĩagakũhe mũcaara waku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.6",
            "verseOrgIds": [
              "MAT.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ningĩ hĩndĩ ĩrĩa mũkũhooya-rĩ, tigagai kũhũhũtĩka ta andũ arĩa matetĩkĩtie Ngai, nĩgũkorwo meciiragia nĩ mekũiguuo nĩ ũndũ wa kũraihia mahooya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.7",
            "verseOrgIds": [
              "MAT.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũtigatuĩke tao, nĩgũkorwo Ithe wanyu nĩoĩ kĩrĩa kĩmũbatairie o na mũtanamũhooya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.8",
            "verseOrgIds": [
              "MAT.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nĩ ũndũ ũcio mwagĩrĩirwo nĩkũhooyaga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.9",
            "verseOrgIds": [
              "MAT.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.10",
            "verseOrgIds": [
              "MAT.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.11",
            "verseOrgIds": [
              "MAT.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.12",
            "verseOrgIds": [
              "MAT.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.13",
            "verseOrgIds": [
              "MAT.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo mũngĩrekera andũ hĩndĩ ĩrĩa mamũhĩtĩria, o nake Ithe wanyu ũrĩa ũrĩ igũrũ nĩarĩmũrekagĩra.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mũngĩaga kũrekera andũ mehia mao-rĩ, o nake Ithe wanyu ndarĩmũrekagĩra mehia manyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwĩhinga Kũrĩa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ningĩ rĩrĩa mũkwĩhinga kũrĩa irio-rĩ, tigagai gũtukia mothiũ manyu ta ũrĩa hinga ciĩkaga, nĩgũkorwo nĩitukagia mothiũ macio nĩguo cionie andũ atĩ nĩciĩhingĩte kũrĩa irio. Ngũmwĩra atĩrĩ na ma, icio nĩirĩkĩtie kwamũkĩra mũcaara wacio wothe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩa wĩhingĩte kũrĩa, wĩhakage maguta mũtwe na wĩthambage ũthiũ,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩguo andũ matikamenye atĩ nĩwĩhingĩte kũrĩa, tiga o Thoguo ũrĩa ũtoonekaga amenye; nake Thoguo ũrĩa wonaga maũndũ marĩa mekagĩrwo hitho-inĩ, nĩagakũhe mũcaara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũthiithũ kũu Igũrũ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tigagai kwĩigĩra mĩthiithũ gũkũ thĩ, kũrĩa indo irĩĩagwo nĩ memenyi na ikaroota, na kũrĩa aici mabunjaga makaiya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.19",
            "verseOrgIds": [
              "MAT.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mwĩigagĩrei mĩthiithũ igũrũ, kũrĩa ĩtangĩrĩĩo nĩ memenyi kana ĩroote, na kũrĩa aici matangĩbunja maiye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.20",
            "verseOrgIds": [
              "MAT.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo kũrĩa mĩthiithũ yanyu ĩrĩ, nokuo ngoro cianyu o nacio irĩĩkoragwo irĩ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.21",
            "verseOrgIds": [
              "MAT.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Riitho nĩrĩo tawa wa mwĩrĩ. Maitho maku mangĩkorwo marĩ mega, mwĩrĩ waku wothe nĩũrĩiyũragwo nĩ ũtheri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.22",
            "verseOrgIds": [
              "MAT.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, maitho maku mangĩkorwo nĩ mathũku, mwĩrĩ waku wothe ũrĩiyũragwo nĩ nduma. Naguo ũtheri ũrĩa ũrĩ thĩinĩ waku ũngĩkorwo nĩ nduma-rĩ, nduma ĩyo kaĩ nĩ nene-ĩ!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.23",
            "verseOrgIds": [
              "MAT.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gũtirĩ mũndũ ũngĩhota gũtungatĩra aathani eerĩ. Nĩ ũndũ no athũũrire ũmwe, na ende ũcio ũngĩ; kana eheane harĩ ũmwe, na anyarare ũcio ũngĩ. Mũtingĩtungatĩra Ngai na mũtungatĩre mbeeca.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
            "verseOrgIds": [
              "MAT.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mũtigatangĩke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nĩ ũndũ ũcio ngũmwĩra atĩrĩ, tigagai gũtangĩkĩra mĩoyo yanyu, nĩ ũndũ wa kĩrĩa mũrĩrĩĩaga kana kĩrĩa mũrĩnyuuaga; kana kĩrĩa mũrĩĩhumbaga mĩĩrĩ yanyu. Githĩ muoyo ndũrĩ bata gũkĩra irio, naguo mwĩrĩ ũkagĩa bata gũkĩra nguo?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.25",
            "verseOrgIds": [
              "MAT.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta rorai nyoni cia rĩera-inĩ; itihaandaga, kana ikagetha, kana ikaiga magetha ikũmbĩ, no Ithe wanyu ũrĩa ũrĩ Igũrũ nĩaciheaga irio. Githĩ inyuĩ mũtikĩrĩ a bata mũno gũkĩra icio?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.26",
            "verseOrgIds": [
              "MAT.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nũũ wanyu ũngĩhota kuongerera muoyo wake ithaa o na rĩmwe nĩ ũndũ wa gwĩtanga?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.27",
            "verseOrgIds": [
              "MAT.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na nĩ kĩĩ gĩtũmaga mwĩtange nĩ ũndũ wa nguo? Ta rorai itoka cia gĩthaka ũrĩa ikũraga. Itirutaga wĩra kana ikogotha ndigi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.28",
            "verseOrgIds": [
              "MAT.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "no ngũmwĩra atĩrĩ, o na Solomoni arĩ na riiri wake wothe ndagemete ta kĩmwe gĩacio.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.29",
            "verseOrgIds": [
              "MAT.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angĩkorwo ũguo nĩguo Ngai ahumbaga nyeki ya gĩthaka ĩrĩa ĩrĩ ho ũmũthĩ na rũciũ ĩgaikio mwaki-inĩ-rĩ, githĩ inyuĩ ndarĩkĩmũhumbaga wega makĩria, inyuĩ mwĩtĩkĩtie o hanini?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.30",
            "verseOrgIds": [
              "MAT.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio-rĩ, tigagai gwĩtanga, mũkĩũria atĩrĩ: ‘Tũkũrĩa kĩĩ?’ kana ‘Tũkũnyua kĩĩ?’ kana ‘Tũkwĩhumba kĩĩ?’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
              "MAT.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo maũndũ maya mothe nĩmo macaragio nĩ andũ arĩa matetĩkĩtie Ngai. No Ithe wanyu wa igũrũ nĩoĩ atĩ nĩmũbataragio nĩmo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
            "verseOrgIds": [
              "MAT.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "No ambai mũcarie ũthamaki wake na ũthingu wake, na maũndũ maya mangĩ mothe o namo nĩarĩmũheaga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio tigagai gwĩtanga nĩ ũndũ wa rũciũ, nĩgũkorwo rũciũ nĩrũgetangĩkĩra ruo rwene. O mũthenya ũrĩ na mathĩĩna maguo ma kũũigana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.34",
            "verseOrgIds": [
              "MAT.6.34"
            ]
          }
        }
      ]
    }
