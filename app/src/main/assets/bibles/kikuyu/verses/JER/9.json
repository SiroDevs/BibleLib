            }
          ]
        },
        {
          "text": "Meere ũũ, “Jehova ekuuga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.22"
            ]
