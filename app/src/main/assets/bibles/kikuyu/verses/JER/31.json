        },
        {
          "text": "“Ihinda-inĩ rĩu ngaakorwo ndĩ Ngai wa mbarĩ ciothe cia Isiraeli, nao nĩmagatuĩka andũ akwa,” ũguo nĩguo Jehova ekuuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
