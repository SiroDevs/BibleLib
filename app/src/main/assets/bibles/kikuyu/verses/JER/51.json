          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.58",
            "verseOrgIds": [
              "JER.51.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JER 51:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ĩno nĩo ndũmĩrĩri ĩrĩa Jeremia aaheire Seraia mũrũ wa Neria, mũrũ wa Maaseia, o ũcio warĩ mũnene ũrĩa mũrori wa maũndũ ma nyũmba ya mũthamaki, rĩrĩa aathiire Babuloni marĩ na Zedekia mũthamaki wa Juda mwaka-inĩ wa ĩna wa ũthamaki wake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.59",
            "verseOrgIds": [
              "JER.51.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JER 51:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nĩandĩkĩte ibuku-inĩ rĩa gĩkũnjo ũhoro wothe ũkoniĩ mwanangĩko ũrĩa ũgaakinyĩrĩra Babuloni: maũndũ marĩa mothe maandĩkĩtwo makoniĩ Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.60",
            "verseOrgIds": [
              "JER.51.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JER 51:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia akĩĩra Seraia atĩrĩ, “Wakinya Babuloni-rĩ, ũgaatigĩrĩra atĩ nĩwathoma mohoro maya mothe wanĩrĩire.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.61",
            "verseOrgIds": [
              "JER.51.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JER 51:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũcooke uuge atĩrĩ, ‘Wee Jehova, nĩugĩte nĩũkũniina kũndũ gũkũ, nĩgeetha gũtikanatũũrwo nĩ mũndũ, o na kana nyamũ; gũgũtũũra gũkirĩte ihooru nginya tene.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.62",
            "verseOrgIds": [
              "JER.51.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JER 51:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warĩkia gũthoma ibuku rĩu rĩa gĩkũnjo-rĩ, ũrĩoherere ihiga, ũrĩikie Rũũĩ rwa Farati.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũcooke uuge atĩrĩ, ‘Ũguo noguo Babuloni gũkaarikĩra kũũrĩre biũ, na gũtigacooka kuumĩra na igũrũ, nĩ ũndũ wa mwanangĩko ũrĩa ngaakũrehithĩria. Nao andũ akuo nĩmakaagũa.’ ”\nŨhoro wa Jeremia ũkinyĩte hau.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        }
      ]
    }
