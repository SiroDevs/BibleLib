            "number": "1",
            "style": "v",
            "sid": "JER 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hĩ! Kaĩ arĩithi arĩa maniinaga na makahurunja mbũri cia rũũru rwakwa marĩ na haaro-ĩ!” ũguo nĩguo Jehova ekuuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.1",
            "verseOrgIds": [
              "JER.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Jehova Ngai wa Isiraeli ekũũria arĩithi arĩa marĩithagia andũ akwa atĩrĩ: “Tondũ nĩmũhurunjĩte mbũri ciakwa na mũgaciingata, na nĩmwagĩte gũcimenyerera-rĩ, nĩngamũherithia nĩ ũndũ wa ũũru ũcio mwĩkĩte,” ũguo nĩguo Jehova ekuuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.2",
            "verseOrgIds": [
              "JER.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Niĩ mwene nĩngacookereria matigari ma rũũru rwa mbũri ciakwa kuuma mabũrũri mothe marĩa ndaacitwarithirie, ndĩcicookie ũrĩithio-inĩ wacio, na nĩigaciaranĩra kuo, cingĩhe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.3",
            "verseOrgIds": [
              "JER.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngacirehera arĩithi a gũcirĩithagia, na itigacooka gwĩtigĩra kana kũmaka, na gũtirĩ o na ĩmwe yacio ĩkoora,” ũguo nĩguo Jehova ekuuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.4",
            "verseOrgIds": [
              "JER.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.5",
            "verseOrgIds": [
              "JER.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Jehova ekuuga atĩrĩ: “Matukũ nĩmarooka, rĩrĩa andũ matagacooka kuuga atĩrĩ, ‘Ti-itherũ o ta ũrĩa Jehova atũũraga muoyo, ũrĩa warutire andũ a Isiraeli kuuma bũrũri wa Misiri,’",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.7",
            "verseOrgIds": [
              "JER.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "no makoigaga atĩrĩ, ‘Ti-itherũ, o ta ũrĩa Jehova atũũraga muoyo, ũrĩa warutire njiaro cia Isiraeli bũrũri ũrĩa ũrĩ mwena wa gathigathini, na kuuma mabũrũri-inĩ mothe kũrĩa aamathaamĩirie.’ Hĩndĩ ĩyo magaatũũra bũrũri wao ene.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        }
      ]
    },
