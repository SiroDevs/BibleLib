              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũũ nĩguo Jehova Mwene-Hinya-Wothe ekuuga:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihinda-inĩ rĩu andũ arĩa mooragithĩtio nĩ Jehova magaakorwo maaraganĩte kũndũ guothe, kuuma gĩturi kĩmwe gĩa thĩ nginya kĩrĩa kĩngĩ. Matikarĩrĩrwo, kana monganio, kana mathikwo, no magaaikara ta rũrua, mahurunjũkĩte thĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
