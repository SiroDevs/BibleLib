        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova ekuuga atĩrĩ: “Ha ũhoro wa andũ acio aaganu maandigiicĩirie, o acio matunyaga andũ akwa a Isiraeli igai rĩrĩa ndaamaheire-rĩ, nĩngamamunya kuuma mabũrũri mao, na munye nyũmba ya Juda yume gatagatĩ kao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, thuutha wa kũmamunya nĩngacooka ndĩmaiguĩre tha na njookie o ũmwe wao igai-inĩ rĩake mwene, bũrũri-inĩ wake kĩũmbe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mangĩkeruta wega mĩthiĩre ya andũ akwa na mehĩte makĩgwetaga rĩĩtwa rĩakwa moige atĩrĩ, ‘Ti-itherũ o ta ũrĩa Jehova atũũraga muoyo,’ o ta ũrĩa maarutire andũ akwa hĩndĩ ĩmwe kwĩhĩta makĩgwetaga rĩĩtwa rĩa Baali-rĩ, hĩndĩ ĩyo nao nĩmakahaandwo marũme wega gatagatĩ ka andũ akwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, rũrĩrĩ o na rũrĩkũ rũngĩkaaga kũnjigua-rĩ, nĩngarũmunya na mĩri na ndĩrũniine biũ,” ũguo nĩguo Jehova ekuuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
