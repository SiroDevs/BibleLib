        },
        {
          "text": "Mũthenya ũrĩa Jehova akaamũhurũkia kuuma mathĩĩna-inĩ na mĩnyamaro-inĩ, na ũkombo-inĩ wa kũhinyĩrĩrio-rĩ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩmũgookĩrĩra mũthamaki wa Babuloni na kĩnyũrũri, mũmwĩre atĩrĩ:",
