        },
        {
          "text": "Ũyũ nĩguo ũhoro ũrĩa Isaia mũrũ wa Amozu onire ũkoniĩ Juda na Jerusalemu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
