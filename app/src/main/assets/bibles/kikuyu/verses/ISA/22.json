        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mũthenya ũcio nĩngeeta ndungata yakwa, Eliakimu mũrũ wa Hilikia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.20",
            "verseOrgIds": [
              "ISA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩngamũhumba nguo yaku ĩrĩa ndaaya na ndĩmũhotore mũcibi waku, na ndĩmũnengere wathani waku. Nĩagatuĩka ithe wa arĩa matũũraga Jerusalemu o na wa nyũmba ya Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.21",
            "verseOrgIds": [
              "ISA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kĩhingũro kĩa nyũmba ya Daudi ngaakĩigĩrĩra kĩande-inĩ gĩake; na rĩrĩ, kĩrĩa gĩothe akaahingũra gũtirĩ mũndũ ũkaahota kũhinga, na kĩrĩa gĩothe akaahinga gũtirĩ mũndũ ũkaahota kũhingũra.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.22",
            "verseOrgIds": [
              "ISA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaamuoherera handũ harũmu aikare ho ta higĩ hũũrĩrĩre; atuĩke gĩtĩ gĩa gĩtĩĩo thĩinĩ wa nyũmba ya ithe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.23",
            "verseOrgIds": [
              "ISA.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩwe ũgaacookererwo nĩ riiri wothe wa nyũmba ya ithe ta ũcuurĩtio harĩ we: ciana ciake na iria ikeyongerera thĩinĩ wa ciana icio, o indo ciothe ciayo iria cionekaga ta itarĩ kĩene, kuuma mbakũri nginya mĩthemba yothe ya ndigithũ.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.24",
            "verseOrgIds": [
              "ISA.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, “Mũthenya ũcio higĩ ĩrĩa thecerere handũ harũmu nĩĩkenyenya; nĩĩkamunyũka ĩgwe, na indo iria njuurie harĩ yo nĩikaharagana.” Jehova nĩwe warĩtie ũhoro ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
      ]
    }
