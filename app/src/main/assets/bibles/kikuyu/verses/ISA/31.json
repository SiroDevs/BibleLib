        },
        {
          "text": "Inyuĩ andũ a Isiraeli-rĩ, cookererai ũcio mũtũire mũremeire mũno.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
