              "type": "text"
            }
          ]
        },
        {
          "text": "Ũyũ nĩguo ũhoro ũrĩa Jehova aarĩtie ũkoniĩ Moabi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, rĩu Jehova ekuuga atĩrĩ: “Mĩaka ĩtatũ ĩtanathira, ĩtarĩtwo ta ũrĩa mĩaka ya mũndũ wandĩkĩtwo wĩra ĩrĩkanagĩrwo-rĩ, riiri wa Moabi hamwe na andũ ake othe nĩũkanyararwo, namo matigari make makorwo marĩ manini mũno na makahinyara.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
