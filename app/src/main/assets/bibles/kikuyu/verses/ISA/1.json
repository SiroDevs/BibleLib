        },
        {
          "text": "Maya nĩmo maũndũ marĩa maaguũrĩirio Isaia mũrũ wa Amozu, makoniĩ Juda na Jerusalemu hĩndĩ ya wathani wa Uzia, na wa Jothamu, na wa Ahazu, na wa Hezekia, arĩa maarĩ athamaki a Juda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.1",
            "verseOrgIds": [
              "ISA.1.1"
            ]
          }
        }
      ]
    },
