          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩgũkorwo oigaga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
