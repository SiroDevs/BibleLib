        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niĩ hamwe na ciana iria Jehova aheete-rĩ, nĩ ithuĩ marũũri na imenyithia thĩinĩ wa Isiraeli kuuma kũrĩ Jehova Mwene-Hinya-Wothe ũrĩa ũtũũraga Kĩrĩma-inĩ gĩa Zayuni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.18",
            "verseOrgIds": [
              "ISA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ mangĩkwĩra ũgatuĩrie kĩrĩra kuuma kũrĩ aragũri na ago arĩa mahehanaga na makangʼungʼura-rĩ, ũkaamoria atĩrĩ, “Githĩ andũ matiagĩrĩirwo nĩgũtuĩria ũhoro harĩ Ngai wao?” Nĩ kĩĩ gĩgũtũma mũtuĩrie ũhoro wa andũ arĩa marĩ muoyo kuuma kũrĩ arĩa akuũ?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.19",
            "verseOrgIds": [
              "ISA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ kaba mũũtuĩrie watho-inĩ wa Ngai o na ũira-inĩ wake! Angĩkorwo ũhoro wao ndũkũringana na ciugo ici, o nao matirĩ na ũtheri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.20",
            "verseOrgIds": [
              "ISA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ magaatuĩkanagĩria bũrũri-inĩ marĩ anyamaarĩku na marĩ ahũtu; na rĩrĩ, rĩrĩa makahũũta mũno, nĩmakarakara mũno na matiire maitho na igũrũ, nao marume mũthamaki wao na Ngai wao.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.21",
            "verseOrgIds": [
              "ISA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hĩndĩ ĩyo makaarora thĩ mone o mĩnyamaro, na nduma, na kĩeha gĩa kũmakania, nao nĩmagaikio nduma-inĩ ndumanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.22",
            "verseOrgIds": [
              "ISA.8.22"
            ]
          }
        }
      ]
