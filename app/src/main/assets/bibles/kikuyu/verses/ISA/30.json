              "type": "text"
            }
          ]
        },
        {
          "text": "Mwathani Jehova Ũrĩa Mũtheru wa Isiraeli ekuuga atĩrĩ:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.15",
            "verseOrgIds": [
              "ISA.30.15"
