            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũcio-rĩ, andũ a Misiri makahaana o ta andũ-a-nja. Makainaina nĩ guoya mona guoko kwa Jehova Mwene-Hinya-Wothe kwambararĩtio kũmookĩrĩre.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo bũrũri wa Juda ũkaguoyohia andũ a Misiri; na mũndũ o wothe ũkaagweterwo ũhoro wa Juda nĩagetigĩra, nĩ ũndũ wa maũndũ marĩa Jehova Mwene-Hinya-Wothe aciirĩire gwĩka amokĩrĩre.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũcio matũũra matano ma bũrũri wa Misiri makaaragia rũthiomi rwa Kaanani, makĩĩhĩtaga atĩ marĩtungatagĩra Jehova Mwene-Hinya-Wothe. Na itũũra rĩmwe rĩamo rĩgeetagwo Itũũra Inene rĩa Mwanangĩko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũcio-rĩ, nĩgũkagĩa na kĩgongona kĩa Jehova o kũu gatagatĩ ka bũrũri wa Misiri, na kũhaandwo ihiga rĩa kĩririkano kĩa Jehova mĩhaka-inĩ yakuo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihiga rĩu rĩgaatuĩka kĩmenyithia na mũira wa maũndũ marĩa Jehova Mwene-Hinya-Wothe ekĩte thĩinĩ wa bũrũri ũcio wa Misiri. Rĩrĩa magaakaĩra Jehova amateithie nĩ ũndũ wa andũ arĩa mamahinyagĩrĩria-rĩ, nĩakamatũmĩra mũhonokia na mũmagitĩri, nake nĩakamahonokia.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Jehova nĩakemenyithania kũrĩ andũ a Misiri, na mũthenya ũcio nĩmagakũũrana Jehova. Makaamũhooyaga makĩmũrutagĩra magongona na maruta ma mũtu: na ningĩ makehĩtaga mĩĩhĩtwa marĩ mbere ya Jehova na mamĩhingagie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova nĩakahũũra bũrũri wa Misiri na mũthiro, amahũũre acooke amahonie. Nao nĩmagacookerera Jehova, nake nĩagathikĩrĩria gũthaithana kwao na amahonie.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũcio nĩgũkagĩa njĩra njariĩ yumĩte bũrũri wa Misiri ĩgakinya Ashuri. Andũ a Ashuri nĩmagathiiaga Misiri, na o andũ a Misiri mathiiage Ashuri. Andũ a Misiri na andũ a Ashuri nĩmakahooyaga hamwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũcio bũrũri wa Isiraeli ũgaatuĩka wa gatatũ, hamwe na Misiri na Ashuri, nao nĩmagatũma thĩ yothe ĩrathimwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Mwene-Hinya-Wothe nĩakamarathima akiugaga atĩrĩ, “Kũrathimwo-rĩ, nĩ andũ akwa a Misiri, o na Aashuri arĩa ndeyũmbĩire, na Isiraeli igai rĩakwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
