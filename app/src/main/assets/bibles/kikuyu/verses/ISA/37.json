          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gĩkĩ nĩkĩo gĩgaakorwo kĩrĩ kĩmenyithia gĩaku, wee Hezekia:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.30",
            "verseOrgIds": [
              "ISA.37.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 37:31"
          },
          "items": [
