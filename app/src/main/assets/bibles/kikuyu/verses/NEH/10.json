          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Danieli, na Ginethoni, na Baruku,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.6",
            "verseOrgIds": [
              "NEH.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Meshulamu, na Abija, na Mijamini,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.7",
            "verseOrgIds": [
              "NEH.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Maazia, na Biligai, na Shemaia. Acio nĩo maarĩ athĩnjĩri-Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.8",
            "verseOrgIds": [
              "NEH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Alawii maarĩ:\nJeshua mũrũ wa Azania, na Binui wa ariũ a Henadadi, na Kadimieli,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.9",
            "verseOrgIds": [
              "NEH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao athiritũ ao maarĩ: Shebania, na Hodia, na Kelita, na Pelaia, na Hanani,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.10",
            "verseOrgIds": [
              "NEH.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mika, na Rehobu, na Hashabia,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.11",
            "verseOrgIds": [
              "NEH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
