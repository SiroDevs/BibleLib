          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hodia, na Bani, na Beninu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.13",
            "verseOrgIds": [
              "NEH.10.13"
            ]
          }
        },
        {
