          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Alawii maarĩ:\na njiaro cia Jeshua (iria cioimĩte harĩ Kadimieli, rũciaro-inĩ rwa Hodavia) ciarĩ 74.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.43",
            "verseOrgIds": [
              "NEH.7.43"
            ]
          }
        },
        {
