          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NEH 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Gazamu, na Uza, na Pasea,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.51",
            "verseOrgIds": [
              "NEH.7.51"
            ]
          }
        },
        {
