            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao athĩnjĩri-Ngai maarĩ:\nnjiaro cia Jedaia (iria cioimĩte harĩ nyũmba ya Jeshua) ciarĩ 973",
          "type": "text",
          "attrs": {
