            "sid": "NEH 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao aini maarĩ:\nnjiaro cia Asafu ciarĩ 148.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.44",
            "verseOrgIds": [
              "NEH.7.44"
            ]
          }
        },
        {
          "name": "verse",
