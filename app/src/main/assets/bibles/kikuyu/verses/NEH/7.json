          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NEH 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Lebana, na Hagaba, na Shalimai,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.48",
            "verseOrgIds": [
              "NEH.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NEH 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hanani, na Gideli, na Gaharu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.49",
            "verseOrgIds": [
              "NEH.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NEH 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
