          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bakabuku, na Hakufa, na Harihuru,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.53",
            "verseOrgIds": [
              "NEH.7.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NEH 7:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Baziluthu, na Mehida, na Harasha,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.54",
            "verseOrgIds": [
              "NEH.7.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NEH 7:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Barikosi, na Sisera, na Tema,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.55",
            "verseOrgIds": [
              "NEH.7.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NEH 7:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Nezia, na Hatifa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.56",
            "verseOrgIds": [
              "NEH.7.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "NEH 7:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio njiaro cia ndungata cia Solomoni ciarĩ:\nnjiaro cia Sotai, na Soferethu, na Perida,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.57",
            "verseOrgIds": [
              "NEH.7.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "NEH 7:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Jaala, na Darikoni, na Gideli,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.58",
            "verseOrgIds": [
              "NEH.7.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "NEH 7:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Shefatia, na Hatili, na Pokerethu-Hazebaimu, na Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.59",
            "verseOrgIds": [
              "NEH.7.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "NEH 7:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndungata cia hekarũ hamwe na njiaro cia ndungata cia Solomoni maarĩ andũ 392.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.60",
            "verseOrgIds": [
              "NEH.7.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "NEH 7:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao aya nĩo maambatire kuuma matũũra ma Teli-Mela, na Teli-Harasha, na Kerubu, na Adoni, na Imeri, no matingĩonanirie atĩ nyũmba ciao ciarĩ cia njiaro cia Isiraeli:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.61",
            "verseOrgIds": [
              "NEH.7.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "NEH 7:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "njiaro cia Delaia, na Tobia, na Nekoda ciarĩ 642.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.62",
            "verseOrgIds": [
              "NEH.7.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "NEH 7:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuuma kũrĩ athĩnjĩri-Ngai:\nnjiaro cia Hobaia, na Hakozu, na Barizilai (mũndũ ũrĩa wahikĩtie mwarĩ wa Barizilai ũrĩa Mũgileadi, na eetanagio na rĩĩtwa rĩu).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.63",
            "verseOrgIds": [
              "NEH.7.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "NEH 7:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ acio nĩmacaririe maandĩko ma nyũmba ciao, no matiigana kũmona, nĩ ũndũ ũcio makĩeherio thiritũ-inĩ ya athĩnjĩri-Ngai, magĩtuuo ta andũ maarĩ na thaahu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.64",
            "verseOrgIds": [
              "NEH.7.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "NEH 7:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake barũthi wa kũu akĩmaatha matikarĩe irio iria therie mũno, o nginya gũkaagĩa mũthĩnjĩri-Ngai ũratungata na Urimu na Thumimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.65",
            "verseOrgIds": [
              "NEH.7.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "NEH 7:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andũ acio othe marĩ hamwe maarĩ 42,360,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.66",
            "verseOrgIds": [
              "NEH.7.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "NEH 7:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "gũtatarĩtwo ndungata ciao cia arũme na cia andũ-a-nja 7, 337; ningĩ nĩ maarĩ na aini arũme na andũ-a-nja 245.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.67",
            "verseOrgIds": [
              "NEH.7.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "NEH 7:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarĩ na mbarathi 736, na nyũmbũ 245,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.68",
            "verseOrgIds": [
              "NEH.7.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "NEH 7:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngamĩĩra 435, na ndigiri 6,720.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.69",
            "verseOrgIds": [
              "NEH.7.69"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "70",
            "style": "v",
            "sid": "NEH 7:70"
          },
          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongoria amwe a nyũmba nĩmarutire indo ciao nĩ ũndũ wa wĩra ũcio. Barũthi wa kũu nĩaheanire durakima 1,000cia thahabu, na mbakũri 50, na nguo cia athĩnjĩri-Ngai 530, nacio ikĩigwo kĩgĩĩna-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.70",
            "verseOrgIds": [
              "NEH.7.70"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "71",
            "style": "v",
            "sid": "NEH 7:71"
          },
          "items": [
            {
              "text": "71",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao atongoria amwe a nyũmba nĩmaheanire indo nĩ ũndũ wa wĩra ũcio, durakima 20,000cia thahabu, na ratiri 2,200cia betha, nacio ikĩigwo kĩgĩĩna-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.71",
            "verseOrgIds": [
              "NEH.7.71"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "72",
            "style": "v",
            "sid": "NEH 7:72"
          },
          "items": [
            {
              "text": "72",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũigana wa kĩrĩa kĩaheanirwo nĩ andũ arĩa angĩ warĩ durakima 20,000 cia thahabu, na ratiri 2,000cia betha, na nguo 67 cia athĩnjĩri-Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.72",
            "verseOrgIds": [
              "NEH.7.72"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "73",
            "style": "v",
            "sid": "NEH 7:73"
          },
          "items": [
            {
              "text": "73",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athĩnjĩri-Ngai, na Alawii, na aikaria a ihingo, na aini na ndungata cia hekarũ, marĩ hamwe na andũ amwe ao, na andũ arĩa angĩ a Isiraeli magĩaka na magĩtũũra matũũra-inĩ mao.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.73",
            "verseOrgIds": [
              "NEH.7.73"
            ]
          }
        }
      ]
    }
  ],
