          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Besai, na Meunimu, na Nefisimu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.52",
            "verseOrgIds": [
              "NEH.7.52"
            ]
          }
        },
