          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao aikaria a ihingo maarĩ:\nnjiaro cia Shalumu, na Ateri, na Talimoni, na Akubu, na Hatita, na Shobai ciarĩ 138.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.45",
            "verseOrgIds": [
              "NEH.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio ndungata cia hekarũ ciarĩ:\nnjiaro cia Ziha, na Hasufa, na Tabaothu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.46",
            "verseOrgIds": [
              "NEH.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Keroso, na Sia, na Padoni,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.47",
            "verseOrgIds": [
              "NEH.7.47"
            ]
          }
        },
        {
