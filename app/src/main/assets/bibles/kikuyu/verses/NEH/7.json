          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "na cia Imeri ciarĩ 1,052",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.40",
            "verseOrgIds": [
