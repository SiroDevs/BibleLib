          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kũgaywo kwa Bũrũri wa Mwena wa Ithũĩro rĩa Rũũĩ rwa Jorodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maya nĩmo mabũrũri marĩa andũ a Isiraeli maheirwo matuĩke igai rĩao bũrũri-inĩ wa Kaanani, ũrĩa Eleazaru mũthĩnjĩri-Ngai,na Joshua mũrũ wa Nuni, na atongoria a mbarĩ cia mĩhĩrĩga ya Isiraeli maamagaĩire.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.1",
            "verseOrgIds": [
              "JOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magai mao maagairwo na njĩra ya gũcuukĩra mĩtĩ kũrĩ o mĩhĩrĩga ĩyo kenda na nuthu, o ta ũrĩa Jehova aathĩte Musa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgũkorwo Musa nĩaheete mĩhĩrĩga ĩĩrĩ na nuthu igai rĩao mwena wa irathĩro wa Rũũĩ rwa Jorodani. No rĩrĩ, ndaaheete Alawii igai hamwe na andũ acio angĩ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nĩgũkorwo ariũ a Jusufu nĩmatuĩkĩte mĩhĩrĩga ĩĩrĩ, nĩyo mũhĩrĩga wa Manase, na wa Efiraimu.Alawii matiigana kũgaĩrwo ithaka tiga o matũũra ma gũtũũra, na ithaka iria ciarigiicĩirie matũũra macio cia kũrĩithagia ndũũru ciao cia mbũri na ngʼombe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio andũ a Isiraeli makĩgayania bũrũri ũcio o ta ũrĩa Jehova aathĩte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalebu Kũheo Hebironi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, andũ a mũhĩrĩga wa Juda magĩthiĩ kũrĩ Joshua kũu Giligali, nake Kalebu mũrũ wa Jefune ũrĩa Mũkenizi akĩmwĩra atĩrĩ, “Wee nĩũũĩ ũhoro ũrĩa Jehova eerire Musa mũndũ wa Ngai ũkoniĩ niĩ nawe tũrĩ kũu Kadeshi-Barinea.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niĩ ndaarĩ na ũkũrũ wa mĩaka mĩrongo ĩna hĩndĩ ĩrĩa Musa ndungata ya Jehova aandũmire kuuma Kadeshi-Barinea thiĩ ngathigaane bũrũri ũcio. Nĩndamũcookeirie ũhoro o ta ũrĩa warĩ ngoro-inĩ yakwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "no rĩrĩ, ariũ a ithe witũ arĩa twaambatanĩtie nao nĩmatũmire ngoro cia andũ ciyũrwo nĩ guoya. No o na kũrĩ ũguo-rĩ, niĩ nĩ ndarũmĩrĩire Jehova Ngai wakwa na ngoro yakwa yothe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio, Musa akĩĩhĩta na mwĩhĩtwa mũthenya o ro ũcio akĩnjĩĩra atĩrĩ, ‘Ti-itherũ bũrũri ũcio makinya maku marakinyangire ũgaatuĩka igai rĩaku na rĩa ciana ciaku nginya tene, nĩ ũndũ nĩũrũmĩrĩire Jehova Ngai wakwa na ngoro yaku yothe.’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na rĩrĩ, o ta ũrĩa Jehova eranĩire nĩageeka-rĩ, nĩandũũrĩtie muoyo mĩaka mĩrongo ĩna na ĩtano kuuma hĩndĩ ĩrĩa aarĩirie Musa akĩmũhe ũhoro ũcio, hĩndĩ ĩyo yothe Isiraeli moorũũraga werũ-inĩ. Na rĩrĩ, ndĩ haha ũmũthĩ, ndĩ na ũkũrũ wa mĩaka mĩrongo ĩnana na ĩtano!",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndĩ na hinya ũmũthĩ o ta ũrĩa ndarĩ naguo mũthenya ũrĩa Musa aandũmire; ndĩ na hinya wa gũthiĩ mbaara-inĩ o ta ũrĩa ndaarĩ naguo hĩndĩ ĩyo, hinya wa gũthiĩ rũgendo kana wa kũinũka mũciĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ ũcio rĩu kĩĩhe bũrũri ũyũ wa irĩma, o ũrĩa Jehova aaririe ũhoro waguo mũthenya ũcio. Wee mwene nĩwaiguire mũthenya ũcio atĩ andũ a Anaki maarĩ kũndũ kũu, namo matũũra mao maarĩ manene na makairigĩrwo na hinya mũno, na rĩrĩ, Jehova angĩkorwo hamwe na niĩ andeithie-rĩ, nĩngũmaingata o ta ũrĩa oigire.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Joshua agĩkĩrathima Kalebu mũrũ wa Jefune, na akĩmũhe Hebironi gũtuĩke igai rĩake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Hebironi gũtũũire kũrĩ gwa Kalebu mũrũ wa Jefune ũcio Mũkenizi kuuma hĩndĩ ĩyo, nĩ ũndũ nĩarũmĩrĩire Jehova Ngai wa Isiraeli na ngoro yake yothe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Hebironi gwetagwo Kiriathu-Ariba nĩ ũndũ gwetanĩtio na Ariba, ũrĩa warĩ mũndũ mũnene mũno gũkĩra arĩa angĩ othe thĩinĩ wa andũ a Anaki). Naguo bũrũri ũkĩhoorera, gũkĩaga mbaara.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
