{
  "id": "JOS.9",
  "number": "9",
  "bookId": "JOS",
  "reference": "Joshua 9",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOS 9"
      },
