          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wara wa Andũ a Gibeoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩa athamaki othe arĩa maarĩ mwena wa ithũĩro wa Rũũĩ rwa Jorodani maiguire maũndũ macio, na arĩa maarĩ bũrũri ũrĩa ũrĩ irĩma, na arĩa maarĩ ituamba-ini ciikũrũko cia irĩma cia mwena wa ithũĩro, na kũu hũgũrũrũ-inĩ cia Iria rĩrĩa Inene guothe o nginya Lebanoni (nĩo athamaki a andũ a Ahiti, na Aamori, na Akaanani, na Aperizi, na Ahivi, na Ajebusi),",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.1",
            "verseOrgIds": [
              "JOS.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "magĩcookanĩrĩra hamwe nĩguo mahũũrane na Joshua na Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.2",
            "verseOrgIds": [
              "JOS.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, rĩrĩa andũ a Gibeonimaaiguire ũrĩa Joshua ekĩte itũũra rĩa Jeriko o na rĩa Ai,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.3",
            "verseOrgIds": [
              "JOS.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "magĩĩka ũndũ wa wara. Magĩthiĩ marĩ ta andũ matũmĩtwo marĩ na ndigiri ciao ikuuithĩtio makũnia matarũkangu, na mondo ngũrũ mũno cia ndibei irĩ nduĩkangu na igatumwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.4",
            "verseOrgIds": [
              "JOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao arũme acio meekĩrĩte iraatũ ciarĩ ndarũku, ciarĩ na iraka, na makehumba nguo ngũrũ. Irio ciao ciothe iria meekuuĩire rĩĩgu ciarĩ nyũmũ na ikagĩa mbuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
              "JOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao magĩthiĩ kũrĩ Joshua kambĩ-inĩ o kũu Giligali, makĩmwĩra atĩrĩ we mwene hamwe na andũ a Isiraeli, “Tũũkĩte kuuma bũrũri wa kũraya mũno na gũkũ; tondũ ũcio gĩai kĩrĩkanĩro na ithuĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
            "verseOrgIds": [
              "JOS.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ a Isiraeli makĩĩra Ahiviacio atĩrĩ, “Hihi no gũkorwo mũtũũraga o gũkũ gũkuhĩ na ithuĩ, tũngĩhota atĩa kũgĩa kĩrĩkanĩro na inyuĩ?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao magĩcookeria Joshua atĩrĩ, “Ithuĩ tũrĩ ndungata ciaku.” Ningĩ Joshua akĩmooria atĩrĩ, “Inyuĩ mũrĩ a, na muumĩte kũ?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao makĩmũcookeria atĩrĩ, “Ithuĩ ndungata ciaku tuumĩte bũrũri wa kũraya mũno na gũkũ, tũũkĩte nĩ ũndũ wa ngumo ya Jehova Ngai wanyu. Nĩgũkorwo nĩtũiguĩte ũhoro wake: o na maũndũ mothe marĩa eekire bũrũri wa Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ũrĩa wothe eekire athamaki arĩa eerĩ a Aamori kũu irathĩro rĩa Rũũĩ rwa Jorodani, nao nĩ Sihoni mũthamaki wa Heshiboni, na Ogu mũthamaki wa Bashani, ũrĩa wathamakaga Ashitarothu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao athuuri atongoria aitũ na andũ arĩa othe matũũraga bũrũri witũ nĩmatwĩrire atĩrĩ, ‘Kuuai irio nĩ ũndũ wa rũgendo rwanyu, mũthiĩ mũcemanie na andũ acio, na mũmeere atĩrĩ, “Ithuĩ tũrĩ ndungata cianyu; gĩai kĩrĩkanĩro na ithuĩ.” ’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.11",
            "verseOrgIds": [
              "JOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irio ici ciitũ cia rĩĩgu ciarĩ hiũ mũthenya ũrĩa tuoimire gwitũ tũke kũrĩ inyuĩ. No rĩu ta kĩonei ũrĩa ciũmĩte na ikagĩa mbuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.12",
            "verseOrgIds": [
              "JOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nacio mondo ici ciarĩ njerũ tũgĩciyũria ndibei, no rĩu ta kĩonei ũrĩa ituĩkangĩte. Nacio nguo ciitũ na iraatũ nĩikũrĩte nĩ ũndũ wa rũgendo kũraiha mũno.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.13",
            "verseOrgIds": [
              "JOS.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andũ a Isiraeli makĩrora irio imwe cia andũ acio, no matiigana kũhooya kĩrĩra kuuma harĩ Jehova.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Joshua akĩgĩa kĩrĩkanĩro gĩa thayũ nao atĩ areke matũũre muoyo, nao atongoria a kĩũngano kĩu kĩa andũ a Isiraeli magĩĩkĩra ũhoro ũcio hinya na mwĩhĩtwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mĩthenya ĩtatũ thuutha wa kũgĩa na kĩrĩkanĩro kĩu na andũ acio a Gibeoni, andũ a Isiraeli makĩigua atĩ andũ acio maahakanĩte nao, na maatũũraga o hakuhĩ nao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio andũ a Isiraeli makiumagara, na mũthenya wa gatatũ magĩkinya matũũra-inĩ mao manene, na nĩmo: Gibeoni, na Kefira, na Beerothu, na Kiriathu-Jearimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "No andũ a Isiraeli matiigana kũmahũũra, nĩ ũndũ atongoria a kĩũngano kĩao nĩmehĩtĩte na mwĩhĩtwa makĩgwetaga rĩĩtwa rĩa Jehova Ngai wa Isiraeli. Nakĩo kĩũngano kĩu gĩothe gĩkĩnuguna nĩ ũndũ wa atongoria acio,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "no atongoria acio othe makĩmacookeria atĩrĩ, “Nĩtwĩhĩtĩte na mwĩhĩtwa tũkĩgwetaga rĩĩtwa rĩa Jehova Ngai wa Isiraeli, na tondũ ũcio tũtingĩmahutia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ũrĩa tũngĩmeeka nĩ atĩrĩ: Nĩ tũkũreka matũũre muoyo, nĩgeetha tũtikanacookererwo nĩ marakara nĩ ũndũ wa kuuna mwĩhĩtwa ũrĩa twehĩtire nĩ ũndũ wao.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O na ningĩ makĩmeera atĩrĩ, “Rekei matũũre muoyo, no matuĩke a kuunaga ngũ na a gũtahagĩra kĩrĩndĩ gĩkĩ gĩothe gĩa Isiraeli maaĩ.” Nĩ ũndũ ũcio atongoria makĩiga kĩrĩko kĩao kũrĩ andũ acio a Gibeoni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ Joshua agĩĩta andũ acio a Gibeoni akĩmooria atĩrĩ, “Nĩ kĩĩ gĩatũmire mũtũheenie rĩrĩa mwoigire atĩrĩ, ‘Tũtũũraga kũndũ kũraya mũno na inyuĩ,’ o rĩrĩa mũtũũraga o gũkũ gũkuhĩ na ithuĩ?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondũ ũcio nĩmwagwatwo nĩ kĩrumi, na inyuĩ mũtigatiga gũtuĩka ndungata cia kuuna ngũ na gũtahagĩra nyũmba ya Ngai wakwa maaĩ.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao magĩcookeria Joshua makĩmwĩra atĩrĩ, “Ithuĩ ndungata ciaku nĩtwerirwo o wega ũrĩa Jehova Ngai waku aathire ndungata yake Musa akamũhe bũrũri ũyũ wothe, na atĩ aniine andũ othe arĩa matũũraga kuo mehere mbere yanyu. Nĩ ũndũ ũcio tũgĩĩtigĩra mũno, tweciria ũrĩa mũngĩtũũraga, na nĩkĩo twekire ũndũ ũcio.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rĩrĩ, rĩu tũrĩ moko-inĩ maku. Twĩke ũndũ ũrĩa wothe ũkuona ũrĩ mwega na wa kĩhooto.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nĩ ũndũ ũcio Joshua akĩmahonokia kuuma kũrĩ andũ a Isiraeli, na matiamoragire.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya o ro ũcio Joshua agĩtua andũ acio a Gibeoni oini a ngũ na atahĩri mũingĩ wa Isiraeli maaĩ, o na atahĩri kĩgongona kĩa Jehova maaĩ o harĩa hothe Jehova angĩathuurire. Ũguo nĩguo matũire nginya ũmũthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        }
      ]
    }
  ],
