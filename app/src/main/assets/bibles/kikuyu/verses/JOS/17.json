{
  "id": "JOS.17",
  "number": "17",
  "bookId": "JOS",
  "reference": "Joshua 17",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
