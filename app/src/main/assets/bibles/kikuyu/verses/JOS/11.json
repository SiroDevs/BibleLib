{
  "id": "JOS.11",
  "number": "11",
  "bookId": "JOS",
  "reference": "Joshua 11",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
