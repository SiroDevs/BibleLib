          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Janimu, na Bethi-Tapua, na Afeka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.53",
            "verseOrgIds": [
              "JOS.15.53"
            ]
          }
        },
        {
          "name": "verse",
