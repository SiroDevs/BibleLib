          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JOS 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humuta, na Kiriathu-Ariba (na no kuo Hebironi), na Zioru; mothe maarĩ matũũra kenda na tũtũũra twamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.54",
            "verseOrgIds": [
