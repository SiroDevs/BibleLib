          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ningĩ itũũra rĩa Ekironi, nginya iria-inĩ na kũrĩa guothe gwakuhĩrĩirie Ashidodi, hamwe na tũtũũra twakuo;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "o na Ashidodi na mĩciĩ ĩrĩa yarĩthiũrũrũkĩirie, na tũtũũra twarĩo; na Gaza na mĩciĩ ĩrĩa yarĩthiũrũrũkĩirie, na tũtũũra twa rĩo, nginya karũũĩ ka bũrũri wa Misiri, na hũgũrũrũ cia Iria rĩrĩa Inene.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
            "verseOrgIds": [
              "JOS.15.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namo matũũra ma bũrũri ũrĩa ũrĩ irĩma nĩ: Shamiru, na Jatiri, na Soko,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Dana, na Kiriathu-Sana (na no kuo Debiri),",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.49",
            "verseOrgIds": [
              "JOS.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Anabu, na Eshitemo, na Animu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.50",
            "verseOrgIds": [
              "JOS.15.50"
            ]
          }
        },
