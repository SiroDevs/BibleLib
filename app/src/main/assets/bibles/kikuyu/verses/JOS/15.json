          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Lebaothu, na Shilihimu, na Aini, na Rimoni; mothe nĩ matũũra mĩrongo ĩrĩ na kenda na tũtũũra twamo.",
          "type": "text",
          "attrs": {
