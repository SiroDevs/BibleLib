              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Shaaraimu, na Adithaimu, na Gedera (kana Gederothaimu); mothe maarĩ matũũra ikũmi na mana na tũtũũra twamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.36",
