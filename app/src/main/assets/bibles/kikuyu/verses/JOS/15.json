          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Zanoa, na Eni-Ganimu, na Tapua, na Enamu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.34",
            "verseOrgIds": [
              "JOS.15.34"
            ]
          }
        },
