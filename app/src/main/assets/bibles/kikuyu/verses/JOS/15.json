          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Halihuli, na Bethi-Zuru, na Gedoru,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.58",
            "verseOrgIds": [
              "JOS.15.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JOS 15:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Maarathu, na Bethi-Anothu, na Elitekoni; mothe maarĩ matũũra matandatũ na tũtũũra twamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.59",
            "verseOrgIds": [
              "JOS.15.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriathu-Baali (na nĩkuo Kiriathu-Jearimu), na Raba; matũũra meerĩ na tũtũũra twamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
              "JOS.15.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "JOS 15:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuo kũu werũ-inĩ matũũra maarĩ: Bethi-Araba, na Midini, na Sekaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.61",
            "verseOrgIds": [
              "JOS.15.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "JOS 15:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Nibushani, na itũũra inene rĩa Cumbĩ, na Eni-Gedi; mothe maarĩ matũũra matandatũ na tũtũũra twamo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.62",
            "verseOrgIds": [
              "JOS.15.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "JOS 15:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "No rĩrĩ, andũ a Juda matiahotire kũingata Ajebusi, arĩa maatũũraga Jerusalemu; na Ajebusi matũũranagia na andũ a Juda kũu Jerusalemu nginya ũmũthĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.63",
            "verseOrgIds": [
              "JOS.15.63"
            ]
          }
        }
      ]
