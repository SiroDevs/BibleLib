        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igai rĩa Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo bũrũri ũrĩa wagaĩirwo mũhĩrĩga wa Juda, kũringana na ũrĩa mbarĩ ciao ciatariĩ, wakinyĩte o mũhaka-inĩ wa bũrũri wa Edomu, o na ũgakinya werũ-inĩ wa Zini gĩturi-inĩ kĩa mwena ũcio wa gũthini.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.1",
            "verseOrgIds": [
              "JOS.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũhaka wao wa mwena wa gũthini wambĩrĩire gĩcongoco-inĩ kĩa mwena wa gũthini kĩa Iria rĩa Cumbĩ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mũhaka ũcio ũkahĩtũkĩra mwena wa gũthini wa Mwanya wa Akirabimu, ũgathiĩ na mbere o nginya Zini, na ũkambatĩrĩra na mwena wa gũthini wa Kadeshi-Barinea. Ningĩ ũgathiĩ wĩgiritanĩtie na Hezironi, ũkambata ũgakinya Adari, ningĩ ũkarigiicũka ũgakinya Karika.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ wacookete ũgathiĩ o ro ũguo nginya Azimoni, ũkoimĩrĩra karũũĩ ka bũrũri wa Misiri, ũkarĩkĩrĩria iria-inĩ. Ũyũ nĩguo mũhaka wao wa mwena wa gũthini.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũhaka wa mwena wa irathĩro warĩ Iria rĩa Cumbĩ nginya mũthia wa Rũũĩ rwa Jorodani. Naguo mũhaka wa mwena wa gathigathini wambĩrĩirie gĩcongoco-inĩ kĩa iria mũthia-inĩ wa Rũũĩ rwa Jorodani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ũkambatĩrĩra nginya Bethi-Hogila, na ũgathiĩ ũhĩtũkĩire mwena wa gathigathini wa Bethi-Araba, na ũkambata ũgakinya Ihiga-inĩ rĩa Bohani mũrũ wa Rubeni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũhaka ũcio wacookete ũkambata nginya Debiri uumĩte Gĩtuamba kĩa Akori, ũgacooka ũkerekera gathigathini o nginya itũũra-inĩ rĩa Giligali, rĩrĩa rĩangʼethanĩire na Mwanya wa Adumimu, mwena wa gũthini wa mũkuru ũcio. Wacookete ũgathiĩ na mbere ũgakinya maaĩ-inĩ ma Eni-Shemeshu, na ũkoimĩrĩra o kũu Eni-Rogeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ ũkambatania na Gĩtuamba kĩa Beni-Hinomu ũikũrũkanĩtie na kĩharũrũka kĩa mwena wa gũthini wa itũũra inene rĩa Mũjebusi (na nĩrĩo Jerusalemu). Kuuma hau ũkambata nginya gacũmbĩrĩ ga karĩma karĩa karĩ mwena wa ithũĩro wa Gĩtuamba kĩa Hinomu o kũu mũthia wa gathigathini wa Gĩtuamba kĩa Refaimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma gacũmbĩrĩ ga karĩma mũhaka ũcio werekeire gĩthima kĩa maaĩ ma Nefitoa, ũkiumĩrĩra matũũra-inĩ ma kĩrĩma kĩa Efironi, na ũgaikũrũka ũgakinya Baala (na nokuo Kiriathu-Jearimu).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũhaka ũcio ũkarigiicũka na mwena wa ithũĩro uumĩte Baala ũgakinya Kĩrĩma kĩa Seiru, ũgacooka ũgaaikũrũkania na kĩharũrũka kĩa mwena wa gathigathini wa kĩrĩma gĩa Jearimu (nĩkĩo Kesaloni), ũgathiĩ na mbere ũikũrũkĩte nginya Bethi-Shemeshu, na ũgakĩra nginya Timina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ mũhaka ũcio ũkoima hau, ũgathiĩ nginya kĩharũrũka-inĩ kĩa mwena wa gathigathini wa Ekironi, ũkehiũria werekeire Shikeroni, ũkahĩtũka, ũgathiĩ kĩrĩma-inĩ kĩa Baala, na ũgakinya Jabuneeli. Mũhaka ũcio wathirĩire o iria-inĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo mũhaka wa mwena wa ithũĩro wegiritanĩtie na hũgũrũrũ cia Iria rĩrĩa Inene. Ĩyo nĩyo mĩhaka ĩrĩa yathiũrũrũkĩirie andũ a mũhĩrĩga wa Juda, o ta ũrĩa mbarĩ ciao ciatariĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ũrĩa Jehova aamwathĩte-rĩ, Joshua nĩaheire Kalebu wa Jefune igai thĩinĩ wa mũhĩrĩga wa Juda, akĩheo Kiriathu-Ariba, na nokuo Hebironi. (Ariba nĩwe warĩ ithe wa Anaki).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Kalebu akĩingata Anaki arĩa atatũ kuuma Hebironi, nĩo Sheshai, na Ahimani, na Talimai, arĩa njiaro cia Anaki.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningĩ agĩcooka agĩthiĩ kũrũa na andũ arĩa maatũũraga itũũra inene rĩa Debiri (kũrĩa tene gwetagwo Kiriathu-Sefari.)",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Kalebu akiuga atĩrĩ, “Mũndũ ũrĩa ugũtharĩkĩra na atunyane Kiriathu-Sefari, ũcio nĩwe ngũhe mwarĩ wakwa Akisa, amũhikie.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Othinieli mũrũ wa Kenazu, mũrũ wa ithe na Kalebu, nĩwe watunyanire itũũra rĩu; nĩ ũndũ ũcio Kalebu akĩmũhe mwarĩ Akisa atuĩke mũtumia wake.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mũthenya ũmwe rĩrĩa Akisa aathiire kũrĩ Othinieli-rĩ, akĩringĩrĩria Akisa ahooe mũgũnda kũrĩ ithe Kalebu. Aarĩkia kuuma igũrũ rĩa ndigiri yake, Kalebu akĩmũũria atĩrĩ, “Ũkwenda ngwĩkĩre atĩa?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake akĩmũcookeria atĩrĩ, “Ndagũthaitha ũndathime. Tondũ nĩũũheete bũrũri wa Negevu, he ithima cia maaĩ o nacio.” Nĩ ũndũ ũcio Kalebu akĩmũhe ithima cia mwena wa rũgongo na cia mwena wa kĩanda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rĩĩrĩ nĩrĩo igai rĩa mũhĩrĩga wa Juda, kũringana na ũrĩa mbarĩ ciao ciatariĩ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.20",
            "verseOrgIds": [
              "JOS.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matũũra marĩa maarĩ mũthia wa gũthini ma mũhĩrĩga wa Juda thĩinĩ wa Negevu kwerekera mũhaka wa Edomu maarĩ maya: Kabizeeli, na Ederi, na Jaguri,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kina, na Dimona, na Adada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kedeshi, na Hazoru, na Ithinani,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Zifu, na Telemu, na Bealothu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hazoru-Hadata, na Keriothu-Hezironi (na norĩo Hazoru),",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Amamu, na Shema, na Molada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hazoru-Gada, na Heshimoni, na Bethi-Peletu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hazoru-Shuali, na Birishiba, na Biziothia,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.28",
            "verseOrgIds": [
              "JOS.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Baala, na Iimu, na Ezemu,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.29",
            "verseOrgIds": [
              "JOS.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Elitoladi, na Chesili, na Horoma,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.30",
