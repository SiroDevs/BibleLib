          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Ekironi na mĩciĩ ĩrĩa yarĩthiũrũrũkĩirie, na tũtũũra twamo;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
