          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "This also cometh forth from the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.29",
            "verseOrgIds": [
              "ISA.28.29"
            ]
          }
        },
        {
