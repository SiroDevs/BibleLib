              "attrs": {
                "verseId": "ISA.28.28",
                "verseOrgIds": [
                  "ISA.28.28"
                ]
              }
            }
          ]
        },
        {
          "text": "the wheel of his cart, nor bruise it",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.28",
            "verseOrgIds": [
              "ISA.28.28"
            ]
          }
