              "attrs": {
                "verseId": "ISA.1.31",
                "verseOrgIds": [
                  "ISA.1.31"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.31",
            "verseOrgIds": [
