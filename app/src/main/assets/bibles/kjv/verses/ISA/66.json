            "number": "1",
            "style": "v",
            "sid": "ISA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.1",
                "verseOrgIds": [
                  "ISA.66.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", The heaven",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.1",
                "verseOrgIds": [
                  "ISA.66.1"
                ]
              }
            }
          ]
        },
        {
          "text": "my throne, and the earth",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.1",
                "verseOrgIds": [
                  "ISA.66.1"
                ]
              }
            }
          ]
        },
        {
          "text": "my footstool: where",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.1",
                "verseOrgIds": [
                  "ISA.66.1"
                ]
              }
            }
          ]
        },
        {
          "text": "the house that ye build unto me? and where",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.1",
                "verseOrgIds": [
                  "ISA.66.1"
                ]
              }
            }
          ]
        },
        {
          "text": "the place of my rest?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "For all those",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "things",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.2",
                "verseOrgIds": [
                  "ISA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hath mine hand made, and all those",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "things",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.2",
                "verseOrgIds": [
                  "ISA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": "have been, saith the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.2",
                "verseOrgIds": [
                  "ISA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": ": but to this",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.2",
                "verseOrgIds": [
                  "ISA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": "will I look,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.2",
                "verseOrgIds": [
                  "ISA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": "to",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "him that is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.2",
                "verseOrgIds": [
                  "ISA.66.2"
                ]
              }
            }
          ]
        },
        {
          "text": "poor and of a contrite spirit, and trembleth at my word.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that killeth an ox",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is as if",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.3",
                "verseOrgIds": [
                  "ISA.66.3"
                ]
              }
            }
          ]
        },
        {
          "text": "he slew a man; he that sacrificeth a lamb,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as if",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.3",
                "verseOrgIds": [
                  "ISA.66.3"
                ]
              }
            }
          ]
        },
        {
          "text": "he cut off a dog's neck; he that offereth an oblation,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as if he offered",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.3",
                "verseOrgIds": [
                  "ISA.66.3"
                ]
              }
            }
          ]
        },
        {
          "text": "swine's blood; he that burneth incense,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as if",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.3",
                "verseOrgIds": [
                  "ISA.66.3"
                ]
              }
            }
          ]
        },
        {
          "text": "he blessed an idol. Yea, they have chosen their own ways, and their soul delighteth in their abominations.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I also will choose their delusions, and will bring their fears upon them; because when I called, none did answer; when I spake, they did not hear: but they did evil before mine eyes, and chose",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.4",
                "verseOrgIds": [
                  "ISA.66.4"
                ]
              }
            }
          ]
        },
        {
          "text": "in which I delighted not.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Hear the word of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.5",
                "verseOrgIds": [
                  "ISA.66.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ye that tremble at his word; Your brethren that hated you, that cast you out for my name's sake, said, Let the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.5",
                "verseOrgIds": [
                  "ISA.66.5"
                ]
              }
            }
          ]
        },
        {
          "text": "be glorified: but he shall appear to your joy, and they shall be ashamed.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A voice of noise from the city, a voice from the temple, a voice of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.6",
                "verseOrgIds": [
                  "ISA.66.6"
                ]
              }
            }
          ]
        },
        {
          "text": "that rendereth recompence to his enemies.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Before she travailed, she brought forth; before her pain came, she was delivered of a man child.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who hath heard such a thing? who hath seen such things? Shall the earth be made to bring forth in one day?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.8",
                "verseOrgIds": [
                  "ISA.66.8"
                ]
              }
            }
          ]
        },
        {
          "text": "shall a nation be born at once? for as soon as Zion travailed, she brought forth her children.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shall I bring to the birth, and not cause to bring forth? saith the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.9",
                "verseOrgIds": [
                  "ISA.66.9"
                ]
              }
            }
          ]
        },
        {
          "text": ": shall I cause to bring forth, and shut",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "the womb",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.9",
                "verseOrgIds": [
                  "ISA.66.9"
                ]
              }
            }
          ]
        },
        {
          "text": "? saith thy God.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rejoice ye with Jerusalem, and be glad with her, all ye that love her: rejoice for joy with her, all ye that mourn for her:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.10",
            "verseOrgIds": [
              "ISA.66.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "That ye may suck, and be satisfied with the breasts of her consolations; that ye may milk out, and be delighted with the abundance of her glory.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.12",
                "verseOrgIds": [
                  "ISA.66.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Behold, I will extend peace to her like a river, and the glory of the Gentiles like a flowing stream: then shall ye suck, ye shall be borne upon",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "her",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.12",
                "verseOrgIds": [
                  "ISA.66.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sides, and be dandled upon",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "her",
              "type": "text",
              "attrs": {
                "verseId": "ISA.66.12",
                "verseOrgIds": [
                  "ISA.66.12"
                ]
              }
            }
