          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.16",
                "verseOrgIds": [
                  "ISA.43.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", which maketh a way in the sea, and a path in the mighty waters;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.16",
            "verseOrgIds": [
              "ISA.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
