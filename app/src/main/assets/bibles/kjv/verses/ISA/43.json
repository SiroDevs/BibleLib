                "verseId": "ISA.43.14",
                "verseOrgIds": [
                  "ISA.43.14"
                ]
              }
            }
          ]
        },
        {
          "text": "in the ships.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        },
        {
