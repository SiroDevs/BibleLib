          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yea, before the day",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.13",
                "verseOrgIds": [
                  "ISA.43.13"
                ]
              }
            }
          ]
        },
        {
          "text": "I",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.13",
                "verseOrgIds": [
                  "ISA.43.13"
                ]
              }
            }
          ]
        },
        {
          "text": "he; and",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.13",
                "verseOrgIds": [
                  "ISA.43.13"
                ]
              }
            }
          ]
        },
        {
          "text": "none that can deliver out of my hand: I will work, and who shall let it?",
          "type": "text",
          "attrs": {
