            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.15",
                "verseOrgIds": [
                  "ISA.43.15"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        },
        {
