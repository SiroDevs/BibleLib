                "verseId": "ISA.43.11",
                "verseOrgIds": [
                  "ISA.43.11"
                ]
              }
            }
          ]
        },
        {
          "text": "I,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.11",
                "verseOrgIds": [
                  "ISA.43.11"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.11",
                "verseOrgIds": [
                  "ISA.43.11"
                ]
              }
            }
          ]
        },
        {
          "text": "; and beside me",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        },
        {
