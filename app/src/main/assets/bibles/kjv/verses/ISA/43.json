                "verseId": "ISA.43.15",
                "verseOrgIds": [
                  "ISA.43.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", your Holy One, the creator of Israel, your King.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        },
        {
