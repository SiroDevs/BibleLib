              "type": "text",
              "attrs": {
                "verseId": "ISA.43.11",
                "verseOrgIds": [
                  "ISA.43.11"
                ]
              }
            }
          ]
        },
        {
          "text": "no saviour.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I have declared, and have saved, and I have shewed, when",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there was",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.12",
                "verseOrgIds": [
                  "ISA.43.12"
                ]
              }
            }
          ]
        },
        {
          "text": "no strange",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "god",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.12",
                "verseOrgIds": [
                  "ISA.43.12"
                ]
              }
            }
          ]
        },
        {
          "text": "among you: therefore ye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.12",
                "verseOrgIds": [
                  "ISA.43.12"
                ]
              }
            }
          ]
        },
        {
          "text": "my witnesses, saith the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.12",
                "verseOrgIds": [
                  "ISA.43.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", that I",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.43.12",
                "verseOrgIds": [
                  "ISA.43.12"
                ]
              }
            }
          ]
        },
        {
          "text": "God.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
              "ISA.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
