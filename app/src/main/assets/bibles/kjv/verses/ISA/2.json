          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.17",
                "verseOrgIds": [
                  "ISA.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": "alone shall be exalted in that day.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.17",
            "verseOrgIds": [
              "ISA.2.17"
            ]
          }
        },
        {
