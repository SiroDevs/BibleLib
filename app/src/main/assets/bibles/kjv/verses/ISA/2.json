          "text": "For the day of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
