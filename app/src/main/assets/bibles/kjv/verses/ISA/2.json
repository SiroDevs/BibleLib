          "text": "upon every",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "one that is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.12",
                "verseOrgIds": [
                  "ISA.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "proud and lofty, and upon every",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "one that is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.12",
                "verseOrgIds": [
                  "ISA.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "lifted up; and he shall be brought low:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
