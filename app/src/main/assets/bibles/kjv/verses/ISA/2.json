          "attrs": {
            "verseId": "ISA.2.19",
            "verseOrgIds": [
              "ISA.2.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
