          "text": "And upon all the cedars of Lebanon,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
              "ISA.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that are",
              "type": "text",
              "attrs": {
                "verseId": "ISA.2.13",
                "verseOrgIds": [
                  "ISA.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "high and lifted up, and upon all the oaks of Bashan,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
              "ISA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
