            "style": "v",
            "sid": "ISA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Hearken unto me, O house of Jacob, and all the remnant of the house of Israel, which are borne",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "by me",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.3",
                "verseOrgIds": [
                  "ISA.46.3"
                ]
              }
            }
          ]
        },
        {
          "text": "from the belly, which are carried from the womb:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "And",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.4",
                "verseOrgIds": [
                  "ISA.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "to",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "your",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.4",
                "verseOrgIds": [
                  "ISA.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "old age I",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.4",
                "verseOrgIds": [
                  "ISA.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "he; and",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.4",
                "verseOrgIds": [
                  "ISA.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "to hoar hairs will I carry",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "you:",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.4",
                "verseOrgIds": [
                  "ISA.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "I have made, and I will bear; even I will carry, and will deliver",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "you",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.4",
                "verseOrgIds": [
                  "ISA.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
