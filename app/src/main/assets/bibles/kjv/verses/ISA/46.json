            "sid": "ISA 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Hearken unto me, ye stouthearted, that",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "ISA.46.12",
                "verseOrgIds": [
                  "ISA.46.12"
                ]
              }
            }
          ]
        },
        {
          "text": "far from righteousness:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I bring near my righteousness; it shall not be far off, and my salvation shall not tarry: and I will place salvation in Zion for Israel my glory.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.13",
            "verseOrgIds": [
              "ISA.46.13"
            ]
          }
        }
      ]
    }
  ],
