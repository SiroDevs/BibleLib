          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ To whom then will ye liken God? or what likeness will ye compare unto him?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.18",
            "verseOrgIds": [
              "ISA.40.18"
            ]
          }
        },
        {
          "name": "verse",
