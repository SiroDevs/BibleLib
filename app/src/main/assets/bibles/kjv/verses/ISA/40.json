          "type": "text",
          "attrs": {
            "verseId": "ISA.40.10",
            "verseOrgIds": [
              "ISA.40.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.10",
            "verseOrgIds": [
              "ISA.40.10"
            ]
          }
        },
        {
          "name": "verse",
