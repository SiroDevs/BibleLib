                "verseOrgIds": [
                  "ISA.40.28"
                ]
              }
            }
          ]
        },
        {
          "text": "the everlasting God, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.28",
            "verseOrgIds": [
              "ISA.40.28"
            ]
          }
