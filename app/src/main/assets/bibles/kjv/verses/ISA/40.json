              "attrs": {
                "verseId": "ISA.40.11",
                "verseOrgIds": [
                  "ISA.40.11"
                ]
              }
            }
          ]
        },
        {
          "text": "shall gently lead those that are with young.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.11",
            "verseOrgIds": [
              "ISA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
