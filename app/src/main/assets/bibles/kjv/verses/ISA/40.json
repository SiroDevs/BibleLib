              "type": "text"
            }
          ]
        },
        {
          "text": "¶ The voice of him that crieth in the wilderness, Prepare ye the way of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.3",
            "verseOrgIds": [
              "ISA.40.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.3",
                "verseOrgIds": [
                  "ISA.40.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", make straight in the desert a highway for our God.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.3",
            "verseOrgIds": [
              "ISA.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
