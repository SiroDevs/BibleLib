                "verseId": "ISA.40.6",
                "verseOrgIds": [
                  "ISA.40.6"
                ]
              }
            }
          ]
        },
        {
          "text": "grass, and all the goodliness thereof",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
