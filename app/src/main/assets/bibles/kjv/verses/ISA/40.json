                "verseId": "ISA.40.27",
                "verseOrgIds": [
                  "ISA.40.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", and my judgment is passed over from my God?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.27",
            "verseOrgIds": [
              "ISA.40.27"
            ]
          }
        }
      ]
