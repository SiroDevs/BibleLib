          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ O Zion, that bringest good tidings, get thee up into the high mountain; O Jerusalem, that bringest good tidings, lift up thy voice with strength; lift",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.9",
            "verseOrgIds": [
              "ISA.40.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.9",
                "verseOrgIds": [
                  "ISA.40.9"
                ]
              }
            }
          ]
        },
        {
          "text": "up, be not afraid; say unto the cities of Judah, Behold your God!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.9",
            "verseOrgIds": [
              "ISA.40.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.9",
            "verseOrgIds": [
              "ISA.40.9"
            ]
          }
        },
        {
