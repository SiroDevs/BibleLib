                "verseId": "ISA.40.5",
                "verseOrgIds": [
                  "ISA.40.5"
                ]
              }
            }
          ]
        },
        {
          "text": "shall be revealed, and all flesh shall see",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.5",
            "verseOrgIds": [
              "ISA.40.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.5",
                "verseOrgIds": [
                  "ISA.40.5"
                ]
              }
            }
          ]
        },
        {
          "text": "together: for the mouth of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.5",
            "verseOrgIds": [
              "ISA.40.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
