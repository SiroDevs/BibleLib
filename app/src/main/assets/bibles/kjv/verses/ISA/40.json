          "type": "text",
          "attrs": {
            "verseId": "ISA.40.13",
            "verseOrgIds": [
              "ISA.40.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.13",
                "verseOrgIds": [
                  "ISA.40.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", or",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.13",
            "verseOrgIds": [
              "ISA.40.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "being",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.13",
                "verseOrgIds": [
                  "ISA.40.13"
                ]
              }
            }
          ]
        },
        {
          "text": "his counsellor hath taught him?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.13",
            "verseOrgIds": [
              "ISA.40.13"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.13",
            "verseOrgIds": [
              "ISA.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "With whom took he counsel, and",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.14",
            "verseOrgIds": [
              "ISA.40.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "who",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.14",
                "verseOrgIds": [
                  "ISA.40.14"
                ]
              }
            }
          ]
        },
        {
          "text": "instructed him, and taught him in the path of judgment, and taught him knowledge, and shewed to him the way of understanding?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.14",
            "verseOrgIds": [
              "ISA.40.14"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.14",
            "verseOrgIds": [
              "ISA.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
