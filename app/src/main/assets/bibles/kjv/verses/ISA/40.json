          "text": "Behold, the nations",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.15",
            "verseOrgIds": [
              "ISA.40.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
