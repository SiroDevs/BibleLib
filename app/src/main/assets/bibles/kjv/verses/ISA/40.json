              "type": "text",
              "attrs": {
                "verseId": "ISA.40.6",
                "verseOrgIds": [
                  "ISA.40.6"
                ]
              }
            }
          ]
        },
        {
          "text": "as the flower of the field:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The grass withereth, the flower fadeth: because the spirit of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.7",
                "verseOrgIds": [
                  "ISA.40.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bloweth upon it: surely the people",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.7",
                "verseOrgIds": [
                  "ISA.40.7"
                ]
              }
            }
          ]
        },
        {
          "text": "grass.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The grass withereth, the flower fadeth: but the word of our God shall stand for ever.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.8",
            "verseOrgIds": [
              "ISA.40.8"
            ]
          }
        }
      ]
