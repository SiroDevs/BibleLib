          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "them",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.11",
                "verseOrgIds": [
                  "ISA.40.11"
                ]
              }
            }
          ]
        },
        {
          "text": "in his bosom,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.11",
            "verseOrgIds": [
              "ISA.40.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
