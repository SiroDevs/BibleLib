              "attrs": {
                "verseId": "ISA.40.10",
                "verseOrgIds": [
                  "ISA.40.10"
                ]
              }
            }
          ]
        },
        {
          "text": "will come with strong",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.10",
            "verseOrgIds": [
              "ISA.40.10"
            ]
