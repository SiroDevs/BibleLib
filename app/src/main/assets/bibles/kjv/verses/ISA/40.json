            "number": "1",
            "style": "v",
            "sid": "ISA 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Comfort ye, comfort ye my people, saith your God.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.1",
            "verseOrgIds": [
              "ISA.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Speak ye comfortably to Jerusalem, and cry unto her, that her warfare is accomplished, that her iniquity is pardoned: for she hath received of the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD's",
              "type": "text",
              "attrs": {
                "verseId": "ISA.40.2",
                "verseOrgIds": [
                  "ISA.40.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hand double for all her sins.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        }
      ]
    },
