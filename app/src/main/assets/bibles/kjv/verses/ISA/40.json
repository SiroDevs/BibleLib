            "number": "4",
            "style": "v",
            "sid": "ISA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Every valley shall be exalted, and every mountain and hill shall be made low: and the crooked shall be made straight, and the rough places plain:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.4",
            "verseOrgIds": [
              "ISA.40.4"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.4",
            "verseOrgIds": [
              "ISA.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
