          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The workman melteth a graven image, and the goldsmith spreadeth it over with gold, and casteth silver chains.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.19",
            "verseOrgIds": [
              "ISA.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.20",
            "verseOrgIds": [
              "ISA.40.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
