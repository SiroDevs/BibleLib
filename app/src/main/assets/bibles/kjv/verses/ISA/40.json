                "verseId": "ISA.40.20",
                "verseOrgIds": [
                  "ISA.40.20"
                ]
              }
            }
          ]
        },
        {
          "text": "so impoverished that he hath no oblation chooseth a tree",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.20",
            "verseOrgIds": [
              "ISA.40.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
