            "sid": "ISA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, the Lord",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.10",
            "verseOrgIds": [
              "ISA.40.10"
            ]
          }
