          "attrs": {
            "verseId": "ISA.40.12",
            "verseOrgIds": [
              "ISA.40.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.12",
            "verseOrgIds": [
              "ISA.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
