{
  "id": "ISA.47",
  "number": "47",
  "bookId": "ISA",
  "reference": "Isaiah 47",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "47",
        "style": "c",
        "sid": "ISA 47"
      },
      "items": [
        {
          "text": "47",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 47:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Come down, and sit in the dust, O virgin daughter of Babylon, sit on the ground:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.1",
                "verseOrgIds": [
                  "ISA.47.1"
                ]
              }
            }
          ]
        },
        {
          "text": "no throne, O daughter of the Chaldeans: for thou shalt no more be called tender and delicate.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.1",
            "verseOrgIds": [
              "ISA.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take the millstones, and grind meal: uncover thy locks, make bare the leg, uncover the thigh, pass over the rivers.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.2",
            "verseOrgIds": [
              "ISA.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thy nakedness shall be uncovered, yea, thy shame shall be seen: I will take vengeance, and I will not meet",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thee as",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.3",
                "verseOrgIds": [
                  "ISA.47.3"
                ]
              }
            }
          ]
        },
        {
          "text": "a man.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.3",
            "verseOrgIds": [
              "ISA.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "As for",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": "our redeemer, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.4",
                "verseOrgIds": [
                  "ISA.47.4"
                ]
              }
            }
          ]
        },
        {
          "text": "his name, the Holy One of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.4",
            "verseOrgIds": [
              "ISA.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sit thou silent, and get thee into darkness, O daughter of the Chaldeans: for thou shalt no more be called, The lady of kingdoms.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.5",
            "verseOrgIds": [
              "ISA.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ I was wroth with my people, I have polluted mine inheritance, and given them into thine hand: thou didst shew them no mercy; upon the ancient hast thou very heavily laid thy yoke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.6",
            "verseOrgIds": [
              "ISA.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ And thou saidst, I shall be a lady for ever:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "so",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.7",
                "verseOrgIds": [
                  "ISA.47.7"
                ]
              }
            }
          ]
        },
        {
          "text": "that thou didst not lay these",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "things",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.7",
                "verseOrgIds": [
                  "ISA.47.7"
                ]
              }
            }
          ]
        },
        {
          "text": "to thy heart, neither didst remember the latter end of it.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.7",
            "verseOrgIds": [
              "ISA.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore hear now this,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thou that art",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.8",
                "verseOrgIds": [
                  "ISA.47.8"
                ]
              }
            }
          ]
        },
        {
          "text": "given to pleasures, that dwellest carelessly, that sayest in thine heart, I",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.8",
                "verseOrgIds": [
                  "ISA.47.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", and none else beside me; I shall not sit",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.8",
                "verseOrgIds": [
                  "ISA.47.8"
                ]
              }
            }
          ]
        },
        {
          "text": "a widow, neither shall I know the loss of children:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "But these two",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "things",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.9",
                "verseOrgIds": [
                  "ISA.47.9"
                ]
              }
            }
          ]
        },
        {
          "text": "shall come to thee in a moment in one day, the loss of children, and widowhood: they shall come upon thee in their perfection for the multitude of thy sorceries,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.9",
                "verseOrgIds": [
                  "ISA.47.9"
                ]
              }
            }
          ]
        },
        {
          "text": "for the great abundance of thine enchantments.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ For thou hast trusted in thy wickedness: thou hast said, None seeth me. Thy wisdom and thy knowledge, it hath perverted thee; and thou hast said in thine heart, I",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.10",
                "verseOrgIds": [
                  "ISA.47.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", and none else beside me.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Therefore shall evil come upon thee; thou shalt not know from whence it riseth: and mischief shall fall upon thee; thou shalt not be able to put it off: and desolation shall come upon thee suddenly,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.11",
                "verseOrgIds": [
                  "ISA.47.11"
                ]
              }
            }
          ]
        },
        {
          "text": "thou shalt not know.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Stand now with thine enchantments, and with the multitude of thy sorceries, wherein thou hast laboured from thy youth; if so be thou shalt be able to profit, if so be thou mayest prevail.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou art wearied in the multitude of thy counsels. Let now the astrologers, the stargazers, the monthly prognosticators, stand up, and save thee from",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "these things",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.13",
                "verseOrgIds": [
                  "ISA.47.13"
                ]
              }
            }
          ]
        },
        {
          "text": "that shall come upon thee.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, they shall be as stubble; the fire shall burn them; they shall not deliver themselves from the power of the flame:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there shall",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.14",
                "verseOrgIds": [
                  "ISA.47.14"
                ]
              }
            }
          ]
        },
        {
          "text": "not",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.14",
                "verseOrgIds": [
                  "ISA.47.14"
                ]
              }
            }
          ]
        },
        {
          "text": "a coal to warm at,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "nor",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.14",
                "verseOrgIds": [
                  "ISA.47.14"
                ]
              }
            }
          ]
        },
        {
          "text": "fire to sit before it.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus shall they be unto thee with whom thou hast laboured,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "ISA.47.15",
                "verseOrgIds": [
                  "ISA.47.15"
                ]
              }
            }
          ]
        },
        {
          "text": "thy merchants, from thy youth: they shall wander every one to his quarter; none shall save thee.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ISA.48",
