              "attrs": {
                "verseId": "ISA.14.27",
                "verseOrgIds": [
                  "ISA.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts hath purposed, and who shall disannul",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.27",
