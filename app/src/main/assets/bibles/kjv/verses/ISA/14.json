          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Howl, O gate; cry, O city; thou, whole Palestina,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
