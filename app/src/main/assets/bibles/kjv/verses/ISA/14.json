              "type": "text",
              "attrs": {
                "verseId": "ISA.14.23",
                "verseOrgIds": [
                  "ISA.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
