          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "This",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
        },
        {
