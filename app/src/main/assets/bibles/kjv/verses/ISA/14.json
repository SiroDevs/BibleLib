                "verseOrgIds": [
                  "ISA.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "the purpose that is purposed upon the whole earth: and this",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.26",
            "verseOrgIds": [
              "ISA.14.26"
            ]
          }
        },
