                "verseOrgIds": [
                  "ISA.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "shall it stand:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
              "ISA.14.24"
            ]
          }
        },
        {
