              "attrs": {
                "verseId": "ISA.26.3",
                "verseOrgIds": [
                  "ISA.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "stayed",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "on thee:",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.3",
                "verseOrgIds": [
                  "ISA.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "because he trusteth in thee.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
