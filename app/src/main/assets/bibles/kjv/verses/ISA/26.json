                "verseOrgIds": [
                  "ISA.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "crieth out in her pangs; so have we been in thy sight, O",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
