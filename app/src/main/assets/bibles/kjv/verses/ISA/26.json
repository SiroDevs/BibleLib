          "text": "shall live,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "together with",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.19",
                "verseOrgIds": [
                  "ISA.26.19"
                ]
              }
            }
          ]
        },
        {
          "text": "my dead body shall they arise. Awake and sing, ye that dwell in dust: for thy dew",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.19",
            "verseOrgIds": [
              "ISA.26.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is as",
              "type": "text",
