          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "God",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.1",
                "verseOrgIds": [
                  "ISA.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": "appoint",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.1",
            "verseOrgIds": [
              "ISA.26.1"
            ]
