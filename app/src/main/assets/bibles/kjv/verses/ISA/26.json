                "verseOrgIds": [
                  "ISA.26.17"
                ]
              }
            }
          ]
        },
        {
          "text": "draweth near the time of her delivery, is in pain,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.17",
            "verseOrgIds": [
              "ISA.26.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
