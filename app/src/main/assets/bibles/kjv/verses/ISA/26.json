          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "For, behold, the",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.21",
                "verseOrgIds": [
                  "ISA.26.21"
                ]
              }
            }
          ]
        },
        {
          "text": "cometh out of his place to punish the inhabitants of the earth for their iniquity: the earth also shall disclose her blood, and shall no more cover her slain.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
          }
        }
