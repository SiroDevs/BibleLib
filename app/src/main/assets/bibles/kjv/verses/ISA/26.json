              "type": "text",
              "attrs": {
                "verseId": "ISA.26.3",
                "verseOrgIds": [
                  "ISA.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "in perfect peace,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "whose",
              "type": "text",
              "attrs": {
                "verseId": "ISA.26.3",
                "verseOrgIds": [
                  "ISA.26.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mind",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.3",
            "verseOrgIds": [
              "ISA.26.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
