                "verseOrgIds": [
                  "1KI.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", which he spake by his servant Ahijah the Shilonite:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
