              "text": "thereof",
              "type": "text",
              "attrs": {
                "verseId": "1KI.15.21",
                "verseOrgIds": [
                  "1KI.15.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", that he left off building of Ramah, and dwelt in Tirzah.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
