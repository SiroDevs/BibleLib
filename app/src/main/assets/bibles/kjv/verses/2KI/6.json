          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he said, If the",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
