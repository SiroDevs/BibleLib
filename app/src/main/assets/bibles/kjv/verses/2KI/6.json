          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he answered, Thou shalt not smite",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.22",
            "verseOrgIds": [
              "2KI.6.22"
            ]
