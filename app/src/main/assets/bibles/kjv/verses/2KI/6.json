                "verseId": "2KI.6.21",
                "verseOrgIds": [
                  "2KI.6.21"
                ]
              }
            }
          ]
        },
        {
          "text": "? shall I smite",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.21",
            "verseOrgIds": [
              "2KI.6.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "them",
