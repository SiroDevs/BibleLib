              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "the money of every one that passeth",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "the account",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", the money that every man is set at,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "all the money that cometh into any man's heart to bring into the house of the",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "char",
