          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that was",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.9",
                "verseOrgIds": [
                  "2KI.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "brought into the house of the",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.9",
                "verseOrgIds": [
                  "2KI.12.10"
                ]
              }
            }
          ]
