              "attrs": {
                "verseId": "2KI.12.12",
                "verseOrgIds": [
                  "2KI.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        },
