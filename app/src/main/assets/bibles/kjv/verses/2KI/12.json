            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "2KI.12.4",
                "verseOrgIds": [
                  "2KI.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
