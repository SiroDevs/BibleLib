          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "MAL.4.1",
                "verseOrgIds": [
                  "MAL.3.19"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts, that it shall leave them neither root nor branch.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.3.19"
            ]
