                "verseOrgIds": [
                  "MAL.3.22"
                ]
              }
            }
          ]
        },
        {
          "text": "the statutes and judgments.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.3.22"
            ]
