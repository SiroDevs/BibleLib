              "text": "this",
              "type": "text",
              "attrs": {
                "verseId": "MAL.4.3",
                "verseOrgIds": [
                  "MAL.3.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", saith the",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.3.21"
            ]
