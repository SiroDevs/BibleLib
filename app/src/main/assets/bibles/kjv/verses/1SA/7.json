            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.13",
                "verseOrgIds": [
                  "1SA.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "was against the Philistines all the days of Samuel.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
