          "text": "Then Samuel took a stone, and set",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.12",
                "verseOrgIds": [
                  "1SA.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "between Mizpeh and Shen, and called the name of it Eben-ezer, saying, Hitherto hath the",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.12",
                "verseOrgIds": [
                  "1SA.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "helped us.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        }
