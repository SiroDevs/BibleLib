          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the children of Israel said to Samuel, Cease not to cry unto the",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.8",
                "verseOrgIds": [
                  "1SA.7.8"
                ]
              }
            }
          ]
        },
