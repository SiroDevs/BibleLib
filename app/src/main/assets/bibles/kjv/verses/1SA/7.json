              "attrs": {
                "verseId": "1SA.7.7",
                "verseOrgIds": [
                  "1SA.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", they were afraid of the Philistines.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
