                "verseId": "1SA.7.3",
                "verseOrgIds": [
                  "1SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "with all your hearts,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
