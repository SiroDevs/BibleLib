            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the men of Israel went out of Mizpeh, and pursued the Philistines, and smote them, until",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "they came",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.11",
                "verseOrgIds": [
                  "1SA.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "under Beth-car.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
