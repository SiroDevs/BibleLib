          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "1SA.7.3",
                "verseOrgIds": [
                  "1SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", and serve him only: and he will deliver you out of the hand of the Philistines.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
