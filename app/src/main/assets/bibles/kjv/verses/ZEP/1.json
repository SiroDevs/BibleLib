                "verseId": "ZEP.1.5",
                "verseOrgIds": [
                  "ZEP.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", and that swear by Malcham;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        },
