              "attrs": {
                "verseId": "ZEP.1.7",
                "verseOrgIds": [
                  "ZEP.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "at hand: for the",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "char",
