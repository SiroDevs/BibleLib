                "verseOrgIds": [
                  "ZEP.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "from off the land, saith the",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
