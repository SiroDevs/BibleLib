          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "And them that are turned back from the",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.6",
            "verseOrgIds": [
              "ZEP.1.6"
            ]
          }
        },
