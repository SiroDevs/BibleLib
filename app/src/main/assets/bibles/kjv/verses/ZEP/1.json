          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "ZEP.1.5",
                "verseOrgIds": [
                  "ZEP.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "that swear by the",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        },
        {
          "name": "char",
