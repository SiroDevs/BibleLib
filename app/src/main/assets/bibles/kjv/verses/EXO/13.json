                "verseOrgIds": [
                  "EXO.13.1"
                ]
              }
            }
          ]
        },
        {
          "text": "spake unto Moses, saying,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.1",
            "verseOrgIds": [
              "EXO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanctify unto me all the firstborn, whatsoever openeth the womb among the children of Israel,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "both",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.2",
                "verseOrgIds": [
                  "EXO.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "of man and of beast: it",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.2",
                "verseOrgIds": [
                  "EXO.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mine.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.2",
            "verseOrgIds": [
              "EXO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
