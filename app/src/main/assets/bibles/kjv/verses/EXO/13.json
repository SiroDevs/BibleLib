            "number": "3",
            "style": "v",
            "sid": "EXO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ And Moses said unto the people, Remember this day, in which ye came out from Egypt, out of the house of bondage; for by strength of hand the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.3",
                "verseOrgIds": [
                  "EXO.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "brought you out from this",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "place:",
              "type": "text",
              "attrs": {
                "verseId": "EXO.13.3",
                "verseOrgIds": [
                  "EXO.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "there shall no leavened bread be eaten.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
