          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "of",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.6",
                "verseOrgIds": [
                  "EXO.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": "pure gold: two cubits and a half",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.6",
                "verseOrgIds": [
                  "EXO.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": "the length thereof, and one cubit and a half the breadth thereof.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he made two cherubims",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "of",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.7",
                "verseOrgIds": [
                  "EXO.37.7"
                ]
              }
            }
          ]
        },
        {
          "text": "gold, beaten out of one piece made he them, on the two ends of the mercy seat;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "One cherub on the end on this side, and another cherub on the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "other",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.8",
                "verseOrgIds": [
                  "EXO.37.8"
                ]
              }
            }
          ]
        },
        {
          "text": "end on that side: out of the mercy seat made he the cherubims on the two ends thereof.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the cherubims spread out",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "their",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.9",
                "verseOrgIds": [
                  "EXO.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wings on high,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.9",
                "verseOrgIds": [
                  "EXO.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "covered with their wings over the mercy seat, with their faces one to another;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "EXO.37.9",
                "verseOrgIds": [
                  "EXO.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "to the mercy seatward were the faces of the cherubims.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
