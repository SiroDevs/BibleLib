        {
          "text": "¶ And the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
