            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "EXO.20.18",
                "verseOrgIds": [
                  "EXO.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", they removed, and stood afar off.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
          "name": "verse",
