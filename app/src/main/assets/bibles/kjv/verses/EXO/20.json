                "verseId": "EXO.20.21",
                "verseOrgIds": [
                  "EXO.20.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
