                "verseId": "EXO.22.15",
                "verseOrgIds": [
                  "EXO.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "an hired",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "char",
