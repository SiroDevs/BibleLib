              "attrs": {
                "verseId": "EXO.22.31",
                "verseOrgIds": [
                  "EXO.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": "flesh",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.31",
                "verseOrgIds": [
                  "EXO.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": "torn of beasts in the field; ye shall cast it to the dogs.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
