                "verseId": "EXO.22.15",
                "verseOrgIds": [
                  "EXO.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "good: if it",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
