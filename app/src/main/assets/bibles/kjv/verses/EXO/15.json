          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        },
