              "EXO.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.2",
                "verseOrgIds": [
                  "EXO.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "my strength and song, and he is become my salvation: he",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.2",
                "verseOrgIds": [
                  "EXO.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "my God, and I will prepare him an habitation; my father's God, and I will exalt him.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.2",
            "verseOrgIds": [
              "EXO.15.2"
            ]
          }
        },
        {
