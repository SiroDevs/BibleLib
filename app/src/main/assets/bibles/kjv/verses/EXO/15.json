                "verseOrgIds": [
                  "EXO.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "a man of war: the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.3",
                "verseOrgIds": [
                  "EXO.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.3",
                "verseOrgIds": [
                  "EXO.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "his name.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.3",
            "verseOrgIds": [
              "EXO.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pharaoh's chariots and his host hath he cast into the sea: his chosen captains also are drowned in the Red sea.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.4",
            "verseOrgIds": [
              "EXO.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The depths have covered them: they sank into the bottom as a stone.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.5",
            "verseOrgIds": [
              "EXO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thy right hand, O",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.6",
                "verseOrgIds": [
                  "EXO.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", is become glorious in power: thy right hand, O",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.6",
                "verseOrgIds": [
                  "EXO.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", hath dashed in pieces the enemy.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.6",
            "verseOrgIds": [
              "EXO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "And in the greatness of thine excellency thou hast overthrown them that rose up against thee: thou sentest forth thy wrath,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.7",
                "verseOrgIds": [
                  "EXO.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "consumed them as stubble.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.7",
            "verseOrgIds": [
              "EXO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "And with the blast of thy nostrils the waters were gathered together, the floods stood upright as an heap,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.8",
                "verseOrgIds": [
                  "EXO.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "the depths were congealed in the heart of the sea.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.8",
            "verseOrgIds": [
              "EXO.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The enemy said, I will pursue, I will overtake, I will divide the spoil; my lust shall be satisfied upon them; I will draw my sword, my hand shall destroy them.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.9",
            "verseOrgIds": [
              "EXO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou didst blow with thy wind, the sea covered them: they sank as lead in the mighty waters.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.10",
            "verseOrgIds": [
              "EXO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.11",
                "verseOrgIds": [
                  "EXO.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "like unto thee, O",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.11",
                "verseOrgIds": [
                  "EXO.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", among the gods? who",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.11",
                "verseOrgIds": [
                  "EXO.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "like thee, glorious in holiness, fearful",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.11",
                "verseOrgIds": [
                  "EXO.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "praises, doing wonders?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.11",
            "verseOrgIds": [
              "EXO.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou stretchedst out thy right hand, the earth swallowed them.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.12",
            "verseOrgIds": [
              "EXO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou in thy mercy hast led forth the people",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.13",
                "verseOrgIds": [
                  "EXO.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "thou hast redeemed: thou hast guided",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "them",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.13",
                "verseOrgIds": [
                  "EXO.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "in thy strength unto thy holy habitation.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.13",
            "verseOrgIds": [
              "EXO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "The people shall hear,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.14",
            "verseOrgIds": [
              "EXO.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.14",
                "verseOrgIds": [
                  "EXO.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "be afraid: sorrow shall take hold on the inhabitants of Palestina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.14",
            "verseOrgIds": [
              "EXO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the dukes of Edom shall be amazed; the mighty men of Moab, trembling shall take hold upon them; all the inhabitants of Canaan shall melt away.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.15",
            "verseOrgIds": [
              "EXO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fear and dread shall fall upon them; by the greatness of thine arm they shall be",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.16",
                "verseOrgIds": [
                  "EXO.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "still as a stone; till thy people pass over, O",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.16",
            "verseOrgIds": [
              "EXO.15.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
