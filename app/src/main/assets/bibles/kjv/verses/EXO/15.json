            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then sang Moses and the children of Israel this song unto the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.1",
                "verseOrgIds": [
                  "EXO.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", and spake, saying, I will sing unto the",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EXO.15.1",
                "verseOrgIds": [
                  "EXO.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", for he hath triumphed gloriously: the horse and his rider hath he thrown into the sea.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        },
        {
