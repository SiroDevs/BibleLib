  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "AMO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear ye this word which I take up against you,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.1",
                "verseOrgIds": [
                  "AMO.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "a lamentation, O house of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.1",
            "verseOrgIds": [
              "AMO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The virgin of Israel is fallen; she shall no more rise: she is forsaken upon her land;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.2",
                "verseOrgIds": [
                  "AMO.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "none to raise her up.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.2",
            "verseOrgIds": [
              "AMO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thus saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.3",
                "verseOrgIds": [
                  "AMO.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "; The city that went out",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "by",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.3",
                "verseOrgIds": [
                  "AMO.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "a thousand shall leave an hundred, and that which went forth",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "by",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.3",
                "verseOrgIds": [
                  "AMO.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "an hundred shall leave ten, to the house of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.3",
            "verseOrgIds": [
              "AMO.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ For thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.4",
                "verseOrgIds": [
                  "AMO.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "unto the house of Israel, Seek ye me, and ye shall live:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.4",
            "verseOrgIds": [
              "AMO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "But seek not Beth-el, nor enter into Gilgal, and pass not to Beer-sheba: for Gilgal shall surely go into captivity, and Beth-el shall come to nought.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.5",
            "verseOrgIds": [
              "AMO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seek the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.6",
                "verseOrgIds": [
                  "AMO.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", and ye shall live; lest he break out like fire in the house of Joseph, and devour",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.6",
                "verseOrgIds": [
                  "AMO.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", and",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there be",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.6",
                "verseOrgIds": [
                  "AMO.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "none to quench",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.6",
                "verseOrgIds": [
                  "AMO.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "in Beth-el.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.6",
            "verseOrgIds": [
              "AMO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye who turn judgment to wormwood, and leave off righteousness in the earth,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.7",
            "verseOrgIds": [
              "AMO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Seek him",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.8",
                "verseOrgIds": [
                  "AMO.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": "that maketh the seven stars and Orion, and turneth the shadow of death into the morning, and maketh the day dark with night: that calleth for the waters of the sea, and poureth them out upon the face of the earth: The",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.8",
                "verseOrgIds": [
                  "AMO.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.8",
                "verseOrgIds": [
                  "AMO.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": "his name:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "That strengtheneth the spoiled against the strong, so that the spoiled shall come against the fortress.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "They hate him that rebuketh in the gate, and they abhor him that speaketh uprightly.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Forasmuch therefore as your treading",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.11",
                "verseOrgIds": [
                  "AMO.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "upon the poor, and ye take from him burdens of wheat: ye have built houses of hewn stone, but ye shall not dwell in them; ye have planted pleasant vineyards, but ye shall not drink wine of them.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "For I know your manifold transgressions and your mighty sins: they afflict the just, they take a bribe, and they turn aside the poor in the gate",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "from their right",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.12",
                "verseOrgIds": [
                  "AMO.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore the prudent shall keep silence in that time; for it",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.13",
            "verseOrgIds": [
              "AMO.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.13",
                "verseOrgIds": [
                  "AMO.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "an evil time.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.13",
            "verseOrgIds": [
              "AMO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seek good, and not evil, that ye may live: and so the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.14",
                "verseOrgIds": [
                  "AMO.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of hosts, shall be with you, as ye have spoken.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hate the evil, and love the good, and establish judgment in the gate: it may be that the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.15",
                "verseOrgIds": [
                  "AMO.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "God of hosts will be gracious unto the remnant of Joseph.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.16",
                "verseOrgIds": [
                  "AMO.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of hosts, the Lord, saith thus; Wailing",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall be",
              "type": "text",
              "attrs": {
                "verseId": "AMO.5.16",
                "verseOrgIds": [
                  "AMO.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "in all streets; and they shall say in all the highways, Alas! alas! and they shall call the husbandman to mourning, and such as are skilful of lamentation to wailing.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.16",
            "verseOrgIds": [
              "AMO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
