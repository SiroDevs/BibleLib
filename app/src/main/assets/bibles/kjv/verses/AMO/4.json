            "style": "add"
          },
          "items": [
            {
              "text": "them",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.3",
                "verseOrgIds": [
                  "AMO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "into the palace, saith the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
