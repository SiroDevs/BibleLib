          "text": "I have overthrown",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "some",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.11",
                "verseOrgIds": [
                  "AMO.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "of you, as God overthrew Sodom and Gomorrah, and ye were as a firebrand plucked out of the burning: yet have ye not returned unto me, saith the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
