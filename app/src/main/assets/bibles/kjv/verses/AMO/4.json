              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear this word, ye kine of Bashan, that",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.1",
                "verseOrgIds": [
                  "AMO.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "in the mountain of Samaria, which oppress the poor, which crush the needy, which say to their masters, Bring, and let us drink.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.1",
            "verseOrgIds": [
              "AMO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Lord",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.2",
                "verseOrgIds": [
                  "AMO.4.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hath sworn by his holiness, that, lo, the days shall come upon you, that he will take you away with hooks, and your posterity with fishhooks.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "And ye shall go out at the breaches, every",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "cow at that which is",
              "type": "text",
              "attrs": {
                "verseId": "AMO.4.3",
                "verseOrgIds": [
                  "AMO.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "before her; and ye shall cast",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        },
        {
          "name": "char",
