            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.6",
                "verseOrgIds": [
                  "AMO.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "repented for this: This also shall not be, saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.6",
                "verseOrgIds": [
                  "AMO.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
