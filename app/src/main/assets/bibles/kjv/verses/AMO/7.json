              "attrs": {
                "verseId": "AMO.7.3",
                "verseOrgIds": [
                  "AMO.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "repented for this: It shall not be, saith the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
