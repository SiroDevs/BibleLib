          "text": "¶ Thus hath the Lord",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
