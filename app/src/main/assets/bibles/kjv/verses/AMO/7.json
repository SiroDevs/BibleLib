              "type": "text",
              "attrs": {
                "verseId": "AMO.7.4",
                "verseOrgIds": [
                  "AMO.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "shewed unto me: and, behold, the Lord",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
