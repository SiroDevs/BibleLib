          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.14",
                "verseOrgIds": [
                  "AMO.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "no prophet, neither",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.14",
                "verseOrgIds": [
                  "AMO.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "I a prophet's son; but I",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "AMO.7.14",
                "verseOrgIds": [
                  "AMO.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "an herdman, and a gatherer of sycomore fruit:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.15",
            "verseOrgIds": [
              "AMO.7.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
