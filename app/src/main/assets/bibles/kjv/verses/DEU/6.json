          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Hear therefore, O Israel, and observe to do",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it;",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.3",
                "verseOrgIds": [
                  "DEU.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "that it may be well with thee, and that ye may increase mightily, as the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.3",
                "verseOrgIds": [
                  "DEU.6.3"
                ]
              }
            }
          ]
        },
        {
          "text": "God of thy fathers hath promised thee, in the land that floweth with milk and honey.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
