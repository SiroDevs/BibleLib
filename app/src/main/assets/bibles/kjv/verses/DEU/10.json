          "text": "¶ At that time the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "separated the tribe of Levi, to bear the ark of the covenant of the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", to stand before the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "to minister unto him, and to bless in his name, unto this day.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wherefore Levi hath no part nor inheritance with his brethren; the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "his inheritance, according as the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "thy God promised him.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "And I stayed in the mount, according to the first time, forty days and forty nights; and the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.10",
                "verseOrgIds": [
                  "DEU.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "hearkened unto me at that time also,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.10",
                "verseOrgIds": [
                  "DEU.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.10",
                "verseOrgIds": [
                  "DEU.10.10"
                ]
              }
            }
          ]
        },
