                "verseId": "LEV.18.30",
                "verseOrgIds": [
                  "LEV.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "of these abominable customs, which were committed before you, and that ye defile not yourselves therein: I",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
