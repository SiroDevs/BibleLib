            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.5",
                "verseOrgIds": [
                  "LEV.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        },
        {
