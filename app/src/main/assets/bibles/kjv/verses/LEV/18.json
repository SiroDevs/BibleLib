              "type": "text",
              "attrs": {
                "verseId": "LEV.18.21",
                "verseOrgIds": [
                  "LEV.18.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
