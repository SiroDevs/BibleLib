                "verseOrgIds": [
                  "LEV.18.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", to uncover her nakedness, beside the other in her life",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        },
