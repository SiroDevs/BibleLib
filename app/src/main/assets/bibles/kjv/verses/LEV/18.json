          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.6",
                "verseOrgIds": [
                  "LEV.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nakedness of thy father, or the nakedness of thy mother, shalt thou not uncover: she",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.7",
                "verseOrgIds": [
                  "LEV.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "thy mother; thou shalt not uncover her nakedness.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nakedness of thy father's wife shalt thou not uncover: it",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.8",
                "verseOrgIds": [
                  "LEV.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "thy father's nakedness.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nakedness of thy sister, the daughter of thy father, or daughter of thy mother,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "whether she be",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.9",
                "verseOrgIds": [
                  "LEV.18.9"
                ]
              }
            }
          ]
        },
        {
          "text": "born at home, or born abroad,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.9",
                "verseOrgIds": [
                  "LEV.18.9"
                ]
              }
            }
          ]
        },
        {
          "text": "their nakedness thou shalt not uncover.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nakedness of thy son's daughter, or of thy daughter's daughter,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.10",
                "verseOrgIds": [
                  "LEV.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "their nakedness thou shalt not uncover: for theirs",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
