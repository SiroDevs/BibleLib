              "attrs": {
                "verseId": "LEV.18.30",
                "verseOrgIds": [
                  "LEV.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
