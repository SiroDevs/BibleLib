          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.10",
                "verseOrgIds": [
                  "LEV.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": "thine own nakedness.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nakedness of thy father's wife's daughter, begotten of thy father, she",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.11",
            "verseOrgIds": [
              "LEV.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.11",
                "verseOrgIds": [
                  "LEV.18.11"
                ]
              }
            }
          ]
        },
        {
          "text": "thy sister, thou shalt not uncover her nakedness.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.11",
            "verseOrgIds": [
              "LEV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt not uncover the nakedness of thy father's sister: she",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.12",
                "verseOrgIds": [
                  "LEV.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "thy father's near kinswoman.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt not uncover the nakedness of thy mother's sister: for she",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.13",
                "verseOrgIds": [
                  "LEV.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "thy mother's near kinswoman.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt not uncover the nakedness of thy father's brother, thou shalt not approach to his wife: she",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.14",
                "verseOrgIds": [
                  "LEV.18.14"
                ]
              }
            }
          ]
        },
        {
          "text": "thine aunt.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt not uncover the nakedness of thy daughter in law: she",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.15",
                "verseOrgIds": [
                  "LEV.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "thy son's wife; thou shalt not uncover her nakedness.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt not uncover the nakedness of thy brother's wife: it",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.16",
                "verseOrgIds": [
                  "LEV.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "thy brother's nakedness.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt not uncover the nakedness of a woman and her daughter, neither shalt thou take her son's daughter, or her daughter's daughter, to uncover her nakedness;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "char",
