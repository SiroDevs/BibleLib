                "verseId": "LEV.18.1",
                "verseOrgIds": [
                  "LEV.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": "spake unto Moses, saying,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.1",
            "verseOrgIds": [
              "LEV.18.1"
            ]
          }
