          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "their",
              "type": "text",
              "attrs": {
                "verseId": "LEV.18.6",
                "verseOrgIds": [
                  "LEV.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nakedness: I",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
