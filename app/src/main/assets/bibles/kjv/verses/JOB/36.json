{
  "id": "JOB.36",
  "number": "36",
  "bookId": "JOB",
  "reference": "Job 36",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JOB 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu also proceeded, and said,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.1",
            "verseOrgIds": [
              "JOB.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suffer me a little, and I will shew thee that",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "I have",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.2",
                "verseOrgIds": [
                  "JOB.36.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yet to speak on God's behalf.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will fetch my knowledge from afar, and will ascribe righteousness to my Maker.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For truly my words",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.4",
                "verseOrgIds": [
                  "JOB.36.4"
                ]
              }
            }
          ]
        },
        {
          "text": "not",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.4",
                "verseOrgIds": [
                  "JOB.36.4"
                ]
              }
            }
          ]
        },
        {
          "text": "false: he that is perfect in knowledge",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.4",
                "verseOrgIds": [
                  "JOB.36.4"
                ]
              }
            }
          ]
        },
        {
          "text": "with thee.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, God",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.5",
                "verseOrgIds": [
                  "JOB.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "mighty, and despiseth not",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "any: he is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.5",
                "verseOrgIds": [
                  "JOB.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "mighty in strength",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.5",
                "verseOrgIds": [
                  "JOB.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wisdom.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "He preserveth not the life of the wicked: but giveth right to the poor.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "He withdraweth not his eyes from the righteous: but with kings",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are they",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.7",
                "verseOrgIds": [
                  "JOB.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": "on the throne; yea, he doth establish them for ever, and they are exalted.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "And if",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "they be",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.8",
                "verseOrgIds": [
                  "JOB.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bound in fetters,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.8",
                "verseOrgIds": [
                  "JOB.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": "be holden in cords of affliction;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he sheweth them their work, and their transgressions that they have exceeded.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He openeth also their ear to discipline, and commandeth that they return from iniquity.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "If they obey and serve",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "him",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.11",
                "verseOrgIds": [
                  "JOB.36.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", they shall spend their days in prosperity, and their years in pleasures.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if they obey not, they shall perish by the sword, and they shall die without knowledge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "But the hypocrites in heart heap up wrath: they cry not when he bindeth them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "They die in youth, and their life",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.14",
                "verseOrgIds": [
                  "JOB.36.14"
                ]
              }
            }
          ]
        },
        {
          "text": "among the unclean.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "He delivereth the poor in his affliction, and openeth their ears in oppression.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Even so would he have removed thee out of the strait",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "into",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.16",
                "verseOrgIds": [
                  "JOB.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "a broad place, where",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.16",
                "verseOrgIds": [
                  "JOB.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "no straitness; and that which should be set on thy table",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "should be",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.16",
                "verseOrgIds": [
                  "JOB.36.16"
                ]
              }
            }
          ]
        },
        {
          "text": "full of fatness.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "But thou hast fulfilled the judgment of the wicked: judgment and justice take hold",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "on thee",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.17",
                "verseOrgIds": [
                  "JOB.36.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Because",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.18",
                "verseOrgIds": [
                  "JOB.36.18"
                ]
              }
            }
          ]
        },
        {
          "text": "wrath,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "beware",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.18",
                "verseOrgIds": [
                  "JOB.36.18"
                ]
              }
            }
          ]
        },
        {
          "text": "lest he take thee away with",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "his",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.18",
                "verseOrgIds": [
                  "JOB.36.18"
                ]
              }
            }
          ]
        },
        {
          "text": "stroke: then a great ransom cannot deliver thee.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Will he esteem thy riches?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "no",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.19",
                "verseOrgIds": [
                  "JOB.36.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", not gold, nor all the forces of strength.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Desire not the night, when people are cut off in their place.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.20",
            "verseOrgIds": [
              "JOB.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take heed, regard not iniquity: for this hast thou chosen rather than affliction.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, God exalteth by his power: who teacheth like him?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who hath enjoined him his way? or who can say, Thou hast wrought iniquity?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember that thou magnify his work, which men behold.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.24",
            "verseOrgIds": [
              "JOB.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Every man may see it; man may behold",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.25",
                "verseOrgIds": [
                  "JOB.36.25"
                ]
              }
            }
          ]
        },
        {
          "text": "afar off.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, God",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.26",
                "verseOrgIds": [
                  "JOB.36.26"
                ]
              }
            }
          ]
        },
        {
          "text": "great, and we know",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "him",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.26",
                "verseOrgIds": [
                  "JOB.36.26"
                ]
              }
            }
          ]
        },
        {
          "text": "not, neither can the number of his years be searched out.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "For he maketh small the drops of water: they pour down rain according to the vapour thereof:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.27",
            "verseOrgIds": [
              "JOB.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Which the clouds do drop",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.28",
                "verseOrgIds": [
                  "JOB.36.28"
                ]
              }
            }
          ]
        },
        {
          "text": "distil upon man abundantly.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Also can",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.29",
            "verseOrgIds": [
              "JOB.36.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "any",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.29",
                "verseOrgIds": [
                  "JOB.36.29"
                ]
              }
            }
          ]
        },
        {
          "text": "understand the spreadings of the clouds,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.29",
            "verseOrgIds": [
              "JOB.36.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.29",
                "verseOrgIds": [
                  "JOB.36.29"
                ]
              }
            }
          ]
        },
        {
          "text": "the noise of his tabernacle?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.29",
            "verseOrgIds": [
              "JOB.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, he spreadeth his light upon it, and covereth the bottom of the sea.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.30",
            "verseOrgIds": [
              "JOB.36.30"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.30",
            "verseOrgIds": [
              "JOB.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "For by them judgeth he the people; he giveth meat in abundance.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.31",
            "verseOrgIds": [
              "JOB.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "With clouds he covereth the light; and commandeth it",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "not to shine",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.32",
                "verseOrgIds": [
                  "JOB.36.32"
                ]
              }
            }
          ]
        },
        {
          "text": "by",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "the cloud",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.32",
                "verseOrgIds": [
                  "JOB.36.32"
                ]
              }
            }
          ]
        },
        {
          "text": "that cometh betwixt.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "The noise thereof sheweth concerning it, the cattle also concerning the vapour.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.33",
            "verseOrgIds": [
              "JOB.36.33"
            ]
          }
        }
      ]
    }
  ],
