  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JOB 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.1",
                "verseOrgIds": [
                  "JOB.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "born of a woman",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.1",
                "verseOrgIds": [
                  "JOB.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "of few days, and full of trouble.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.1",
            "verseOrgIds": [
              "JOB.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "He cometh forth like a flower, and is cut down: he fleeth also as a shadow, and continueth not.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.2",
            "verseOrgIds": [
              "JOB.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "And dost thou open thine eyes upon such an one, and bringest me into judgment with thee?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.3",
            "verseOrgIds": [
              "JOB.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who can bring a clean",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thing",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.4",
                "verseOrgIds": [
                  "JOB.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": "out of an unclean? not one.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.4",
            "verseOrgIds": [
              "JOB.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeing his days",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.5",
                "verseOrgIds": [
                  "JOB.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "determined, the number of his months",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.5",
                "verseOrgIds": [
                  "JOB.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "with thee, thou hast appointed his bounds that he cannot pass;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.5",
            "verseOrgIds": [
              "JOB.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Turn from him, that he may rest, till he shall accomplish, as an hireling, his day.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.6",
            "verseOrgIds": [
              "JOB.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "For there is hope of a tree, if it be cut down, that it will sprout again, and that the tender branch thereof will not cease.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.7",
            "verseOrgIds": [
              "JOB.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though the root thereof wax old in the earth, and the stock thereof die in the ground;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.8",
            "verseOrgIds": [
              "JOB.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Yet",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.9",
                "verseOrgIds": [
                  "JOB.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "through the scent of water it will bud, and bring forth boughs like a plant.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.9",
            "verseOrgIds": [
              "JOB.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "But man dieth, and wasteth away: yea, man giveth up the ghost, and where",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.10",
                "verseOrgIds": [
                  "JOB.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "he?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.10",
            "verseOrgIds": [
              "JOB.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "As",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.11",
                "verseOrgIds": [
                  "JOB.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "the waters fail from the sea, and the flood decayeth and drieth up:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.11",
            "verseOrgIds": [
              "JOB.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "So man lieth down, and riseth not: till the heavens",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.12",
                "verseOrgIds": [
                  "JOB.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "no more, they shall not awake, nor be raised out of their sleep.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.12",
            "verseOrgIds": [
              "JOB.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O that thou wouldest hide me in the grave, that thou wouldest keep me secret, until thy wrath be past, that thou wouldest appoint me a set time, and remember me!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.13",
            "verseOrgIds": [
              "JOB.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "If a man die, shall he live",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "again",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.14",
                "verseOrgIds": [
                  "JOB.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "? all the days of my appointed time will I wait, till my change come.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.14",
            "verseOrgIds": [
              "JOB.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt call, and I will answer thee: thou wilt have a desire to the work of thine hands.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.15",
            "verseOrgIds": [
              "JOB.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "For now thou numberest my steps: dost thou not watch over my sin?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.16",
            "verseOrgIds": [
              "JOB.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "My transgression",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.17",
            "verseOrgIds": [
              "JOB.14.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.17",
                "verseOrgIds": [
                  "JOB.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sealed up in a bag, and thou sewest up mine iniquity.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.17",
            "verseOrgIds": [
              "JOB.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "And surely the mountain falling cometh to nought, and the rock is removed out of his place.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.18",
            "verseOrgIds": [
              "JOB.14.18"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.18",
            "verseOrgIds": [
              "JOB.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The waters wear the stones: thou washest away the things which grow",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "out",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.19",
                "verseOrgIds": [
                  "JOB.14.19"
                ]
              }
            }
          ]
        },
        {
          "text": "of the dust of the earth; and thou destroyest the hope of man.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.19",
            "verseOrgIds": [
              "JOB.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou prevailest for ever against him, and he passeth: thou changest his countenance, and sendest him away.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.20",
            "verseOrgIds": [
              "JOB.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "His sons come to honour, and he knoweth",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.21",
                "verseOrgIds": [
                  "JOB.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "not; and they are brought low, but he perceiveth",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "JOB.14.21",
                "verseOrgIds": [
                  "JOB.14.21"
                ]
              }
            }
          ]
        },
        {
          "text": "not of them.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.21",
            "verseOrgIds": [
              "JOB.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "But his flesh upon him shall have pain, and his soul within him shall mourn.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.14.22",
            "verseOrgIds": [
              "JOB.14.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOB.15",
    "number": "15",
    "bookId": "JOB"
  },
