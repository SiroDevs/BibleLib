          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "He evil entreateth the barren",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
              "JOB.24.21"
            ]
