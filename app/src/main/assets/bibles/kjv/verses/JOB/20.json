                "verseOrgIds": [
                  "JOB.20.29"
                ]
              }
            }
          ]
        },
        {
          "text": "the portion of a wicked man from God, and the heritage appointed unto him by God.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
