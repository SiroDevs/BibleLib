                "verseId": "JOB.20.23",
                "verseOrgIds": [
                  "JOB.20.23"
                ]
              }
            }
          ]
        },
        {
          "text": "he is about to fill his belly,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "God",
