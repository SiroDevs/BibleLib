              "attrs": {
                "verseId": "JOB.20.23",
                "verseOrgIds": [
                  "JOB.20.23"
                ]
              }
            }
          ]
        },
        {
          "text": "shall cast the fury of his wrath upon him, and shall rain",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "JOB.20.23",
                "verseOrgIds": [
                  "JOB.20.23"
                ]
              }
            }
          ]
        },
        {
          "text": "upon him while he is eating.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "He shall flee from the iron weapon,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "JOB.20.24",
                "verseOrgIds": [
                  "JOB.20.24"
                ]
              }
            }
          ]
        },
        {
          "text": "the bow of steel shall strike him through.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is drawn, and cometh out of the body; yea, the glittering sword cometh out of his gall: terrors",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "JOB.20.25",
                "verseOrgIds": [
                  "JOB.20.25"
                ]
              }
            }
          ]
        },
        {
          "text": "upon him.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "All darkness",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall be",
              "type": "text",
              "attrs": {
                "verseId": "JOB.20.26",
                "verseOrgIds": [
                  "JOB.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "hid in his secret places: a fire not blown shall consume him; it shall go ill with him that is left in his tabernacle.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "The heaven shall reveal his iniquity; and the earth shall rise up against him.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.27",
            "verseOrgIds": [
              "JOB.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "The increase of his house shall depart,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.28",
            "verseOrgIds": [
              "JOB.20.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and his goods",
              "type": "text",
              "attrs": {
                "verseId": "JOB.20.28",
                "verseOrgIds": [
                  "JOB.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": "shall flow away in the day of his wrath.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.28",
            "verseOrgIds": [
              "JOB.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "This",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
          }
        },
        {
          "name": "char",
