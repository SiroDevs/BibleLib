  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JOB 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moreover Job continued his parable, and said,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.1",
            "verseOrgIds": [
              "JOB.29.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.1",
            "verseOrgIds": [
              "JOB.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh that I were as",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.2",
                "verseOrgIds": [
                  "JOB.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": "months past, as",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.2",
                "verseOrgIds": [
                  "JOB.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": "the days",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "when",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.2",
                "verseOrgIds": [
                  "JOB.29.2"
                ]
              }
            }
          ]
        },
        {
          "text": "God preserved me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.2",
            "verseOrgIds": [
              "JOB.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "When his candle shined upon my head,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and when",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.3",
                "verseOrgIds": [
                  "JOB.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": "by his light I walked",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "through",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.3",
                "verseOrgIds": [
                  "JOB.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": "darkness;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.3",
            "verseOrgIds": [
              "JOB.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "As I was in the days of my youth, when the secret of God",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.4",
                "verseOrgIds": [
                  "JOB.29.4"
                ]
              }
            }
          ]
        },
        {
          "text": "upon my tabernacle;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.4",
            "verseOrgIds": [
              "JOB.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the Almighty",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.5",
                "verseOrgIds": [
                  "JOB.29.5"
                ]
              }
            }
          ]
        },
        {
          "text": "yet with me,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "when",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.5",
                "verseOrgIds": [
                  "JOB.29.5"
                ]
              }
            }
          ]
        },
        {
          "text": "my children",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "were",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.5",
                "verseOrgIds": [
                  "JOB.29.5"
                ]
              }
            }
          ]
        },
        {
          "text": "about me;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.5",
            "verseOrgIds": [
              "JOB.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I washed my steps with butter, and the rock poured me out rivers of oil;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.6",
            "verseOrgIds": [
              "JOB.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "When I went out to the gate through the city,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "when",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.7",
                "verseOrgIds": [
                  "JOB.29.7"
                ]
              }
            }
          ]
        },
        {
          "text": "I prepared my seat in the street!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.7",
            "verseOrgIds": [
              "JOB.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The young men saw me, and hid themselves: and the aged arose,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.8",
                "verseOrgIds": [
                  "JOB.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": "stood up.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.8",
            "verseOrgIds": [
              "JOB.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The princes refrained talking, and laid",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "their",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.9",
                "verseOrgIds": [
                  "JOB.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": "hand on their mouth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.9",
            "verseOrgIds": [
              "JOB.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nobles held their peace, and their tongue cleaved to the roof of their mouth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.10",
            "verseOrgIds": [
              "JOB.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the ear heard",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.11",
                "verseOrgIds": [
                  "JOB.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", then it blessed me; and when the eye saw",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.11",
                "verseOrgIds": [
                  "JOB.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", it gave witness to me:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.11",
            "verseOrgIds": [
              "JOB.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Because I delivered the poor that cried, and the fatherless, and",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "him that had",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.12",
                "verseOrgIds": [
                  "JOB.29.12"
                ]
              }
            }
          ]
        },
        {
          "text": "none to help him.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.12",
            "verseOrgIds": [
              "JOB.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The blessing of him that was ready to perish came upon me: and I caused the widow's heart to sing for joy.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.13",
            "verseOrgIds": [
              "JOB.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I put on righteousness, and it clothed me: my judgment",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.14",
                "verseOrgIds": [
                  "JOB.29.14"
                ]
              }
            }
          ]
        },
        {
          "text": "as a robe and a diadem.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.14",
            "verseOrgIds": [
              "JOB.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I was eyes to the blind, and feet",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.15",
                "verseOrgIds": [
                  "JOB.29.15"
                ]
              }
            }
          ]
        },
        {
          "text": "I to the lame.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.15",
            "verseOrgIds": [
              "JOB.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.16",
                "verseOrgIds": [
                  "JOB.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "a father to the poor: and the cause",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.16",
                "verseOrgIds": [
                  "JOB.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "I knew not I searched out.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.16",
            "verseOrgIds": [
              "JOB.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "And I brake the jaws of the wicked, and plucked the spoil out of his teeth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.17",
            "verseOrgIds": [
              "JOB.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I said, I shall die in my nest, and I shall multiply",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "my",
              "type": "text",
              "attrs": {
                "verseId": "JOB.29.18",
                "verseOrgIds": [
                  "JOB.29.18"
                ]
              }
            }
          ]
        },
        {
          "text": "days as the sand.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.29.18",
            "verseOrgIds": [
              "JOB.29.18"
            ]
          }
        },
        {
