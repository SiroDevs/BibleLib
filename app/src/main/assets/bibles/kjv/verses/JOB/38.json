                "verseOrgIds": [
                  "JOB.38.27"
                ]
              }
            }
          ]
        },
        {
          "text": "and to cause the bud of the tender herb to spring forth?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.27",
            "verseOrgIds": [
              "JOB.38.27"
            ]
