          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canst thou send lightnings, that they may go, and say unto thee, Here we",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.35",
            "verseOrgIds": [
