          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "The waters are hid as",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.30",
            "verseOrgIds": [
              "JOB.38.30"
            ]
          }
        },
