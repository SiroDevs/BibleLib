                "verseId": "JOB.38.24",
                "verseOrgIds": [
                  "JOB.38.24"
                ]
              }
            }
          ]
        },
        {
          "text": "scattereth the east wind upon the earth?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.24",
            "verseOrgIds": [
              "JOB.38.24"
            ]
          }
        }
