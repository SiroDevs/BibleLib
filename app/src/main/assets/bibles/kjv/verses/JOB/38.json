          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "By what way is the light parted,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.24",
            "verseOrgIds": [
              "JOB.38.24"
            ]
          }
        },
        {
          "name": "char",
