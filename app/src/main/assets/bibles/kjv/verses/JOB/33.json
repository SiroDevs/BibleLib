{
  "id": "JOB.33",
  "number": "33",
  "bookId": "JOB",
  "reference": "Job 33",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "JOB 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wherefore, Job, I pray thee, hear my speeches, and hearken to all my words.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.1",
            "verseOrgIds": [
              "JOB.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, now I have opened my mouth, my tongue hath spoken in my mouth.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.2",
            "verseOrgIds": [
              "JOB.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "My words",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall be of",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.3",
                "verseOrgIds": [
                  "JOB.33.3"
                ]
              }
            }
          ]
        },
        {
          "text": "the uprightness of my heart: and my lips shall utter knowledge clearly.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.3",
            "verseOrgIds": [
              "JOB.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Spirit of God hath made me, and the breath of the Almighty hath given me life.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.4",
            "verseOrgIds": [
              "JOB.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "If thou canst answer me, set",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thy words",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.5",
                "verseOrgIds": [
                  "JOB.33.5"
                ]
              }
            }
          ]
        },
        {
          "text": "in order before me, stand up.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.5",
            "verseOrgIds": [
              "JOB.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, I",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.6",
                "verseOrgIds": [
                  "JOB.33.6"
                ]
              }
            }
          ]
        },
        {
          "text": "according to thy wish in God's stead: I also am formed out of the clay.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.6",
            "verseOrgIds": [
              "JOB.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, my terror shall not make thee afraid, neither shall my hand be heavy upon thee.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.7",
            "verseOrgIds": [
              "JOB.33.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely thou hast spoken in mine hearing, and I have heard the voice of",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thy",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.8",
                "verseOrgIds": [
                  "JOB.33.8"
                ]
              }
            }
          ]
        },
        {
          "text": "words,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "saying",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.8",
                "verseOrgIds": [
                  "JOB.33.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.8",
            "verseOrgIds": [
              "JOB.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am clean without transgression, I",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.9",
                "verseOrgIds": [
                  "JOB.33.9"
                ]
              }
            }
          ]
        },
        {
          "text": "innocent; neither",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is there",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.9",
                "verseOrgIds": [
                  "JOB.33.9"
                ]
              }
            }
          ]
        },
        {
          "text": "iniquity in me.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.9",
            "verseOrgIds": [
              "JOB.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, he findeth occasions against me, he counteth me for his enemy,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.10",
            "verseOrgIds": [
              "JOB.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "He putteth my feet in the stocks, he marketh all my paths.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.11",
            "verseOrgIds": [
              "JOB.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.12",
                "verseOrgIds": [
                  "JOB.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": "this thou art not just: I will answer thee, that God is greater than man.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.12",
            "verseOrgIds": [
              "JOB.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why dost thou strive against him? for he giveth not account of any of his matters.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.13",
            "verseOrgIds": [
              "JOB.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "For God speaketh once, yea twice,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "yet man",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.14",
                "verseOrgIds": [
                  "JOB.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": "perceiveth it not.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.14",
            "verseOrgIds": [
              "JOB.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "In a dream, in a vision of the night, when deep sleep falleth upon men, in slumberings upon the bed;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.15",
            "verseOrgIds": [
              "JOB.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he openeth the ears of men, and sealeth their instruction,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.16",
            "verseOrgIds": [
              "JOB.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "That he may withdraw man",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "from his",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.17",
                "verseOrgIds": [
                  "JOB.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": "purpose, and hide pride from man.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.17",
            "verseOrgIds": [
              "JOB.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "He keepeth back his soul from the pit, and his life from perishing by the sword.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.18",
            "verseOrgIds": [
              "JOB.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "He is chastened also with pain upon his bed, and the multitude of his bones with strong",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "pain:",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.19",
                "verseOrgIds": [
                  "JOB.33.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.19",
            "verseOrgIds": [
              "JOB.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "So that his life abhorreth bread, and his soul dainty meat.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.20",
            "verseOrgIds": [
              "JOB.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "His flesh is consumed away, that it cannot be seen; and his bones",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.21",
                "verseOrgIds": [
                  "JOB.33.21"
                ]
              }
            }
          ]
        },
        {
          "text": "were not seen stick out.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.21",
            "verseOrgIds": [
              "JOB.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yea, his soul draweth near unto the grave, and his life to the destroyers.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.22",
            "verseOrgIds": [
              "JOB.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "If there be a messenger with him, an interpreter, one among a thousand, to shew unto man his uprightness:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.23",
            "verseOrgIds": [
              "JOB.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he is gracious unto him, and saith, Deliver him from going down to the pit: I have found a ransom.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.24",
            "verseOrgIds": [
              "JOB.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "His flesh shall be fresher than a child's: he shall return to the days of his youth:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.25",
            "verseOrgIds": [
              "JOB.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "He shall pray unto God, and he will be favourable unto him: and he shall see his face with joy: for he will render unto man his righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
              "JOB.33.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "He looketh upon men, and",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "if any",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.27",
                "verseOrgIds": [
                  "JOB.33.27"
                ]
              }
            }
          ]
        },
        {
          "text": "say, I have sinned, and perverted",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that which was",
              "type": "text",
              "attrs": {
                "verseId": "JOB.33.27",
                "verseOrgIds": [
                  "JOB.33.27"
                ]
              }
            }
          ]
        },
        {
          "text": "right, and it profited me not;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will deliver his soul from going into the pit, and his life shall see the light.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
