          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "That through them I may prove Israel, whether they will keep the way of the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
