              "type": "text",
              "attrs": {
                "verseId": "JDG.2.22",
                "verseOrgIds": [
                  "JDG.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "to walk therein, as their fathers did keep",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "JDG.2.22",
                "verseOrgIds": [
                  "JDG.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", or not.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
