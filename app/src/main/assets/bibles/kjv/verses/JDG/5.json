          "attrs": {
            "verseId": "JDG.5.10",
            "verseOrgIds": [
              "JDG.5.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.10",
            "verseOrgIds": [
              "JDG.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "They that are delivered",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.11",
                "verseOrgIds": [
                  "JDG.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "from the noise of archers in the places of drawing water, there shall they rehearse the righteous acts of the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        },
