              "attrs": {
                "verseId": "JDG.5.2",
                "verseOrgIds": [
                  "JDG.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "for the avenging of Israel, when the people willingly offered themselves.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.2",
            "verseOrgIds": [
              "JDG.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear, O ye kings; give ear, O ye princes; I,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.3",
                "verseOrgIds": [
                  "JDG.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "I, will sing unto the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
