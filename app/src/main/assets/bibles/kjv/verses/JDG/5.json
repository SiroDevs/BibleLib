            }
          ]
        },
        {
          "text": "; I will sing",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "praise",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.3",
                "verseOrgIds": [
                  "JDG.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "to the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.3",
            "verseOrgIds": [
              "JDG.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
