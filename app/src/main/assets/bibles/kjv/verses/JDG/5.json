          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.11",
                "verseOrgIds": [
                  "JDG.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        },
