          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.9",
                "verseOrgIds": [
                  "JDG.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.9",
            "verseOrgIds": [
              "JDG.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
