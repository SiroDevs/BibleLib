            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.4",
                "verseOrgIds": [
                  "JDG.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", when thou wentest out of Seir, when thou marchedst out of the field of Edom, the earth trembled, and the heavens dropped, the clouds also dropped water.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.4",
            "verseOrgIds": [
              "JDG.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The mountains melted from before the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.5",
            "verseOrgIds": [
              "JDG.5.5"
            ]
          }
        },
