          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "toward the inhabitants",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.11",
                "verseOrgIds": [
                  "JDG.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "of his villages in Israel: then shall the people of the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.11",
                "verseOrgIds": [
                  "JDG.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "go down to the gates.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.11",
            "verseOrgIds": [
              "JDG.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
