        },
        {
          "text": "Then sang Deborah and Barak the son of Abinoam on that day, saying,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.1",
            "verseOrgIds": [
              "JDG.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Praise ye the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.2",
            "verseOrgIds": [
              "JDG.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
