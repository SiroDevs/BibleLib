            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "JDG.5.5",
                "verseOrgIds": [
                  "JDG.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "that Sinai from before the",
          "type": "text",
          "attrs": {
            "verseId": "JDG.5.5",
            "verseOrgIds": [
              "JDG.5.5"
            ]
          }
        },
