            "verseId": "ZEC.6.5",
            "verseOrgIds": [
              "ZEC.6.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
