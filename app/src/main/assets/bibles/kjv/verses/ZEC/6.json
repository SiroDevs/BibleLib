            "verseId": "ZEC.6.4",
            "verseOrgIds": [
              "ZEC.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.6.4",
                "verseOrgIds": [
                  "ZEC.6.4"
                ]
              }
            }
          ]
        },
