          "text": "¶ Then answered I, and said unto him, What",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.4.11",
                "verseOrgIds": [
                  "ZEC.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "these two olive trees upon the right",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
