              "attrs": {
                "verseId": "ZEC.4.11",
                "verseOrgIds": [
                  "ZEC.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "of the candlestick and upon the left",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "side",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.4.11",
                "verseOrgIds": [
                  "ZEC.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "thereof?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "And I answered again, and said unto him, What",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be these",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.4.12",
                "verseOrgIds": [
                  "ZEC.4.12"
                ]
              }
            }
          ]
        },
        {
          "text": "two olive branches which through the two golden pipes empty the golden",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "oil",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.4.12",
                "verseOrgIds": [
                  "ZEC.4.12"
                ]
              }
            }
          ]
        },
        {
          "text": "out of themselves?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he answered me and said, Knowest thou not what these",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.4.13",
                "verseOrgIds": [
                  "ZEC.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "? And I said, No, my lord.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.13",
            "verseOrgIds": [
              "ZEC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 4:14"
          },
          "items": [
            {
              "text": "14",
