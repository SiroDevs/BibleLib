                "verseOrgIds": [
                  "ZEC.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "the words which the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
