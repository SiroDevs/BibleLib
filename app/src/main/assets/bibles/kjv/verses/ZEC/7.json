          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.6",
            "verseOrgIds": [
              "ZEC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
