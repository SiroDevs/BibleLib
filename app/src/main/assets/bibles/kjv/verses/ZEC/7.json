            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.8",
                "verseOrgIds": [
                  "ZEC.7.8"
                ]
              }
            }
          ]
        },
