          "text": "in the house of the",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.3",
                "verseOrgIds": [
                  "ZEC.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts, and to the prophets, saying, Should I weep in the fifth month, separating myself, as I have done these so many years?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        }
