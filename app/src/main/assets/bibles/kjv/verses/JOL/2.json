          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "But I will remove far off from you the northern",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.20",
            "verseOrgIds": [
              "JOL.2.20"
            ]
          }
        },
