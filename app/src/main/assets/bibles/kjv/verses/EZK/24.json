  "reference": "Ezekiel 24",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "EZK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Again in the ninth year, in the tenth month, in the tenth",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "day",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.1",
                "verseOrgIds": [
                  "EZK.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "of the month, the word of the",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.1",
                "verseOrgIds": [
                  "EZK.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "came unto me, saying,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Son of man, write thee the name of the day,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.2",
                "verseOrgIds": [
                  "EZK.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "of this same day: the king of Babylon set himself against Jerusalem this same day.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "And utter a parable unto the rebellious house, and say unto them, Thus saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.3",
                "verseOrgIds": [
                  "EZK.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "; Set on a pot, set",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.3",
                "verseOrgIds": [
                  "EZK.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "on, and also pour water into it:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gather the pieces thereof into it,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.4",
                "verseOrgIds": [
                  "EZK.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "every good piece, the thigh, and the shoulder; fill",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.4",
                "verseOrgIds": [
                  "EZK.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "with the choice bones.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.4",
            "verseOrgIds": [
              "EZK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take the choice of the flock, and burn also the bones under it,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.5",
                "verseOrgIds": [
                  "EZK.24.5"
                ]
              }
            }
          ]
        },
        {
          "text": "make it boil well, and let them seethe the bones of it therein.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Wherefore thus saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.6",
                "verseOrgIds": [
                  "EZK.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "; Woe to the bloody city, to the pot whose scum",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.6",
                "verseOrgIds": [
                  "EZK.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "therein, and whose scum is not gone out of it! bring it out piece by piece; let no lot fall upon it.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "For her blood is in the midst of her; she set it upon the top of a rock; she poured it not upon the ground, to cover it with dust;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "That it might cause fury to come up to take vengeance; I have set her blood upon the top of a rock, that it should not be covered.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore thus saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.9",
                "verseOrgIds": [
                  "EZK.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "; Woe to the bloody city! I will even make the pile for fire great.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heap on wood, kindle the fire, consume the flesh, and spice it well, and let the bones be burned.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then set it empty upon the coals thereof, that the brass of it may be hot, and may burn, and",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.11",
                "verseOrgIds": [
                  "EZK.24.11"
                ]
              }
            }
          ]
        },
        {
          "text": "the filthiness of it may be molten in it,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.11",
                "verseOrgIds": [
                  "EZK.24.11"
                ]
              }
            }
          ]
        },
        {
          "text": "the scum of it may be consumed.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "She hath wearied",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "herself",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.12",
                "verseOrgIds": [
                  "EZK.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "with lies, and her great scum went not forth out of her: her scum",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall be",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.12",
                "verseOrgIds": [
                  "EZK.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "in the fire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "In thy filthiness",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.13",
                "verseOrgIds": [
                  "EZK.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "lewdness: because I have purged thee, and thou wast not purged, thou shalt not be purged from thy filthiness any more, till I have caused my fury to rest upon thee.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I the",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.14",
                "verseOrgIds": [
                  "EZK.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "have spoken",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it:",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.14",
                "verseOrgIds": [
                  "EZK.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "it shall come to pass, and I will do",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it;",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.14",
                "verseOrgIds": [
                  "EZK.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "I will not go back, neither will I spare, neither will I repent; according to thy ways, and according to thy doings, shall they judge thee, saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.14",
                "verseOrgIds": [
                  "EZK.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Also the word of the",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.24.15",
                "verseOrgIds": [
                  "EZK.24.15"
                ]
              }
            }
          ]
        },
        {
          "text": "came unto me, saying,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
