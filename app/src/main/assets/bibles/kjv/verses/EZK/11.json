            "number": "16",
            "style": "v",
            "sid": "EZK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore say, Thus saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.16",
            "verseOrgIds": [
              "EZK.11.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.11.16",
                "verseOrgIds": [
                  "EZK.11.16"
                ]
              }
            }
          ]
        },
        {
          "text": "; Although I have cast them far off among the heathen, and although I have scattered them among the countries, yet will I be to them as a little sanctuary in the countries where they shall come.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.16",
            "verseOrgIds": [
              "EZK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Therefore say, Thus saith the Lord",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.17",
            "verseOrgIds": [
              "EZK.11.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "GOD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.11.17",
                "verseOrgIds": [
                  "EZK.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": "; I will even gather you from the people, and assemble you out of the countries where ye have been scattered, and I will give you the land of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.17",
            "verseOrgIds": [
              "EZK.11.17"
            ]
          }
