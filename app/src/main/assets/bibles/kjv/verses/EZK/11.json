              "attrs": {
                "verseId": "EZK.11.15",
                "verseOrgIds": [
                  "EZK.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "they unto whom the inhabitants of Jerusalem have said, Get you far from the",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.15",
            "verseOrgIds": [
              "EZK.11.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.11.15",
                "verseOrgIds": [
                  "EZK.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": ": unto us is this land given in possession.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.15",
            "verseOrgIds": [
              "EZK.11.15"
            ]
