            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The hand of the",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
