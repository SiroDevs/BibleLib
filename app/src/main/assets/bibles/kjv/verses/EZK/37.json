          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.15",
                "verseOrgIds": [
                  "EZK.37.15"
                ]
              }
            }
