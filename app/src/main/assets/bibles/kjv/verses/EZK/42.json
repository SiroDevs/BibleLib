          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "were",
              "type": "text",
              "attrs": {
                "verseId": "EZK.42.10",
                "verseOrgIds": [
                  "EZK.42.10"
                ]
              }
            }
          ]
        },
