              "type": "text",
              "attrs": {
                "verseId": "EZK.42.11",
                "verseOrgIds": [
                  "EZK.42.11"
                ]
              }
            }
          ]
        },
        {
          "text": "as broad as they: and all their goings out",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "were",
              "type": "text",
              "attrs": {
                "verseId": "EZK.42.11",
                "verseOrgIds": [
                  "EZK.42.11"
                ]
              }
            }
          ]
