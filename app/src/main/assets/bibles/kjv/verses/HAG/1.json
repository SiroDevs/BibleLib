              "type": "text",
              "attrs": {
                "verseId": "HAG.1.13",
                "verseOrgIds": [
                  "HAG.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
