        {
          "text": "The silver",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.8",
                "verseOrgIds": [
                  "HAG.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mine, and the gold",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.8",
                "verseOrgIds": [
                  "HAG.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mine, saith the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.8",
                "verseOrgIds": [
                  "HAG.2.8"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "The glory of this latter house shall be greater than of the former, saith the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.9",
                "verseOrgIds": [
                  "HAG.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts: and in this place will I give peace, saith the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.9",
                "verseOrgIds": [
                  "HAG.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
    },
    {
