              "type": "text",
              "attrs": {
                "verseId": "HAG.2.10",
                "verseOrgIds": [
                  "HAG.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", in the second year of Darius, came the word of the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.10",
                "verseOrgIds": [
                  "HAG.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "by Haggai the prophet, saying,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.11",
                "verseOrgIds": [
                  "HAG.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts; Ask now the priests",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "concerning",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.11",
                "verseOrgIds": [
                  "HAG.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "the law, saying,",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "If one bear holy flesh in the skirt of his garment, and with his skirt do touch bread, or pottage, or wine, or oil, or any meat, shall it be holy? And the priests answered and said, No.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then said Haggai, If",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "one that is",
              "type": "text",
              "attrs": {
                "verseId": "HAG.2.13",
