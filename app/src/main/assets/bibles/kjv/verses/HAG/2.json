                "verseId": "HAG.2.10",
                "verseOrgIds": [
                  "HAG.2.10"
                ]
              }
            }
          ]
        },
        {
          "text": "of the ninth",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
