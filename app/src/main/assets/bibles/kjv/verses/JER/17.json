          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "And say unto them, Hear ye the word of the",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.17.20",
                "verseOrgIds": [
                  "JER.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", ye kings of Judah, and all Judah, and all the inhabitants of Jerusalem, that enter in by these gates:",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
