          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "And I will make",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thee",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.14",
                "verseOrgIds": [
                  "JER.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "to pass with thine enemies into a land",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.14",
                "verseOrgIds": [
                  "JER.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "thou knowest not: for a fire is kindled in mine anger,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.14",
                "verseOrgIds": [
                  "JER.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "shall burn upon you.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
