              "text": "Is",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.28",
                "verseOrgIds": [
                  "JER.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": "this man Coniah a despised broken idol?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is he",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.28",
                "verseOrgIds": [
                  "JER.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": "a vessel wherein",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.28",
                "verseOrgIds": [
                  "JER.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": "no pleasure? wherefore are they cast out, he and his seed, and are cast into a land which they know not?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "O earth, earth, earth, hear the word of the",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.29",
                "verseOrgIds": [
                  "JER.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.30",
                "verseOrgIds": [
                  "JER.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", Write ye this man childless, a man",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.30",
                "verseOrgIds": [
                  "JER.22.30"
                ]
              }
            }
          ]
        },
        {
          "text": "shall not prosper in his days: for no man of his seed shall prosper, sitting upon the throne of David, and ruling any more in Judah.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.30",
            "verseOrgIds": [
              "JER.22.30"
            ]
          }
        }
      ]
