              "attrs": {
                "verseId": "JER.22.17",
                "verseOrgIds": [
                  "JER.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
