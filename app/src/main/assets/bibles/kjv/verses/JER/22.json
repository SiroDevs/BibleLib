              "attrs": {
                "verseId": "JER.22.16",
                "verseOrgIds": [
                  "JER.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "not this to know me? saith the",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.22.16",
                "verseOrgIds": [
                  "JER.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "But thine eyes and thine heart",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
