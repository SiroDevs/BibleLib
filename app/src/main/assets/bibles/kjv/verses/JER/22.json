              "type": "text",
              "attrs": {
                "verseId": "JER.22.17",
                "verseOrgIds": [
                  "JER.22.17"
                ]
              }
            }
          ]
        },
        {
          "text": "not but for thy covetousness, and for to shed innocent blood, and for oppression, and for violence, to do",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
