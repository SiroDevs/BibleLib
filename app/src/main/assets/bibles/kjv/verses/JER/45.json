            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The word that Jeremiah the prophet spake unto Baruch the son of Neriah, when he had written these words in a book at the mouth of Jeremiah, in the fourth year of Jehoiakim the son of Josiah king of Judah, saying,",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus saith the",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.45.2",
                "verseOrgIds": [
                  "JER.45.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", the God of Israel, unto thee, O Baruch;",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou didst say, Woe is me now! for the",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.45.3",
                "verseOrgIds": [
                  "JER.45.3"
                ]
              }
            }
          ]
        },
        {
          "text": "hath added grief to my sorrow; I fainted in my sighing, and I find no rest.",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
