            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.19",
                "verseOrgIds": [
                  "JER.33.19"
                ]
              }
            }
          ]
        },
        {
          "text": "came unto Jeremiah, saying,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
