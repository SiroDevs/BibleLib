          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then will I cast away the seed of Jacob, and David my servant,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "so",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.26",
                "verseOrgIds": [
                  "JER.33.26"
                ]
              }
            }
          ]
        },
        {
          "text": "that I will not take",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "any",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.26",
                "verseOrgIds": [
                  "JER.33.26"
                ]
              }
            }
          ]
        },
        {
          "text": "of his seed",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "to be",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.26",
                "verseOrgIds": [
                  "JER.33.26"
                ]
              }
            }
          ]
        },
        {
          "text": "rulers over the seed of Abraham, Isaac, and Jacob: for I will cause their captivity to return, and have mercy on them.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        }
