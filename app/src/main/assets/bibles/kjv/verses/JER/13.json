          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I have seen thine adulteries, and thy neighings, the lewdness of thy whoredom,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.27",
            "verseOrgIds": [
              "JER.13.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
