                "verseOrgIds": [
                  "JER.13.25"
                ]
              }
            }
          ]
        },
        {
          "text": "; because thou hast forgotten me, and trusted in falsehood.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        },
