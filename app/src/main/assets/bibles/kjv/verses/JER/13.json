            "sid": "JER 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lift up your eyes, and behold them that come from the north: where",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        },
