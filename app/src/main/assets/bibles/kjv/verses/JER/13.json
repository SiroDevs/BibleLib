          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.20",
                "verseOrgIds": [
                  "JER.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "the flock",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.20",
                "verseOrgIds": [
                  "JER.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "was given thee, thy beautiful flock?",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.20",
            "verseOrgIds": [
              "JER.13.20"
            ]
          }
        },
        {
          "name": "verse",
