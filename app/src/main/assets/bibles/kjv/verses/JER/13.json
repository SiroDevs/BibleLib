              "attrs": {
                "verseId": "JER.13.25",
                "verseOrgIds": [
                  "JER.13.25"
                ]
              }
            }
          ]
        },
        {
          "text": "thy lot, the portion of thy measures from me, saith the",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        },
