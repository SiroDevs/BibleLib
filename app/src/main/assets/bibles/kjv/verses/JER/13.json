          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The cities of the south shall be shut up, and none shall open",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "them:",
              "type": "text",
              "attrs": {
                "verseId": "JER.13.19",
                "verseOrgIds": [
                  "JER.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Judah shall be carried away captive all of it, it shall be wholly carried away captive.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.19",
            "verseOrgIds": [
              "JER.13.19"
            ]
