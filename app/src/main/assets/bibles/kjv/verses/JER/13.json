                "verseOrgIds": [
                  "JER.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "captains,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.21",
            "verseOrgIds": [
              "JER.13.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
