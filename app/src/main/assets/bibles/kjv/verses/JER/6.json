              "attrs": {
                "verseId": "JER.6.28",
                "verseOrgIds": [
                  "JER.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "brass and iron; they",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.28",
            "verseOrgIds": [
              "JER.6.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "JER.6.28",
                "verseOrgIds": [
                  "JER.6.28"
                ]
              }
            }
          ]
        },
