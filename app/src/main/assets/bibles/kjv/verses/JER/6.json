            "sid": "JER 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reprobate silver shall",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.30",
            "verseOrgIds": [
              "JER.6.30"
            ]
          }
        },
