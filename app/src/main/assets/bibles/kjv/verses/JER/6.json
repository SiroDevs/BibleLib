                "verseId": "JER.6.16",
                "verseOrgIds": [
                  "JER.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.16",
            "verseOrgIds": [
              "JER.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
