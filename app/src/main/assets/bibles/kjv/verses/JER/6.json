                "verseOrgIds": [
                  "JER.6.30"
                ]
              }
            }
          ]
        },
        {
          "text": "call them, because the",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.30",
            "verseOrgIds": [
              "JER.6.30"
            ]
          }
        },
        {
