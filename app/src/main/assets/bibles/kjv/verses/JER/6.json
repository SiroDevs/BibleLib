          "text": "a tower",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.27",
            "verseOrgIds": [
              "JER.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "JER.6.27",
                "verseOrgIds": [
                  "JER.6.27"
                ]
              }
            }
          ]
        },
        {
          "text": "a fortress among my people, that thou mayest know and try their way.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.27",
            "verseOrgIds": [
              "JER.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "They",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.28",
            "verseOrgIds": [
              "JER.6.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
