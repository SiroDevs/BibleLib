          "text": "all corrupters.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.28",
            "verseOrgIds": [
              "JER.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "The bellows are burned, the lead is consumed of the fire; the founder melteth in vain: for the wicked are not plucked away.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.29",
            "verseOrgIds": [
              "JER.6.29"
            ]
          }
        },
