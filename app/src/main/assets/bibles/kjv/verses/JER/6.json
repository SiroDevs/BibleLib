          "text": "I have set thee",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.27",
            "verseOrgIds": [
              "JER.6.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "for",
