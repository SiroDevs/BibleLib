          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ Your iniquities have turned away these",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.25",
            "verseOrgIds": [
              "JER.5.25"
            ]
          }
        },
