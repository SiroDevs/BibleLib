            "style": "v",
            "sid": "PSA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Many",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.2",
                "verseOrgIds": [
                  "PSA.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "which say of my soul,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "There is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.2",
                "verseOrgIds": [
                  "PSA.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "no help for him in God. Selah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.2",
            "verseOrgIds": [
              "PSA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "But thou, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.3",
                "verseOrgIds": [
                  "PSA.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.3.3",
                "verseOrgIds": [
                  "PSA.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "a shield for me; my glory, and the lifter up of mine head.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.3.3",
            "verseOrgIds": [
              "PSA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
