      },
      "items": [
        {
          "text": "86",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A Prayer of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 86:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bow down thine ear, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.1",
                "verseOrgIds": [
                  "PSA.86.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", hear me: for I",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.1",
                "verseOrgIds": [
                  "PSA.86.1"
                ]
              }
            }
          ]
        },
        {
          "text": "poor and needy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.1",
            "verseOrgIds": [
              "PSA.86.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 86:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Preserve my soul; for I",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.2",
                "verseOrgIds": [
                  "PSA.86.2"
                ]
              }
            }
          ]
        },
        {
          "text": "holy: O thou my God, save thy servant that trusteth in thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.2",
            "verseOrgIds": [
              "PSA.86.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 86:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be merciful unto me, O Lord: for I cry unto thee daily.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.3",
            "verseOrgIds": [
              "PSA.86.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 86:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rejoice the soul of thy servant: for unto thee, O Lord, do I lift up my soul.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.4",
            "verseOrgIds": [
              "PSA.86.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 86:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thou, Lord,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.5",
                "verseOrgIds": [
                  "PSA.86.5"
                ]
              }
            }
          ]
        },
        {
          "text": "good, and ready to forgive; and plenteous in mercy unto all them that call upon thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.5",
            "verseOrgIds": [
              "PSA.86.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 86:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Give ear, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.6",
                "verseOrgIds": [
                  "PSA.86.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", unto my prayer; and attend to the voice of my supplications.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.6",
            "verseOrgIds": [
              "PSA.86.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 86:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "In the day of my trouble I will call upon thee: for thou wilt answer me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.7",
            "verseOrgIds": [
              "PSA.86.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 86:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Among the gods",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.8",
                "verseOrgIds": [
                  "PSA.86.8"
                ]
              }
            }
          ]
        },
        {
          "text": "none like unto thee, O Lord; neither",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are there any works",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.8",
                "verseOrgIds": [
                  "PSA.86.8"
                ]
              }
            }
          ]
        },
        {
          "text": "like unto thy works.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.8",
            "verseOrgIds": [
              "PSA.86.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 86:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "All nations whom thou hast made shall come and worship before thee, O Lord; and shall glorify thy name.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.9",
            "verseOrgIds": [
              "PSA.86.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 86:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.10",
                "verseOrgIds": [
                  "PSA.86.10"
                ]
              }
            }
          ]
        },
        {
          "text": "great, and doest wondrous things: thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.10",
                "verseOrgIds": [
                  "PSA.86.10"
                ]
              }
            }
          ]
        },
        {
          "text": "God alone.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.10",
            "verseOrgIds": [
              "PSA.86.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 86:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teach me thy way, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.11",
                "verseOrgIds": [
                  "PSA.86.11"
                ]
              }
            }
          ]
        },
        {
          "text": "; I will walk in thy truth: unite my heart to fear thy name.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.11",
            "verseOrgIds": [
              "PSA.86.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 86:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will praise thee, O Lord my God, with all my heart: and I will glorify thy name for evermore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.12",
            "verseOrgIds": [
              "PSA.86.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 86:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "For great",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.13",
                "verseOrgIds": [
                  "PSA.86.13"
                ]
              }
            }
          ]
        },
        {
          "text": "thy mercy toward me: and thou hast delivered my soul from the lowest hell.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.13",
            "verseOrgIds": [
              "PSA.86.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 86:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O God, the proud are risen against me, and the assemblies of violent",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "men",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.14",
                "verseOrgIds": [
                  "PSA.86.14"
                ]
              }
            }
          ]
        },
        {
          "text": "have sought after my soul; and have not set thee before them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.14",
            "verseOrgIds": [
              "PSA.86.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 86:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "But thou, O Lord,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.15",
                "verseOrgIds": [
                  "PSA.86.15"
                ]
              }
            }
          ]
        },
        {
          "text": "a God full of compassion, and gracious, longsuffering, and plenteous in mercy and truth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.15",
            "verseOrgIds": [
              "PSA.86.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 86:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O turn unto me, and have mercy upon me; give thy strength unto thy servant, and save the son of thine handmaid.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.16",
            "verseOrgIds": [
              "PSA.86.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 86:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shew me a token for good; that they which hate me may see",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.17",
            "verseOrgIds": [
              "PSA.86.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.17",
                "verseOrgIds": [
                  "PSA.86.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", and be ashamed: because thou,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.17",
            "verseOrgIds": [
              "PSA.86.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.86.17",
                "verseOrgIds": [
                  "PSA.86.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", hast holpen me, and comforted me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.86.17",
            "verseOrgIds": [
              "PSA.86.17"
            ]
          }
        }
      ]
    }
  ],
