  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "137",
        "style": "c",
        "sid": "PSA 137"
      },
      "items": [
        {
          "text": "137",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 137:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "By the rivers of Babylon, there we sat down, yea, we wept, when we remembered Zion.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.1",
            "verseOrgIds": [
              "PSA.137.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 137:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "We hanged our harps upon the willows in the midst thereof.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.2",
            "verseOrgIds": [
              "PSA.137.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 137:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For there they that carried us away captive required of us a song; and they that wasted us",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "required of us",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.3",
                "verseOrgIds": [
                  "PSA.137.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mirth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "saying",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.3",
                "verseOrgIds": [
                  "PSA.137.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Sing us",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "one",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.3",
                "verseOrgIds": [
                  "PSA.137.3"
                ]
              }
            }
          ]
        },
        {
          "text": "of the songs of Zion.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.3",
            "verseOrgIds": [
              "PSA.137.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 137:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "How shall we sing the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD's",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.4",
                "verseOrgIds": [
                  "PSA.137.4"
                ]
              }
            }
          ]
        },
        {
          "text": "song in a strange land?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.4",
            "verseOrgIds": [
              "PSA.137.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 137:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "If I forget thee, O Jerusalem, let my right hand forget",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "her cunning",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.5",
                "verseOrgIds": [
                  "PSA.137.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.5",
            "verseOrgIds": [
              "PSA.137.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 137:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "If I do not remember thee, let my tongue cleave to the roof of my mouth; if I prefer not Jerusalem above my chief joy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.6",
            "verseOrgIds": [
              "PSA.137.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 137:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.7",
                "verseOrgIds": [
                  "PSA.137.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", the children of Edom in the day of Jerusalem; who said, Rase",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.7",
                "verseOrgIds": [
                  "PSA.137.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", rase",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it, even",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.7",
                "verseOrgIds": [
                  "PSA.137.7"
                ]
              }
            }
          ]
        },
        {
          "text": "to the foundation thereof.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.7",
            "verseOrgIds": [
              "PSA.137.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 137:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O daughter of Babylon, who art to be destroyed; happy",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall he be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.8",
                "verseOrgIds": [
                  "PSA.137.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", that rewardeth thee as thou hast served us.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.8",
            "verseOrgIds": [
              "PSA.137.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 137:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Happy",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall he be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.137.9",
                "verseOrgIds": [
                  "PSA.137.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", that taketh and dasheth thy little ones against the stones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.137.9",
            "verseOrgIds": [
              "PSA.137.9"
            ]
          }
        }
      ]
    }
  ],
