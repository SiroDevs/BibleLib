{
  "id": "PSA.10",
  "number": "10",
  "bookId": "PSA",
  "reference": "Psalms 10",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "PSA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Why standest thou afar off, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.1",
                "verseOrgIds": [
                  "PSA.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "why",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.1",
                "verseOrgIds": [
                  "PSA.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "hidest thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thyself",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.1",
                "verseOrgIds": [
                  "PSA.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "in times of trouble?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.1",
            "verseOrgIds": [
              "PSA.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wicked in",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "his",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.2",
                "verseOrgIds": [
                  "PSA.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "pride doth persecute the poor: let them be taken in the devices that they have imagined.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.2",
            "verseOrgIds": [
              "PSA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the wicked boasteth of his heart's desire, and blesseth the covetous,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "whom",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.3",
                "verseOrgIds": [
                  "PSA.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.3",
                "verseOrgIds": [
                  "PSA.10.3"
                ]
              }
            }
          ]
        },
        {
          "text": "abhorreth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.3",
            "verseOrgIds": [
              "PSA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wicked, through the pride of his countenance, will not seek",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "after God:",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.4",
                "verseOrgIds": [
                  "PSA.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "God",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.4",
                "verseOrgIds": [
                  "PSA.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "not in all his thoughts.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.4",
            "verseOrgIds": [
              "PSA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "His ways are always grievous; thy judgments",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.5",
                "verseOrgIds": [
                  "PSA.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "far above out of his sight:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as for",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.5",
                "verseOrgIds": [
                  "PSA.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "all his enemies, he puffeth at them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.5",
            "verseOrgIds": [
              "PSA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "He hath said in his heart, I shall not be moved: for",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "I shall",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.6",
                "verseOrgIds": [
                  "PSA.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "never",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.6",
                "verseOrgIds": [
                  "PSA.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "in adversity.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.6",
            "verseOrgIds": [
              "PSA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "His mouth is full of cursing and deceit and fraud: under his tongue",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.7",
                "verseOrgIds": [
                  "PSA.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "mischief and vanity.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.7",
            "verseOrgIds": [
              "PSA.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He sitteth in the lurking places of the villages: in the secret places doth he murder the innocent: his eyes are privily set against the poor.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.8",
            "verseOrgIds": [
              "PSA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He lieth in wait secretly as a lion in his den: he lieth in wait to catch the poor: he doth catch the poor, when he draweth him into his net.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.9",
            "verseOrgIds": [
              "PSA.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He croucheth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.10",
                "verseOrgIds": [
                  "PSA.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "humbleth himself, that the poor may fall by his strong ones.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.10",
            "verseOrgIds": [
              "PSA.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "He hath said in his heart, God hath forgotten: he hideth his face; he will never see",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.11",
                "verseOrgIds": [
                  "PSA.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.11",
            "verseOrgIds": [
              "PSA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arise, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.12",
                "verseOrgIds": [
                  "PSA.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "; O God, lift up thine hand: forget not the humble.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.12",
            "verseOrgIds": [
              "PSA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wherefore doth the wicked contemn God? he hath said in his heart, Thou wilt not require",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.13",
                "verseOrgIds": [
                  "PSA.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.13",
            "verseOrgIds": [
              "PSA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou hast seen",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it;",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.14",
                "verseOrgIds": [
                  "PSA.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "for thou beholdest mischief and spite, to requite",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.10.14",
                "verseOrgIds": [
                  "PSA.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "with thy hand: the poor committeth himself unto thee; thou art the helper of the fatherless.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.14",
            "verseOrgIds": [
              "PSA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Break thou the arm of the wicked and the evil",
          "type": "text",
          "attrs": {
            "verseId": "PSA.10.15",
            "verseOrgIds": [
              "PSA.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
