              "attrs": {
                "verseId": "PSA.19.3",
                "verseOrgIds": [
                  "PSA.19.4"
                ]
              }
            }
          ]
        },
        {
          "text": "their voice is not heard.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
