              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "There is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.19.3",
                "verseOrgIds": [
                  "PSA.19.4"
