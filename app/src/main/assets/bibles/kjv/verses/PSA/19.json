              "type": "text",
              "attrs": {
                "verseId": "PSA.19.5",
                "verseOrgIds": [
                  "PSA.19.6"
                ]
              }
            }
          ]
        },
        {
          "text": "rejoiceth as a strong man to run a race.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
