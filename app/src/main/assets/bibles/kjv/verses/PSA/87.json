          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.4",
                "verseOrgIds": [
                  "PSA.87.4"
                ]
              }
            }
          ]
        },
