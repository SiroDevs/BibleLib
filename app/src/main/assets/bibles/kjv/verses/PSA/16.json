                "verseId": "PSA.16.3",
                "verseOrgIds": [
                  "PSA.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "to the saints that",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.3",
                "verseOrgIds": [
                  "PSA.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "in the earth, and",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "to",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.3",
                "verseOrgIds": [
                  "PSA.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "the excellent, in whom",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.3",
                "verseOrgIds": [
                  "PSA.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "all my delight.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.3",
            "verseOrgIds": [
              "PSA.16.3"
            ]
          }
        }
      ]
    },
    {
