              "attrs": {
                "verseId": "PSA.16.5",
                "verseOrgIds": [
                  "PSA.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.5",
                "verseOrgIds": [
                  "PSA.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "the portion of mine inheritance and of my cup: thou maintainest my lot.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.5",
            "verseOrgIds": [
              "PSA.16.5"
            ]
          }
        }
