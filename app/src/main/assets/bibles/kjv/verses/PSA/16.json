          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.4",
                "verseOrgIds": [
                  "PSA.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "hasten",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "after",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.4",
                "verseOrgIds": [
                  "PSA.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "another",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "god:",
              "type": "text",
              "attrs": {
                "verseId": "PSA.16.4",
                "verseOrgIds": [
                  "PSA.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "their drink offerings of blood will I not offer, nor take up their names into my lips.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.16.4",
            "verseOrgIds": [
              "PSA.16.4"
            ]
          }
        }
      ]
    },
