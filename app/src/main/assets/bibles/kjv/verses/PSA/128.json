          "text": ", and",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it shall be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.128.2",
                "verseOrgIds": [
                  "PSA.128.2"
                ]
              }
            }
          ]
        },
        {
          "text": "well with thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
