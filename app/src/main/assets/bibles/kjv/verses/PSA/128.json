            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.128.1",
                "verseOrgIds": [
                  "PSA.128.1"
                ]
              }
            }
          ]
        },
        {
          "text": "; that walketh in his ways.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
