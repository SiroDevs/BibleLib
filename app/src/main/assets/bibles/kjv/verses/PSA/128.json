                "verseId": "PSA.128.2",
                "verseOrgIds": [
                  "PSA.128.2"
                ]
              }
            }
          ]
        },
        {
          "text": "thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
