          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bless the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.1",
                "verseOrgIds": [
                  "PSA.103.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", O my soul: and all that is within me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "bless",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.1",
                "verseOrgIds": [
                  "PSA.103.1"
                ]
              }
            }
          ]
        },
        {
          "text": "his holy name.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.1",
            "verseOrgIds": [
              "PSA.103.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 103:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bless the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.2",
                "verseOrgIds": [
                  "PSA.103.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", O my soul, and forget not all his benefits:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.2",
            "verseOrgIds": [
              "PSA.103.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 103:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who forgiveth all thine iniquities; who healeth all thy diseases;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.3",
            "verseOrgIds": [
              "PSA.103.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 103:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who redeemeth thy life from destruction; who crowneth thee with lovingkindness and tender mercies;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.4",
            "verseOrgIds": [
              "PSA.103.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 103:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who satisfieth thy mouth with good",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "things; so that",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.5",
                "verseOrgIds": [
                  "PSA.103.5"
                ]
              }
            }
          ]
        },
        {
          "text": "thy youth is renewed like the eagle's.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.5",
            "verseOrgIds": [
              "PSA.103.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
