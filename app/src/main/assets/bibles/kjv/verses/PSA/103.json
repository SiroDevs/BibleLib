          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "As for",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.15",
                "verseOrgIds": [
                  "PSA.103.15"
                ]
              }
            }
          ]
        },
        {
          "text": "man, his days",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.15",
                "verseOrgIds": [
                  "PSA.103.15"
                ]
              }
            }
          ]
        },
        {
          "text": "as grass: as a flower of the field, so he flourisheth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.15",
            "verseOrgIds": [
              "PSA.103.15"
            ]
          }
        }
      ]
    },
    {
