          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "his",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.13",
                "verseOrgIds": [
                  "PSA.103.13"
                ]
              }
            }
          ]
        },
