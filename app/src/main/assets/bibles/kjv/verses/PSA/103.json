          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.14",
                "verseOrgIds": [
                  "PSA.103.14"
                ]
              }
            }
          ]
        },
        {
          "text": "dust.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.14",
            "verseOrgIds": [
              "PSA.103.14"
            ]
          }
        }
      ]
    },
