          "text": "children,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "so",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.13",
                "verseOrgIds": [
                  "PSA.103.13"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.103.13",
            "verseOrgIds": [
              "PSA.103.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.13",
                "verseOrgIds": [
                  "PSA.103.13"
                ]
              }
            }
          ]
