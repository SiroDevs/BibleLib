            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.103.17",
                "verseOrgIds": [
                  "PSA.103.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
