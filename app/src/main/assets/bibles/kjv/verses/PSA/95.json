          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O come, let us worship and bow down: let us kneel before the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.6",
                "verseOrgIds": [
                  "PSA.95.6"
                ]
              }
            }
          ]
        },
        {
          "text": "our maker.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.6",
            "verseOrgIds": [
              "PSA.95.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 95:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "For he",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.7",
                "verseOrgIds": [
                  "PSA.95.7"
                ]
              }
            }
          ]
        },
        {
          "text": "our God; and we",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.7",
                "verseOrgIds": [
                  "PSA.95.7"
                ]
              }
            }
          ]
        },
        {
          "text": "the people of his pasture, and the sheep of his hand. To day if ye will hear his voice,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.7",
            "verseOrgIds": [
              "PSA.95.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 95:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harden not your heart, as in the provocation,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.8",
                "verseOrgIds": [
                  "PSA.95.8"
                ]
              }
            }
          ]
        },
        {
          "text": "as",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.8",
                "verseOrgIds": [
                  "PSA.95.8"
                ]
              }
            }
          ]
        },
        {
          "text": "the day of temptation in the wilderness:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.8",
            "verseOrgIds": [
              "PSA.95.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 95:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "When your fathers tempted me, proved me, and saw my work.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.9",
            "verseOrgIds": [
              "PSA.95.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 95:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Forty years long was I grieved with",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "this",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.10",
                "verseOrgIds": [
                  "PSA.95.10"
                ]
              }
            }
          ]
        },
        {
          "text": "generation, and said, It",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.10",
                "verseOrgIds": [
                  "PSA.95.10"
                ]
              }
            }
          ]
        },
        {
          "text": "a people that do err in their heart, and they have not known my ways:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.10",
            "verseOrgIds": [
              "PSA.95.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 95:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unto whom I sware in my wrath that they should not enter into my rest.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.11",
            "verseOrgIds": [
              "PSA.95.11"
            ]
          }
        }
      ]
    }
