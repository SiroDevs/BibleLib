          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O come, let us sing unto the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.1",
                "verseOrgIds": [
                  "PSA.95.1"
                ]
              }
            }
          ]
        },
        {
          "text": ": let us make a joyful noise to the rock of our salvation.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.1",
            "verseOrgIds": [
              "PSA.95.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 95:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let us come before his presence with thanksgiving, and make a joyful noise unto him with psalms.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.2",
            "verseOrgIds": [
              "PSA.95.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 95:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.3",
                "verseOrgIds": [
                  "PSA.95.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.3",
            "verseOrgIds": [
              "PSA.95.3"
            ]
