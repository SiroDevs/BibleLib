            "number": "5",
            "style": "v",
            "sid": "PSA 95:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sea",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.5",
                "verseOrgIds": [
                  "PSA.95.5"
                ]
              }
            }
          ]
        },
        {
          "text": "his, and he made it: and his hands formed the dry",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "land",
              "type": "text",
              "attrs": {
                "verseId": "PSA.95.5",
                "verseOrgIds": [
                  "PSA.95.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.95.5",
            "verseOrgIds": [
              "PSA.95.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
