          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.1",
                "verseOrgIds": [
                  "PSA.132.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", remember David,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.1",
                "verseOrgIds": [
                  "PSA.132.1"
                ]
              }
            }
          ]
        },
        {
          "text": "all his afflictions:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 132:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "How he sware unto the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.2",
                "verseOrgIds": [
                  "PSA.132.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.2",
                "verseOrgIds": [
                  "PSA.132.2"
                ]
              }
            }
          ]
        },
        {
          "text": "vowed unto the mighty",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "God",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.2",
                "verseOrgIds": [
                  "PSA.132.2"
                ]
              }
            }
          ]
        },
        {
          "text": "of Jacob;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 132:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely I will not come into the tabernacle of my house, nor go up into my bed;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 132:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will not give sleep to mine eyes,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.4",
                "verseOrgIds": [
                  "PSA.132.4"
                ]
              }
            }
          ]
        },
        {
          "text": "slumber to mine eyelids,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 132:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Until I find out a place for the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.5",
                "verseOrgIds": [
                  "PSA.132.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", an habitation for the mighty",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "God",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.5",
                "verseOrgIds": [
                  "PSA.132.5"
                ]
              }
            }
          ]
        },
        {
          "text": "of Jacob.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 132:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo, we heard of it at Ephratah: we found it in the fields of the wood.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 132:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "We will go into his tabernacles: we will worship at his footstool.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 132:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arise, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.8",
                "verseOrgIds": [
                  "PSA.132.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", into thy rest; thou, and the ark of thy strength.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 132:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let thy priests be clothed with righteousness; and let thy saints shout for joy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 132:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thy servant David's sake turn not away the face of thine anointed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 132:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.11",
                "verseOrgIds": [
                  "PSA.132.11"
                ]
              }
            }
          ]
        },
        {
          "text": "hath sworn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.11",
                "verseOrgIds": [
                  "PSA.132.11"
                ]
              }
            }
          ]
        },
        {
          "text": "truth unto David; he will not turn from it; Of the fruit of thy body will I set upon thy throne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 132:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "If thy children will keep my covenant and my testimony that I shall teach them, their children shall also sit upon thy throne for evermore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 132:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.13",
                "verseOrgIds": [
                  "PSA.132.13"
                ]
              }
            }
          ]
        },
        {
          "text": "hath chosen Zion; he hath desired",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.13",
                "verseOrgIds": [
                  "PSA.132.13"
                ]
              }
            }
          ]
        },
        {
          "text": "for his habitation.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 132:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "This",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.14",
                "verseOrgIds": [
                  "PSA.132.14"
                ]
              }
            }
          ]
        },
        {
          "text": "my rest for ever: here will I dwell; for I have desired it.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 132:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will abundantly bless her provision: I will satisfy her poor with bread.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 132:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will also clothe her priests with salvation: and her saints shall shout aloud for joy.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 132:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "There will I make the horn of David to bud: I have ordained a lamp for mine anointed.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.17",
            "verseOrgIds": [
              "PSA.132.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 132:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "His enemies will I clothe with shame: but upon himself shall his crown flourish.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.18",
            "verseOrgIds": [
              "PSA.132.18"
            ]
          }
        }
      ]
    }
  ],
