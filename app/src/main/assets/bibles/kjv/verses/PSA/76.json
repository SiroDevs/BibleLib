  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "76",
        "style": "c",
        "sid": "PSA 76"
      },
      "items": [
        {
          "text": "76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "To the chief Musician on Neginoth, A Psalm",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text"
            }
          ]
        },
        {
          "text": "Song of Asaph.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 76:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "In Judah",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.1",
                "verseOrgIds": [
                  "PSA.76.2"
                ]
              }
            }
          ]
        },
        {
          "text": "God known: his name",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.1",
                "verseOrgIds": [
                  "PSA.76.2"
                ]
              }
            }
          ]
        },
        {
          "text": "great in Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 76:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "In Salem also is his tabernacle, and his dwelling place in Zion.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 76:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "There brake he the arrows of the bow, the shield, and the sword, and the battle. Selah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 76:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.4",
                "verseOrgIds": [
                  "PSA.76.5"
                ]
              }
            }
          ]
        },
        {
          "text": "more glorious",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.4",
                "verseOrgIds": [
                  "PSA.76.5"
                ]
              }
            }
          ]
        },
        {
          "text": "excellent than the mountains of prey.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 76:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The stouthearted are spoiled, they have slept their sleep: and none of the men of might have found their hands.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 76:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "At thy rebuke, O God of Jacob, both the chariot and horse are cast into a dead sleep.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 76:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.7",
                "verseOrgIds": [
                  "PSA.76.8"
                ]
              }
            }
          ]
        },
        {
          "text": "thou,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.7",
                "verseOrgIds": [
                  "PSA.76.8"
                ]
              }
            }
          ]
        },
        {
          "text": "to be feared: and who may stand in thy sight when once thou art angry?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 76:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou didst cause judgment to be heard from heaven; the earth feared, and was still,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 76:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "When God arose to judgment, to save all the meek of the earth. Selah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 76:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Surely the wrath of man shall praise thee: the remainder of wrath shalt thou restrain.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 76:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vow, and pay unto the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.11",
                "verseOrgIds": [
                  "PSA.76.12"
                ]
              }
            }
          ]
        },
        {
          "text": "your God: let all that be round about him bring presents unto him that ought to be feared.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 76:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "He shall cut off the spirit of princes:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "he is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.12",
                "verseOrgIds": [
                  "PSA.76.13"
                ]
              }
            }
          ]
        },
        {
          "text": "terrible to the kings of the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    }
  ],
