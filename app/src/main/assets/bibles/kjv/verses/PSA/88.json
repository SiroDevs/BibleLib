{
  "id": "PSA.88",
  "number": "88",
  "bookId": "PSA",
  "reference": "Psalms 88",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "88",
        "style": "c",
        "sid": "PSA 88"
      },
      "items": [
        {
          "text": "88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A Song",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text"
            }
          ]
        },
        {
          "text": "Psalm for the sons of Korah, to the chief Musician upon Mahalath Leannoth, Maschil of Heman the Ezrahite.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 88:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.1",
                "verseOrgIds": [
                  "PSA.88.2"
                ]
              }
            }
          ]
        },
        {
          "text": "God of my salvation, I have cried day",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.1",
                "verseOrgIds": [
                  "PSA.88.2"
                ]
              }
            }
          ]
        },
        {
          "text": "night before thee:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 88:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let my prayer come before thee: incline thine ear unto my cry;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 88:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "For my soul is full of troubles: and my life draweth nigh unto the grave.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 88:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I am counted with them that go down into the pit: I am as a man",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that hath",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.4",
                "verseOrgIds": [
                  "PSA.88.5"
                ]
              }
            }
          ]
        },
        {
          "text": "no strength:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 88:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Free among the dead, like the slain that lie in the grave, whom thou rememberest no more: and they are cut off from thy hand.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 88:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou hast laid me in the lowest pit, in darkness, in the deeps.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 88:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thy wrath lieth hard upon me, and thou hast afflicted",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "me",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.7",
                "verseOrgIds": [
                  "PSA.88.8"
                ]
              }
            }
          ]
        },
        {
          "text": "with all thy waves. Selah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 88:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou hast put away mine acquaintance far from me; thou hast made me an abomination unto them:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "I am",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.8",
                "verseOrgIds": [
                  "PSA.88.9"
                ]
              }
            }
          ]
        },
        {
          "text": "shut up, and I cannot come forth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 88:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mine eye mourneth by reason of affliction:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.9",
                "verseOrgIds": [
                  "PSA.88.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", I have called daily upon thee, I have stretched out my hands unto thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 88:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wilt thou shew wonders to the dead? shall the dead arise",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.10",
                "verseOrgIds": [
                  "PSA.88.11"
                ]
              }
            }
          ]
        },
        {
          "text": "praise thee? Selah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 88:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shall thy lovingkindness be declared in the grave?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.11",
                "verseOrgIds": [
                  "PSA.88.12"
                ]
              }
            }
          ]
        },
        {
          "text": "thy faithfulness in destruction?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 88:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shall thy wonders be known in the dark? and thy righteousness in the land of forgetfulness?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 88:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "But unto thee have I cried, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.13",
                "verseOrgIds": [
                  "PSA.88.14"
                ]
              }
            }
          ]
        },
        {
          "text": "; and in the morning shall my prayer prevent thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 88:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.14",
                "verseOrgIds": [
                  "PSA.88.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", why castest thou off my soul?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "why",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.14",
                "verseOrgIds": [
                  "PSA.88.15"
                ]
              }
            }
          ]
        },
        {
          "text": "hidest thou thy face from me?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 88:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.15",
                "verseOrgIds": [
                  "PSA.88.16"
                ]
              }
            }
          ]
        },
        {
          "text": "afflicted and ready to die from",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "my",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.15",
                "verseOrgIds": [
                  "PSA.88.16"
                ]
              }
            }
          ]
        },
        {
          "text": "youth up:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "while",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.15",
                "verseOrgIds": [
                  "PSA.88.16"
                ]
              }
            }
          ]
        },
        {
          "text": "I suffer thy terrors I am distracted.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 88:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thy fierce wrath goeth over me; thy terrors have cut me off.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.16",
            "verseOrgIds": [
              "PSA.88.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 88:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "They came round about me daily like water; they compassed me about together.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.17",
            "verseOrgIds": [
              "PSA.88.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 88:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lover and friend hast thou put far from me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.18",
            "verseOrgIds": [
              "PSA.88.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.18",
                "verseOrgIds": [
                  "PSA.88.19"
                ]
              }
            }
          ]
        },
        {
          "text": "mine acquaintance into darkness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.18",
            "verseOrgIds": [
              "PSA.88.19"
            ]
          }
        }
      ]
    }
