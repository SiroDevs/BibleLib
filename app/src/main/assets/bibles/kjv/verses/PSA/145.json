              "attrs": {
                "verseId": "PSA.145.6",
                "verseOrgIds": [
                  "PSA.145.6"
                ]
              }
            }
          ]
        },
        {
          "text": "shall speak of the might of thy terrible acts: and I will declare thy greatness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        }
