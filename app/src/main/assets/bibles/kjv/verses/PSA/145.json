                "verseOrgIds": [
                  "PSA.145.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", and greatly to be praised; and his greatness",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.3",
            "verseOrgIds": [
              "PSA.145.3"
            ]
          }
        },
