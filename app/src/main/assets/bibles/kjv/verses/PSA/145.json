    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 145:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will extol thee, my God, O king; and I will bless thy name for ever and ever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.1",
            "verseOrgIds": [
              "PSA.145.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 145:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Every day will I bless thee; and I will praise thy name for ever and ever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.2",
            "verseOrgIds": [
              "PSA.145.2"
            ]
          }
        }
      ]
    },
