              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "And",
          "type": "text",
          "attrs": {
            "verseId": "PSA.145.6",
            "verseOrgIds": [
              "PSA.145.6"
            ]
          }
        },
        {
