                "verseId": "PSA.93.1",
                "verseOrgIds": [
                  "PSA.93.1"
                ]
              }
            }
          ]
        },
        {
          "text": "reigneth, he is clothed with majesty; the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
