                "verseOrgIds": [
                  "PSA.74.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", and",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
