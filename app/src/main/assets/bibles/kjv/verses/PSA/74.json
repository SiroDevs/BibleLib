              "attrs": {
                "verseId": "PSA.74.18",
                "verseOrgIds": [
                  "PSA.74.18"
                ]
              }
            }
          ]
        },
        {
          "text": "the enemy hath reproached, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
          }
        },
