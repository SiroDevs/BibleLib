            "style": "v",
            "sid": "PSA 74:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arise, O God, plead thine own cause: remember how the foolish man reproacheth thee daily.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
            ]
          }
        }
      ]
    },
