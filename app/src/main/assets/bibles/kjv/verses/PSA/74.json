          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O deliver not the soul of thy turtledove unto the multitude",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "of the wicked:",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.19",
                "verseOrgIds": [
                  "PSA.74.19"
                ]
              }
            }
          ]
        },
        {
          "text": "forget not the congregation of thy poor for ever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
      ]
    },
