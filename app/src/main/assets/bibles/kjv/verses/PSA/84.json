        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 84:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "My soul longeth, yea, even fainteth for the courts of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.2",
                "verseOrgIds": [
                  "PSA.84.3"
                ]
              }
            }
          ]
        },
        {
          "text": ": my heart and my flesh crieth out for the living God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 84:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yea, the sparrow hath found an house, and the swallow a nest for herself, where she may lay her young,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.3",
                "verseOrgIds": [
                  "PSA.84.4"
                ]
              }
            }
          ]
        },
        {
          "text": "thine altars, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.3",
                "verseOrgIds": [
                  "PSA.84.4"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts, my King, and my God.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
