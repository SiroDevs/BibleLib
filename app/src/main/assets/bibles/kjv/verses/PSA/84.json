                "verseId": "PSA.84.1",
                "verseOrgIds": [
                  "PSA.84.2"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
