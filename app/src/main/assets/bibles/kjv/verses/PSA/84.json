        "style": "d"
      },
      "items": [
        {
          "text": "To the chief Musician upon Gittith, A Psalm for the sons of Korah.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
