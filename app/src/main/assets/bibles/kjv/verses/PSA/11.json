          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD's",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.4",
                "verseOrgIds": [
                  "PSA.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "throne",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.4",
            "verseOrgIds": [
              "PSA.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
