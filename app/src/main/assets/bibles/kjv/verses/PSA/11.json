              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.5",
                "verseOrgIds": [
                  "PSA.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "trieth the righteous: but the wicked and him that loveth violence his soul hateth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.5",
            "verseOrgIds": [
              "PSA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upon the wicked he shall rain snares, fire and brimstone, and an horrible tempest:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "this shall be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.6",
                "verseOrgIds": [
                  "PSA.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "the portion of their cup.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.6",
            "verseOrgIds": [
              "PSA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the righteous",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.7",
                "verseOrgIds": [
                  "PSA.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "loveth righteousness; his countenance doth behold the upright.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.7",
            "verseOrgIds": [
              "PSA.11.7"
            ]
          }
        }
      ]
