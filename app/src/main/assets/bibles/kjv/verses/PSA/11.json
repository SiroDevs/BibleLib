          "text": "In the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.1",
                "verseOrgIds": [
                  "PSA.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "put I my trust: how say ye to my soul, Flee",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as",
              "type": "text",
              "attrs": {
                "verseId": "PSA.11.1",
                "verseOrgIds": [
                  "PSA.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "a bird to your mountain?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.11.1",
            "verseOrgIds": [
              "PSA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
