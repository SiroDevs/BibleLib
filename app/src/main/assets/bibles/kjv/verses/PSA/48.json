  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "48",
        "style": "c",
        "sid": "PSA 48"
      },
      "items": [
        {
          "text": "48",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "A Song",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text"
            }
          ]
        },
        {
          "text": "Psalm for the sons of Korah.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Great",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.1",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.1",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", and greatly to be praised in the city of our God,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "in",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.1",
                "verseOrgIds": [
                  "PSA.48.2"
                ]
              }
            }
          ]
        },
        {
          "text": "the mountain of his holiness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.1",
            "verseOrgIds": [
              "PSA.48.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beautiful for situation, the joy of the whole earth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.2",
                "verseOrgIds": [
                  "PSA.48.3"
                ]
              }
            }
          ]
        },
        {
          "text": "mount Zion,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "on",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.2",
                "verseOrgIds": [
                  "PSA.48.3"
                ]
              }
            }
          ]
        },
        {
          "text": "the sides of the north, the city of the great King.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.2",
            "verseOrgIds": [
              "PSA.48.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "God is known in her palaces for a refuge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.3",
            "verseOrgIds": [
              "PSA.48.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For, lo, the kings were assembled, they passed by together.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.4",
            "verseOrgIds": [
              "PSA.48.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "They saw",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it, and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.5",
                "verseOrgIds": [
                  "PSA.48.6"
                ]
              }
            }
          ]
        },
        {
          "text": "so they marvelled; they were troubled,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.5",
                "verseOrgIds": [
                  "PSA.48.6"
                ]
              }
            }
          ]
        },
        {
          "text": "hasted away.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.5",
            "verseOrgIds": [
              "PSA.48.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fear took hold upon them there,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.6",
                "verseOrgIds": [
                  "PSA.48.7"
                ]
              }
            }
          ]
        },
        {
          "text": "pain, as of a woman in travail.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.6",
            "verseOrgIds": [
              "PSA.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou breakest the ships of Tarshish with an east wind.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.7",
            "verseOrgIds": [
              "PSA.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "As we have heard, so have we seen in the city of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.8",
                "verseOrgIds": [
                  "PSA.48.9"
                ]
              }
            }
          ]
        },
        {
          "text": "of hosts, in the city of our God: God will establish it for ever. Selah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.8",
            "verseOrgIds": [
              "PSA.48.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "We have thought of thy lovingkindness, O God, in the midst of thy temple.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.9",
            "verseOrgIds": [
              "PSA.48.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "According to thy name, O God, so",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.10",
                "verseOrgIds": [
                  "PSA.48.11"
                ]
              }
            }
          ]
        },
        {
          "text": "thy praise unto the ends of the earth: thy right hand is full of righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.10",
            "verseOrgIds": [
              "PSA.48.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let mount Zion rejoice, let the daughters of Judah be glad, because of thy judgments.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.11",
            "verseOrgIds": [
              "PSA.48.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walk about Zion, and go round about her: tell the towers thereof.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.12",
            "verseOrgIds": [
              "PSA.48.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mark ye well her bulwarks, consider her palaces; that ye may tell",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.13",
                "verseOrgIds": [
                  "PSA.48.14"
                ]
              }
            }
          ]
        },
        {
          "text": "to the generation following.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.13",
            "verseOrgIds": [
              "PSA.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "For this God",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.14",
            "verseOrgIds": [
              "PSA.48.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.14",
                "verseOrgIds": [
                  "PSA.48.15"
                ]
              }
            }
          ]
        },
        {
          "text": "our God for ever and ever: he will be our guide",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.14",
            "verseOrgIds": [
              "PSA.48.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "PSA.48.14",
                "verseOrgIds": [
                  "PSA.48.15"
                ]
              }
            }
          ]
        },
        {
          "text": "unto death.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.48.14",
            "verseOrgIds": [
              "PSA.48.15"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.49",
    "number": "49",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.47",
    "number": "47",
