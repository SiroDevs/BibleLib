          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou makest darkness, and it is night: wherein all the beasts of the forest do creep",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.20",
            "verseOrgIds": [
              "PSA.104.20"
