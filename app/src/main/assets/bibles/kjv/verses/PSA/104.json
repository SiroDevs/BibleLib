  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "104",
        "style": "c",
        "sid": "PSA 104"
      },
      "items": [
        {
          "text": "104",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 104:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bless the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.1",
                "verseOrgIds": [
                  "PSA.104.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", O my soul. O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.1",
                "verseOrgIds": [
                  "PSA.104.1"
                ]
              }
            }
          ]
        },
        {
          "text": "my God, thou art very great; thou art clothed with honour and majesty.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 104:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who coverest",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "thyself",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.2",
                "verseOrgIds": [
                  "PSA.104.2"
                ]
              }
            }
          ]
        },
        {
          "text": "with light as",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.2",
                "verseOrgIds": [
                  "PSA.104.2"
                ]
              }
            }
          ]
        },
        {
          "text": "a garment: who stretchest out the heavens like a curtain:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 104:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who layeth the beams of his chambers in the waters: who maketh the clouds his chariot: who walketh upon the wings of the wind:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 104:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who maketh his angels spirits; his ministers a flaming fire:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 104:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "Who",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.5",
                "verseOrgIds": [
                  "PSA.104.5"
                ]
              }
            }
          ]
        },
        {
          "text": "laid the foundations of the earth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.5",
                "verseOrgIds": [
                  "PSA.104.5"
                ]
              }
            }
          ]
        },
        {
          "text": "it should not be removed for ever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 104:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou coveredst it with the deep as",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.6",
                "verseOrgIds": [
                  "PSA.104.6"
                ]
              }
            }
          ]
        },
        {
          "text": "a garment: the waters stood above the mountains.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 104:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "At thy rebuke they fled; at the voice of thy thunder they hasted away.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 104:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "They go up by the mountains; they go down by the valleys unto the place which thou hast founded for them.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 104:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou hast set a bound that they may not pass over; that they turn not again to cover the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 104:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He sendeth the springs into the valleys,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.10",
                "verseOrgIds": [
                  "PSA.104.10"
                ]
              }
            }
          ]
        },
        {
          "text": "run among the hills.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 104:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "They give drink to every beast of the field: the wild asses quench their thirst.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 104:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "By them shall the fowls of the heaven have their habitation,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.12",
                "verseOrgIds": [
                  "PSA.104.12"
                ]
              }
            }
          ]
        },
        {
          "text": "sing among the branches.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 104:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "He watereth the hills from his chambers: the earth is satisfied with the fruit of thy works.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 104:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "He causeth the grass to grow for the cattle, and herb for the service of man: that he may bring forth food out of the earth;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 104:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "And wine",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.15",
                "verseOrgIds": [
                  "PSA.104.15"
                ]
              }
            }
          ]
        },
        {
          "text": "maketh glad the heart of man,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.15",
                "verseOrgIds": [
                  "PSA.104.15"
                ]
              }
            }
          ]
        },
        {
          "text": "oil to make",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "his",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.15",
                "verseOrgIds": [
                  "PSA.104.15"
                ]
              }
            }
          ]
        },
        {
          "text": "face to shine, and bread",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.15",
                "verseOrgIds": [
                  "PSA.104.15"
                ]
              }
            }
          ]
        },
        {
          "text": "strengtheneth man's heart.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 104:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "The trees of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.16",
                "verseOrgIds": [
                  "PSA.104.16"
                ]
              }
            }
          ]
        },
        {
          "text": "are full",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "of sap;",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.16",
                "verseOrgIds": [
                  "PSA.104.16"
                ]
              }
            }
          ]
        },
        {
          "text": "the cedars of Lebanon, which he hath planted;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 104:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Where the birds make their nests:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as for",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.17",
                "verseOrgIds": [
                  "PSA.104.17"
                ]
              }
            }
          ]
        },
        {
          "text": "the stork, the fir trees",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.104.17",
                "verseOrgIds": [
                  "PSA.104.17"
                ]
              }
            }
          ]
        },
        {
          "text": "her house.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.17",
            "verseOrgIds": [
              "PSA.104.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
