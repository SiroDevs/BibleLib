          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Not unto us, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.1",
                "verseOrgIds": [
                  "PSA.115.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", not unto us, but unto thy name give glory, for thy mercy,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.1",
                "verseOrgIds": [
                  "PSA.115.1"
                ]
              }
            }
          ]
        },
        {
          "text": "for thy truth's sake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
