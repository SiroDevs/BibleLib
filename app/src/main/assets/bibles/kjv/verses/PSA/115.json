              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.2",
                "verseOrgIds": [
                  "PSA.115.2"
                ]
              }
            }
          ]
        },
        {
          "text": "now their God?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
