          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.3",
                "verseOrgIds": [
                  "PSA.115.3"
                ]
              }
            }
          ]
        },
        {
          "text": "in the heavens: he hath done whatsoever he hath pleased.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
