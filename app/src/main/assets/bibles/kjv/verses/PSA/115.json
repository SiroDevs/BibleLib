          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wherefore should the heathen say, Where",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        },
