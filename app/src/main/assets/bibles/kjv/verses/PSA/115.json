            "number": "5",
            "style": "v",
            "sid": "PSA 115:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have mouths, but they speak not: eyes have they, but they see not:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
