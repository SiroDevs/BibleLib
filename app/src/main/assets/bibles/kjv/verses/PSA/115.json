            "number": "6",
            "style": "v",
            "sid": "PSA 115:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have ears, but they hear not: noses have they, but they smell not:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
