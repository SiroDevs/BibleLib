  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "94",
        "style": "c",
        "sid": "PSA 94"
      },
      "items": [
        {
          "text": "94",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 94:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.1",
                "verseOrgIds": [
                  "PSA.94.1"
                ]
              }
            }
          ]
        },
        {
          "text": "God, to whom vengeance belongeth; O God, to whom vengeance belongeth, shew thyself.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.1",
            "verseOrgIds": [
              "PSA.94.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 94:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lift up thyself, thou judge of the earth: render a reward to the proud.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.2",
            "verseOrgIds": [
              "PSA.94.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 94:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.3",
                "verseOrgIds": [
                  "PSA.94.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", how long shall the wicked, how long shall the wicked triumph?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.3",
            "verseOrgIds": [
              "PSA.94.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 94:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "How long",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.4",
                "verseOrgIds": [
                  "PSA.94.4"
                ]
              }
            }
          ]
        },
        {
          "text": "shall they utter",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.4",
                "verseOrgIds": [
                  "PSA.94.4"
                ]
              }
            }
          ]
        },
        {
          "text": "speak hard things?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.4",
                "verseOrgIds": [
                  "PSA.94.4"
                ]
              }
            }
          ]
        },
        {
          "text": "all the workers of iniquity boast themselves?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.4",
            "verseOrgIds": [
              "PSA.94.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 94:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "They break in pieces thy people, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.5",
                "verseOrgIds": [
                  "PSA.94.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", and afflict thine heritage.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.5",
            "verseOrgIds": [
              "PSA.94.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 94:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "They slay the widow and the stranger, and murder the fatherless.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.6",
            "verseOrgIds": [
              "PSA.94.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 94:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yet they say, The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.7",
                "verseOrgIds": [
                  "PSA.94.7"
                ]
              }
            }
          ]
        },
        {
          "text": "shall not see, neither shall the God of Jacob regard",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.7",
                "verseOrgIds": [
                  "PSA.94.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.7",
            "verseOrgIds": [
              "PSA.94.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 94:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Understand, ye brutish among the people: and",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "ye",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.8",
                "verseOrgIds": [
                  "PSA.94.8"
                ]
              }
            }
          ]
        },
        {
          "text": "fools, when will ye be wise?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.8",
            "verseOrgIds": [
              "PSA.94.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 94:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that planted the ear, shall he not hear? he that formed the eye, shall he not see?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.9",
            "verseOrgIds": [
              "PSA.94.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 94:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that chastiseth the heathen, shall not he correct? he that teacheth man knowledge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall not he know",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.10",
                "verseOrgIds": [
                  "PSA.94.10"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.10",
            "verseOrgIds": [
              "PSA.94.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 94:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.11",
                "verseOrgIds": [
                  "PSA.94.11"
                ]
              }
            }
          ]
        },
        {
          "text": "knoweth the thoughts of man, that they",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.11",
                "verseOrgIds": [
                  "PSA.94.11"
                ]
              }
            }
          ]
        },
        {
          "text": "vanity.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.11",
            "verseOrgIds": [
              "PSA.94.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 94:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Blessed",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.12",
                "verseOrgIds": [
                  "PSA.94.12"
                ]
              }
            }
          ]
        },
        {
          "text": "the man whom thou chastenest, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.12",
                "verseOrgIds": [
                  "PSA.94.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", and teachest him out of thy law;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.12",
            "verseOrgIds": [
              "PSA.94.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 94:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "That thou mayest give him rest from the days of adversity, until the pit be digged for the wicked.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.13",
            "verseOrgIds": [
              "PSA.94.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 94:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.14",
                "verseOrgIds": [
                  "PSA.94.14"
                ]
              }
            }
          ]
        },
        {
          "text": "will not cast off his people, neither will he forsake his inheritance.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.14",
            "verseOrgIds": [
              "PSA.94.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 94:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "But judgment shall return unto righteousness: and all the upright in heart shall follow it.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.15",
            "verseOrgIds": [
              "PSA.94.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 94:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Who will rise up for me against the evildoers?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.16",
            "verseOrgIds": [
              "PSA.94.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.16",
                "verseOrgIds": [
                  "PSA.94.16"
                ]
              }
            }
          ]
        },
        {
          "text": "who will stand up for me against the workers of iniquity?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.16",
            "verseOrgIds": [
              "PSA.94.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 94:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unless the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
            "verseOrgIds": [
              "PSA.94.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.17",
                "verseOrgIds": [
                  "PSA.94.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
            "verseOrgIds": [
              "PSA.94.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "had been",
              "type": "text",
              "attrs": {
                "verseId": "PSA.94.17",
                "verseOrgIds": [
                  "PSA.94.17"
                ]
              }
            }
          ]
        },
        {
          "text": "my help, my soul had almost dwelt in silence.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.94.17",
