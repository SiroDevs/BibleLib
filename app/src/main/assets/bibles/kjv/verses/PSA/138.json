            "style": "add"
          },
          "items": [
            {
              "text": "A Psalm",
              "type": "text"
            }
          ]
        },
        {
          "text": "of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 138:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will praise thee with my whole heart: before the gods will I sing praise unto thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.1",
            "verseOrgIds": [
              "PSA.138.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 138:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will worship toward thy holy temple, and praise thy name for thy lovingkindness and for thy truth: for thou hast magnified thy word above all thy name.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.2",
            "verseOrgIds": [
              "PSA.138.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 138:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "In the day when I cried thou answeredst me,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.3",
                "verseOrgIds": [
                  "PSA.138.3"
                ]
              }
            }
          ]
        },
        {
          "text": "strengthenedst me",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.3",
                "verseOrgIds": [
                  "PSA.138.3"
                ]
              }
            }
          ]
        },
        {
          "text": "strength in my soul.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.3",
            "verseOrgIds": [
              "PSA.138.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 138:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "All the kings of the earth shall praise thee, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.4",
                "verseOrgIds": [
                  "PSA.138.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", when they hear the words of thy mouth.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.4",
            "verseOrgIds": [
              "PSA.138.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 138:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yea, they shall sing in the ways of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.5",
                "verseOrgIds": [
                  "PSA.138.5"
                ]
              }
            }
          ]
        },
        {
          "text": ": for great",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.5",
                "verseOrgIds": [
                  "PSA.138.5"
                ]
              }
            }
          ]
        },
        {
          "text": "the glory of the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.5",
                "verseOrgIds": [
                  "PSA.138.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.5",
            "verseOrgIds": [
              "PSA.138.5"
            ]
          }
        }
      ]
    },
