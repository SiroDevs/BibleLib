          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        },
        {
          "name": "char",
