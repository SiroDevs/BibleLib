          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.6",
                "verseOrgIds": [
                  "PSA.138.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "be",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.6",
                "verseOrgIds": [
                  "PSA.138.6"
                ]
              }
            }
          ]
        },
        {
          "text": "high, yet hath he respect unto the lowly: but the proud he knoweth afar off.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.6",
            "verseOrgIds": [
              "PSA.138.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 138:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Though I walk in the midst of trouble, thou wilt revive me: thou shalt stretch forth thine hand against the wrath of mine enemies, and thy right hand shall save me.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.7",
            "verseOrgIds": [
              "PSA.138.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 138:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": "will perfect",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that which",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": "concerneth me: thy mercy, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "endureth",
              "type": "text",
              "attrs": {
                "verseId": "PSA.138.8",
                "verseOrgIds": [
                  "PSA.138.8"
                ]
              }
            }
          ]
        },
        {
          "text": "for ever: forsake not the works of thine own hands.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.138.8",
            "verseOrgIds": [
              "PSA.138.8"
            ]
          }
        }
      ]
    }
