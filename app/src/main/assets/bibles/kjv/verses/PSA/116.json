              "type": "text",
              "attrs": {
                "verseId": "PSA.116.2",
                "verseOrgIds": [
                  "PSA.116.2"
                ]
              }
            }
          ]
        },
        {
          "text": "as long as I live.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
