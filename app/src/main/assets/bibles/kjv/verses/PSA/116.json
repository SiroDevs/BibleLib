                "verseId": "PSA.116.4",
                "verseOrgIds": [
                  "PSA.116.4"
                ]
              }
            }
          ]
        },
        {
          "text": "; O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.4",
                "verseOrgIds": [
                  "PSA.116.4"
                ]
              }
            }
          ]
        },
