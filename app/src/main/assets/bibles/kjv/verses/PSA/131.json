                "verseOrgIds": [
                  "PSA.131.2"
                ]
              }
            }
          ]
        },
        {
          "text": "even as a weaned child.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
