{
  "id": "PSA.5",
  "number": "5",
  "bookId": "PSA",
  "reference": "Psalms 5",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PSA 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "To the chief Musician upon Nehiloth, A Psalm of David.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Give ear to my words, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.1",
                "verseOrgIds": [
                  "PSA.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", consider my meditation.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.1",
            "verseOrgIds": [
              "PSA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hearken unto the voice of my cry, my King, and my God: for unto thee will I pray.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.2",
            "verseOrgIds": [
              "PSA.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "My voice shalt thou hear in the morning, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.3",
                "verseOrgIds": [
                  "PSA.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "; in the morning will I direct",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "my prayer",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.3",
                "verseOrgIds": [
                  "PSA.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "unto thee, and will look up.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.3",
            "verseOrgIds": [
              "PSA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.4",
                "verseOrgIds": [
                  "PSA.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "not a God that hath pleasure in wickedness: neither shall evil dwell with thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.4",
            "verseOrgIds": [
              "PSA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "The foolish shall not stand in thy sight: thou hatest all workers of iniquity.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.5",
            "verseOrgIds": [
              "PSA.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thou shalt destroy them that speak leasing: the",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.6",
                "verseOrgIds": [
                  "PSA.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "will abhor the bloody and deceitful man.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.6",
            "verseOrgIds": [
              "PSA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "But as for me, I will come",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "into",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.7",
                "verseOrgIds": [
                  "PSA.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": "thy house in the multitude of thy mercy:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.7",
                "verseOrgIds": [
                  "PSA.5.8"
                ]
              }
            }
          ]
        },
        {
          "text": "in thy fear will I worship toward thy holy temple.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.7",
            "verseOrgIds": [
              "PSA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lead me, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.8",
                "verseOrgIds": [
                  "PSA.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", in thy righteousness because of mine enemies; make thy way straight before my face.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.8",
            "verseOrgIds": [
              "PSA.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "For",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.9",
                "verseOrgIds": [
                  "PSA.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "no faithfulness in their mouth; their inward part",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.9",
                "verseOrgIds": [
                  "PSA.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "very wickedness; their throat",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.9",
                "verseOrgIds": [
                  "PSA.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "an open sepulchre; they flatter with their tongue.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.9",
            "verseOrgIds": [
              "PSA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Destroy thou them, O God; let them fall by their own counsels; cast them out in the multitude of their transgressions; for they have rebelled against thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.10",
            "verseOrgIds": [
              "PSA.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "But let all those that put their trust in thee rejoice: let them ever shout for joy, because thou defendest them: let them also that love thy name be joyful in thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.11",
            "verseOrgIds": [
              "PSA.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "For thou,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.12",
                "verseOrgIds": [
                  "PSA.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", wilt bless the righteous; with favour wilt thou compass him as",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with",
              "type": "text",
              "attrs": {
                "verseId": "PSA.5.12",
                "verseOrgIds": [
                  "PSA.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "a shield.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.5.12",
            "verseOrgIds": [
              "PSA.5.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.6",
    "number": "6",
    "bookId": "PSA"
  },
