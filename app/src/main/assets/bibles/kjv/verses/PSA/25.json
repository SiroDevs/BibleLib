            "sid": "PSA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "The troubles of my heart are enlarged:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.17",
            "verseOrgIds": [
              "PSA.25.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "O",
              "type": "text",
              "attrs": {
