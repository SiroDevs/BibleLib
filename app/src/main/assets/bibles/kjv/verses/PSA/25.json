                "verseId": "PSA.25.16",
                "verseOrgIds": [
                  "PSA.25.16"
                ]
              }
            }
          ]
        },
        {
          "text": "desolate and afflicted.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
