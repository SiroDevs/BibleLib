          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let integrity and uprightness preserve me; for I wait on thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.21",
            "verseOrgIds": [
              "PSA.25.21"
            ]
          }
        }
