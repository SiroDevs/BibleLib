                "verseOrgIds": [
                  "PSA.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "bring thou me out of my distresses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.17",
            "verseOrgIds": [
              "PSA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Look upon mine affliction and my pain; and forgive all my sins.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.18",
            "verseOrgIds": [
              "PSA.25.18"
            ]
          }
        }
      ]
    },
    {
