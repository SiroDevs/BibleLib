              }
            }
          ]
        },
        {
          "text": "; for he shall pluck my feet out of the net.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.15",
            "verseOrgIds": [
              "PSA.25.15"
            ]
          }
        }
