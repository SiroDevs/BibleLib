          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Turn thee unto me, and have mercy upon me; for I",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.16",
            "verseOrgIds": [
              "PSA.25.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
