          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Consider mine enemies; for they are many; and they hate me with cruel hatred.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.19",
            "verseOrgIds": [
              "PSA.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O keep my soul, and deliver me: let me not be ashamed; for I put my trust in thee.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.20",
            "verseOrgIds": [
              "PSA.25.20"
            ]
          }
        }
      ]
    },
    {
