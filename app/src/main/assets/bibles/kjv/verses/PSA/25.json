          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lead me in thy truth, and teach me: for thou",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
