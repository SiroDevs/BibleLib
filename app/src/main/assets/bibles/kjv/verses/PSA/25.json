          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.5",
                "verseOrgIds": [
                  "PSA.25.5"
                ]
              }
            }
          ]
        },
        {
          "text": "the God of my salvation; on thee do I wait all the day.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
