          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PSA.98.2",
                "verseOrgIds": [
                  "PSA.98.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hath made known his salvation: his righteousness hath he openly shewed in the sight of the heathen.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.2",
            "verseOrgIds": [
              "PSA.98.2"
            ]
          }
        }
      ]
    },
