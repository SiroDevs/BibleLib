                "verseId": "PSA.98.1",
                "verseOrgIds": [
                  "PSA.98.1"
                ]
              }
            }
          ]
        },
        {
          "text": "a new song; for he hath done marvellous things: his right hand, and his holy arm, hath gotten him the victory.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.98.1",
            "verseOrgIds": [
              "PSA.98.1"
            ]
