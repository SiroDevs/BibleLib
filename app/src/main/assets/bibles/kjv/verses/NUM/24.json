                "verseOrgIds": [
                  "NUM.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "from the coast of Chittim, and shall afflict Asshur, and shall afflict Eber, and he also shall perish for ever.",
          "type": "text",
          "attrs": {
