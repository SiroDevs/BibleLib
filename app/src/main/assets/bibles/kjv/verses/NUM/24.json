          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "And ships",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
