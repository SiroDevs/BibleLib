                ]
              }
            }
          ]
        },
        {
          "text": "that he perish for ever.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        },
