            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "SNG.5.13",
                "verseOrgIds": [
                  "SNG.5.13"
                ]
              }
            }
          ]
        },
        {
