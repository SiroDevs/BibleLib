          "type": "text",
          "attrs": {
            "verseId": "SNG.5.13",
            "verseOrgIds": [
              "SNG.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as",
              "type": "text",
              "attrs": {
                "verseId": "SNG.5.13",
                "verseOrgIds": [
                  "SNG.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sweet flowers: his lips",
          "type": "text",
          "attrs": {
            "verseId": "SNG.5.13",
            "verseOrgIds": [
              "SNG.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
