          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.1",
            "verseOrgIds": [
              "SNG.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.1",
                "verseOrgIds": [
                  "SNG.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "the rose of Sharon,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.1",
            "verseOrgIds": [
              "SNG.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.1",
                "verseOrgIds": [
                  "SNG.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "the lily of the valleys.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.1",
            "verseOrgIds": [
              "SNG.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "As the lily among thorns, so",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.2",
                "verseOrgIds": [
                  "SNG.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "my love among the daughters.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.2",
            "verseOrgIds": [
              "SNG.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "As the apple tree among the trees of the wood, so",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.3",
                "verseOrgIds": [
                  "SNG.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "my beloved among the sons. I sat down under his shadow with great delight, and his fruit",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.3",
                "verseOrgIds": [
                  "SNG.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sweet to my taste.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.3",
            "verseOrgIds": [
              "SNG.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "He brought me to the banqueting house, and his banner over me",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.4",
                "verseOrgIds": [
                  "SNG.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "love.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.4",
            "verseOrgIds": [
              "SNG.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Stay me with flagons, comfort me with apples: for I",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.5",
                "verseOrgIds": [
                  "SNG.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sick of love.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.5",
            "verseOrgIds": [
              "SNG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "His left hand",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.6",
                "verseOrgIds": [
                  "SNG.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "under my head, and his right hand doth embrace me.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.6",
            "verseOrgIds": [
              "SNG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "I charge you, O ye daughters of Jerusalem, by the roes, and by the hinds of the field, that ye stir not up, nor awake",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "my",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.7",
                "verseOrgIds": [
                  "SNG.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "love, till he please.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.7",
            "verseOrgIds": [
              "SNG.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ The voice of my beloved! behold, he cometh leaping upon the mountains, skipping upon the hills.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.8",
            "verseOrgIds": [
              "SNG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "My beloved is like a roe or a young hart: behold, he standeth behind our wall, he looketh forth at the windows, shewing himself through the lattice.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.9",
            "verseOrgIds": [
              "SNG.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "My beloved spake, and said unto me, Rise up, my love, my fair one, and come away.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.10",
            "verseOrgIds": [
              "SNG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "For, lo, the winter is past, the rain is over",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.11",
                "verseOrgIds": [
                  "SNG.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gone;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.11",
            "verseOrgIds": [
              "SNG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "SNG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The flowers appear on the earth; the time of the singing",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "of birds",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.12",
                "verseOrgIds": [
                  "SNG.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "is come, and the voice of the turtle is heard in our land;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.12",
            "verseOrgIds": [
              "SNG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "SNG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fig tree putteth forth her green figs, and the vines",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.13",
                "verseOrgIds": [
                  "SNG.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "the tender grape give a",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "good",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.13",
                "verseOrgIds": [
                  "SNG.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "smell. Arise, my love, my fair one, and come away.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.13",
            "verseOrgIds": [
              "SNG.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "SNG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ O my dove,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that art",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.14",
                "verseOrgIds": [
                  "SNG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "in the clefts of the rock, in the secret",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "places",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.14",
                "verseOrgIds": [
                  "SNG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "of the stairs, let me see thy countenance, let me hear thy voice; for sweet",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.14",
                "verseOrgIds": [
                  "SNG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "thy voice, and thy countenance",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.14",
                "verseOrgIds": [
                  "SNG.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "comely.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.14",
            "verseOrgIds": [
              "SNG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "SNG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Take us the foxes, the little foxes, that spoil the vines: for our vines",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.15",
            "verseOrgIds": [
              "SNG.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "have",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.15",
                "verseOrgIds": [
                  "SNG.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "tender grapes.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.15",
            "verseOrgIds": [
              "SNG.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "SNG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "¶ My beloved",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.16",
            "verseOrgIds": [
              "SNG.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.16",
                "verseOrgIds": [
                  "SNG.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "mine, and I",
          "type": "text",
          "attrs": {
            "verseId": "SNG.2.16",
            "verseOrgIds": [
              "SNG.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "SNG.2.16",
                "verseOrgIds": [
                  "SNG.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "his: he feedeth among the lilies.",
