          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thy navel",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is like",
