              "attrs": {
                "verseId": "SNG.7.2",
                "verseOrgIds": [
                  "SNG.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "a round goblet,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.2",
            "verseOrgIds": [
              "SNG.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "which",
