          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "How beautiful are thy feet with shoes, O prince's daughter! the joints of thy thighs",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "SNG.7.1",
                "verseOrgIds": [
                  "SNG.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "like jewels, the work of the hands of a cunning workman.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.7.1",
            "verseOrgIds": [
              "SNG.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
