            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "GEN.2.14",
                "verseOrgIds": [
                  "GEN.2.14"
                ]
              }
            }
          ]
        },
