          "text": "Gihon: the same",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.13",
            "verseOrgIds": [
              "GEN.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "GEN.2.13",
                "verseOrgIds": [
                  "GEN.2.13"
                ]
              }
            }
          ]
        },
