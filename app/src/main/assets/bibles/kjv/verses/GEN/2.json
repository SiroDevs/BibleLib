          "text": "Hiddekel: that",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "GEN.2.14",
                "verseOrgIds": [
                  "GEN.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "it which goeth toward the east of Assyria. And the fourth river",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "GEN.2.14",
                "verseOrgIds": [
                  "GEN.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Euphrates.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.14",
            "verseOrgIds": [
              "GEN.2.14"
            ]
          }
        },
        {
