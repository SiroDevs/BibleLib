            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "GEN.43.32",
                "verseOrgIds": [
                  "GEN.43.32"
                ]
              }
            }
          ]
        },
        {
          "text": "an abomination unto the Egyptians.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.32",
            "verseOrgIds": [
              "GEN.43.32"
            ]
          }
        },
