              "text": "where",
              "type": "text",
              "attrs": {
                "verseId": "GEN.43.30",
                "verseOrgIds": [
                  "GEN.43.30"
                ]
              }
            }
          ]
        },
        {
          "text": "to weep; and he entered into",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.30",
            "verseOrgIds": [
              "GEN.43.30"
            ]
          }
        },
        {
          "name": "char",
