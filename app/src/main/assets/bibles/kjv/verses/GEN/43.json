          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he said, Peace",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.23",
            "verseOrgIds": [
              "GEN.43.23"
            ]
          }
        },
        {
