                "verseId": "GEN.16.16",
                "verseOrgIds": [
                  "GEN.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "fourscore and six years old, when Hagar bare Ishmael to Abram.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
