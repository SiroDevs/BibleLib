          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
