              "type": "text",
              "attrs": {
                "verseId": "GEN.13.18",
                "verseOrgIds": [
                  "GEN.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "in Hebron, and built there an altar unto the",
          "type": "text",
          "attrs": {
