          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LAM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "I called for my lovers,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.19",
            "verseOrgIds": [
              "LAM.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "but",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.19",
                "verseOrgIds": [
                  "LAM.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "they deceived me: my priests and mine elders gave up the ghost in the city, while they sought their meat to relieve their souls.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.19",
            "verseOrgIds": [
              "LAM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LAM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Behold, O",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.20",
                "verseOrgIds": [
                  "LAM.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": "; for I",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.20",
                "verseOrgIds": [
                  "LAM.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": "in distress: my bowels are troubled; mine heart is turned within me; for I have grievously rebelled: abroad the sword bereaveth, at home",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.20",
                "verseOrgIds": [
                  "LAM.1.20"
                ]
              }
            }
          ]
        },
