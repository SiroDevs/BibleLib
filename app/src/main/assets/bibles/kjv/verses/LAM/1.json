            "verseOrgIds": [
              "LAM.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "should be",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.17",
                "verseOrgIds": [
                  "LAM.1.17"
                ]
              }
            }
          ]
