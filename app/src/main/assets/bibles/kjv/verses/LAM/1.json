          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "For these",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
