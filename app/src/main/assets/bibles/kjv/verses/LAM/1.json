          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LAM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zion spreadeth forth her hands,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.17",
            "verseOrgIds": [
