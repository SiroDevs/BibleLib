          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        },
        {
