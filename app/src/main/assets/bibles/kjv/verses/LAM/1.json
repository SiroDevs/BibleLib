            "sid": "LAM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Lord hath trodden under foot all my mighty",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "men",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.15",
                "verseOrgIds": [
                  "LAM.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "in the midst of me: he hath called an assembly against me to crush my young men: the Lord hath trodden the virgin, the daughter of Judah,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.15",
            "verseOrgIds": [
              "LAM.1.15"
            ]
          }
        },
