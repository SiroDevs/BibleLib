          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let all their wickedness come before thee; and do unto them, as thou hast done unto me for all my transgressions: for my sighs",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        },
