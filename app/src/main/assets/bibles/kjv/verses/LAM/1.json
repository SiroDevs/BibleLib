              "attrs": {
                "verseId": "LAM.1.22",
                "verseOrgIds": [
                  "LAM.1.22"
                ]
              }
            }
          ]
        },
        {
          "text": "many, and my heart",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.22",
            "verseOrgIds": [
              "LAM.1.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
