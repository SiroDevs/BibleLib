          "text": "thou hast called, and they shall be like unto me.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        },
