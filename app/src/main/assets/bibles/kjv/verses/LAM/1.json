          "text": "as death.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.20",
            "verseOrgIds": [
              "LAM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LAM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "They have heard that I sigh:",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.21",
                "verseOrgIds": [
                  "LAM.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "none to comfort me: all mine enemies have heard of my trouble; they are glad that thou hast done",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it:",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.21",
                "verseOrgIds": [
                  "LAM.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "thou wilt bring the day",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.21",
            "verseOrgIds": [
              "LAM.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "that",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.21",
                "verseOrgIds": [
                  "LAM.1.21"
                ]
              }
            }
          ]
        },
