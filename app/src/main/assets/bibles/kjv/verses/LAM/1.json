              "text": "things",
              "type": "text",
              "attrs": {
                "verseId": "LAM.1.16",
                "verseOrgIds": [
                  "LAM.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "I weep; mine eye, mine eye runneth down with water, because the comforter that should relieve my soul is far from me: my children are desolate, because the enemy prevailed.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.1.16",
            "verseOrgIds": [
              "LAM.1.16"
            ]
          }
        },
