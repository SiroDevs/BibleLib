{
  "id": "PRO.8",
  "number": "8",
  "bookId": "PRO",
  "reference": "Proverbs 8",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "PRO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doth not wisdom cry? and understanding put forth her voice?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.1",
            "verseOrgIds": [
              "PRO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "She standeth in the top of high places, by the way in the places of the paths.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.2",
            "verseOrgIds": [
              "PRO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "She crieth at the gates, at the entry of the city, at the coming in at the doors.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.3",
            "verseOrgIds": [
              "PRO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unto you, O men, I call; and my voice",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.4",
                "verseOrgIds": [
                  "PRO.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "to the sons of man.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.4",
            "verseOrgIds": [
              "PRO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ye simple, understand wisdom: and, ye fools, be ye of an understanding heart.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.5",
            "verseOrgIds": [
              "PRO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear; for I will speak of excellent things; and the opening of my lips",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall be",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.6",
                "verseOrgIds": [
                  "PRO.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": "right things.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.6",
            "verseOrgIds": [
              "PRO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "For my mouth shall speak truth; and wickedness",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.7",
                "verseOrgIds": [
                  "PRO.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "an abomination to my lips.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.7",
            "verseOrgIds": [
              "PRO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "All the words of my mouth",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.8",
                "verseOrgIds": [
                  "PRO.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "in righteousness;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.8",
                "verseOrgIds": [
                  "PRO.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nothing froward or perverse in them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.8",
            "verseOrgIds": [
              "PRO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "They",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.9",
                "verseOrgIds": [
                  "PRO.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "all plain to him that understandeth, and right to them that find knowledge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.9",
            "verseOrgIds": [
              "PRO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Receive my instruction, and not silver; and knowledge rather than choice gold.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.10",
            "verseOrgIds": [
              "PRO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "For wisdom",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.11",
                "verseOrgIds": [
                  "PRO.8.11"
                ]
              }
            }
          ]
        },
        {
          "text": "better than rubies; and all the things that may be desired are not to be compared to it.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.11",
            "verseOrgIds": [
              "PRO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I wisdom dwell with prudence, and find out knowledge of witty inventions.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.12",
            "verseOrgIds": [
              "PRO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fear of the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.13",
                "verseOrgIds": [
                  "PRO.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.13",
                "verseOrgIds": [
                  "PRO.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "to hate evil: pride, and arrogancy, and the evil way, and the froward mouth, do I hate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.13",
            "verseOrgIds": [
              "PRO.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Counsel",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.14",
                "verseOrgIds": [
                  "PRO.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "mine, and sound wisdom: I",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "am",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.14",
                "verseOrgIds": [
                  "PRO.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": "understanding; I have strength.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.14",
            "verseOrgIds": [
              "PRO.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "By me kings reign, and princes decree justice.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.15",
            "verseOrgIds": [
              "PRO.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "By me princes rule, and nobles,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "even",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.16",
                "verseOrgIds": [
                  "PRO.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "all the judges of the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.16",
            "verseOrgIds": [
              "PRO.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "I love them that love me; and those that seek me early shall find me.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.17",
            "verseOrgIds": [
              "PRO.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riches and honour",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.18",
                "verseOrgIds": [
                  "PRO.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "with me;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "yea",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.18",
                "verseOrgIds": [
                  "PRO.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", durable riches and righteousness.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.18",
            "verseOrgIds": [
              "PRO.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "My fruit",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.19",
                "verseOrgIds": [
                  "PRO.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "better than gold, yea, than fine gold; and my revenue than choice silver.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.19",
            "verseOrgIds": [
              "PRO.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I lead in the way of righteousness, in the midst of the paths of judgment:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.20",
            "verseOrgIds": [
              "PRO.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "That I may cause those that love me to inherit substance; and I will fill their treasures.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.21",
            "verseOrgIds": [
              "PRO.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "The",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.22",
                "verseOrgIds": [
                  "PRO.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "possessed me in the beginning of his way, before his works of old.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.22",
            "verseOrgIds": [
              "PRO.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I was set up from everlasting, from the beginning, or ever the earth was.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.23",
            "verseOrgIds": [
              "PRO.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "When",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there were",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.24",
                "verseOrgIds": [
                  "PRO.8.24"
                ]
              }
            }
          ]
        },
        {
          "text": "no depths, I was brought forth; when",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "there were",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.24",
                "verseOrgIds": [
                  "PRO.8.24"
                ]
              }
            }
          ]
        },
        {
          "text": "no fountains abounding with water.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.24",
            "verseOrgIds": [
              "PRO.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Before the mountains were settled, before the hills was I brought forth:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.25",
            "verseOrgIds": [
              "PRO.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "While as yet he had not made the earth, nor the fields, nor the highest part of the dust of the world.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.26",
            "verseOrgIds": [
              "PRO.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "When he prepared the heavens, I",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "was",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.27",
                "verseOrgIds": [
                  "PRO.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "there: when he set a compass upon the face of the depth:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.27",
            "verseOrgIds": [
              "PRO.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "When he established the clouds above: when he strengthened the fountains of the deep:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.28",
            "verseOrgIds": [
              "PRO.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "When he gave to the sea his decree, that the waters should not pass his commandment: when he appointed the foundations of the earth:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.29",
            "verseOrgIds": [
              "PRO.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I was by him,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "as",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.30",
                "verseOrgIds": [
                  "PRO.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": "one brought up",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with him:",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.30",
                "verseOrgIds": [
                  "PRO.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": "and I was daily",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "his",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.30",
                "verseOrgIds": [
                  "PRO.8.30"
                ]
              }
            }
          ]
        },
        {
          "text": "delight, rejoicing always before him;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.30",
            "verseOrgIds": [
              "PRO.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rejoicing in the habitable part of his earth; and my delights",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "were",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.31",
                "verseOrgIds": [
                  "PRO.8.31"
                ]
              }
            }
          ]
        },
        {
          "text": "with the sons of men.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.31",
            "verseOrgIds": [
              "PRO.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now therefore hearken unto me, O ye children: for blessed",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are they that",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.32",
                "verseOrgIds": [
                  "PRO.8.32"
                ]
              }
            }
          ]
        },
        {
          "text": "keep my ways.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
              "PRO.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hear instruction, and be wise, and refuse it not.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.33",
            "verseOrgIds": [
              "PRO.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Blessed",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.34",
                "verseOrgIds": [
                  "PRO.8.34"
                ]
              }
            }
          ]
        },
        {
          "text": "the man that heareth me, watching daily at my gates, waiting at the posts of my doors.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.34",
            "verseOrgIds": [
              "PRO.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "PRO 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "For whoso findeth me findeth life, and shall obtain favour of the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.8.35",
                "verseOrgIds": [
                  "PRO.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.35",
            "verseOrgIds": [
              "PRO.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "PRO 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "But he that sinneth against me wrongeth his own soul: all they that hate me love death.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.36",
            "verseOrgIds": [
              "PRO.8.36"
            ]
          }
        }
      ]
    }
