{
  "id": "PRO.17",
  "number": "17",
  "bookId": "PRO",
  "reference": "Proverbs 17",
  "copyright": "PUBLIC DOMAIN except in the United Kingdom, where a Crown Copyright applies to printing the KJV. See http://www.cambridge.org/about-us/who-we-are/queens-printers-patent",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "PRO 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.1",
                "verseOrgIds": [
                  "PRO.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "a dry morsel, and quietness therewith, than an house full of sacrifices",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "with",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.1",
                "verseOrgIds": [
                  "PRO.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "strife.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wise servant shall have rule over a son that causeth shame, and shall have part of the inheritance among the brethren.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.2",
            "verseOrgIds": [
              "PRO.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The fining pot",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.3",
                "verseOrgIds": [
                  "PRO.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "for silver, and the furnace for gold: but the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.3",
                "verseOrgIds": [
                  "PRO.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "trieth the hearts.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wicked doer giveth heed to false lips;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.4",
                "verseOrgIds": [
                  "PRO.17.4"
                ]
              }
            }
          ]
        },
        {
          "text": "a liar giveth ear to a naughty tongue.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoso mocketh the poor reproacheth his Maker:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.5",
                "verseOrgIds": [
                  "PRO.17.5"
                ]
              }
            }
          ]
        },
        {
          "text": "he that is glad at calamities shall not be unpunished.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.5",
            "verseOrgIds": [
              "PRO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Children's children",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.6",
                "verseOrgIds": [
                  "PRO.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "the crown of old men; and the glory of children",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.6",
                "verseOrgIds": [
                  "PRO.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": "their fathers.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.6",
            "verseOrgIds": [
              "PRO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Excellent speech becometh not a fool: much less do lying lips a prince.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.7",
            "verseOrgIds": [
              "PRO.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gift",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is as",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.8",
                "verseOrgIds": [
                  "PRO.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "a precious stone in the eyes of him that hath it: whithersoever it turneth, it prospereth.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that covereth a transgression seeketh love; but he that repeateth a matter separateth",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "very",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.9",
                "verseOrgIds": [
                  "PRO.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "friends.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A reproof entereth more into a wise man than an hundred stripes into a fool.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "An evil",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.11",
                "verseOrgIds": [
                  "PRO.17.11"
                ]
              }
            }
          ]
        },
        {
          "text": "seeketh only rebellion: therefore a cruel messenger shall be sent against him.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
            "verseOrgIds": [
              "PRO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Let a bear robbed of her whelps meet a man, rather than a fool in his folly.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
            "verseOrgIds": [
              "PRO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whoso rewardeth evil for good, evil shall not depart from his house.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.13",
            "verseOrgIds": [
              "PRO.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "The beginning of strife",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is as",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.14",
                "verseOrgIds": [
                  "PRO.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "when one letteth out water: therefore leave off contention, before it be meddled with.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.14",
            "verseOrgIds": [
              "PRO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that justifieth the wicked, and he that condemneth the just, even they both",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.15",
                "verseOrgIds": [
                  "PRO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": "abomination to the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.15",
                "verseOrgIds": [
                  "PRO.17.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.15",
            "verseOrgIds": [
              "PRO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wherefore",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is there",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.16",
                "verseOrgIds": [
                  "PRO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "a price in the hand of a fool to get wisdom, seeing",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "he hath",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.16",
                "verseOrgIds": [
                  "PRO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "no heart",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "to it",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.16",
                "verseOrgIds": [
                  "PRO.17.16"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
            "verseOrgIds": [
              "PRO.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A friend loveth at all times, and a brother is born for adversity.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
              "PRO.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A man void of understanding striketh hands,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.18",
            "verseOrgIds": [
              "PRO.17.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.18",
                "verseOrgIds": [
                  "PRO.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "becometh surety in the presence of his friend.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.18",
            "verseOrgIds": [
              "PRO.17.18"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.18",
            "verseOrgIds": [
              "PRO.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "He loveth transgression that loveth strife:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.19",
            "verseOrgIds": [
              "PRO.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.19",
                "verseOrgIds": [
                  "PRO.17.19"
                ]
              }
            }
          ]
        },
        {
          "text": "he that exalteth his gate seeketh destruction.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.19",
            "verseOrgIds": [
              "PRO.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that hath a froward heart findeth no good: and he that hath a perverse tongue falleth into mischief.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.20",
            "verseOrgIds": [
              "PRO.17.20"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.20",
            "verseOrgIds": [
              "PRO.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that begetteth a fool",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.21",
            "verseOrgIds": [
              "PRO.17.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "doeth it",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.21",
                "verseOrgIds": [
                  "PRO.17.21"
                ]
              }
            }
          ]
        },
        {
          "text": "to his sorrow: and the father of a fool hath no joy.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.21",
            "verseOrgIds": [
              "PRO.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A merry heart doeth good",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.22",
            "verseOrgIds": [
              "PRO.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "like",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.22",
                "verseOrgIds": [
                  "PRO.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "a medicine: but a broken spirit drieth the bones.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.22",
            "verseOrgIds": [
              "PRO.17.22"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.22",
            "verseOrgIds": [
              "PRO.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wicked",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.23",
            "verseOrgIds": [
              "PRO.17.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.23",
                "verseOrgIds": [
                  "PRO.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "taketh a gift out of the bosom to pervert the ways of judgment.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.23",
            "verseOrgIds": [
              "PRO.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wisdom",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.24",
            "verseOrgIds": [
              "PRO.17.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.24",
                "verseOrgIds": [
                  "PRO.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "before him that hath understanding; but the eyes of a fool",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.24",
            "verseOrgIds": [
              "PRO.17.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.24",
                "verseOrgIds": [
                  "PRO.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "in the ends of the earth.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.24",
            "verseOrgIds": [
              "PRO.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A foolish son",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.25",
            "verseOrgIds": [
              "PRO.17.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.25",
                "verseOrgIds": [
                  "PRO.17.25"
                ]
              }
            }
          ]
        },
        {
          "text": "a grief to his father, and bitterness to her that bare him.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.25",
            "verseOrgIds": [
              "PRO.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Also to punish the just",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.26",
            "verseOrgIds": [
              "PRO.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.26",
                "verseOrgIds": [
                  "PRO.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "not good,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.26",
            "verseOrgIds": [
              "PRO.17.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "nor",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.26",
                "verseOrgIds": [
                  "PRO.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "to strike princes for equity.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.26",
            "verseOrgIds": [
              "PRO.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
