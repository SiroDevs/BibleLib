          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that hath knowledge spareth his words:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.27",
            "verseOrgIds": [
              "PRO.17.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.27",
                "verseOrgIds": [
                  "PRO.17.27"
                ]
              }
            }
          ]
        },
        {
          "text": "a man of understanding is of an excellent spirit.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.27",
            "verseOrgIds": [
              "PRO.17.27"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.27",
            "verseOrgIds": [
              "PRO.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Even a fool, when he holdeth his peace, is counted wise:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.28",
            "verseOrgIds": [
              "PRO.17.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.28",
                "verseOrgIds": [
                  "PRO.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "he that shutteth his lips",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.28",
            "verseOrgIds": [
              "PRO.17.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is esteemed",
              "type": "text",
              "attrs": {
                "verseId": "PRO.17.28",
                "verseOrgIds": [
                  "PRO.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "a man of understanding.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.28",
            "verseOrgIds": [
              "PRO.17.28"
            ]
          }
        }
