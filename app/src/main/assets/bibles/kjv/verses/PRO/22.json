            "sid": "PRO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "good",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.1",
                "verseOrgIds": [
                  "PRO.22.1"
                ]
              }
            }
          ]
        },
        {
          "text": "name",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.1",
                "verseOrgIds": [
                  "PRO.22.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rather to be chosen than great riches,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.1",
                "verseOrgIds": [
                  "PRO.22.1"
                ]
              }
            }
          ]
        },
        {
          "text": "loving favour rather than silver and gold.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.1",
            "verseOrgIds": [
              "PRO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The rich and poor meet together: the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.2",
                "verseOrgIds": [
                  "PRO.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.2",
                "verseOrgIds": [
                  "PRO.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": "the maker of them all.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.2",
            "verseOrgIds": [
              "PRO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A prudent",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.3",
                "verseOrgIds": [
                  "PRO.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": "foreseeth the evil, and hideth himself: but the simple pass on, and are punished.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.3",
            "verseOrgIds": [
              "PRO.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "By humility",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.4",
                "verseOrgIds": [
                  "PRO.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "the fear of the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.4",
                "verseOrgIds": [
                  "PRO.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.4",
                "verseOrgIds": [
                  "PRO.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": "riches, and honour, and life.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.4",
            "verseOrgIds": [
              "PRO.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thorns",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.5",
                "verseOrgIds": [
                  "PRO.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "snares",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "are",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.5",
                "verseOrgIds": [
                  "PRO.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "in the way of the froward: he that doth keep his soul shall be far from them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.5",
            "verseOrgIds": [
              "PRO.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Train up a child in the way he should go: and when he is old, he will not depart from it.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.6",
            "verseOrgIds": [
              "PRO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "The rich ruleth over the poor, and the borrower",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.7",
                "verseOrgIds": [
                  "PRO.22.7"
                ]
              }
            }
          ]
        },
        {
          "text": "servant to the lender.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.7",
            "verseOrgIds": [
              "PRO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that soweth iniquity shall reap vanity: and the rod of his anger shall fail.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.8",
            "verseOrgIds": [
              "PRO.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that hath a bountiful eye shall be blessed; for he giveth of his bread to the poor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.9",
            "verseOrgIds": [
              "PRO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cast out the scorner, and contention shall go out; yea, strife and reproach shall cease.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.10",
            "verseOrgIds": [
              "PRO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that loveth pureness of heart,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "for",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.11",
                "verseOrgIds": [
                  "PRO.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "the grace of his lips the king",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall be",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.11",
                "verseOrgIds": [
                  "PRO.22.11"
                ]
              }
            }
          ]
        },
        {
          "text": "his friend.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.11",
            "verseOrgIds": [
              "PRO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The eyes of the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.12",
                "verseOrgIds": [
                  "PRO.22.12"
                ]
              }
            }
          ]
        },
        {
          "text": "preserve knowledge, and he overthroweth the words of the transgressor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.12",
            "verseOrgIds": [
              "PRO.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The slothful",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.13",
                "verseOrgIds": [
                  "PRO.22.13"
                ]
              }
            }
          ]
        },
        {
          "text": "saith,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "There is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.13",
                "verseOrgIds": [
                  "PRO.22.13"
                ]
              }
            }
          ]
        },
        {
          "text": "a lion without, I shall be slain in the streets.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.13",
            "verseOrgIds": [
              "PRO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "The mouth of strange women",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.14",
                "verseOrgIds": [
                  "PRO.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "a deep pit: he that is abhorred of the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.14",
                "verseOrgIds": [
                  "PRO.22.14"
                ]
              }
            }
          ]
        },
        {
          "text": "shall fall therein.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.14",
            "verseOrgIds": [
              "PRO.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Foolishness",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.15",
                "verseOrgIds": [
                  "PRO.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bound in the heart of a child;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "but",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.15",
                "verseOrgIds": [
                  "PRO.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "the rod of correction shall drive it far from him.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.15",
            "verseOrgIds": [
              "PRO.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that oppresseth the poor to increase his",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "riches, and",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.16",
                "verseOrgIds": [
                  "PRO.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "he that giveth to the rich,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "shall",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.16",
                "verseOrgIds": [
                  "PRO.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "surely",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "come",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.16",
                "verseOrgIds": [
                  "PRO.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "to want.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.16",
            "verseOrgIds": [
              "PRO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bow down thine ear, and hear the words of the wise, and apply thine heart unto my knowledge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
              "PRO.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "For",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.18",
                "verseOrgIds": [
                  "PRO.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "a pleasant thing if thou keep them within thee; they shall withal be fitted in thy lips.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.18",
            "verseOrgIds": [
              "PRO.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "That thy trust may be in the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.19",
                "verseOrgIds": [
                  "PRO.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", I have made known to thee this day, even to thee.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Have not I written to thee excellent things in counsels and knowledge,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.20",
            "verseOrgIds": [
              "PRO.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "That I might make thee know the certainty of the words of truth; that thou mightest answer the words of truth to them that send unto thee?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.21",
            "verseOrgIds": [
              "PRO.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rob not the poor, because he",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.22",
            "verseOrgIds": [
              "PRO.22.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.22",
                "verseOrgIds": [
                  "PRO.22.22"
                ]
              }
            }
          ]
        },
        {
          "text": "poor: neither oppress the afflicted in the gate:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.22",
            "verseOrgIds": [
              "PRO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.23",
            "verseOrgIds": [
              "PRO.22.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.23",
                "verseOrgIds": [
                  "PRO.22.23"
                ]
              }
            }
          ]
        },
        {
          "text": "will plead their cause, and spoil the soul of those that spoiled them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.23",
            "verseOrgIds": [
              "PRO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Make no friendship with an angry man; and with a furious man thou shalt not go:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.24",
            "verseOrgIds": [
              "PRO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lest thou learn his ways, and get a snare to thy soul.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.25",
            "verseOrgIds": [
              "PRO.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be not thou",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
              "PRO.22.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "one",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.26",
                "verseOrgIds": [
                  "PRO.22.26"
                ]
              }
            }
          ]
        },
        {
          "text": "of them that strike hands,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
              "PRO.22.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "or",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.26",
                "verseOrgIds": [
                  "PRO.22.26"
                ]
              }
            }
          ]
        },
        {
          "text": "of them that are sureties for debts.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
              "PRO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "If thou hast nothing to pay, why should he take away thy bed from under thee?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.27",
            "verseOrgIds": [
              "PRO.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remove not the ancient landmark, which thy fathers have set.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seest thou a man diligent in his business? he shall stand before kings; he shall not stand before mean",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.29",
            "verseOrgIds": [
              "PRO.22.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "men",
              "type": "text",
              "attrs": {
                "verseId": "PRO.22.29",
                "verseOrgIds": [
                  "PRO.22.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.29",
            "verseOrgIds": [
              "PRO.22.29"
            ]
          }
        }
      ]
    }
  ],
