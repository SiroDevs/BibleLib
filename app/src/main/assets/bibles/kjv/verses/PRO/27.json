              "attrs": {
                "verseId": "PRO.27.21",
                "verseOrgIds": [
                  "PRO.27.21"
                ]
              }
            }
          ]
        },
        {
          "text": "a man to his praise.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.21",
            "verseOrgIds": [
              "PRO.27.21"
            ]
          }
        },
        {
          "name": "verse",
