        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "As",
              "type": "text",
              "attrs": {
                "verseId": "PRO.27.21",
                "verseOrgIds": [
                  "PRO.27.21"
                ]
              }
            }
          ]
        },
        {
          "text": "the fining pot for silver, and the furnace for gold; so",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.21",
            "verseOrgIds": [
              "PRO.27.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
