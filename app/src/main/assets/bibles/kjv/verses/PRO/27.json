                "verseId": "PRO.27.22",
                "verseOrgIds": [
                  "PRO.27.22"
                ]
              }
            }
          ]
        },
        {
          "text": "will not his foolishness depart from him.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.22",
            "verseOrgIds": [
              "PRO.27.22"
            ]
          }
        }
