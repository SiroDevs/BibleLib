          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wise",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        },
