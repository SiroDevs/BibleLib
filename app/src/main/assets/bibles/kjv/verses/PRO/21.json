            "style": "add"
          },
          "items": [
            {
              "text": "There is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.20",
                "verseOrgIds": [
                  "PRO.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "treasure to be desired and oil in the dwelling of the wise; but a foolish man spendeth it up.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.20",
            "verseOrgIds": [
              "PRO.21.20"
            ]
          }
        },
        {
