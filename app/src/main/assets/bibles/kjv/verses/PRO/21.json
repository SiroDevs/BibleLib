          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "The wicked",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        },
        {
          "name": "char",
