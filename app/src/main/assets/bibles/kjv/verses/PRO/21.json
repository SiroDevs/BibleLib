          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man",
              "type": "text",
              "attrs": {
                "verseId": "PRO.21.22",
                "verseOrgIds": [
                  "PRO.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "scaleth the city of the mighty, and casteth down the strength of the confidence thereof.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        },
