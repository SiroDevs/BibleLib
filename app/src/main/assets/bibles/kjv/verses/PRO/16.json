          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.19",
            "verseOrgIds": [
              "PRO.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "it is to be",
