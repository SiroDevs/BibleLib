                "verseId": "PRO.16.16",
                "verseOrgIds": [
                  "PRO.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "to get wisdom than gold! and to get understanding rather to be chosen than silver!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        },
