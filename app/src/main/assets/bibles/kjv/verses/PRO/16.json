          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "LORD's",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.11",
                "verseOrgIds": [
                  "PRO.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": ": all the weights of the bag",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        },
        {
          "name": "char",
