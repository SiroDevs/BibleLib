                "verseOrgIds": [
                  "PRO.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "life; and his favour",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
