          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "The highway of the upright",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.17",
                "verseOrgIds": [
                  "PRO.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "to depart from evil: he that keepeth his way preserveth his soul.",
          "type": "text",
          "attrs": {
