            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.16.10",
                "verseOrgIds": [
                  "PRO.16.10"
                ]
              }
            }
