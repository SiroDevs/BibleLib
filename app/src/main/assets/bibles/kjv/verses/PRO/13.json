          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that walketh with wise",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.20",
            "verseOrgIds": [
              "PRO.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "men",
              "type": "text",
              "attrs": {
                "verseId": "PRO.13.20",
                "verseOrgIds": [
                  "PRO.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "shall be wise: but a companion of fools shall be destroyed.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.20",
            "verseOrgIds": [
              "PRO.13.20"
            ]
          }
        },
        {
