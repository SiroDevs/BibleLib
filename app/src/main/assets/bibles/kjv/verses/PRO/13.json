                "verseId": "PRO.13.19",
                "verseOrgIds": [
                  "PRO.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "abomination to fools to depart from evil.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.19",
            "verseOrgIds": [
              "PRO.13.19"
            ]
          }
        },
        {
