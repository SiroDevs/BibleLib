          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A good",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.22",
            "verseOrgIds": [
              "PRO.13.22"
            ]
          }
        },
        {
