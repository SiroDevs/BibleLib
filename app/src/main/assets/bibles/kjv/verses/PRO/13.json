                "verseOrgIds": [
                  "PRO.13.23"
                ]
              }
            }
          ]
        },
        {
          "text": "the tillage of the poor: but there is",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.23",
            "verseOrgIds": [
              "PRO.13.23"
            ]
