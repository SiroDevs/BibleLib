          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The desire accomplished is sweet to the soul: but",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.19",
            "verseOrgIds": [
              "PRO.13.19"
            ]
          }
        },
