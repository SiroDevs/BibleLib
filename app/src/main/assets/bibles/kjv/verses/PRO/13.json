              "attrs": {
                "verseId": "PRO.13.18",
                "verseOrgIds": [
                  "PRO.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "him that refuseth instruction: but he that regardeth reproof shall be honoured.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.18",
            "verseOrgIds": [
              "PRO.13.18"
