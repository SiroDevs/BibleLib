          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Evil pursueth sinners: but to the righteous good shall be repayed.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.21",
            "verseOrgIds": [
              "PRO.13.21"
