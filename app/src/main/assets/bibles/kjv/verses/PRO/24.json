                "verseId": "PRO.24.23",
                "verseOrgIds": [
                  "PRO.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": "also",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        },
        {
          "name": "char",
