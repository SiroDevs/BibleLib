              "attrs": {
                "verseId": "PRO.24.26",
                "verseOrgIds": [
                  "PRO.24.26"
                ]
              }
            }
          ]
        },
        {
          "text": "shall kiss",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "his",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.26",
                "verseOrgIds": [
                  "PRO.24.26"
                ]
              }
            }
          ]
        },
        {
          "text": "lips that giveth a right answer.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
