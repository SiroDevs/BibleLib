              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "These",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        },
        {
          "name": "char",
