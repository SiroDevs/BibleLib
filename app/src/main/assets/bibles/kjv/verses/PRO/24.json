                "verseId": "PRO.24.23",
                "verseOrgIds": [
                  "PRO.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": "to the wise.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "It is",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.23",
                "verseOrgIds": [
                  "PRO.24.23"
                ]
              }
            }
          ]
        },
        {
          "text": "not good to have respect of persons in judgment.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "He that saith unto the wicked, Thou",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "art",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.24",
                "verseOrgIds": [
                  "PRO.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "righteous; him shall the people curse, nations shall abhor him:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "But to them that rebuke",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "him",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.25",
                "verseOrgIds": [
                  "PRO.24.25"
                ]
              }
            }
          ]
        },
        {
          "text": "shall be delight, and a good blessing shall come upon them.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        },
        {
