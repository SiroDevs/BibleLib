          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fret not thyself because of evil",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "men",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.19",
                "verseOrgIds": [
                  "PRO.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", neither be thou envious at the wicked;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "For there shall be no reward to the evil",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "add"
          },
          "items": [
            {
              "text": "man;",
              "type": "text",
              "attrs": {
                "verseId": "PRO.24.20",
                "verseOrgIds": [
                  "PRO.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "the candle of the wicked shall be put out.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
